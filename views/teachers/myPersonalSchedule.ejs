<%- layout("/layouts/boilerplateTeacher") -%>

<style>
  body {
    background-color: #f3f4f6;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* ✨ ELITE EMERALD / TEAL DEEP LUXURY GLASS BANNER */
  .premium-profile-card {
    background: linear-gradient(135deg, #0f172a 0%, #0f766e 100%);
    border-radius: 20px;
    box-shadow: 0 12px 30px rgba(15, 118, 110, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  /* Background decorative glow effect */
  .premium-profile-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 300px;
    height: 300px;
    background: rgba(20, 184, 166, 0.2);
    filter: blur(80px);
    border-radius: 50%;
  }

  .avatar-lux-box {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #2dd4bf;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  /* ✨ SHARP & MODERN ROUTINE CONTROLLER MATRIX */
  .matrix-wrapper-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .custom-table-panel th {
    background-color: #0f172a !important;
    color: #ffffff !important;
    font-weight: 600;
    letter-spacing: 0.5px;
    border: none !important;
  }

  .table-fixed-layout th, 
  .table-fixed-layout td {
    min-width: 180px; 
    max-width: 220px; 
    word-wrap: break-word;
    white-space: normal; 
    vertical-align: middle; 
    padding: 18px 14px !important;
  }

  /* Sleek Day Column Header Grid styling */
  .day-side-strip { 
    min-width: 110px !important; 
    max-width: 120px !important; 
    font-weight: 700; 
    color: #0f172a;
    background-color: #f8fafc !important;
    border-right: 3px solid #0f766e !important; /* Left Border line feature */
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  .time-sub-label {
    color: #94a3b8 !important;
    font-size: 0.8rem !important;
    font-weight: 400;
    margin-top: 4px;
  }

  /* ✨ PREMIUM LECTURE SELECTION ELEMENT BOARDS */
  .subject-main-title { 
    font-size: 1rem; 
    font-weight: 700; 
    color: #0f172a; 
    display: block;
    line-height: 1.3;
  }

  .class-gold-badge {
    font-size: 0.75rem; 
    font-weight: 600; 
    color: #b45309; 
    background-color: #fef3c7;
    padding: 5px 10px; 
    border-radius: 8px; 
    display: inline-block; 
    margin-top: 8px; 
    border: 1px solid #fde68a;
    box-shadow: 0 2px 5px rgba(180, 83, 9, 0.04);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Super smooth interactive hover mechanics */
  .table-fixed-layout tbody tr:hover {
    background-color: rgba(248, 250, 252, 0.7) !important;
  }

  .table-fixed-layout td:hover .class-gold-badge {
    background-color: #0f766e;
    color: #ffffff;
    border-color: #0f766e;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(15, 118, 110, 0.2);
  }

  /* Velvet Smooth Rest Period Slot styling */
  .leisure-break-cell { 
    background-color: #fafafa !important; 
    color: #9ca3af !important; 
    font-size: 0.85rem; 
    font-weight: 400;
    border: 1px dashed #e5e7eb !important;
  }

  .leisure-icon {
    color: #d1d5db;
    font-size: 0.95rem;
    margin-right: 4px;
    transition: all 0.3s ease;
  }
  
  .table-fixed-layout td:hover .leisure-icon {
    color: #f59e0b; /* Turns amber gold on mouse hover */
    transform: rotate(15deg) scale(1.1);
  }

  /* ✨ RICH STATE FALLBACK DOCK ELEMENT */
  .premium-empty-view {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 70px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.01);
  }
</style>

<div class="container-fluid my-5 px-4">
  
  <!-- 🔥 BRAND NEW DYNAMIC DUAL-GLOW BANNER CARD -->
  <div class="card premium-profile-card p-4 mb-4 text-white border-0">
    <div class="row align-items-center position-relative" style="z-index: 2;">
      <div class="col-12 text-center text-sm-start d-sm-flex align-items-center gap-4">
        <div class="avatar-lux-box mb-3 mb-sm-0">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <span class="badge bg-teal-500 text-uppercase tracking-wider px-2 py-1 mb-1" style="background-color: #14b8a6; font-size: 0.68rem; font-weight: 700; letter-spacing: 1px;">Verified Faculty Portal</span>
          <h3 class="fw-bold m-0 text-white" style="letter-spacing: -0.5px;"><%= teacherName %></h3>
          <p class="text-white-50 small m-0 mt-1 d-flex align-items-center gap-1.5">
            <i class="fa-solid fa-clock-rotate-left" style="color:#2dd4bf;"></i> Personalized Real-time Academic Calendar Sync
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- 🔥 INTERACTIVE BLUEPRINT GRID ENGINE -->
  <% if (hasSchedule) { %>
    
    <div class="card matrix-wrapper-card mb-5">
      <div class="card-header py-3.5 px-4 border-0 d-flex align-items-center justify-content-between" style="background-color: #0f172a;">
        <h5 class="m-0 fw-bold d-flex align-items-center gap-2 text-white" style="font-size: 1.05rem; letter-spacing: 0.3px;">
          <i class="fa-solid fa-grip text-teal-400" style="color: #2dd4bf;"></i> Matrix Allocation Plan
        </h5>
        <div class="d-flex align-items-center gap-2">
          <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 8px; height: 8px;"></span>
          <span class="text-white-50 small fw-medium" style="font-size: 0.8rem;">Live Engine Linked</span>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table text-center align-middle custom-table-panel table-fixed-layout mb-0">
            <thead>
              <tr>
                <th class="day-side-strip text-center text-uppercase border-b" style="background-color: #1e293b !important; color:#cbd5e1 !important;">Timeline</th>
                <% periods.forEach(period => { %>
                  <th class="py-3.5">
                    <div class="fs-6 fw-bold">Period <%= period.id %></div>
                    <div class="time-sub-label"><%= period.displayTime %></div>
                  </th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% days.forEach(day => { %>
                <tr>
                  <!-- Dynamic Left Indicator Strip Row Header -->
                  <td class="day-side-strip text-center text-uppercase fw-bold"><%= day %></td>
                  
                  <% periods.forEach(period => { %>
                    <% let slot = groupedTimetable[day] ? groupedTimetable[day][period.id] : null; %>
                    
                    <% if (slot) { %>
                      <!-- Dynamic Populated Target Session Area -->
                      <td class="bg-white">
                        <span class="subject-main-title"><%= slot.subject %></span>
                        <span class="class-gold-badge">
                          <i class="fa-solid fa-map-pin me-1" style="font-size: 9px;"></i><%= slot.targetClass %>
                        </span>
                      </td>
                    <% } else { %>
                      <!-- Premium Soft Empty Cell Area -->
                      <td class="leisure-break-cell">
                        <span class="d-flex align-items-center justify-content-center">
                          <i class="fa-solid fa-umbrella-beach leisure-icon"></i> Free period
                        </span>
                      </td>
                    <% } %>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <% } else { %>

    <!-- 🚨 NEW ELEVATED ZERO STATE FALLBACK PANEL -->
    <div class="premium-empty-view text-center my-5 mx-auto" style="max-width: 620px;">
      <div class="avatar-lux-box mx-auto mb-3" style="background: #f3f4f6; color: #9ca3af; border: none;">
        <i class="fa-solid fa-calendar-minus"></i>
      </div>
      <h4 class="fw-bold text-dark" style="letter-spacing: -0.3px;">No Schedule Found</h4>
      <p class="text-muted mx-auto mt-2 px-2" style="font-size: 0.98rem; max-width: 480px; line-height: 1.5;">
      There are no classes assigned to your name in the system for this week.
      </p>
      
      <div class="mt-4 pt-2">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-light border text-secondary small">
          <i class="fa-solid fa-circle-info text-teal-600" style="color: #0f766e;"></i>Please contact the Admin Office to update your timetable.
        </div>
      </div>
    </div>

  <% } %>

</div>