<%- layout("/layouts/boilerplateTeacher") -%>

<style>
  :root {
    --primary-slate: #0f172a;
    --accent-indigo: #4f46e5;
    --border-color: #e2e8f0;
    --bg-light: #f8fafc;
  }

  .main-wrapper { max-width: 1280px; margin: 0 auto; }
  .page-banner {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
    border-left: 6px solid var(--accent-indigo);
  }
  .page-tag {
    font-size: 0.725rem; font-weight: 800; letter-spacing: 0.6px;
    text-transform: uppercase; color: var(--accent-indigo); background: #e0e7ff;
    padding: 4px 10px; border-radius: 6px; display: inline-block;
  }
  .meta-badge {
    background: var(--bg-light); border: 1px solid var(--border-color);
    color: #475569; font-size: 0.825rem; padding: 5px 12px; border-radius: 8px; font-weight: 500;
  }
  .meta-badge strong { color: #0f172a; }
  .kpi-card {
    background: #ffffff; border: 1px solid var(--border-color);
    border-radius: 12px; padding: 14px; transition: all 0.2s ease;
  }
  .kpi-card:hover { box-shadow: 0 6px 16px rgba(0,0,0,0.04); }
  .kpi-title {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    color: #64748b; letter-spacing: 0.4px;
  }
  .kpi-value { font-size: 1.35rem; font-weight: 800; margin-top: 2px; line-height: 1.2; }
  .register-card {
    background: #ffffff; border: 1px solid var(--border-color);
    border-radius: 16px; box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03); overflow: hidden;
  }
  .register-table thead th {
    background: #f1f5f9; color: #334155; font-size: 0.75rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.6px; padding: 14px 16px;
    border-bottom: 2px solid var(--border-color);
  }
  .register-table tbody tr:hover { background-color: #f8fafc; }
  .register-table td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
  .roll-badge { background: #f1f5f9; color: #475569; font-weight: 700; padding: 4px 8px; border-radius: 6px; font-size: 0.85rem; }
  .student-name { color: #0f172a; font-weight: 700; font-size: 0.95rem; }
  .custom-input {
    border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 6px 10px;
    font-weight: 600; color: #0f172a;
  }
  .custom-input:focus { border-color: var(--accent-indigo); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12); }
  .save-bar-wrapper {
    background: #ffffff; border: 1px solid var(--border-color);
    border-radius: 12px; padding: 12px 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
  }
</style>

<div class="main-wrapper my-4 px-3">

  <!-- 1️⃣ PAGE HEADER BANNER -->
  <div class="page-banner p-3 p-md-4 mb-4">
    <div class="row align-items-center g-3">
      
      <!-- Info Section -->
      <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
          <span class="page-tag">📋 Marks Register Viewer</span>
          <% if(markSheet.status === "LOCKED") { %>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-2 fw-bold">
              🔒 Locked
            </span>
          <% } else { %>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-2 fw-bold">
              🔓 Editable
            </span>
          <% } %>
        </div>

        <!-- Corrected HTML rendering with <%- %> -->
        <h2 class="fw-bold text-dark mb-1">
          <%- markSheet.subject %> 
          <span class="text-muted fs-5 fw-normal">(<%= markSheet.examName %>)</span>
        </h2>
        
        <p class="text-muted small mb-3">Viewing student performance register for class assessments and grading.</p>

        <!-- Meta Badges -->
        <div class="d-flex flex-wrap gap-2">
          <span class="meta-badge">Session: <strong><%= markSheet.academicYear %></strong></span>
          <span class="meta-badge">Class: <strong><%= markSheet.className %> - <%= markSheet.section %></strong></span>
          <span class="meta-badge">Semester: <strong><%= markSheet.semester %></strong></span>
          <span class="meta-badge">Max Marks: <strong><%= markSheet.maxMarks %></strong></span>
          <span class="meta-badge">Passing: <strong><%= markSheet.passMarks %></strong></span>
          <span class="meta-badge">Type: <strong><%= markSheet.examType %></strong></span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="col-lg-5 text-lg-end">
        <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
          
          <!-- Delete Register Button -->
          <button 
            type="button" 
            class="btn btn-outline-danger btn-sm fw-bold rounded-2 py-2 px-3"
            data-bs-toggle="modal"
            data-bs-target="#deleteConfirmModal"
            <%= markSheet.status === "LOCKED" ? "disabled" : "" %>
          >
            🗑️ Delete Register
          </button>

          <!-- Edit Setup Button -->
          <button 
            type="button" 
            class="btn btn-outline-secondary btn-sm fw-bold rounded-2 py-2 px-3" 
            data-bs-toggle="modal" 
            data-bs-target="#editExamModal"
            <%= markSheet.status === "LOCKED" ? "disabled" : "" %>
            onclick="loadAllowedSubjects()"
          >
            ✏️ Edit Setup
          </button>

          <!-- Edit Marks Button -->
          <button 
            id="toggleEditBtn" 
            class="btn btn-primary btn-sm fw-bold rounded-2 py-2 px-3"
            style="background-color: var(--accent-indigo); border: none;"
            <%= markSheet.status === "LOCKED" ? "disabled" : "" %>
            onclick="enableMarksEdit()"
          >
            📝 Edit Marks
          </button>

        </div>
      </div>

    </div>
  </div>

  <!-- 2️⃣ KPI STATS DASHBOARD -->
  <div class="row g-2 mb-4">
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center">
        <div class="kpi-title">Students</div>
        <div class="kpi-value text-dark"><%= stats.totalStudents %></div>
      </div>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center" style="border-left: 4px solid #22c55e;">
        <div class="kpi-title text-success">Present</div>
        <div class="kpi-value text-success"><%= stats.presentCount %></div>
      </div>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center" style="border-left: 4px solid #ef4444;">
        <div class="kpi-title text-danger">Absent</div>
        <div class="kpi-value text-danger"><%= stats.absentCount %></div>
      </div>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center" style="border-left: 4px solid #06b6d4;">
        <div class="kpi-title text-info">Highest</div>
        <div class="kpi-value text-info"><%= stats.highest %></div>
      </div>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center" style="border-left: 4px solid #eab308;">
        <div class="kpi-title text-warning">Lowest</div>
        <div class="kpi-value text-warning"><%= stats.lowest %></div>
      </div>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="kpi-card text-center" style="border-left: 4px solid #6366f1;">
        <div class="kpi-title text-indigo" style="color: #6366f1;">Average</div>
        <div class="kpi-value text-indigo" style="color: #6366f1;"><%= stats.average %></div>
      </div>
    </div>
  </div>

  <!-- 3️⃣ MARKS REGISTER TABLE FORM -->
  <form action="/update/student-marks/<%= markSheet._id %>" method="POST" id="marksForm" class="needs-validation" novalidate>
    <div class="register-card">
      <div class="table-responsive">
        <table class="table register-table align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 100px;">Admin No</th>
              <th>Student Name</th>
              <th>fatherName</th>
              <th style="width: 160px;">Attendance</th>
              <th style="width: 180px;">Obtained Score</th>
              <th>Remarks / Note</th>
            </tr>
          </thead>
          <tbody>
            <% markSheet.students.forEach((s) => { %>
              <tr>
                <td><span class="roll-badge"><%= s.rollNumber %></span></td>
                <td><div class="student-name"><%= s.studentName %></div></td>
                <td><div class="student-name"><%= s.fatherName %></div></td>

                <!-- Attendance Status -->
                <td>
                  <select 
                    name="studentMarks[<%= s.studentId %>][attendanceStatus]" 
                    class="form-select form-select-sm custom-input attendance-input" 
                    data-student-id="<%= s.studentId %>"
                    disabled
                  >
                    <option value="Present" <%= s.attendanceStatus === 'Present' ? 'selected' : '' %>>🟢 Present</option>
                    <option value="Absent" <%= s.attendanceStatus === 'Absent' ? 'selected' : '' %>>🔴 Absent</option>
                  </select>
                </td>

                <!-- Obtained Marks -->
                <td>
                  <span class="marks-text fw-bold fs-6 <%= s.attendanceStatus === 'Absent' ? 'text-danger' : 'text-primary' %>">
                    <%= s.attendanceStatus === 'Absent' ? 'AB' : s.obtainedMarks %> 
                    <small class="text-muted fw-normal fs-7">/ <%= markSheet.maxMarks %></small>
                  </span>
                  <div class="input-group input-group-sm d-none marks-input-group">
                    <input 
                      type="number" 
                      id="input-marks-<%= s.studentId %>"
                      name="studentMarks[<%= s.studentId %>][obtainedMarks]" 
                      class="form-control custom-input marks-input fw-bold" 
                      value="<%= s.obtainedMarks %>" 
                      max="<%= markSheet.maxMarks %>" 
                      min="0"
                      step="0.01"
                      disabled
                      <%= s.attendanceStatus === 'Absent' ? 'disabled' : '' %>
                    >
                    <span class="input-group-text bg-light text-muted fw-semibold">/ <%= markSheet.maxMarks %></span>
                  </div>
                </td>

                <!-- Remarks -->
                <td>
                  <span class="remarks-text text-muted small"><%= s.remarks || '-' %></span>
                  <input 
                    type="text" 
                    name="studentMarks[<%= s.studentId %>][remarks]" 
                    class="form-control form-control-sm custom-input remarks-input d-none" 
                    value="<%= s.remarks %>" 
                    maxlength="150"
                    disabled
                  >
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Floating / Sticky Save Action Bar -->
    <div id="saveBar" class="d-none justify-content-end align-items-center gap-2 mt-3 save-bar-wrapper">
      <span class="text-muted small me-2"><i class="bi bi-info-circle"></i> Unsaved changes present</span>
      <button type="button" class="btn btn-light border btn-sm fw-semibold rounded-2 px-3" onclick="location.reload()">Cancel</button>
      <button type="submit" id="saveMarksBtn" class="btn btn-success btn-sm fw-bold rounded-2 px-4">💾 Save Register</button>
    </div>
  </form>

</div>

<!-- 4️⃣ EDIT EXAM DETAILS MODAL -->
<div class="modal fade" id="editExamModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom px-4 pt-4 pb-3">
        <h5 class="modal-title fw-bold text-dark">✏️ Edit Exam Setup</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/update/exam-details/<%= markSheet._id %>" method="POST" id="editExamForm" class="needs-validation" novalidate>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-bold small text-muted text-uppercase">Subject Name</label>
            <select name="subject" id="editSubjectSelect" class="form-select custom-input" required>
              <!-- Corrected option tag rendering -->
              <option value="<%- markSheet.subject %>" selected><%- markSheet.subject %></option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small text-muted text-uppercase">Exam / Test Name</label>
            <input type="text" name="examName" class="form-control custom-input" value="<%= markSheet.examName %>" required>
          </div>

          <div class="row g-2">
            <div class="col-6 mb-3">
              <label class="form-label fw-bold small text-muted text-uppercase">Max Marks</label>
              <input type="number" id="editMaxMarks" name="maxMarks" class="form-control custom-input" value="<%= markSheet.maxMarks %>" required min="1" readonly>
            </div>
            <div class="col-6 mb-3">
              <label class="form-label fw-bold small text-muted text-uppercase">Passing Marks</label>
              <input type="number" id="editPassMarks" name="passMarks" class="form-control custom-input" value="<%= markSheet.passMarks %>" required min="0" readonly>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small text-muted text-uppercase">Exam Type</label>
            <select name="examType" class="form-select custom-input" required>
              <option value="Theory" <%= markSheet.examType === 'Theory' ? 'selected' : '' %>>Theory</option>
              <option value="Practical" <%= markSheet.examType === 'Practical' ? 'selected' : '' %>>Practical</option>
            </select>
          </div>
        </div>

        <div class="modal-footer border-top px-4 py-3">
          <button type="button" class="btn btn-light border fw-semibold rounded-2" data-bs-dismiss="modal">Close</button>
          <button type="submit" id="saveExamBtn" class="btn btn-primary fw-bold rounded-2">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 5️⃣ DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-body p-4 text-center">
        <div class="text-danger mb-2 fs-1">⚠️</div>
        <h5 class="fw-bold text-dark mb-1">Delete Register?</h5>
        <p class="text-muted small mb-3">Are you sure you want to delete this marksheet for <strong><%- markSheet.subject %> (<%= markSheet.examName %>)</strong>? This action cannot be undone.</p>
        
        <form action="/delete/marks-register/<%= markSheet._id %>" method="POST">
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-light border w-50 fw-semibold rounded-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger w-50 fw-bold rounded-2">Delete</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Single HTML Entity Decode Function
function decodeHTMLEntities(text) {
  const textarea = document.createElement('textarea');
  textarea.innerHTML = text;
  return textarea.value;
}

async function loadAllowedSubjects() {
  const subjectSelect = document.getElementById("editSubjectSelect");
  const className = "<%= markSheet.className %>";
  const semester = "<%= markSheet.semester %>";
  const section = "<%= markSheet.section %>";
  
  // Decoding current subject safely
  const currentSubject = decodeHTMLEntities("<%- markSheet.subject %>");

  try {
    const res = await fetch(`/get-subjects?class=${encodeURIComponent(className)}&semester=${encodeURIComponent(semester)}&section=${encodeURIComponent(section)}`);
    const subjects = await res.json();

    if (Array.isArray(subjects) && subjects.length > 0) {
      subjectSelect.innerHTML = "";

      // Current subject added first
      const currentOpt = document.createElement("option");
      currentOpt.value = currentSubject;
      currentOpt.textContent = currentSubject;
      currentOpt.selected = true;
      subjectSelect.appendChild(currentOpt);

      // Append rest without duplicates
      subjects.forEach(sub => {
        if (sub !== currentSubject) {
          const opt = document.createElement("option");
          opt.value = sub;
          opt.textContent = sub;
          subjectSelect.appendChild(opt);
        }
      });
    }
  } catch (err) {
    console.error("Error loading subjects:", err);
  }
}

function enableMarksEdit() {
  document.querySelectorAll(".marks-text").forEach(el => el.classList.add("d-none"));
  document.querySelectorAll(".remarks-text").forEach(el => el.classList.add("d-none"));

  document.querySelectorAll(".attendance-input").forEach(el => el.removeAttribute("disabled"));
  document.querySelectorAll(".marks-input-group").forEach(el => el.classList.remove("d-none"));
  document.querySelectorAll(".marks-input").forEach(el => el.removeAttribute("disabled"));
  document.querySelectorAll(".remarks-input").forEach(el => {
    el.classList.remove("d-none");
    el.removeAttribute("disabled");
  });

  document.getElementById("saveBar").classList.remove("d-none");
  document.getElementById("saveBar").classList.add("d-flex");
  document.getElementById("toggleEditBtn").classList.add("d-none");
  
  const firstEnabledInput = document.querySelector(".marks-input:not(:disabled)");
  if (firstEnabledInput) {
    firstEnabledInput.focus();
    firstEnabledInput.select();
  }
}

document.addEventListener("DOMContentLoaded", () => {
  const saveMarksBtn = document.getElementById("saveMarksBtn");

  // Attendance Toggle Logic
  document.querySelectorAll(".attendance-input").forEach(select => {
    select.addEventListener("change", (e) => {
      const studentId = e.target.getAttribute("data-student-id");
      const marksInput = document.getElementById(`input-marks-${studentId}`);
      
      if (e.target.value === "Absent") {
        marksInput.value = 0;
        marksInput.disabled = true;
      } else {
        marksInput.disabled = false;
      }
    });
  });

  // ENTER KEY NAVIGATION FOR MARKS INPUTS
  const marksInputs = Array.from(document.querySelectorAll(".marks-input"));
  marksInputs.forEach((input, index) => {
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();

        let nextIndex = index + 1;
        while (nextIndex < marksInputs.length && marksInputs[nextIndex].disabled) {
          nextIndex++;
        }

        if (nextIndex < marksInputs.length) {
          marksInputs[nextIndex].focus();
          marksInputs[nextIndex].select();
        } else {
          saveMarksBtn.focus();
        }
      }
    });
  });

  // ENTER KEY NAVIGATION FOR REMARKS INPUTS
  const remarksInputs = Array.from(document.querySelectorAll(".remarks-input"));
  remarksInputs.forEach((input, index) => {
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();

        let nextIndex = index + 1;
        while (nextIndex < remarksInputs.length && remarksInputs[nextIndex].disabled) {
          nextIndex++;
        }

        if (nextIndex < remarksInputs.length) {
          remarksInputs[nextIndex].focus();
          remarksInputs[nextIndex].select();
        } else {
          saveMarksBtn.focus();
        }
      }
    });
  });

  const editExamForm = document.getElementById("editExamForm");
  editExamForm.addEventListener("submit", (e) => {
    const maxMarks = parseFloat(document.getElementById("editMaxMarks").value);
    const passMarks = parseFloat(document.getElementById("editPassMarks").value);

    if (passMarks > maxMarks) {
      e.preventDefault();
      alert("Validation Error: Passing marks cannot be greater than Maximum marks.");
      return false;
    }
  });
});
</script>