<%- layout("/layouts/boilerplateTeacher") -%>

<div id="loaderOverlay" style="
  display:none;
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,0.6);
  z-index:9999;
  justify-content:center;
  align-items:center;
  flex-direction:column;
  color:white;
  font-size:20px;
">
  <div class="spinner"></div>
  <p>Please wait... Updating attendance</p>
</div>

<style>
.spinner {
  width:50px;
  height:50px;
  border:6px solid #f3f3f3;
  border-top:6px solid #0d6efd;
  border-radius:50%;
  animation:spin 1s linear infinite;
  margin-bottom:15px;
}
@keyframes spin {
  0% { transform:rotate(0deg); }
  100% { transform:rotate(360deg); }
}
</style>

<div class="container mt-3">
  <div class="text-center mb-4">
    <h3 class="fw-bold text-primary">📝 Update Attendance</h3>
    <p class="text-muted">Date: <%= new Date().toDateString() %></p>
  </div>

  <div class="row g-3 mb-3">

   <input type="hidden" id="className" value="<%= cleanClass %>">
  <input type="hidden" id="semester" value="<%= cleanSemester %>">
  <input type="hidden" id="section" value="<%= cleanSection %>">
  <input type="hidden" id="teacherName" value="<%= teacherName %>">
  

    <div class="col-md-4">
      <label for="period" class="form-label fw-bold">Period</label>
      <% if (currentAttendance && currentAttendance.periods) { %>
        <select id="period_display" class="form-select shadow-sm" disabled>
          <option value="<%= currentAttendance.periods %>" selected>
            <%= currentAttendance.periods %>
          </option>
        </select>
        <input type="hidden" id="period" name="period" value="<%= currentAttendance.periods %>">
      <% } else { %>
        <input id="period" name="period" type="number" min="1" max="6" class="form-control shadow-sm" placeholder="Enter period number" value="">
      <% } %>
    </div>

    <div class="col-md-4">
      <label for="unit" class="form-label fw-bold">Unit</label>
      <input id="unit" type="text" class="form-control shadow-sm" placeholder="Enter unit" value="<%= currentAttendance?.unit || '' %>">
    </div>

    <div class="col-md-4">
      <label for="subject" class="form-label fw-bold">Subject</label>
      <select id="subject_display" class="form-control shadow-sm" disabled>
        <% for(let sub of commonSubjects){ %>
          <option value="<%= sub %>" <%= sub === subject ? "selected" : "" %>><%= sub %></option>
        <% } %>
      </select>
      <input type="hidden" id="subject" name="subject" value="<%= subject %>">
    </div>
  </div>

  <div class="mb-3">
    <label for="description" class="form-label fw-bold">
      Description <small class="text-muted">(max 200 characters)</small>
    </label>
    <textarea id="description" name="description" rows="3" class="form-control shadow-sm" placeholder="Enter description... max 200 characters only" maxlength="200" required><%= currentAttendance?.description || "" %></textarea>
    <div class="d-flex justify-content-between mt-1">
      <small class="text-muted">Max 200 characters</small>
      <small id="charCount" class="fw-semibold text-secondary">0 / 200</small>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-6 d-flex mb-2 mb-md-0">
      <input type="text" id="searchInput" class="form-control me-2 shadow-sm" placeholder="Search by name...">
      <button type="button" id="searchBtn" class="btn btn-primary shadow-sm">Search</button>
      <button type="button" id="backBtn" class="btn btn-secondary ms-2 shadow-sm" style="display:none;">Back</button>
    </div>
    
    <div class="col-md-6 text-md-end">
      <button type="button" class="btn btn-success me-2 shadow-sm" id="markAllPresent">All Present</button>
      <button type="button" class="btn btn-danger shadow-sm" id="markAllAbsent">All Absent</button>
    </div>
  </div>

  <div id="searchMsg" class="text-danger fw-bold text-center mb-2" style="display:none;"></div>

  <div class="table-responsive shadow rounded p-2 bg-white">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark text-center">
        <tr>
          <th>Roll No</th>
          <th>Name</th>
          <th>Father Name</th>
          <th>Attendance</th>
        </tr>
      </thead>
      <tbody id="studentTableBody">
        <% for(let s of students){ %>
          <tr class="text-center" data-student-id="<%= s._id %>">
            <td><%= s.rollNo %></td>
            <td><%= s.name %></td>
            <td><%= s.fatherName %></td>
            <td>
              <div class="d-flex justify-content-center align-items-center">
                <button class="btn btn-sm btn-success mark-btn" data-id="<%= s._id %>" data-status="Present">P</button>
                <button class="btn btn-sm btn-danger ms-2 mark-btn" data-id="<%= s._id %>" data-status="Absent">A</button>
                <span class="ms-3 fw-bold status <%= s.attendanceToday === 'Present' ? 'text-success' : (s.attendanceToday === 'Absent' ? 'text-danger' : '') %>">
                  <%= s.attendanceToday || "" %>
                </span>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="text-center mt-3">
    <button class="btn btn-primary col-4 fw-bold" id="doneBtn">Done</button>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const tableBody = document.getElementById("studentTableBody");
  const originalTableBody = tableBody.innerHTML; 
  const msgBox = document.getElementById("searchMsg");
  const backBtn = document.getElementById("backBtn");
  const description = document.getElementById("description");
  const charCount = document.getElementById("charCount");
  const loader = document.getElementById("loaderOverlay");

  // 🔹 FUTURE-PROOF FIX: Global state to track ALL students attendance
  const allStudentsAttendance = {};

  // Initialize global state with current values from DOM on first load
  function initializeAttendanceState() {
    document.querySelectorAll("#studentTableBody tr").forEach(row => {
      const studentId = row.dataset.studentId;
      const statusSpan = row.querySelector(".status");
      if (studentId && statusSpan) {
        const currentStatus = statusSpan.textContent.trim();
        if (currentStatus === "Present" || currentStatus === "Absent") {
          allStudentsAttendance[studentId] = currentStatus;
        }
      }
    });
  }
  initializeAttendanceState();

  // Description character limit indicator
  description.addEventListener("input", () => {
    const length = description.value.length;
    charCount.textContent = `${length} / 200`;
    if (length >= 200) {
      charCount.className = "fw-semibold text-danger";
    } else {
      charCount.className = "fw-semibold text-secondary";
    }
  });

  // Function to sync UI status based on global state
  function syncUIFromState() {
    document.querySelectorAll("#studentTableBody tr").forEach(row => {
      const studentId = row.dataset.studentId;
      if (studentId && allStudentsAttendance[studentId]) {
        const status = allStudentsAttendance[studentId];
        const statusSpan = row.querySelector(".status");
        if (statusSpan) {
          statusSpan.textContent = status;
          statusSpan.classList.remove("text-success", "text-danger");
          statusSpan.classList.add(status === "Present" ? "text-success" : "text-danger");
        }
      }
    });
  }

  function attachEvents() {
    document.querySelectorAll(".mark-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const studentId = e.target.dataset.id;
        const status = e.target.dataset.status;
        
        // Update global state
        allStudentsAttendance[studentId] = status;
        
        // Update current row UI
        const row = e.target.closest("tr");
        const statusSpan = row.querySelector(".status");
        statusSpan.textContent = status;
        statusSpan.classList.remove("text-success", "text-danger");
        statusSpan.classList.add(status === "Present" ? "text-success" : "text-danger");
      });
    });
  }
  attachEvents();

  // Bulk Present
  document.getElementById("markAllPresent").addEventListener("click", () => {
    // If table is filtered, mark only visible ones, or mark all from original DOM.
    // To make it perfectly intuitive: mark whatever is currently visible in UI
    document.querySelectorAll("#studentTableBody tr").forEach(row => {
      const studentId = row.dataset.studentId;
      if(studentId) {
        allStudentsAttendance[studentId] = "Present";
      }
    });
    syncUIFromState();
  });

  // Bulk Absent
  document.getElementById("markAllAbsent").addEventListener("click", () => {
    document.querySelectorAll("#studentTableBody tr").forEach(row => {
      const studentId = row.dataset.studentId;
      if(studentId) {
        allStudentsAttendance[studentId] = "Absent";
      }
    });
    syncUIFromState();
  });

  // Search Implementation
  document.getElementById("searchBtn").addEventListener("click", async () => {
    const query = document.getElementById("searchInput").value.trim();
    if(!query) return;

    try {
      const res = await fetch(`/search/attendance/student?name=${encodeURIComponent(query)}`);
      const results = await res.json();

      tableBody.innerHTML = "";
      msgBox.style.display = "none";

      if(!results.success){
        msgBox.innerText = results.message;
        msgBox.style.display = "block";
        backBtn.style.display = "inline-block";
        return;
      }

      results.data.forEach(s => {
        const tr = document.createElement("tr");
        tr.classList.add("text-center");
        tr.setAttribute("data-student-id", s._id);
        
        // Check if we already have an un-submitted status change in memory
        const currentStatus = allStudentsAttendance[s._id] || s.attendanceToday || "";
        const statusClass = currentStatus === 'Present' ? 'text-success' : (currentStatus === 'Absent' ? 'text-danger' : '');

        tr.innerHTML = `
          <td>${s.rollNo}</td>
          <td>${s.name}</td>
          <td>${s.fatherName}</td>
          <td>
            <div class="d-flex justify-content-center align-items-center">
              <button class="btn btn-sm btn-success mark-btn" data-id="${s._id}" data-status="Present">P</button>
              <button class="btn btn-sm btn-danger ms-2 mark-btn" data-id="${s._id}" data-status="Absent">A</button>
              <span class="ms-3 fw-bold status ${statusClass}">${currentStatus}</span>
            </div>
          </td>
        `;
        tableBody.appendChild(tr);
      });

      attachEvents();
      backBtn.style.display = "inline-block"; 
    } catch(err){ console.error(err); }
  });

  // Back Button Fix
  backBtn.onclick = () => {
    tableBody.innerHTML = originalTableBody;
    attachEvents();
    syncUIFromState(); // Restore state onto full list
    msgBox.style.display = "none";
    backBtn.style.display = "none";
    document.getElementById("searchInput").value = "";
  };

  // Submit Handler
  document.getElementById("doneBtn").addEventListener("click", async () => {
    const period = parseInt(document.getElementById("period").value, 10);
    const unit = document.getElementById("unit").value.trim();
    const description = document.getElementById("description").value.trim();
    const subject = document.getElementById("subject").value.trim();
    const className = document.getElementById("className").value.trim();
    const section = document.getElementById("section").value.trim();
    const semester = document.getElementById("semester").value.trim();
     const teacherName = document.getElementById("teacherName").value.trim();
    

    if(!period || period < 1 || period > 6){ alert("Enter valid period 1-6"); return; }
    if(!unit){ alert("Unit is required"); return; }
    if(!description){ alert("Description is required"); return; }
    if(!subject){ alert("Select a subject"); return; }

    // Frontend validation: Check total count from original list if necessary
    if(Object.keys(allStudentsAttendance).length === 0){
      alert("Please mark attendance before saving!");
      return;
    }

    try {
      // Show loader overlay safely
      loader.style.display = "flex";

      const res = await fetch("/attendance/updateAll", {
        method: "POST",
        headers: { "Content-Type":"application/json" },
        body: JSON.stringify({ students: allStudentsAttendance, period, unit, description, subject,className,section,semester, teacherName  })
      });

      if(res.ok) {
         window.location.href = "/student/attendance/record";
      } else {
         loader.style.display = "none";
         alert("Server error occurred while saving attendance.");
      }
    } catch(err){ 
      loader.style.display = "none";
      console.error(err); 
    }
  });
});
</script>
