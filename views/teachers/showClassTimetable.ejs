<%- layout("/layouts/boilerplateTeacher") -%>

<style>
  body {
    background-color: #f3f4f6;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* ✨ ELITE EMERALD / TEAL DEEP LUXURY GLASS BANNER */
  .premium-profile-card {
    background: linear-gradient(135deg, #0f172a 0%, #0f766e 100%);
    border-radius: 20px;
    box-shadow: 0 12px 30px rgba(15, 118, 110, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  /* Background decorative glow effect */
  .premium-profile-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 300px;
    height: 300px;
    background: rgba(20, 184, 166, 0.2);
    filter: blur(80px);
    border-radius: 50%;
  }

  .avatar-lux-box {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #2dd4bf;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  /* Dynamic Top pill layout trackers */
  .meta-glass-pill {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 18px;
    min-width: 120px;
    backdrop-filter: blur(4px);
  }

  /* ✨ SHARP & MODERN ROUTINE CONTROLLER MATRIX */
  .matrix-wrapper-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .custom-table-panel th {
    background-color: #0f172a !important;
    color: #ffffff !important;
    font-weight: 600;
    letter-spacing: 0.5px;
    border: none !important;
  }

  .table-fixed-layout th, 
  .table-fixed-layout td {
    min-width: 180px; 
    max-width: 220px; 
    word-wrap: break-word;
    white-space: normal; 
    vertical-align: middle; 
    padding: 18px 14px !important;
  }

  /* Sleek Day Column Header Grid styling */
  .day-side-strip { 
    min-width: 110px !important; 
    max-width: 120px !important; 
    font-weight: 700; 
    color: #0f172a;
    background-color: #f8fafc !important;
    border-right: 3px solid #0f766e !important;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
  }

  .time-sub-label {
    color: #94a3b8 !important;
    font-size: 0.8rem !important;
    font-weight: 400;
    margin-top: 4px;
  }

  /* ✨ PREMIUM LECTURE SELECTION ELEMENT BOARDS */
  .subject-main-title { 
    font-size: 1rem; 
    font-weight: 700; 
    color: #0f172a; 
    display: block;
    line-height: 1.3;
  }

  .faculty-gold-badge {
    font-size: 0.75rem; 
    font-weight: 600; 
    color: #b45309; 
    background-color: #fef3c7;
    padding: 5px 10px; 
    border-radius: 8px; 
    display: inline-block; 
    margin-top: 8px; 
    border: 1px solid #fde68a;
    box-shadow: 0 2px 5px rgba(180, 83, 9, 0.04);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Interactive hover mechanics */
  .table-fixed-layout tbody tr:hover {
    background-color: rgba(248, 250, 252, 0.7) !important;
  }

  .table-fixed-layout td:hover .faculty-gold-badge {
    background-color: #0f766e;
    color: #ffffff;
    border-color: #0f766e;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(15, 118, 110, 0.2);
  }

  /* Soft Blank Cell Area */
  .leisure-break-cell { 
    background-color: #fafafa !important; 
    color: #9ca3af !important; 
    font-size: 0.85rem; 
    font-weight: 400;
    border: 1px dashed #e5e7eb !important;
  }

  /* Lunch slot style override */
  .lunch-break-cell {
    background-color: #fffbeb !important;
    color: #d97706 !important;
    font-weight: 700;
    font-size: 0.9rem;
    border: 1px solid #fef3c7 !important;
  }

  /* ✨ RICH STATE FALLBACK / ERROR CARD STYLING */
  .premium-empty-view {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 60px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.01);
  }

  .status-icon-ring {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    margin-bottom: 20px;
  }
  .ring-missing { background-color: #fef2f2; color: #ef4444; }
  .ring-incomplete { background-color: #fff7ed; color: #f97316; }
</style>

<div class="container-fluid my-5 px-4">
  
  <!-- 🔥 DUAL-GLOW BANNER CARD WITH CLASS CONFIG DATA -->
  <div class="card premium-profile-card p-4 mb-4 text-white border-0">
    <div class="row align-items-center position-relative" style="z-index: 2;">
      <div class="col-lg-5 text-center text-lg-start d-sm-flex align-items-center gap-4 mb-3 mb-lg-0">
        <div class="avatar-lux-box mb-3 mb-sm-0">
          <i class="fa-solid fa-network-wired"></i>
        </div>
        <div>
          <span class="badge text-uppercase tracking-wider px-2 py-1 mb-1" style="background-color: #14b8a6; font-size: 0.68rem; font-weight: 700; letter-spacing: 1px;">Class Monitoring System</span>
          <h3 class="fw-bold m-0 text-white" style="letter-spacing: -0.5px;">Master Timetable View</h3>
        </div>
      </div>
      
      <!-- Right Side Tracking Meta Badges -->
      <div class="col-lg-7">
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-end">
          <div class="meta-glass-pill text-center">
            <span class="text-white-50 d-block small" style="font-size: 0.72rem; font-weight: 500;">COURSE / CLASS</span>
            <strong class="fs-6 text-white"><%= className %></strong>
          </div>
          <div class="meta-glass-pill text-center">
            <span class="text-white-50 d-block small" style="font-size: 0.72rem; font-weight: 500;">SEMESTER</span>
            <strong class="fs-6 text-white"><%= semester %></strong>
          </div>
          <div class="meta-glass-pill text-center">
            <span class="text-white-50 d-block small" style="font-size: 0.72rem; font-weight: 500;">SECTION</span>
            <strong class="fs-6" style="color: #2dd4bf;"><%= section %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🔥 DYNAMIC RENDER MONITOR ENGINE -->
  <% if (isComplete) { %>
    
    <div class="card matrix-wrapper-card mb-5">
      <div class="card-header py-3.5 px-4 border-0 d-flex align-items-center justify-content-between" style="background-color: #0f172a;">
        <h5 class="m-0 fw-bold d-flex align-items-center gap-2 text-white" style="font-size: 1.05rem; letter-spacing: 0.3px;">
          <i class="fa-solid fa-grip text-teal-400" style="color: #2dd4bf;"></i> Structural Database Route Mapping
        </h5>
        <div class="d-flex align-items-center gap-2">
          <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 8px; height: 8px;"></span>
          <span class="text-white-50 small fw-medium" style="font-size: 0.8rem;">Data Integrity Verified</span>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table text-center align-middle custom-table-panel table-fixed-layout mb-0">
            <thead>
              <tr>
                <th class="day-side-strip text-center text-uppercase border-b" style="background-color: #1e293b !important; color:#cbd5e1 !important;">Timeline</th>
                <% periods.forEach(period => { %>
                  <th class="py-3.5">
                    <div class="fs-6 fw-bold">Lecture <%= period.id %></div>
                    <div class="time-sub-label"><%= period.displayTime %></div>
                  </th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% days.forEach(day => { %>
                <tr>
                  <!-- Dynamic Left Strip Column -->
                  <td class="day-side-strip text-center text-uppercase fw-bold"><%= dayNames[day] %></td>
                  
                  <% periods.forEach(period => { %>
                    <% let slot = groupedTimetable[day] ? groupedTimetable[day][period.id] : null; %>
                    
                    <% if (slot) { %>
                      <% if (slot.subject.includes('LUNCH')) { %>
                        <!-- Lunch Break Allocation Row overrides -->
                        <td class="lunch-break-cell text-uppercase">
                          <i class="fa-solid fa-utensils me-1"></i> Lunch Break
                        </td>
                      <% } else { %>
                        <!-- Standard Class Booked Slot -->
                        <td class="bg-white">
                          <span class="subject-main-title"><%= slot.subject %></span>
                          <span class="faculty-gold-badge">
                            <i class="fa-solid fa-user-tie me-1" style="font-size: 9px;"></i><%= slot.teacher %>
                          </span>
                        </td>
                      <% } %>
                    <% } else { %>
                      <!-- Gray Empty Cell -->
                      <td class="leisure-break-cell">-</td>
                    <% } %>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <% } else { %>

    <!-- 🚨 NEW DYNAMIC INTEGRATED ANOMALY WRAPPER STATES -->
    <div class="premium-empty-view text-center my-5 mx-auto" style="max-width: 620px;">
      <% if (messageType === 'missing') { %>
        <div class="status-icon-ring ring-missing mx-auto">
          <i class="fa-solid fa-calendar-xmark"></i>
        </div>
        <h4 class="fw-bold text-dark" style="letter-spacing: -0.3px;">Timetable Schema Missing</h4>
        <p class="text-muted mx-auto mt-2 px-2" style="font-size: 0.98rem; max-width: 480px; line-height: 1.5;">
        No timetable has been created yet for <strong><%= className %> (Section- <%= section %>)</strong> in the system.
        </p>
      <% } else if (messageType === 'incomplete') { %>
        <div class="status-icon-ring ring-incomplete mx-auto">
          <i class="fa-solid fa-circle-exclamation"></i>
        </div>
        <h4 class="fw-bold text-dark" style="letter-spacing: -0.3px;">Incomplete Timetable</h4>
        <p class="text-muted mx-auto mt-2 px-2" style="font-size: 0.98rem; max-width: 480px; line-height: 1.5;">
       Some lecture slots are empty or missing details for this class schedule.
        </p>
      <% } %>
      
      <div class="mt-4 pt-2">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-light border text-secondary small">
          <i class="fa-solid fa-lightbulb text-teal-600" style="color: #0f766e;"></i> System Hint: Please contact the Admin Office to fix or update this schedule.
      </div>
      </div>
    </div>

  <% } %>

</div>