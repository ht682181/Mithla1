<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mithla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="/images/logo.png">

    <style>
        /* Modern Gradient Rangeen Background */
        body {
            background: linear-gradient(-45deg, #0f172a, #1e1b4b, #2e1065, #0f172a);
            background-size: 400% 400%;
            animation: gradientBg 15s ease infinite;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        @keyframes gradientBg {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* --- STAGE CONTAINER (Height optimized for compactness) --- */
        .stage-container {
            width: 100%;
            max-width: 940px;
            height: 520px;
            background: linear-gradient(135deg, #2b44cb 0%, #4f46e5 100%);
            border-radius: 24px;
            position: relative;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding: 30px 45px;
            transition: all 0.5s ease;
        }

        /* --- LEFT SIDE: CHARACTER & 3D TEXT --- */
        .left-branding-section {
            width: 42%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 10;
            opacity: 0;
            transform: translateX(-100px);
            animation: characterWalkIn 1.5s forwards 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* PREMIUM 3D TEXT */
        .welcome-text-3d {
            font-size: 2.4rem;
            font-weight: 900;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
            text-shadow: 0 1px 0 #cbd5e1,
                         0 2px 0 #94a3b8,
                         0 3px 0 #64748b,
                         0 4px 0 #475569,
                         0 5px 0 #334155,
                         0 6px 20px rgba(0,0,0,0.4);
            transform-style: preserve-3d;
            animation: textFloat 3s infinite alternate ease-in-out;
        }

        @keyframes textFloat {
            0% { transform: translateY(0) rotateX(10deg) rotateY(-5deg); }
            100% { transform: translateY(-10px) rotateX(10deg) rotateY(5deg); }
        }

        .premium-avatar {
            width: 100%;
            max-width: 200px;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 15px 25px rgba(0,0,0,0.4));
            animation: avatarIdle 2.5s infinite alternate ease-in-out 2s;
        }

        /* --- RIGHT SIDE: FORM CONTAINER --- */
        .form-section {
            width: 46%;
            z-index: 20;
            position: relative;
        }

        /* PREMIUM COMPACT FORM BOX */
        .login-box {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px) saturate(120%);
            -webkit-backdrop-filter: blur(16px) saturate(120%);
            border-radius: 20px;
            box-shadow: 0px 30px 60px rgba(0, 0, 0, 0.35), 
                        inset 0px 1px 0px rgba(255, 255, 255, 0.5);
            padding: 1.8rem 2rem !important;
            width: 100%;
            transform: scale(0) translateY(50px);
            opacity: 0;
            transform-origin: center right;
            animation: formPopUp 0.8s forwards 1.8s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        /* Custom Alert Messages inside Form Card */
        .custom-form-alert {
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.6rem 0.9rem;
            margin-bottom: 1.2rem;
            border: 1px solid transparent;
        }

        /* Typography & Inputs */
        .form-heading { color: #0f172a; font-weight: 800; font-size: 1.6rem; letter-spacing: -0.5px; }
        .form-subheading { color: #64748b; font-size: 0.88rem; margin-bottom: 1.2rem; }
        .form-label { font-weight: 600; color: #334155; font-size: 0.8rem; margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .form-control {
            border-radius: 10px;
            padding: 0.65rem 1rem;
            border: 1px solid #e2e8f0;
            background-color: rgba(248, 250, 252, 0.8);
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .form-control:focus {
            background-color: #ffffff;
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
            transform: translateY(-1px);
        }

        /* Interactive Action Button */
        .btn-custom-green {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            color: white;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem;
            border-radius: 10px;
            width: 100%;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
            transition: all 0.25s ease;
        }
        .btn-custom-green:hover { 
            background: linear-gradient(135deg, #34d399 0%, #059669 100%);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.5);
            transform: translateY(-2px);
        }

        .forgot-password-link { text-decoration: none; color: #4f46e5; font-size: 0.8rem; font-weight: 600; }
        .forgot-password-link:hover { color: #312e81; text-decoration: underline; }

        /* Keyframes */
        @keyframes characterWalkIn {
            0% { opacity: 0; transform: translateX(-150px); }
            100% { opacity: 1; transform: translateX(0); }
        }
        @keyframes avatarIdle {
            0% { transform: translateY(0); }
            100% { transform: translateY(-8px); }
        }
        @keyframes formPopUp {
            0% { transform: scale(0) translateY(50px); opacity: 0; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        /* Responsive */
        @media (max-width: 920px) {
            .stage-container {
                flex-direction: column;
                height: auto;
                padding: 25px 20px;
                gap: 20px;
            }
            .left-branding-section { width: 100%; height: auto; }
            .welcome-text-3d { font-size: 2rem; margin-bottom: 5px; }
            .premium-avatar { max-height: 130px; }
            .form-section { width: 100%; }
            .login-box { padding: 1.5rem 1.2rem !important; }
        }
    </style>
</head>
<body>

    <div class="stage-container">
        
        <div class="left-branding-section">
            <div class="welcome-text-3d"> 🚩 Welcome 🚩</div>
            
            <svg class="premium-avatar" viewBox="0 0 200 240" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="120" r="70" fill="rgba(255,255,255,0.1)"/>
                <rect x="84" y="170" width="12" height="60" rx="4" fill="#3b0764"/>
                <rect x="104" y="170" width="12" height="60" rx="4" fill="#3b0764"/>
                <ellipse cx="90" cy="230" rx="10" ry="6" fill="#ffffff"/>
                <ellipse cx="110" cy="230" rx="10" ry="6" fill="#ffffff"/>
                <path d="M 65 105 Q 45 120 70 145" stroke="#ffccd5" stroke-width="10" stroke-linecap="round" fill="none"/>
                <path d="M 135 105 Q 165 110 180 100" stroke="#ffccd5" stroke-width="10" stroke-linecap="round" fill="none"/>
                <path d="M 70 105 L 130 105 L 125 170 L 75 170 Z" fill="#3b0764"/>
                <path d="M 75 100 L 125 100 L 120 130 L 80 130 Z" fill="#ffffff"/>
                <rect x="94" y="80" width="12" height="25" fill="#ffccd5"/>
                <circle cx="100" cy="70" r="22" fill="#ffccd5"/>
                <path d="M 78 65 Q 100 40 122 65 Q 125 85 115 85 Q 100 70 85 85 Z" fill="#1e293b"/>
                <circle cx="92" cy="68" r="2" fill="#000000"/>
                <circle cx="108" cy="68" r="2" fill="#000000"/>
                <path d="M 95 78 Q 100 82 105 78" stroke="#000000" stroke-width="1.5" fill="none"/>
                <circle cx="77" cy="74" r="4" stroke="#eab308" stroke-width="2" fill="none"/>
                <circle cx="123" cy="74" r="4" stroke="#eab308" stroke-width="2" fill="none"/>
            </svg>
        </div>

        <div class="form-section">
            <div class="login-box">

                <% if(typeof error !== 'undefined' && error && error.length){ %>
                    <div class="alert alert-danger custom-form-alert alert-dismissible fade show shadow-sm" role="alert">
                        ⚠️ <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <% if(typeof success !== 'undefined' && success && success.length){ %>
                    <div class="alert alert-success custom-form-alert alert-dismissible fade show shadow-sm" role="alert">
                        ✅ <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <form id="loginForm" action="/student/attendance/login" method="post" novalidate class="needs-validation">
                    
                    <div class="text-center">
                        <h2 class="form-heading">Login now</h2>
                        <p class="form-subheading">Secure your spot in our live system</p>
                    </div>
                    
                    <div class="mb-2">
                        <label for="role" class="form-label">Role</label>
                        <input name="role" class="form-control shadow-sm" id="role" placeholder="Select your role" required list="option" autocomplete="off">
                        <datalist id="option">
                            <option value="Admin"></option>
                            <option value="Teacher"></option>
                            <option value="Student"></option>
                        </datalist>
                    </div>

                    <div class="mb-2">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" name="username" class="form-control shadow-sm" id="username" placeholder="Username" required autocomplete="off">
                    </div>
                   
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="password" class="form-label mb-0">Password</label>
                            <a href="/forgot-password" class="forgot-password-link">Forgot?</a>
                        </div>
                        <input type="password" name="password" class="form-control shadow-sm" id="password" placeholder="Password" required>
                    </div>

                    <button type="submit" class="btn btn-custom-green shadow-sm">Next</button>
                </form>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Form field client-side checker
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()

        // Dynamic routing action path configuration based on role selection
        document.getElementById("role").addEventListener("change", function() {
            let form = document.getElementById("loginForm");
            if (this.value === "Teacher") {
                form.action = "/login/modal";   
            } else {
                form.action = "/student/attendance/login";
            }
        });
    </script>
</body>
</html>