<%- layout("/layouts/boilerplateTeacher") -%>

<style>
  .page-container {
    max-width: 1320px;
    margin: 0 auto;
  }
  .glass-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.05);
  }

  .sidebar-gradient {
    background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .sidebar-gradient::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }

  .step-badge {
    background: #e0e7ff;
    color: #3730a3;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 6px 14px;
    border-radius: 30px;
    text-transform: uppercase;
  }

  .form-control-pro, .form-select-pro {
    border: 1.5px solid #e2e8f0;
    background-color: #f8fafc;
    border-radius: 12px;
    padding: 12px 16px;
    font-weight: 600;
    color: #1e293b;
    transition: all 0.2s ease-in-out;
  }

  .form-control-pro:focus, .form-select-pro:focus {
    background-color: #ffffff;
    border-color: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
  }

  .form-control-pro:disabled, .form-select-pro:disabled {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    opacity: 0.6;
    cursor: not-allowed;
  }

  .pro-label {
    font-size: 0.825rem;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }

  .btn-gradient-submit {
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    border: none;
    border-radius: 14px;
    padding: 14px 28px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
    transition: all 0.25s ease;
  }

  .btn-gradient-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(79, 70, 229, 0.4);
  }

  .btn-gradient-submit:disabled {
    background: #cbd5e1;
    box-shadow: none;
    cursor: not-allowed;
  }

  .info-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 12px 16px;
  }

  .exam-select-box {
    border: 2px solid #6366f1 !important;
    background-color: #f5f3ff !important;
  }
</style>

<div class="page-container my-4 px-3">

    <!-- Centered Header Section -->
<div class="text-center mb-4 pb-2 mt-4">

  <h3 class="fw-bold text-dark mb-1"> 📊 Student View  Marks</h3>
  <p class="text-muted small mb-0">Select class filters below to view published marksheets and academic records</p>
</div>
  <div class="w-100">
    <div class="card glass-card p-3 p-lg-4">
      <div class="row g-4 align-items-stretch">
        
        

        <!-- LEFT PANEL: Dark Status & Info Board -->
        <div class="col-lg-4 d-flex mt-5">
          <div class="sidebar-gradient p-4 p-xl-5 w-100 d-flex flex-column justify-content-between">
            <div>
              <span class="badge bg-indigo rounded-pill px-3 py-2 mb-3 fw-bold fs-7" style="background: #6366f1;">
                Marks Register Viewer
              </span>
              <h2 class="fw-extrabold text-white mb-2">Search Records</h2>
              <p class="text-white-50 fs-6">Select class parameters and exam filters to load published student marksheets.</p>

              <div class="mt-4 pt-2 d-flex flex-column gap-3">
                <div class="info-pill">
                  <div class="text-white-50 small text-uppercase fw-bold"><i class="bi bi-funnel me-1"></i> Filter Status</div>
                  <div class="fw-semibold text-white fs-7 mt-1">
                    Select Class, Section & Subject to query available exams.
                  </div>
                </div>

                <div class="info-pill">
                  <div class="text-white-50 small text-uppercase fw-bold"><i class="bi bi-shield-check me-1"></i> Access Scope</div>
                  <div class="fw-bold text-warning fs-6 mt-1">Teacher Authorized Register</div>
                </div>
              </div>
            </div>

            <div class="pt-4 border-top border-secondary border-opacity-25 mt-4">
              <small class="text-white-50"><i class="bi bi-info-circle me-1"></i> Academic years load automatically from existing entries.</small>
            </div>
          </div>
        </div>

        <!-- RIGHT PANEL: Filter Form Grid -->
        <div class="col-lg-8 ps-lg-4">
          <form action="/view/student-marks" method="GET" class="needs-validation h-100 d-flex flex-column justify-content-between" novalidate>
            
            <div>
              <!-- STEP 1: Academic Year & Class Mapping -->
              <div class="d-flex align-items-center gap-2 mb-3">
                <span class="step-badge">Phase 01</span>
                <h5 class="fw-bold text-dark mb-0">Class & Session Filters</h5>
              </div>

              <!-- Academic Year -->
              <div class="mb-3">
                <label class="pro-label">Academic Session / Year</label>
                <select name="academicYear" id="academicYear" class="form-select form-select-pro shadow-none" required disabled>
                  <option value="">Loading Academic Years...</option>
                </select>
                <div class="invalid-feedback">Please select academic year</div>
              </div>

              <!-- Class & Semester -->
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="pro-label">Class</label>
                  <select name="className" id="class" class="form-select form-select-pro shadow-none" required>
                    <option value="">-- Choose Class --</option>
                    <% if (classData?.class?.length) { %>
                      <% classData.class.forEach(cls => { %>
                        <option value="<%= cls.className %>"><%= cls.className %></option>
                      <% }) %>
                    <% } %>
                  </select>
                  <div class="invalid-feedback">Please select class</div>
                </div>

                <div class="col-md-6">
                  <label class="pro-label">Semester</label>
                  <select name="semester" id="semester" class="form-select form-select-pro shadow-none" required disabled>
                    <option value="">-- Choose Semester --</option>
                  </select>
                  <div class="invalid-feedback">Please select semester</div>
                </div>
              </div>

              <!-- Section & Subject -->
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="pro-label">Section</label>
                  <select name="section" id="section" class="form-select form-select-pro shadow-none" required disabled>
                    <option value="">-- Choose Section --</option>
                  </select>
                  <div class="invalid-feedback">Please select section</div>
                </div>

                <div class="col-md-6">
                  <label class="pro-label">Subject</label>
                  <select name="subject" id="subject" class="form-select form-select-pro shadow-none" required disabled>
                    <option value="">-- Choose Subject --</option>
                  </select>
                  <div class="invalid-feedback">Please select subject</div>
                </div>
              </div>

              <hr class="my-4" style="border-top: 1.5px dashed #cbd5e1;">

              <!-- STEP 2: Exam Target Selection -->
              <div class="d-flex align-items-center gap-2 mb-3">
                <span class="step-badge" style="background:#fef3c7; color:#92400e;">Phase 02</span>
                <h5 class="fw-bold text-dark mb-0">Select Target Assessment</h5>
              </div>

              <!-- Exam Name Dropdown -->
              <div class="mb-3">
                <label class="pro-label text-indigo" style="color: #4f46e5;">Exam / Test Name</label>
                <select name="examName" id="examName" class="form-select form-select-pro exam-select-box shadow-none" required disabled>
                  <option value="">-- Choose Exam --</option>
                </select>
                <div class="invalid-feedback">Please select exam</div>
                <small id="examHelpText" class="form-text text-muted mt-2 d-block">
                  Complete all upper selections to load available examination registers.
                </small>
              </div>
            </div>

            <!-- Action Bar -->
            <div class="pt-4 border-top mt-4 d-flex justify-content-end">
              <button type="submit" id="submitBtn" class="btn btn-primary btn-gradient-submit text-white w-100 w-md-auto" disabled>
                Load Marks Register <i class="bi bi-box-arrow-in-right ms-2"></i>
              </button>
            </div>

          </form>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- SCRIPT (100% UNTOUCHED LOGIC) -->
<script>
const academicYearSelect = document.getElementById("academicYear");
const classSelect = document.getElementById("class");
const semesterSelect = document.getElementById("semester");
const sectionSelect = document.getElementById("section");
const subjectSelect = document.getElementById("subject");
const examSelect = document.getElementById("examName");
const submitBtn = document.getElementById("submitBtn");

// 🟢 PAGE LOAD HOTEY HI TEACHER KE ACADEMIC YEARS FETCH KARO
window.addEventListener("DOMContentLoaded", async () => {
  try {
    const res = await fetch("/get-teacher-academic-years");
    const years = await res.json();

    if (!years || years.length === 0) {
      academicYearSelect.innerHTML = '<option value="">No Registers Found</option>';
      academicYearSelect.disabled = true;
      return;
    }

    academicYearSelect.innerHTML = '<option value="">-- Select Academic Year --</option>';
    years.forEach(year => {
      academicYearSelect.innerHTML += `<option value="${year}">${year}</option>`;
    });

    academicYearSelect.disabled = false;
  } catch (error) {
    console.error("Error loading academic years:", error);
    academicYearSelect.innerHTML = '<option value="">Failed to Load Years</option>';
  }
});

// Helper Reset Function
function resetExams() {
  examSelect.innerHTML = '<option value="">-- Choose Exam --</option>';
  examSelect.disabled = true;
  submitBtn.disabled = true;
}

// 1️⃣ CLASS → SEMESTER
classSelect.addEventListener("change", async () => {
  const className = classSelect.value;
  semesterSelect.innerHTML = '<option>Loading...</option>';
  semesterSelect.disabled = true;
  sectionSelect.innerHTML = '<option value="">-- Choose Section --</option>';
  sectionSelect.disabled = true;
  subjectSelect.innerHTML = '<option value="">-- Choose Subject --</option>';
  subjectSelect.disabled = true;
  resetExams();

  if (!className) return;

  const res = await fetch(`/get-semesters?class=${encodeURIComponent(className)}`);
  const semesters = await res.json();

  semesterSelect.innerHTML = '<option value="">-- Choose Semester --</option>';
  semesters.forEach(s => {
    semesterSelect.innerHTML += `<option value="${s}">${s}</option>`;
  });
  semesterSelect.disabled = false;
});

// 2️⃣ SEMESTER → SECTION
semesterSelect.addEventListener("change", async () => {
  const className = classSelect.value;
  const semester = semesterSelect.value;

  sectionSelect.innerHTML = '<option>Loading...</option>';
  sectionSelect.disabled = true;
  subjectSelect.innerHTML = '<option value="">-- Choose Subject --</option>';
  subjectSelect.disabled = true;
  resetExams();

  if (!className || !semester) return;

  const res = await fetch(`/get-sections?class=${encodeURIComponent(className)}&semester=${encodeURIComponent(semester)}`);
  const sections = await res.json();

  sectionSelect.innerHTML = '<option value="">-- Choose Section --</option>';
  sections.forEach(sec => {
    sectionSelect.innerHTML += `<option value="${sec}">${sec}</option>`;
  });
  sectionSelect.disabled = false;
});

// 3️⃣ SECTION → SUBJECT
sectionSelect.addEventListener("change", async () => {
  const className = classSelect.value;
  const semester = semesterSelect.value;
  const section = sectionSelect.value;

  subjectSelect.innerHTML = '<option>Loading Subjects...</option>';
  subjectSelect.disabled = true;
  resetExams();

  if (!className || !semester || !section) return;

  const res = await fetch(`/get-subjects?class=${encodeURIComponent(className)}&semester=${encodeURIComponent(semester)}&section=${encodeURIComponent(section)}`);
  const subjects = await res.json();

  subjectSelect.innerHTML = '<option value="">-- Choose Subject --</option>';
  subjects.forEach(sub => {
    subjectSelect.innerHTML += `<option value="${sub.subjectName}">${sub.subjectName}</option>`;
  });
  subjectSelect.disabled = false;
});

// 4️⃣ SUBJECT / ACADEMIC YEAR → FETCH EXAMS (API CALL)
async function fetchExams() {
  const academicYear = academicYearSelect.value;
  const className = classSelect.value;
  const semester = semesterSelect.value;
  const section = sectionSelect.value;
  const subject = subjectSelect.value;

  if (!academicYear || !className || !semester || !section || !subject) {
    resetExams();
    return;
  }

  examSelect.innerHTML = '<option>Loading Exams...</option>';
  examSelect.disabled = true;

  const queryParams = new URLSearchParams({
    academicYear,
    className,
    semester,
    section,
    subject
  });

  const res = await fetch(`/get-exams-by-filters?${queryParams.toString()}`);
  const exams = await res.json();

  if (exams.length === 0) {
    examSelect.innerHTML = '<option value="">-- No Exams Found --</option>';
    examSelect.disabled = true;
    submitBtn.disabled = true;
    return;
  }

  examSelect.innerHTML = '<option value="">-- Select Exam --</option>';
  exams.forEach(ex => {
    examSelect.innerHTML += `<option value="${ex}">${ex}</option>`;
  });

  examSelect.disabled = false;
}

// Triggers for fetching exams
subjectSelect.addEventListener("change", fetchExams);
academicYearSelect.addEventListener("change", fetchExams);

// Enable submit button when exam is chosen
examSelect.addEventListener("change", () => {
  submitBtn.disabled = !examSelect.value;
});
</script>