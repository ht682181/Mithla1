<%# views/student/messages/index.ejs
    <% layout("layouts/boilerplate") %>
%>
<script>window.CURRENT_USER_ROLE = "Student";</script>
<link rel="stylesheet" href="/css/messaging.css" />

<div class="msg-app">
  <div class="msg-shell">
    <div class="msg-eyebrow">Inbox</div>
    <h1 class="msg-title">Your Messages <span id="notif-badge"></span></h1>
    <p class="msg-subtitle">Messages sent to your class, section, or directly to you.</p>

    <div id="inboxList">
      <% if (!messages || messages.length === 0) { %>
        <div class="msg-card">
          <div class="msg-empty">
            <div class="msg-empty-mark">✉</div>
            <p>No messages yet.</p>
          </div>
        </div>
      <% } else { %>
        <% messages.forEach(function(m) { %>
          <div class="msg-inbox-card" data-msg-id="<%= m._id %>">
            <div class="msg-inbox-head">
              <div>
                <span class="msg-sender-name"><%= m.sender.name %></span>
                <span class="msg-sender-role"><%= m.sender.role %></span>
              </div>
              <span class="msg-timestamp"><%= new Date(m.createdAt).toLocaleString() %></span>
            </div>

            <p class="msg-content-text"><%= m.content %></p>

            <% if (m.subjectContext && m.subjectContext.subjectName) { %>
              <div class="msg-meta-line">Subject: <%= m.subjectContext.subjectName %></div>
            <% } %>

            <% if (canReply) { %>
              <div class="msg-reply-box">
                <textarea placeholder="Write a reply…" class="replyText"></textarea>
                <button class="msg-btn msg-btn-primary msg-btn-sm replyBtn" data-msg-id="<%= m._id %>">Reply</button>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
(function () {
  document.querySelectorAll(".replyBtn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const card = btn.closest(".msg-inbox-card");
      const id = btn.dataset.msgId;
      const textarea = card.querySelector(".replyText");
      const content = textarea.value.trim();
      if (!content) return alert("Reply cannot be empty.");

      btn.disabled = true;
      btn.textContent = "Sending…";

      const res = await fetch(`/student/message/${id}/reply`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content }),
      });

      btn.disabled = false;
      btn.textContent = "Reply";

      if (res.ok || res.redirected) {
        textarea.value = "";
        const confirmEl = document.createElement("div");
        confirmEl.className = "msg-meta-line";
        confirmEl.style.color = "var(--green-600)";
        confirmEl.textContent = "✓ Reply sent";
        card.appendChild(confirmEl);
        setTimeout(() => confirmEl.remove(), 3000);
      } else {
        const errBody = await res.json().catch(() => null);
        alert(errBody?.message || "Failed to send reply. Reply may be disabled by administrator.");
      }
    });
  });
})();
</script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/socketClient.js"></script>
