<%- layout("/layouts/boilerplate") %>

<style>
  .table-fixed-layout th,
  .table-fixed-layout td {
    vertical-align: middle;
    padding: 10px 8px !important;
  }
  .stat-card {
    border-left: 5px solid #0d6efd;
    transition: transform 0.2s ease-in-out;
  }
  .stat-card:hover { transform: translateY(-2px); }
  .stat-card-success { border-left-color: #198754; }
  .stat-card-info { border-left-color: #0dcaf0; }
  .stat-card-warning { border-left-color: #ffc107; }
  .stat-card-danger { border-left-color: #dc3545; }

  .sticky-section-nav {
    position: sticky;
    top: 10px;
    z-index: 1020;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(5px);
    border-radius: 12px;
  }
  .sem-due-badge {
    font-size: 0.78rem;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .btn-remove-penalty {
    line-height: 1;
    font-size: 0.85rem;
    padding: 1px 5px;
    border-radius: 50%;
  }
</style>

<!-- 🔔 DYNAMIC TOAST NOTIFICATION -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
  <div id="dynamicToast" class="toast align-items-center text-white border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body fw-bold" id="toastMessage">--</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<div class="container-fluid my-4">

  <!-- 🔍 MAIN COURSE/BATCH FILTER -->
  <div class="card shadow-sm border-0 bg-white p-4 mb-4">
    <div class="row align-items-center">
      <div class="col-md-5">
        <h3 class="fw-bold text-dark m-0">Fee Management Dashboard</h3>
        <p class="text-muted small m-0">Select Course & Batch Session to load student ledgers.</p>
      </div>
      <div class="col-md-7 mt-3 mt-md-0">
        <form id="feeFilterForm" action="/show/fee/dashboard" method="GET" class="row g-2 justify-content-md-end">
          <div class="col-md-5">
            <select name="baseCourse" id="classSelector" class="form-select form-select-lg fw-bold border-2" onchange="checkAndSubmitForm()">
              <option value="" <%= !selectedBaseCourse ? 'selected' : '' %> disabled>-- Select Course --</option>
              <% allBaseCourses.forEach(course => { %>
                <option value="<%= course %>" <%= selectedBaseCourse === course ? 'selected' : '' %>><%= course %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-5">
            <select name="batchSession" id="yearSelector" class="form-select form-select-lg fw-bold border-2" onchange="checkAndSubmitForm()">
              <option value="" <%= !selectedBatch ? 'selected' : '' %> disabled>-- Select Batch Session --</option>
              <% allBatches.forEach(batch => { %>
                <option value="<%= batch %>" <%= selectedBatch === batch ? 'selected' : '' %>><%= batch %></option>
              <% }); %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <% if (selectedBaseCourse && selectedBatch && Object.keys(sectionwiseData).length > 0) { %>

    <!-- 📊 GRAND OVERALL SUMMARY CARD -->
    <div class="card border-0 shadow-sm bg-dark text-white p-3 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-secondary pb-2">
        <h5 class="fw-bold m-0 text-warning">
          <i class="fa-solid fa-chart-line me-2"></i>Overall Collection Summary (<%= selectedBaseCourse %> - <%= selectedBatch %>)
        </h5>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-light btn-sm fw-bold" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> Print Current Data
          </button>
          <span class="badge bg-success fs-6 px-3 py-2 fw-bold">
            Total Collected: ₹<%= (overallDashboard.totalCollected || 0).toLocaleString('en-IN') %>
          </span>
        </div>
      </div>
      <div class="row text-center g-2 pt-1">
        <div class="col">
          <small class="text-light-50 d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Total Demand</small>
          <span class="fw-bold fs-6">₹<%= (overallDashboard.totalFee || 0).toLocaleString('en-IN') %></span>
        </div>
        <div class="col">
          <small class="text-light-50 d-block text-uppercase fw-semibold text-success" style="font-size: 0.75rem;">Sem Paid</small>
          <span class="fw-bold fs-6 text-success">₹<%= (overallDashboard.totalPaid || 0).toLocaleString('en-IN') %></span>
        </div>
        <div class="col">
          <small class="text-light-50 d-block text-uppercase fw-semibold text-info" style="font-size: 0.75rem;">Total Advance</small>
          <span class="fw-bold fs-6 text-info">₹<%= (overallDashboard.totalAdvance || 0).toLocaleString('en-IN') %></span>
        </div>
        <div class="col">
          <small class="text-light-50 d-block text-uppercase fw-semibold text-warning" style="font-size: 0.75rem;">Total Penalty</small>
          <span class="fw-bold fs-6 text-warning">₹<%= (overallDashboard.totalPenalty || 0).toLocaleString('en-IN') %></span>
        </div>
        <div class="col">
          <small class="text-light-50 d-block text-uppercase fw-semibold text-danger" style="font-size: 0.75rem;">Net Pending</small>
          <span class="fw-bold fs-6 text-danger">₹<%= (overallDashboard.netPending || 0).toLocaleString('en-IN') %></span>
        </div>
      </div>
    </div>

    <!-- 🔘 JUMP TO SECTION NAVIGATION TABS -->
    <div class="card sticky-section-nav p-2 mb-4 shadow-sm border">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="fw-bold text-muted ms-2 small text-uppercase">
          <i class="fa-solid fa-compass me-1"></i> Jump To Section:
        </span>
        <div class="d-flex gap-2">
          <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
            <button type="button" class="btn btn-dark fw-bold btn-sm px-3" onclick="scrollToSec('SEC_BLOCK_<%= sec %>')">
              🚩 Section <%= sec %>
            </button>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- 📦 ITERATE SECTIONS -->
    <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
      <% const secInfo = sectionwiseData[sec]; %>
      <% const secSummary = secInfo.summary; %>
      <% const secStudents = secInfo.students; %>
      <% const yrData = secInfo.yearlyBreakdown; %>

      <div id="SEC_BLOCK_<%= sec %>" class="mb-5 pt-3 border-top">
        
        <!-- SUMMARY DASHBOARD CARDS -->
        <div class="mb-3">
          <h5 class="fw-bold text-dark mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><span class="badge bg-primary fs-6 me-1">Section <%= sec %></span> Summary Dashboard</span>
            <span class="badge bg-success fs-6 fw-bold">Section Total Collected: ₹<%= (secSummary.totalCollected || 0).toLocaleString('en-IN') %></span>
          </h5>
          <div class="row g-2">
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card bg-white">
                <span class="text-muted small fw-bold text-uppercase">Total Demand</span>
                <h4 class="fw-bold text-dark mb-0 mt-1">₹<%= (secSummary.totalFee || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-success bg-white">
                <span class="text-muted small fw-bold text-uppercase">Collected</span>
                <h4 class="fw-bold text-success mb-0 mt-1">₹<%= (secSummary.totalPaid || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-warning bg-white">
                <span class="text-muted small fw-bold text-uppercase">⚠️ Total Penalty</span>
                <h4 class="fw-bold text-warning mb-0 mt-1">₹<%= (secSummary.totalPenalty || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-info bg-white">
                <span class="text-muted small fw-bold text-uppercase">Advance</span>
                <h4 class="fw-bold text-info mb-0 mt-1">₹<%= (secSummary.totalAdvance || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-danger bg-white">
                <span class="text-muted small fw-bold text-uppercase">Net Pending</span>
                <h4 class="fw-bold text-danger mb-0 mt-1">₹<%= (secSummary.netPending || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
          </div>
        </div>

        <!-- OVERVIEW BAR (YEAR-WISE SPLIT) -->
        <div class="card bg-light border-0 shadow-sm p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold m-0 text-dark">
              <span class="badge bg-dark me-1"><%= selectedBaseCourse %></span> Section <%= sec %> Overview (Year-wise Split)
            </h5>
          </div>
          <div class="row g-2 text-center">
            <% ["1ST YEAR", "2ND YEAR", "3RD YEAR", "4TH YEAR"].forEach(yTag => { %>
              <% const yMetrics = yrData[yTag]; %>
              <% if (yMetrics && (yMetrics.demand > 0 || yMetrics.paid > 0)) { %>
                <div class="col-md-3">
                  <div class="bg-white p-2 rounded border shadow-sm">
                    <span class="fw-bold text-primary border-bottom d-block mb-1"><%= yTag %></span>
                    <div class="d-flex justify-content-between px-2 small">
                      <span>Demand: <b>₹<%= yMetrics.demand.toLocaleString('en-IN') %></b></span>
                      <span class="text-success">Paid: <b>₹<%= yMetrics.paid.toLocaleString('en-IN') %></b></span>
                    </div>
                    <div class="d-flex justify-content-between px-2 small mt-1">
                      <span class="text-warning">Fine: <b>₹<%= yMetrics.penalty.toLocaleString('en-IN') %></b></span>
                      <span class="text-danger">Pending: <b>₹<%= yMetrics.pending.toLocaleString('en-IN') %></b></span>
                    </div>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>

        <!-- SECTION ACTION BAR -->
        <div class="card bg-dark text-white p-3 mb-3 shadow-sm border-0">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
              <div class="form-check m-0 ms-1">
                <input type="checkbox" class="form-check-input sec-master-cb" data-sec="<%= sec %>" id="masterSelect_<%= sec %>" style="transform: scale(1.2); cursor: pointer;">
                <label class="form-check-label fw-bold text-light ms-1" for="masterSelect_<%= sec %>" style="cursor: pointer;">Select All Section <%= sec %></label>
              </div>
              <span class="badge bg-warning text-dark fw-bold px-3 py-2" id="counter_<%= sec %>">0 Selected</span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button class="btn btn-warning btn-sm fw-bold px-3" onclick="togglePenaltyDrawer('<%= sec %>')">
                ⚠️ Add Penalty (Sec <%= sec %>)
              </button>

              <button type="button" 
                      class="btn btn-outline-light btn-sm fw-bold px-3" 
                      onclick="openEditStructureModal('<%= selectedBaseCourse %>', '<%= selectedBatch %>', '<%= sec %>')">
                ✏️ Edit Structure
              </button>

              <button type="button" 
                      class="btn btn-outline-danger btn-sm fw-bold px-3" 
                      onclick="openDeleteStructureModal('<%= selectedBaseCourse %>', '<%= selectedBatch %>', '<%= sec %>')">
                🗑️ Delete Structure
              </button>
            </div>
          </div>

          <!-- PENALTY DRAWER -->
          <div id="penaltyDrawer_<%= sec %>" class="bg-light p-3 mt-3 text-dark rounded d-none">
            <div class="row align-items-center g-2">
              <div class="col-md-3">
                <label class="fw-bold small mb-1">Target Semester:</label>
                <select id="penaltySem_<%= sec %>" class="form-select form-select-sm fw-bold">
                  <option value="1">Semester 1</option>
                  <option value="2">Semester 2</option>
                  <option value="3">Semester 3</option>
                  <option value="4">Semester 4</option>
                  <option value="5">Semester 5</option>
                  <option value="6">Semester 6</option>
                  <option value="7">Semester 7</option>
                  <option value="8">Semester 8</option>
                </select>
              </div>
              <div class="col-md-6">
                <span class="small text-muted fw-bold">Penalty enter karke "Save Penalties" par click karein.</span>
              </div>
              <div class="col-md-3 text-end">
                <button type="button" class="btn btn-success btn-sm fw-bold px-4" onclick="saveSectionPenalties('<%= sec %>', event)">
                  💾 Save Penalties
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- SEARCH & UNPAID PDF FILTER BAR -->
        <div class="card p-3 bg-white mb-3 shadow-sm border">
          <div class="row g-2 align-items-center">
            <div class="col-md-4">
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control fw-bold" id="searchInp_<%= sec %>" placeholder="Search Student Name / Admin No..." onkeyup="filterSectionTable('<%= sec %>')">
              </div>
            </div>

            <div class="col-md-6">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold small text-muted">Unpaid Fee Sem Filter:</span>
                <% [1,2,3,4,5,6,7,8].forEach(sNum => { %>
                  <div class="form-check form-check-inline m-0">
                    <input class="form-check-input sem-filter-cb-<%= sec %>" type="checkbox" value="<%= sNum %>" id="sem_<%= sec %>_<%= sNum %>" onchange="filterSectionTable('<%= sec %>')">
                    <label class="form-check-label small fw-bold" for="sem_<%= sec %>_<%= sNum %>">Sem <%= sNum %></label>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="col-md-2 text-end">
              <button class="btn btn-danger btn-sm fw-bold w-100" onclick="exportRouteUnpaidPDF('<%= sec %>')">
                <i class="fa-solid fa-file-pdf me-1"></i> Download PDF
              </button>
            </div>
          </div>
        </div>

        <!-- UNIFIED TABLE -->
        <div class="card shadow-sm border">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-bordered table-striped table-hover align-middle text-center table-fixed-layout mb-0" id="table_<%= sec %>">
                <thead class="table-dark">
                  <tr>
                    <th style="width: 40px;">#</th>
                    <th style="width: 120px;">Admin No</th>
                    <th class="text-start" style="width: 220px;">Student Details</th>
                    <th class="text-start" style="width: 45%;">Semesters, Dues & Penalty</th>
                    <th style="width: 30%;">Total Paid, Advance, Balance & Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% secStudents.forEach((student) => { %>
                    <tr class="student-row-<%= sec %>" 
                        data-name="<%= (student.studentName || '').toLowerCase() %>" 
                        data-roll="<%= (student.rollNumber || '').toString().toLowerCase() %>">
                      <td>
                        <input type="checkbox" class="form-check-input student-cb-<%= sec %>" value="<%= student._id %>" data-stname="<%= student.studentName %>" data-stroll="<%= student.rollNumber %>" onchange="updateSectionCount('<%= sec %>')">
                      </td>
                      <td class="fw-bold text-dark"><%= student.rollNumber %></td>
                      <td class="text-start">
                        <div class="fw-bold text-primary"><%= student.studentName %></div>
                        <small class="text-muted"><i class="fa-solid fa-user-group me-1"></i><%= student.fatherName || 'N/A' %></small>
                      </td>
                      
                      <td class="text-start">
                        <% if (student.semesters && student.semesters.length > 0) { %>
                          <% student.semesters.forEach(sem => { %>
                            <% const penAmt = sem.penalty_amount || sem.penalty || 0; %>
                            <% const paidAmt = sem.amount_paid || 0; %>
                            <div class="sem-due-badge border bg-light mb-1 d-flex justify-content-between align-items-center" data-semnum="<%= sem.semNumber %>" data-sempending="<%= sem.calculated_pending %>">
                              <div>
                                <span class="badge bg-secondary me-1">Sem <%= sem.semNumber %></span>
                                <span class="fw-bold">Due: ₹<%= (sem.due_amount || 0).toLocaleString('en-IN') %></span>
                                <% if (penAmt > 0) { %>
                                  <span class="badge bg-danger ms-1 d-inline-flex align-items-center gap-1">
                                    +Fine: ₹<%= penAmt %>
                                    <button type="button" 
                                            class="btn btn-dark text-white btn-remove-penalty ms-1" 
                                            title="Remove Penalty"
                                            data-studentid="<%= student._id %>"
                                            data-semnum="<%= sem.semNumber %>"
                                            data-paidamt="<%= paidAmt %>"
                                            onclick="handlePenaltyClick(this)">
                                      &times;
                                    </button>
                                  </span>
                                <% } %>
                              </div>
                              <span class="small text-muted">(Paid: ₹<%= paidAmt.toLocaleString('en-IN') %>)</span>
                            </div>
                          <% }); %>
                        <% } else { %>
                          <span class="text-muted small">No Structure Added</span>
                        <% } %>

                        <div class="penalty-input-box-<%= sec %> d-none mt-2">
                          <input type="number" 
                                 class="form-control form-control-sm border-danger penalty-val-<%= sec %>" 
                                 data-studentid="<%= student._id %>" 
                                 placeholder="Enter Penalty ₹" 
                                 min="0">
                        </div>
                      </td>

                      <td>
                        <div class="fw-bold text-success fs-6">
                          Paid: ₹<%= (student.total_allocated_paid || 0).toLocaleString('en-IN') %>
                        </div>

                        <% if (student.advance_balance && student.advance_balance > 0) { %>
                          <div class="mt-1">
                            <span class="badge bg-info-subtle text-info border border-info px-2 py-1" style="font-size: 0.75rem;">
                              ⚡ Advance: ₹<%= student.advance_balance.toLocaleString('en-IN') %>
                            </span>
                          </div>
                        <% } %>

                        <div class="mt-1 fw-bold <%= student.overall_pending_balance > 0 ? 'text-danger' : 'text-success' %>" style="font-size: 0.9rem;">
                          Pending: ₹<%= (student.overall_pending_balance || 0).toLocaleString('en-IN') %>
                        </div>

                        <div class="mt-1">
                          <% if (student.paymentHistory && student.paymentHistory.length > 0) { %>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary border-0 p-0 fw-bold small text-decoration-underline" 
                                    data-stname="<%= student.studentName %>"
                                    data-stroll="<%= student.rollNumber %>"
                                    data-txs="<%= encodeURIComponent(JSON.stringify(student.paymentHistory)) %>"
                                    onclick="openReceiptsModal(this)">
                              <i class="fa-solid fa-receipt me-1"></i>Receipts (<%= student.paymentHistory.length %>)
                            </button>
                          <% } else { %>
                            <span class="text-muted small" style="font-size: 0.75rem;">No Receipts</span>
                          <% } %>
                        </div>

                        <div class="mt-2 pt-1 border-top">
                          <span class="badge bg-dark text-warning border border-warning px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                            💰 Total Paid Amount: ₹<%= (student.total_amount_paid || 0).toLocaleString('en-IN') %>
                          </span>
                        </div>

                        <!-- ⚡ STUDENT ACTION BUTTON -->
                        <button type="button" 
                                class="btn btn-warning btn-sm fw-bold mt-2 w-100 shadow-sm" 
                                data-stname="<%= student.studentName %>"
                                data-stroll="<%= student.rollNumber %>"
                                data-txs="<%= encodeURIComponent(JSON.stringify(student.paymentHistory || [])) %>"
                                onclick="openStudentActionModal('<%= student._id %>', this)">
                          ⚡ Action / Edit Fees
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    <% }); %>

  <% } else { %>
    <div class="card p-5 text-center text-muted shadow-sm border border-dashed">
      <h5 class="fw-bold mb-1 text-dark">Welcome to Fee Dashboard</h5>
      <p class="m-0 small">Select Course and Batch Session above to load Section-wise data.</p>
    </div>
  <% } %>

</div>

