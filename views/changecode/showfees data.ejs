<!-- 📄 RECEIPT PASSBOOK MODAL -->
<div class="modal fade" id="receiptsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-receipt me-2 text-warning"></i>Payment Receipts
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="bg-light p-3 rounded mb-3 border d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0 text-dark" id="modalStudentName">--</h6>
            <small class="text-muted">Admin No: <span id="modalRollNo" class="fw-bold text-primary">--</span></small>
          </div>
          <span class="badge bg-primary px-3 py-2" id="modalReceiptCount">0 Receipts</span>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th>Receipt No</th>
                <th>Date</th>
                <th>Sem</th>
                <th>Amount Paid</th>
                <th>Mode / Status</th>
                <th>Reason / Info</th>
              </tr>
            </thead>
            <tbody id="receiptsTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function showToast(message, isSuccess = true) {
    const toastEl = document.getElementById('dynamicToast');
    const msgEl = document.getElementById('toastMessage');
    
    msgEl.innerText = message;
    toastEl.className = `toast align-items-center text-white border-0 shadow ${isSuccess ? 'bg-success' : 'bg-danger'}`;
    
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
    toast.show();
  }

  function checkAndSubmitForm() {
    const classVal = document.getElementById('classSelector').value;
    const yearVal = document.getElementById('yearSelector').value;
    if (classVal && yearVal) {
      document.getElementById('feeFilterForm').submit();
    }
  }

  function scrollToSec(elementId) {
    const targetEl = document.getElementById(elementId);
    if (targetEl) {
      const yOffset = -70;
      const y = targetEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }
  }

  document.querySelectorAll('.sec-master-cb').forEach(master => {
    master.addEventListener('change', function() {
      const sec = this.getAttribute('data-sec');
      document.querySelectorAll(`.student-cb-${sec}`).forEach(cb => cb.checked = this.checked);
      updateSectionCount(sec);
    });
  });

  function updateSectionCount(sec) {
    const selectedCount = document.querySelectorAll(`.student-cb-${sec}:checked`).length;
    const counterEl = document.getElementById(`counter_${sec}`);
    if (counterEl) counterEl.innerText = `${selectedCount} Selected`;
  }

  function filterSectionTable(sec) {
    const searchVal = document.getElementById(`searchInp_${sec}`).value.toLowerCase().trim().replace(/\s+/g, ' ');
    const checkedSems = Array.from(document.querySelectorAll(`.sem-filter-cb-${sec}:checked`)).map(cb => parseInt(cb.value));

    const rows = document.querySelectorAll(`.student-row-${sec}`);

    rows.forEach(row => {
      const name = (row.getAttribute('data-name') || '').replace(/\s+/g, ' ');
      const roll = (row.getAttribute('data-roll') || '').replace(/\s+/g, ' ');
      const matchesSearch = name.includes(searchVal) || roll.includes(searchVal);

      let matchesSem = true;
      if (checkedSems.length > 0) {
        matchesSem = false;
        const semBadges = row.querySelectorAll('.sem-due-badge');
        semBadges.forEach(badge => {
          const semNum = parseInt(badge.getAttribute('data-semnum'));
          const semPending = parseFloat(badge.getAttribute('data-sempending') || '0');
          if (checkedSems.includes(semNum) && semPending > 0) {
            matchesSem = true;
          }
        });
      }

      if (matchesSearch && matchesSem) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  function exportRouteUnpaidPDF(sec) {
    const baseCourse = "<%= selectedBaseCourse %>";
    const batchSession = "<%= selectedBatch %>";
    const checkedSems = Array.from(document.querySelectorAll(`.sem-filter-cb-${sec}:checked`)).map(cb => cb.value);

    let baseUrl = `${window.location.origin}/export/fee/unpaid-pdf`;
    let params = new URLSearchParams();

    params.append("baseCourse", baseCourse);
    params.append("batchSession", batchSession);
    params.append("section", sec);

    checkedSems.forEach(s => params.append("sem", s));

    window.location.href = `${baseUrl}?${params.toString()}`;
  }

  function togglePenaltyDrawer(sec) {
    document.getElementById(`penaltyDrawer_${sec}`).classList.toggle('d-none');
    document.querySelectorAll(`.penalty-input-box-${sec}`).forEach(box => box.classList.toggle('d-none'));
  }

  async function saveSectionPenalties(sec, event) {
    const semSelect = document.getElementById(`penaltySem_${sec}`);
    const semNum = semSelect ? semSelect.value : "1";
    
    const inputs = document.querySelectorAll(`.penalty-val-${sec}`);
    const payload = [];

    inputs.forEach(inp => {
      const val = parseFloat(inp.value);
      if (!isNaN(val) && val > 0) {
        payload.push({ 
          studentId: inp.getAttribute('data-studentid'), 
          penalty: val 
        });
      }
    });

    if (payload.length === 0) {
      return showToast("⚠️ No valid penalty amount (₹ > 0) was provided for any student.", false);
    }

    const btn = event.currentTarget || event.target;
    const originalTxt = btn.innerText;
    btn.innerText = "⏳ Saving...";
    btn.disabled = true;

    try {
      const response = await fetch('/add/fee/penalty', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'X-Requested-With': 'CollegeFeeSystemSecure#2026'
        },
        body: JSON.stringify({ targetSem: semNum, penalties: payload })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "🎉 Penalties added successfully!", true);
        setTimeout(() => window.location.reload(), 2500);
      } else {
        showToast("❌ Error: " + result.message, false);
        btn.innerText = originalTxt;
        btn.disabled = false;
      }
    } catch (err) {
      console.error("Penalty Add Error:", err);
      showToast("❌ Server connection issue!", false);
      btn.innerText = originalTxt;
      btn.disabled = false;
    }
  }

  function handlePenaltyClick(btnEl) {
    const studentId = btnEl.getAttribute('data-studentid');
    const semNumber = btnEl.getAttribute('data-semnum');
    const paidAmount = parseFloat(btnEl.getAttribute('data-paidamt') || '0');

    if (!studentId || studentId === 'undefined' || studentId.trim() === '') {
      console.error("Missing or Invalid Student ID on Element:", btnEl);
      return showToast("❌ Error: Invalid Student ID! Please refresh the page.", false);
    }

    btnEl.disabled = true;
    btnEl.style.opacity = '0.5';

    removePenalty(studentId, semNumber, paidAmount, btnEl);
  }

  async function removePenalty(studentId, semNumber, paidAmount, btnEl) {
    if (!studentId || studentId === 'undefined') {
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      return showToast("❌ Invalid Student ID!", false);
    }

    if (paidAmount > 0) {
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      return showToast(`🚨 Cannot remove penalty! Fees (₹${paidAmount}) are already paid for Semester ${semNumber}.`, false);
    }

    try {
      const response = await fetch('/remove/fee/penalty', {
        method: 'DELETE',
        headers: { 
          'Content-Type': 'application/json',
          'X-Requested-With': 'CollegeFeeSystemSecure#2026'
        },
        body: JSON.stringify({ studentId, targetSem: semNumber })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "✅ Penalty removed successfully!", true);
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showToast("❌ Error: " + result.message, false);
        if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      }
    } catch (err) {
      console.error("Penalty Remove Error:", err);
      showToast("❌ Server communication failure!", false);
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
    }
  }

  function openReceiptsModal(btnEl) {
    const stName = btnEl.getAttribute('data-stname') || '--';
    const stRoll = btnEl.getAttribute('data-stroll') || '--';
    const txRaw = btnEl.getAttribute('data-txs');
    
    let transactions = [];
    try {
      if (txRaw) {
        transactions = JSON.parse(decodeURIComponent(txRaw));
      }
    } catch(err) {
      console.error("Receipt JSON Parsing Error:", err);
      showToast("⚠️ Could not load receipt history properly.", false);
    }

    document.getElementById('modalStudentName').innerText = stName;
    document.getElementById('modalRollNo').innerText = stRoll;
    document.getElementById('modalReceiptCount').innerText = `${transactions.length} Receipts`;

    const tbody = document.getElementById('receiptsTableBody');
    tbody.innerHTML = '';

    if (transactions && transactions.length > 0) {
      transactions.forEach(tx => {
        const dateStr = tx.paymentDate ? new Date(tx.paymentDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';
        const isCancelled = tx.status === 'CANCELLED';

        tbody.innerHTML += `
          <tr class="${isCancelled ? 'table-danger' : ''}">
            <td class="fw-bold text-primary">${tx.receiptNumber || 'N/A'}</td>
            <td class="small">${dateStr}</td>
            <td><span class="badge bg-secondary">Sem ${tx.semNumber || '-'}</span></td>
            <td class="fw-bold text-success">₹${(tx.amountPaid || 0).toLocaleString('en-IN')}</td>
            <td>
              ${isCancelled 
                ? '<span class="badge bg-danger">CANCELLED</span>' 
                : `<span class="badge bg-info text-dark">${tx.paymentMode || 'Cash'}</span>`}
            </td>
            <td class="small text-start">${tx.actionReason ? `<b>Reason:</b> ${tx.actionReason}` : '-'}</td>
          </tr>
        `;
      });
    } else {
      tbody.innerHTML = `<tr><td colspan="6" class="text-muted p-3">No receipt transactions found.</td></tr>`;
    }

    new bootstrap.Modal(document.getElementById('receiptsModal')).show();
  }

  function syncEditFullClassName() {
    const courseInput = document.getElementById('modalCourse');
    if (!courseInput) return '';

    const baseCourse = (courseInput.dataset.baseCourse || courseInput.value || '').trim();
    const yearTagSelect = document.getElementById('modalYearTag');
    const yearTag = yearTagSelect ? yearTagSelect.value.trim() : '';

    const combinedName = (baseCourse && yearTag) 
      ? `${baseCourse} ${yearTag}`.replace(/\s+/g, ' ').trim().toUpperCase() 
      : baseCourse.replace(/\s+/g, ' ').trim().toUpperCase();

    courseInput.value = combinedName;
    return combinedName;
  }

  function openEditStructureModal(baseCourse, batchSession, section) {
    const courseInput = document.getElementById('modalCourse');
    
    if (courseInput) {
      courseInput.dataset.baseCourse = baseCourse;
      courseInput.value = baseCourse;
    }

    document.getElementById('modalBatch').value = batchSession;
    document.getElementById('modalSec').value = section;

    document.getElementById('modalContextDisplay').innerHTML = `
      <span class="badge bg-primary me-1">${baseCourse}</span> 
      <span class="badge bg-dark me-1">${batchSession}</span> 
      <span class="badge bg-secondary">Section ${section}</span>
    `;

    const yearSelect = document.getElementById('modalYearTag');
    if (yearSelect) {
      yearSelect.selectedIndex = 0;
      yearSelect.onchange = syncEditFullClassName;
    }

    syncEditFullClassName();

    const modal = new bootstrap.Modal(document.getElementById('editStructureYearModal'));
    modal.show();
  }

  async function redirectToEditStructure(event) {
    event.preventDefault();

    const course = document.getElementById('modalCourse').value;
    const batch = document.getElementById('modalBatch').value;
    const sec = document.getElementById('modalSec').value;
    const yearTag = document.getElementById('modalYearTag').value;

    if (!yearTag) {
      return showToast("⚠️ Please select a Year!", false);
    }

    const fullClassName = syncEditFullClassName();

    const submitBtn = event.target.querySelector('button[type="submit"]');
    const originalTxt = submitBtn.innerText;
    submitBtn.innerText = "⏳ Verifying Structure...";
    submitBtn.disabled = true;

    try {
      const verifyUrl = `/api/check-fee-structure-exists?baseCourse=${encodeURIComponent(course)}&batchSession=${encodeURIComponent(batch)}&section=${encodeURIComponent(sec)}&yearTag=${encodeURIComponent(yearTag)}`;
      const response = await fetch(verifyUrl);
      const data = await response.json();

      if (!data.exists) {
        showToast(data.message || "🚨 Structure Not Defined for selected Year!", false);
        submitBtn.innerText = originalTxt;
        submitBtn.disabled = false;
        return;
      }

      const targetUrl = `/add/student/fees?baseCourse=${encodeURIComponent(course)}&batchSession=${encodeURIComponent(batch)}&section=${encodeURIComponent(sec)}&yearTag=${encodeURIComponent(yearTag)}&mode=edit`;
      window.location.href = targetUrl;

    } catch (error) {
      console.error("Structure check failed:", error);
      showToast("❌ Server communication error while validating structure!", false);
      submitBtn.innerText = originalTxt;
      submitBtn.disabled = false;
    }
  }

  function syncFullClassName() {
    const baseCourse = document.getElementById('delModalCourse').dataset.baseCourse || '';
    const yearTag = document.getElementById('delModalYearTag').value.trim();
    const hiddenInput = document.getElementById('delModalCourse');

    if (baseCourse && yearTag) {
      hiddenInput.value = `${baseCourse} ${yearTag}`.trim().toUpperCase();
    } else {
      hiddenInput.value = baseCourse.trim().toUpperCase();
    }
  }

  function openDeleteStructureModal(baseCourse, batchSession, section) {
    const selectedStudents = document.querySelectorAll(`.student-cb-${section}:checked`);

    if (selectedStudents.length === 0) {
      return showToast("⚠️ Please select at least one student from the table!", false);
    }

    const courseInput = document.getElementById('delModalCourse');
    courseInput.dataset.baseCourse = baseCourse;
    
    document.getElementById('delModalBatch').value = batchSession;
    document.getElementById('delModalSec').value = section;

    document.getElementById('delModalContextDisplay').innerHTML = `
      <span class="badge bg-primary me-1">${baseCourse}</span> 
      <span class="badge bg-dark me-1">${batchSession}</span> 
      <span class="badge bg-secondary">Section ${section}</span>
      <span class="badge bg-warning text-dark ms-1">${selectedStudents.length} Student(s) Selected</span>
    `;

    const yearTagSelect = document.getElementById('delModalYearTag');
    yearTagSelect.selectedIndex = 0;
    yearTagSelect.onchange = syncFullClassName;
    
    syncFullClassName();

    new bootstrap.Modal(document.getElementById('deleteStructureModal')).show();
  }

  async function handleStructureDeletion(event) {
    event.preventDefault();

    const fullClassName = document.getElementById('delModalCourse').value;
    const batch = document.getElementById('delModalBatch').value;
    const sec = document.getElementById('delModalSec').value;
    const yearTag = document.getElementById('delModalYearTag').value;

    const selectedStudentCbs = document.querySelectorAll(`.student-cb-${sec}:checked`);
    const selectedStudentIds = Array.from(selectedStudentCbs).map(cb => cb.value);

    if (selectedStudentIds.length === 0) {
      return showToast("⚠️ Please select at least one student from the table!", false);
    }

    if (!yearTag) {
      return showToast("⚠️ Please select an academic year to delete!", false);
    }

    const btn = document.getElementById('btnDeleteSubmit');
    const originalTxt = btn.innerText;
    btn.innerText = "⏳ Validating & Deleting...";
    btn.disabled = true;

    try {
      const response = await fetch('/api/delete-fee-structure', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'X-Requested-With': 'CollegeFeeSystemSecure#2026'
        },
        body: JSON.stringify({ 
          fullClassName: fullClassName, 
          batchSession: batch, 
          section: sec, 
          yearTag: yearTag, 
          studentIds: selectedStudentIds 
        })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message, true);
        setTimeout(() => window.location.reload(), 2000);
      } else {
        showToast("❌ " + result.message, false);
        btn.innerText = originalTxt;
        btn.disabled = false;
      }
    } catch (error) {
      console.error("Delete Error:", error);
      showToast("❌ Server communication issue!", false);
      btn.innerText = originalTxt;
      btn.disabled = false;
    }
  }

  function openStudentActionModal(studentId, btnEl) {
    const name = btnEl.getAttribute('data-stname') || '--';
    const roll = btnEl.getAttribute('data-stroll') || '--';
    const txRaw = btnEl.getAttribute('data-txs');

    document.getElementById('actionStudentName').innerText = name;
    document.getElementById('actionRollNo').innerText = roll;

    const tbody = document.getElementById('actionReceiptsTbody');
    tbody.innerHTML = '';

    let receipts = [];
    try {
      if (txRaw) receipts = JSON.parse(decodeURIComponent(txRaw));
    } catch (err) {
      console.error("Receipt Parse Error:", err);
    }

    if (receipts && receipts.length > 0) {
      receipts.forEach(tx => {
        const isCancelled = tx.status === 'CANCELLED';
        const editCount = tx.editCount || 0;
        const canEdit = !isCancelled && editCount < 2;

        tbody.innerHTML += `
          <tr class="${isCancelled ? 'table-danger' : ''}">
            <td class="fw-bold text-primary">${tx.receiptNumber || 'N/A'}</td>
            <td><span class="badge bg-secondary">Sem ${tx.semNumber || '-'}</span></td>
            <td class="fw-bold text-success">₹${(tx.amountPaid || 0).toLocaleString('en-IN')}</td>
            <td>
              ${isCancelled 
                ? '<span class="badge bg-danger">CANCELLED</span>' 
                : `<span class="badge bg-info text-dark">${tx.paymentMode || 'Cash'}</span> <small class="text-muted">(Edits: ${editCount}/2)</small>`}
            </td>
            <td>
              ${isCancelled 
                ? '<span class="text-muted small">No Actions Available</span>' 
                : `
                  <button class="btn btn-sm btn-outline-primary me-1" ${!canEdit ? 'disabled' : ''} onclick="openEditReceipt('${tx._id}', '${tx.receiptNumber}', ${tx.amountPaid}, '${tx.paymentMode || 'Cash'}', '${studentId}')">✏️ Edit</button>
                  <button class="btn btn-sm btn-outline-danger" onclick="openCancelReceipt('${tx._id}', '${studentId}')">❌ Cancel</button>
                `}
            </td>
          </tr>
        `;
      });
    } else {
      tbody.innerHTML = '<tr><td colspan="5" class="text-muted p-3">No receipt transactions found for this student.</td></tr>';
    }

    new bootstrap.Modal(document.getElementById('studentActionModal')).show();
  }

  function openEditReceipt(txId, receiptNum, amount, mode, studentId) {
    document.getElementById('editTxId').value = txId;
    document.getElementById('editStudentId').value = studentId;
    document.getElementById('editReceiptNum').value = receiptNum;
    document.getElementById('editAmountPaid').value = amount;
    document.getElementById('editPaymentMode').value = mode;
    document.getElementById('editReason').value = '';
    document.getElementById('editPassword').value = '';

    new bootstrap.Modal(document.getElementById('editReceiptModal')).show();
  }

  async function submitReceiptUpdate(event) {
    event.preventDefault();

    const txId = document.getElementById('editTxId').value;
    const studentId = document.getElementById('editStudentId').value;
    const newAmount = parseFloat(document.getElementById('editAmountPaid').value);
    const newMode = document.getElementById('editPaymentMode').value;
    const editReason = document.getElementById('editReason').value;
    const password = document.getElementById('editPassword').value;

    try {
      const res = await fetch('/api/update-fee-receipt', {
        method: 'PUT',
        headers: { 
          'Content-Type': 'application/json',
          'X-Requested-With': 'CollegeFeeSystemSecure#2026'
        },
        body: JSON.stringify({ txId, studentId, amountPaid: newAmount, paymentMode: newMode, password, editReason })
      });

      const result = await res.json();
      if (result.success) {
        showToast(result.message, true);
        setTimeout(() => window.location.reload(), 1300);
      } else {
        showToast("❌ " + result.message, false);
      }
    } catch (err) {
      showToast("❌ Error updating receipt!", false);
    }
  }

  function openCancelReceipt(txId, studentId) {
    document.getElementById('cancelTxId').value = txId;
    document.getElementById('cancelStudentId').value = studentId;
    document.getElementById('cancelReason').value = '';
    document.getElementById('cancelPassword').value = '';

    new bootstrap.Modal(document.getElementById('cancelReceiptModal')).show();
  }

  async function submitReceiptCancellation(event) {
    event.preventDefault();

    const txId = document.getElementById('cancelTxId').value;
    const studentId = document.getElementById('cancelStudentId').value;
    const cancelReason = document.getElementById('cancelReason').value;
    const password = document.getElementById('cancelPassword').value;

    try {
      const res = await fetch('/api/cancel-fee-receipt', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'X-Requested-With': 'CollegeFeeSystemSecure#2026'
        },
        body: JSON.stringify({ txId, studentId, password, cancelReason })
      });

      const result = await res.json();
      if (result.success) {
        showToast(result.message, true);
        setTimeout(() => window.location.reload(), 1300);
      } else {
        showToast("❌ " + result.message, false);
      }
    } catch (err) {
      showToast("❌ Error cancelling receipt!", false);
    }
  }
</script>






