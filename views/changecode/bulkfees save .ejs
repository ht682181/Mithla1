            <option value="<%= i %>" <%= query.semester == i ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Section</label>
        <select name="section" class="form-select" required>
          <option value="">Choose section...</option>
          <% sectionData.forEach(s => { %>
            <option value="<%= s.name %>" <%= query.section === s.name ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn w-100 fw-bold py-2 shadow-sm text-white" style="background-color: #0f766e;">
          Load Batch Ledger
        </button>
      </div>
    </form>
  </div>

  <% if (students && students.length > 0) { %>
    
    <!-- SINGLE INJECTOR ENGINE -->
    <div class="card p-3 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <div class="row align-items-center g-3">
        <div class="col-lg-5">
          <span class="fw-bold fs-5">⚡ Global Year-Fees Injector (Sem-<%= activeSemesters[0] %> & Sem-<%= activeSemesters[1] %>):</span>
        </div>
        <div class="col-lg-4">
          <input type="number" id="masterYearFee" class="form-control" placeholder="Enter Full Year Fees Amount (e.g. 40000)">
        </div>
        <div class="col-lg-3">
          <button type="button" onclick="applyGlobalYearFee()" class="btn btn-dark w-100 fw-bold">Inject & Auto-Divide</button>
        </div>
      </div>
    </div>

    <!-- MAIN STUDENT LEDGER MATRIX FORM -->
    <form action="/fees/save-bulk-ledger" method="POST" id="ledgerGridForm" onsubmit="return validateGridForm()" class="needs-validation" novalidate>
      <input type="hidden" name="semA" value="<%= activeSemesters[0] %>">
      <input type="hidden" name="semB" value="<%= activeSemesters[1] %>">
      <input type="hidden" name="className" value="<%= query.className %>">
      <input type="hidden" name="section" value="<%= query.section %>">

      <div class="card p-3 mb-4 bg-light border-start border-warning border-4 shadow-sm">
  <div class="row align-items-center">
    <!-- Label -->
    <div class="col-md-4">
      <label for="currentYear" class="form-label fw-bold text-dark mb-0 fs-6">
        📅 Select Target Academic Year for Save:
      </label>
    </div>
    
    <!-- Input Field with Validation -->
    <div class="col-md-4">
      <input 
        type="number" 
        placeholder="Enter the current year" 
        name="currentYear" 
        id="currentYear"
        class="form-select fw-bold border-dark" 
        required 
        list="year"
