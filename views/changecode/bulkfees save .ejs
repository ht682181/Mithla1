  <% } else if (selectedSem) { %>
    <div class="alert alert-warning text-center fw-semibold">No active student profiles discovered matching the requested query parameters.</div>
  <% } %>

</div>

<!-- GRID CONTROLLER LOGIC SCRIPTS -->
<script>
function updateGrandTotals() {
  let totalYear = 0;
  let totalSemA = 0;
  let totalSemB = 0;

  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    if (row.querySelector('.row-status-select').value === "Active") {
      const yearVal = parseFloat(row.querySelector('.row-year-total').value) || 0;
      const semAVal = parseFloat(row.querySelector('.row-semA-input').value) || 0;
      const semBVal = parseFloat(row.querySelector('.row-semB-input').value) || 0;

      totalYear += yearVal;
      totalSemA += semAVal;
      totalSemB += semBVal;
    }
  });

  document.getElementById('grandYearTotal').innerText = '₹' + totalYear.toLocaleString('en-IN');
  document.getElementById('grandSemATotal').innerText = '₹' + totalSemA.toLocaleString('en-IN');
  document.getElementById('grandSemBTotal').innerText = '₹' + totalSemB.toLocaleString('en-IN');
}

function applyGlobalYearFee() {
  const annualAmount = parseFloat(document.getElementById('masterYearFee').value) || 0;
  if(annualAmount <= 0) {
    alert("Kripya ek valid price enter karein!");
    return;
  }
  
  const splitShare = annualAmount / 2;
  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      row.querySelector('.row-year-total').value = annualAmount;
      row.querySelector('.row-semA-input').value = splitShare;
      row.querySelector('.row-semB-input').value = splitShare;
    }
  });
  
  updateGrandTotals();
}

function divideRowFeesEqually(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const totalAmt = parseFloat(inputElement.value) || 0;
  row.querySelector('.row-semA-input').value = totalAmt / 2;
  row.querySelector('.row-semB-input').value = totalAmt / 2;
  
  updateGrandTotals();
}

function recalculateRowTotal(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const sA = parseFloat(row.querySelector('.row-semA-input').value) || 0;
  const sB = parseFloat(row.querySelector('.row-semB-input').value) || 0;
  row.querySelector('.row-year-total').value = sA + sB;
  
  updateGrandTotals();
}

// 🛡️ Fix Alert: Changing 'disabled' to 'readOnly' to protect backend array validation pipelines
function toggleRowState(selectElement) {
  const row = selectElement.closest('.student-row-item');
  const inputs = row.querySelectorAll('input[type="number"]');
  if(selectElement.value === "Left College") {
    row.style.opacity = "0.4";
    inputs.forEach(i => {
      i.readOnly = true;
      i.style.backgroundColor = "#e9ecef";
    });
  } else {
    row.style.opacity = "1";
    inputs.forEach(i => {
      i.readOnly = false;
      i.style.backgroundColor = "#fff";
    });
  }
  
  updateGrandTotals();
}

function validateGridForm() {
  const rows = document.querySelectorAll('.student-row-item');
  let valid = true;

  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      const yearFee = parseFloat(row.querySelector('.row-year-total').value) || 0;
      if(yearFee <= 0) {
        valid = false;
        row.querySelector('.row-year-total').style.border = "2px solid red";
      } else {
        row.querySelector('.row-year-total').style.border = "1px solid #dee2e6";
      }
    }
  });

  if(!valid) {
    alert("⚠️ Validation Warning: Sabhi active bacchon ki fees ₹0 se badi honi chahiye!");
    return false;
  }
  return true;
}

document.addEventListener("DOMContentLoaded", () => {
  updateGrandTotals();
});
</script>










<!-- fees ke dash board ko show kARne ke liye -->


app.get("/show/fee/dashboard", verifiedAny, WrapAsync(async (req, res) => {
  const { baseCourse, batchSession } = req.query;

  const rawBaseCourses = await FeeLedger.distinct("currentCourse");
  const allBaseCourses = rawBaseCourses.filter(Boolean);

  const rawBatches = await FeeLedger.distinct("session");
  const allBatches = rawBatches.filter(Boolean);

  let sectionwiseData = {}; 

  if (baseCourse && batchSession) {
    const query = { currentCourse: baseCourse, session: batchSession };

    const studentsLedger = await FeeLedger.find(query).lean();
    const studentIds = studentsLedger.map(s => s.student_id).filter(Boolean);

    const allTransactions = await FeeTransaction.find({
      student_id: { $in: studentIds }
    }).sort({ paymentDate: -1 }).lean();

    const txMap = new Map();
    allTransactions.forEach(tx => {
      const sId = tx.student_id ? tx.student_id.toString() : '';
      if (sId) {
        if (!txMap.has(sId)) txMap.set(sId, []);
        txMap.get(sId).push(tx);
      }
    });

    studentsLedger.forEach(student => {
      let secName = "A";
      if (Array.isArray(student.classesHistory) && student.classesHistory.length > 0) {
        secName = student.classesHistory[student.classesHistory.length - 1].section || "A";
      } else if (student.section) {
        secName = student.section;
      }
      secName = secName.toUpperCase();

      if (!sectionwiseData[secName]) {
        sectionwiseData[secName] = {
          summary: { totalFee: 0, totalPaid: 0, totalAdvance: 0, totalPenalty: 0, netPending: 0 },
          yearlyBreakdown: {
            "1ST YEAR": { demand: 0, paid: 0, penalty: 0, pending: 0 },
            "2ND YEAR": { demand: 0, paid: 0, penalty: 0, pending: 0 },
            "3RD YEAR": { demand: 0, paid: 0, penalty: 0, pending: 0 }
          },
          students: []
        };
      }

      let studentTotalDue = 0;
      let studentTotalPaid = 0;
      let studentTotalPenalty = 0;

      const studentIdStr = student.student_id ? student.student_id.toString() : student._id.toString();
      student.paymentHistory = txMap.get(studentIdStr) || [];

      if (Array.isArray(student.semesters)) {
        student.semesters.forEach(sem => {
          const semDue = sem.due_amount || 0;
          const semPaid = sem.amount_paid || 0;
          const semPenalty = sem.penalty_amount || sem.penalty || 0;

          // Sem Balance Pending Calculation
          sem.calculated_pending = Math.max(0, (semDue + semPenalty) - semPaid);

          studentTotalDue += semDue;
          studentTotalPaid += semPaid;
          studentTotalPenalty += semPenalty;

          // Yearly Split Logic (Sem 1-2: 1st Yr, Sem 3-4: 2nd Yr, Sem 5-6: 3rd Yr)
          let yTag = "1ST YEAR";
          if (sem.semNumber === 3 || sem.semNumber === 4) yTag = "2ND YEAR";
          if (sem.semNumber === 5 || sem.semNumber === 6) yTag = "3RD YEAR";

          const yRef = sectionwiseData[secName].yearlyBreakdown[yTag];
          yRef.demand += semDue;
          yRef.paid += semPaid;
          yRef.penalty += semPenalty;
          yRef.pending += sem.calculated_pending;
        });
      }

      const advance = student.advance_balance || 0;
      const netStudentPending = Math.max(0, (studentTotalDue + studentTotalPenalty) - studentTotalPaid);

      student.total_amount_paid = studentTotalPaid;
      student.total_penalty_amount = studentTotalPenalty;
      student.overall_pending_balance = netStudentPending;

      // Section Level Summaries
      const secSum = sectionwiseData[secName].summary;
      secSum.totalFee += studentTotalDue;
      secSum.totalPaid += studentTotalPaid;
      secSum.totalPenalty += studentTotalPenalty;
      secSum.totalAdvance += advance;
      secSum.netPending += netStudentPending;

      sectionwiseData[secName].students.push(student);
    });
  }

  res.render("admin/showFeeData.ejs", {
    allBaseCourses,
    allBatches,
    selectedBaseCourse: baseCourse || "",
    selectedBatch: batchSession || "",
    sectionwiseData
  });
}));









<%- layout("/layouts/boilerplate") %>

<style>
  .table-fixed-layout th,
  .table-fixed-layout td {
    vertical-align: middle;
    padding: 10px 8px !important;
  }
  .stat-card {
    border-left: 5px solid #0d6efd;
    transition: transform 0.2s ease-in-out;
  }
  .stat-card:hover { transform: translateY(-2px); }
  .stat-card-success { border-left-color: #198754; }
  .stat-card-info { border-left-color: #0dcaf0; }
  .stat-card-warning { border-left-color: #ffc107; }
  .stat-card-danger { border-left-color: #dc3545; }

  .sticky-section-nav {
    position: sticky;
    top: 10px;
    z-index: 1020;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(5px);
    border-radius: 12px;
  }
  .sem-due-badge {
    font-size: 0.78rem;
    padding: 4px 8px;
    border-radius: 4px;
  }
</style>

<div class="container-fluid my-4">

  <!-- 🔍 MAIN COURSE/BATCH FILTER -->
  <div class="card shadow-sm border-0 bg-white p-4 mb-4">
    <div class="row align-items-center">
      <div class="col-md-5">
        <h3 class="fw-bold text-dark m-0">Fee Management Dashboard</h3>
        <p class="text-muted small m-0">Select Course & Batch Session to load student ledgers.</p>
      </div>
      <div class="col-md-7 mt-3 mt-md-0">
        <form id="feeFilterForm" action="/show/fee/dashboard" method="GET" class="row g-2 justify-content-md-end">
          <div class="col-md-5">
            <select name="baseCourse" id="classSelector" class="form-select form-select-lg fw-bold border-2" onchange="checkAndSubmitForm()">
              <option value="" <%= !selectedBaseCourse ? 'selected' : '' %> disabled>-- Select Course --</option>
              <% allBaseCourses.forEach(course => { %>
                <option value="<%= course %>" <%= selectedBaseCourse === course ? 'selected' : '' %>><%= course %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-5">
            <select name="batchSession" id="yearSelector" class="form-select form-select-lg fw-bold border-2" onchange="checkAndSubmitForm()">
              <option value="" <%= !selectedBatch ? 'selected' : '' %> disabled>-- Select Batch Session --</option>
              <% allBatches.forEach(batch => { %>
                <option value="<%= batch %>" <%= selectedBatch === batch ? 'selected' : '' %>><%= batch %></option>
              <% }); %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <% if (selectedBaseCourse && selectedBatch && Object.keys(sectionwiseData).length > 0) { %>

    <!-- 🔘 JUMP TO SECTION NAVIGATION TABS -->
    <div class="card sticky-section-nav p-2 mb-4 shadow-sm border">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="fw-bold text-muted ms-2 small text-uppercase">
          <i class="fa-solid fa-compass me-1"></i> Jump To Section:
        </span>
        <div class="d-flex gap-2">
          <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
            <button type="button" class="btn btn-dark fw-bold btn-sm px-3" onclick="scrollToSec('SEC_BLOCK_<%= sec %>')">
              🚩 Section <%= sec %>
            </button>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- 📦 ITERATE SECTIONS -->
    <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
      <% const secInfo = sectionwiseData[sec]; %>
      <% const secSummary = secInfo.summary; %>
      <% const secStudents = secInfo.students; %>
      <% const yrData = secInfo.yearlyBreakdown; %>

      <div id="SEC_BLOCK_<%= sec %>" class="mb-5 pt-3 border-top">
        
        <!-- SUMMARY DASHBOARD CARDS -->
        <div class="mb-3">
          <h5 class="fw-bold text-dark mb-2">
            <span class="badge bg-primary fs-6 me-1">Section <%= sec %></span> Summary Dashboard
          </h5>
          <div class="row g-2">
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card bg-white">
                <span class="text-muted small fw-bold text-uppercase">Total Demand</span>
                <h4 class="fw-bold text-dark mb-0 mt-1">₹<%= (secSummary.totalFee || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-success bg-white">
                <span class="text-muted small fw-bold text-uppercase">Collected</span>
                <h4 class="fw-bold text-success mb-0 mt-1">₹<%= (secSummary.totalPaid || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-warning bg-white">
                <span class="text-muted small fw-bold text-uppercase">⚠️ Total Penalty</span>
                <h4 class="fw-bold text-warning mb-0 mt-1">₹<%= (secSummary.totalPenalty || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-info bg-white">
                <span class="text-muted small fw-bold text-uppercase">Advance</span>
                <h4 class="fw-bold text-info mb-0 mt-1">₹<%= (secSummary.totalAdvance || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-danger bg-white">
                <span class="text-muted small fw-bold text-uppercase">Net Pending</span>
