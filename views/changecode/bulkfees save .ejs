          <option value="">Select...</option>
          <% if (typeof sectionData !== 'undefined' && sectionData) { %>
            <% sectionData.forEach(s => { %>
              <option value="<%= s.name %>" <%= (query && query.section === s.name) ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- DYNAMIC ACADEMIC YEAR INPUT WITH DATALIST (Width: 2) -->
      <div class="col-md-2">
        <label for="academicYear" class="form-label fw-bold text-secondary">📅 Academic Year</label>
