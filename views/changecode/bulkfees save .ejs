        Please select or enter a valid academic year.
      </div>
    </div>
    
    <!-- Help Text (Translated to English) -->
    <div class="col-md-4 text-muted small">
      * Selecting this field is mandatory to ensure fees are tracked under the correct session in the database.
    </div>
  </div>
</div>

      <div class="table-responsive shadow-sm rounded">
        <table class="table align-middle bg-white table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th style="width: 10%;">Roll No</th>
              <th style="width: 15%;">Student Name</th>
