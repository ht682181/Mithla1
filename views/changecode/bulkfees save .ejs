            <option value="<%= i %>" <%= (query && query.semester == i) ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <!-- Section Selection (Width: 2) -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Section</label>
