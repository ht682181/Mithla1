        <select name="modeSelection" id="timelineSelect" class="form-select" required>
          <option value="single" <%= (query && query.modeSelection === 'single') ? 'selected' : '' %>>Current Sem</option>
          <option value="next" <%= (query && query.modeSelection === 'next') ? 'selected' : '' %>>Next Sem</option>
          <option value="both" <%= (query && query.modeSelection === 'both') ? 'selected' : '' %>>Both Sem</option>
        </select>
      </div>

      <!-- Submit Button (Width: 2) -->
      <div class="col-md-2">
        <button type="submit" class="btn w-100 fw-bold text-white py-2 shadow-sm" style="background-color: #0f766e;">Load Batch</button>
      </div>
    </form>
  </div>

  <% if (typeof students !== 'undefined' && students && students.length > 0) { %>

