            <% students.forEach((student, index) => { %>
              <tr class="student-row-item">
                <td>
                  <input type="hidden" name="fees[<%= index %>][student_id]" value="<%= student._id %>">
                  <input type="hidden" name="fees[<%= index %>][rollNumber]" value="<%= student.rollNo %>">
                  <input type="hidden" name="fees[<%= index %>][studentName]" value="<%= student.name %>">
