

const Joi = require('joi');

const bulkPaymentSchema = Joi.object({
  className: Joi.string().required(),
  section: Joi.string().required(),
  academicYear: Joi.alternatives().try(Joi.number(), Joi.string()).required(),
  modeSelection: Joi.string().valid('single', 'next', 'both').required(),
  semA: Joi.number().integer().min(1).max(8).required(),
  semB: Joi.number().integer().min(1).max(8).optional().allow(null, ''),
  submitToken: Joi.string().required(),
  payments: Joi.array().items(
    Joi.object({
      student_id: Joi.string().hex().length(24).required(),
      rollNumber: Joi.string().required(),
      studentName: Joi.string().required(),
      status: Joi.string().valid('Active', 'Left College').required(),
      amountToPay: Joi.number().min(0).required(),
      paymentMode: Joi.string().valid('Cash', 'UPI', 'Net Banking', 'Cheque').required()
    })
  ).min(1).required()
});

const validateBulkPayments = (req, res, next) => {
  const { error } = bulkPaymentSchema.validate(req.body);
  if (error) {
    req.flash("error", `⚠️ Joi Validation Error: ${error.details[0].message}`);
    return res.redirect('/fees/collect-bulk');
  }
  next();
};

module.exports = validateBulkPayments;


app.get("/fees/collect-bulk", verifiedAny, WrapAsync(async (req, res) => {
  const classData = await Class.find({});
  const sectionData = await Section.find({});
  // 1. Fetch all unique academic years present inside classesHistory array
  const uniqueYearsData = await FeeLedger.aggregate([
    { $unwind: "$classesHistory" },
    { $group: { _id: "$classesHistory.academicYear" } },
    { $sort: { _id: -1 } } 
  ]);
  const academicYearsList = uniqueYearsData.map(item => item._id).filter(Boolean);
  
  const { className, semester, section, modeSelection,academicYear } = req.query;
  let studentsData = [];
  let activeSemesters = [];

  const submitToken = crypto.randomBytes(16).toString('hex');
  req.session.lastFeeSubmitToken = submitToken;

  if (className && semester && section && modeSelection && academicYear) {
    const semNum = parseInt(semester);
    const allowedRange = getSemesterRangeByClass(className) || [1, 6]; 

    if (semNum < allowedRange[0] || semNum > allowedRange[1]) {
      req.flash("error", `Mismatch: Selected Semester (${semNum}) is not valid for ${className}`);
      return res.redirect('/fees/collect-bulk');
    }
    
    if (modeSelection === 'both') {
      const nextSem = semNum + 1 <= allowedRange[1] ? semNum + 1 : null;
      activeSemesters = [semNum, nextSem]; 
    } else if (modeSelection === 'next') {
      const nextSem = semNum + 1 <= allowedRange[1] ? semNum + 1 : semNum;
      activeSemesters = [nextSem, null];
    } else {
      activeSemesters = [semNum, null];
    }

    const targetYear = parseInt(academicYear);

  // Purani query ko hata kar yeh lagao:
const ledgersRaw = await FeeLedger.find({
  classesHistory: {
    $elemMatch: {
      className: className.trim(),
      section: section.trim(),
      academicYear: targetYear
    }
  },
  status: 'Active'
}).lean();

  if (!ledgersRaw || ledgersRaw.length === 0) {
  req.flash("error", "Data not found! Please check if the Class, Section, or Year is mismatched.");
  return res.redirect('/fees/collect-bulk');
}

    studentsData = ledgersRaw.map(ledger => {
      let virtualSemesters = JSON.parse(JSON.stringify(ledger.semesters || []));
      let tempAdvance = ledger.advance_balance || 0;

      // SORT: Chronological order for waterfall simulation
      virtualSemesters.sort((a, b) => a.semNumber - b.semNumber);
      
      // PHASE 1: Chronological Advance Waterfall Simulation across ALL semesters
      virtualSemesters.forEach(s => {
        let originalPending = Math.max(0, s.due_amount - s.amount_paid);
        if (tempAdvance > 0 && originalPending > 0) {
          let absorb = Math.min(tempAdvance, originalPending);
          s.amount_paid += absorb;
          s.balance_pending = Math.max(0, s.due_amount - s.amount_paid);
          tempAdvance -= absorb;
        } else {
          s.balance_pending = originalPending;
        }
      });

      // PHASE 2: Segregate Historical Dues vs View Context Dues
      let previousPendingDues = 0;
      virtualSemesters.forEach(s => {
        if (s.semNumber < activeSemesters[0]) {
          previousPendingDues += s.balance_pending;
        }
      });

      // Map Active View Semesters (Purane Logic ke liye for final total pending calculation)
      const semAData = virtualSemesters.find(s => s.semNumber === activeSemesters[0]) || { balance_pending: 0 };
      const semBData = activeSemesters[1] ? (virtualSemesters.find(s => s.semNumber === activeSemesters[1]) || { balance_pending: 0 }) : { balance_pending: 0 };

      // EXACT REQUIREMENT: Bina waterfall ko chhede, direct database ki original database records se data pull karna
      const rawSemA = ledger.semesters?.find(s => s.semNumber === activeSemesters[0]) || { due_amount: 0, amount_paid: 0, balance_pending: 0 };
      const rawSemB = activeSemesters[1] ? (ledger.semesters?.find(s => s.semNumber === activeSemesters[1]) || { due_amount: 0, amount_paid: 0, balance_pending: 0 }) : { due_amount: 0, amount_paid: 0, balance_pending: 0 };

      const totalYearDues = previousPendingDues + semAData.balance_pending + (activeSemesters[1] ? semBData.balance_pending : 0);
      const isLocked = (totalYearDues <= 0);

      return {
        student_id: ledger.student_id.toString(),
        rollNumber: ledger.rollNumber,
        studentName: ledger.studentName,
        fatherName: ledger.fatherName || 'N/A',
        status: ledger.status,
        advanceBalance: tempAdvance, 
        previousPendingDues: previousPendingDues,
        semA: { 
          num: activeSemesters[0], 
          originalDue: rawSemA.due_amount,            // Database original fees (due_amount)
          dbAmountPaid: rawSemA.amount_paid,          // Database original amount_paid
          dbBalancePending: rawSemA.balance_pending,  // Database original balance_pending
          waterfallPending: semAData.balance_pending  // Purana calculation input input mapping ke liye
        },
        semB: activeSemesters[1] ? { 
          num: activeSemesters[1], 
          originalDue: rawSemB.due_amount,            // Database original fees (due_amount)
          dbAmountPaid: rawSemB.amount_paid,          // Database original amount_paid
          dbBalancePending: rawSemB.balance_pending,  // Database original balance_pending
          waterfallPending: semBData.balance_pending  // Purana calculation input input mapping ke liye
        } : null,
        totalYearDues: totalYearDues,
        isLocked: isLocked
      };
    });
  }

  res.render("admin/collectBulkFees", {
    classData,
    sectionData,
    academicYearsList ,
    students: studentsData,
    activeSemesters,
    submitToken, 
    query: req.query || {}
  });
}));


// ==========================================
// POST Route: Process Payments & Clean Synced Ledger
// ==========================================
app.post("/fees/process-bulk-payments", verifiedAny, validateBulkPayments, WrapAsync(async (req, res) => {
  const { payments, semA, semB, className, section, modeSelection, submitToken , academicYear} = req.body;
  if (!className || !payments|| !section ||!academicYear || !semA || !semB || !modeSelection) {
    req.flash("error", "⚠️ Security Error: Crucial input parameters are missing!");
    return res.redirect("/fees/collect-bulk");
  }

  const sA = parseInt(semA);
  const sB = semB ? parseInt(semB) : null;
  const targetYear = parseInt(academicYear);


  if (!req.session.lastFeeSubmitToken || req.session.lastFeeSubmitToken !== submitToken) {
    req.flash("error", "⚠️ Duplicate Transaction Detected! Please refresh the grid and try again.");
  return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);
  }

  req.session.lastFeeSubmitToken = null;
  const session = await mongoose.startSession();
  session.startTransaction();

  try {
    const studentIds = payments.map(p => p.student_id);
    const existingLedgers = await FeeLedger.find({ student_id: { $in: studentIds } }).session(session);
    const ledgerMap = new Map(existingLedgers.map(l => [l.student_id.toString(), l]));

    const bulkOperations = [];
    const transactionRecords = [];

    for (let payRow of payments) {
      if (payRow.status === "Left College") continue;

      let rawCashPaid = parseFloat(payRow.amountToPay) || 0;
      let runtimeAllocation = rawCashPaid;
      let ledger = ledgerMap.get(payRow.student_id.toString());
      if (!ledger) throw new Error(`Student ledger not found for ID: ${payRow.student_id}`);

      let targetSemesters = [...ledger.semesters];
      targetSemesters.sort((a, b) => a.semNumber - b.semNumber);

      let currentAdvance = ledger.advance_balance || 0;
      let initialAdvanceUsed = currentAdvance;
      
      let receiptBreakdown = [];

      // STAGE 1: Process current wallet advance balance across chronological timelines
      for (let sItem of targetSemesters) {
        let historyPending = Math.max(0, sItem.due_amount - sItem.amount_paid);
        if (historyPending > 0 && currentAdvance > 0) {
          let absorb = Math.min(currentAdvance, historyPending);
          sItem.amount_paid += absorb;
          sItem.balance_pending = Math.max(0, sItem.due_amount - sItem.amount_paid);
          currentAdvance -= absorb;
          
          receiptBreakdown.push({ semNumber: sItem.semNumber, amount: absorb, source: "Wallet Adjustment" });
        }
      }

      // STAGE 2: Allocate fresh liquid incoming cash
      if (runtimeAllocation > 0) {
        for (let sItem of targetSemesters) {
          let pendingDues = Math.max(0, sItem.due_amount - sItem.amount_paid);
          if (pendingDues > 0 && runtimeAllocation > 0) {
            let absorbCash = Math.min(runtimeAllocation, pendingDues);
            sItem.amount_paid += absorbCash;
            sItem.balance_pending = Math.max(0, sItem.due_amount - sItem.amount_paid);
            runtimeAllocation -= absorbCash;

            receiptBreakdown.push({ semNumber: sItem.semNumber, amount: absorbCash, source: "Liquid Cash" });
          }
        }

        // STAGE 3: Turn remaining extra cash into Wallet Advance Balance
        if (runtimeAllocation > 0) {
          currentAdvance += runtimeAllocation;
          receiptBreakdown.push({ semNumber: sB || sA, amount: runtimeAllocation, source: "Advance Spillover Saved" });
        }
      }

      // FIXED BUG: total_amount_paid adds up all historically captured values + fresh new liquid cash flow parameters
      const currentCalculatedPaid = targetSemesters.reduce((sum, s) => sum + s.amount_paid, 0);
      const overallAmountPaid = (ledger.total_amount_paid || 0) + rawCashPaid; 
      const compositePendingBalance = Math.max(0, ledger.total_course_fees - currentCalculatedPaid);

      if (rawCashPaid > 0 || (initialAdvanceUsed - currentAdvance) > 0) {
        transactionRecords.push({
          receiptNumber: `REC-BULK-${Date.now()}-${Math.floor(1000 + Math.random() * 9000)}`,
          student_id: payRow.student_id,
          rollNumber: payRow.rollNumber,
             academicYear:targetYear,
          studentName: payRow.studentName,
          fatherName: ledger.fatherName,
          semNumber: sA, 
          amountPaid: rawCashPaid, 
          paymentMode: payRow.paymentMode,
          metadata: {
            breakdown: receiptBreakdown,
            walletAdvanceSubtracted: initialAdvanceUsed - currentAdvance,
            retainedWalletAdvance: currentAdvance
          }
        });
      }

      bulkOperations.push({
        updateOne: {
          filter: { student_id: payRow.student_id },
          update: {
            $set: {
              semesters: targetSemesters,
              advance_balance: currentAdvance,
              total_amount_paid: overallAmountPaid,
              overall_pending_balance: compositePendingBalance
            }
          }
        }
      });
    }

    if (bulkOperations.length > 0) {
      if (transactionRecords.length > 0) {
        await FeeTransaction.insertMany(transactionRecords, { session });
      }
      await FeeLedger.bulkWrite(bulkOperations, { session });
    }

    await session.commitTransaction();
    session.endSession();

    req.flash("success", "🚀 Complete Ledger Sequence synced successfully with Single Token Clean Receipts.");
    return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);
  } catch (error) {
    await session.abortTransaction();
    session.endSession();
    req.flash("error", `Error encountered during batch sequence processing: ${error.message}`);
   return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);
  }
}));           





<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
  <h2 class="mb-4 text-dark fw-bold border-bottom pb-2">📦 Unified Batch Fee Collection (Live Ledger Sync)</h2>

  <!-- HIDDEN METADATA FOR JAVASCRIPT -->
  <input type="hidden" id="metadataClassName" value="<%= (query && query.className) ? query.className : '' %>">
  <input type="hidden" id="metadataSemester" value="<%= (query && query.semester) ? query.semester : '' %>">

  <!-- SEARCH CONTROLS FRAMEWORK -->
<div class="card p-4 shadow-sm mb-4 bg-white border-0">
  <form action="/fees/collect-bulk" method="GET" class="row g-3 align-items-end needs-validation" novalidate id="filterForm">
    
    <!-- Class Selection Dropdown (Width: 2) -->
    <div class="col-md-2">
      <label class="form-label fw-bold text-secondary">Class / Branch</label>
      <select name="className" id="classSelect" class="form-select" required onchange="syncSemesterDropdown()">
        <option value="">Select branch...</option>
        <% if (typeof classData !== 'undefined' && classData) { %>
          <% classData.forEach(c => { %>
            <option value="<%= c.class %>" <%= (query && query.className === c.class) ? 'selected' : '' %>><%= c.class %></option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <!-- Target Semester (Width: 2) -->
    <div class="col-md-2">
      <label class="form-label fw-bold text-secondary">Semester</label>
      <select name="semester" id="semesterSelect" class="form-select" required onchange="syncTimelineScope()">
        <option value="">Select...</option>
        <% for(let i=1; i<=8; i++) { %>
          <option value="<%= i %>" <%= (query && query.semester == i) ? 'selected' : '' %>><%= i %></option>
        <% } %>
      </select>
    </div>

    <!-- Section Selection (Width: 2 - Now equal to Semester) -->
    <div class="col-md-2">
      <label class="form-label fw-bold text-secondary">Section</label>
      <select name="section" class="form-select" required>
        <option value="">Select...</option>
        <% if (typeof sectionData !== 'undefined' && sectionData) { %>
          <% sectionData.forEach(s => { %>
            <option value="<%= s.name %>" <%= (query && query.section === s.name) ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <!-- DYNAMIC ACADEMIC YEAR INPUT WITH DATALIST (Width: 2) -->
    <div class="col-md-2">
      <label for="academicYear" class="form-label fw-bold text-secondary">📅 Academic Year</label>
      <input 
        type="number" 
        placeholder="Session" 
        name="academicYear" 
        id="academicYear"
        class="form-select fw-bold" 
        value="<%= (query && query.academicYear) ? query.academicYear : '' %>"
        required 
        list="yearOptionsList"
      >
      <datalist id="yearOptionsList">
        <% if (typeof academicYearsList !== 'undefined' && academicYearsList.length > 0) { %>
          <% academicYearsList.forEach(year => { %>
            <option value="<%= year %>"><%= year %></option>
          <% }) %>
        <% } %>
      </datalist>
    </div>

    <!-- Timeline Scope Mode (Width: 2) -->
    <div class="col-md-2">
      <label class="form-label fw-bold text-secondary">Timeline Scope</label>
      <select name="modeSelection" id="timelineSelect" class="form-select" required>
        <option value="single" <%= (query && query.modeSelection === 'single') ? 'selected' : '' %>>Current Sem</option>
        <option value="next" <%= (query && query.modeSelection === 'next') ? 'selected' : '' %>>Next Sem</option>
        <option value="both" <%= (query && query.modeSelection === 'both') ? 'selected' : '' %>>Both Sem</option>
      </select>
    </div>

    <!-- Submit Button (Width: 2) -->
    <div class="col-md-2">
      <button type="submit" class="btn w-100 fw-bold text-white py-2 shadow-sm" style="background-color: #0f766e;">Load Batch</button>
    </div>
  </form>
</div>

  <% if (typeof students !== 'undefined' && students && students.length > 0) { %>

    <!-- MASTER CONTROL TOOLKIT -->
    <div class="card p-4 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <h5 class="fw-bold mb-3 border-bottom pb-2 text-warning">⚡ Core Automation Control Toolkit</h5>
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">1. OUTSTANDING INJECTOR</label>
          <button type="button" onclick="executeGlobalDuesClearance()" class="btn btn-warning w-100 fw-bold shadow-sm">
            Inject All Net Pending Dues
          </button>
        </div>
        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">2. CUSTOM VALUE MULTI-INJECTOR</label>
          <div class="input-group">
            <input type="number" id="globalCustomValueInput" class="form-control" placeholder="Enter custom amount...">
            <button class="btn btn-dark fw-bold" type="button" onclick="executeCustomAmountInjection()">Inject Value</button>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">3. GLOBAL PAYMENT MODE OVERRIDE</label>
          <select id="globalPaymentModeSelector" class="form-select fw-bold" onchange="executeGlobalPaymentModeOverride(this.value)">
            <option value="">Select Mode Override...</option>
            <option value="Cash">Cash</option>
            <option value="UPI">UPI</option>
            <option value="Net Banking">Net Banking</option>
            <option value="Cheque">Cheque</option>
          </select>
        </div>
      </div>
    </div>

    <!-- DATA GRID FORM -->
    <form action="/fees/process-bulk-payments" method="POST" id="waterfallGridForm">
      <input type="hidden" name="semA" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %>">
      <input type="hidden" name="semB" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %>">
      <input type="hidden" name="className" value="<%= (query && query.className) ? query.className : '' %>">
      <input type="hidden" name="section" value="<%= (query && query.section) ? query.section : '' %>">
      <input type="hidden" name="academicYear" value="<%= (query && query.academicYear) ? query.academicYear : '' %>">
      <input type="hidden" name="modeSelection" value="<%= (query && query.modeSelection) ? query.modeSelection : '' %>">
      <input type="hidden" name="submitToken" value="<%= typeof submitToken !== 'undefined' ? submitToken : '' %>">

      <div class="table-responsive shadow rounded">
        <table class="table align-middle bg-white table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>Roll No</th>
              <th>Student Identity Meta</th>
              <th class="text-center text-warning bg-secondary">Prev Pending</th>
              <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !== 'undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %> Dues</th>
              <% if(query && query.modeSelection === 'both') { %>
                <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !== 'undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %> Dues</th>
              <% } %>
              <th class="text-center" style="width: 28%;">Balance Settlement</th>
              <th class="text-center text-success" style="width: 18%;">Amount to Pay (₹)</th>
              <th style="width: 15%;">Payment Method</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach((student, index) => { %>
              <tr class="payment-row-item <%= student.isLocked ? 'table-light opacity-75' : '' %>" data-index="<%= index %>">
                <td>
                  <input type="hidden" name="payments[<%= index %>][student_id]" value="<%= student.student_id %>">
                  <input type="hidden" name="payments[<%= index %>][rollNumber]" value="<%= student.rollNumber %>">
                  <input type="hidden" name="payments[<%= index %>][studentName]" value="<%= student.studentName %>">
                  <input type="hidden" name="payments[<%= index %>][status]" value="<%= student.status %>">
                  <span class="badge bg-dark fs-6"><%= student.rollNumber %></span>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= student.studentName %></div>
                  <small class="text-muted">F: <%= student.fatherName %></small>
                </td>

                <!-- Previous Pending -->
                <td class="text-center fw-semibold text-danger bg-light">
                  <span class="label-prev-pending">₹<%= student.previousPendingDues %></span>
                </td>

                <!-- Sem A Column (ALWAYS ORIGINAL DUE + CONDITION BASED PENDING DISPLAY FROM DATABASE) -->
                <td class="text-center table-active text-dark fw-bold">
                  <!-- Hamesha original fees hi dikhaye (due_amount) -->
                  <div class="fs-6 text-primary">₹<%= student.semA.originalDue %></div>
                  
                  <!-- CONDITION: Agar database se nikal kar balance_pending > 0 hai -->
                  <% if(student.semA.dbBalancePending > 0) { %>
                    <!-- Uske just upar ye line dikhaye previous amount_paid ki value -->
                    <div class="text-muted small fw-normal" style="font-size: 0.72rem; display: block; line-height: 1.1; margin-top: 2px;">
                      (Amount_paid: ₹<%= student.semA.dbAmountPaid %> cut in this semester)
                    </div>
                    <!-- Us column me balance_pending fees ko dikhaye -->
                    <div class="badge bg-danger-subtle text-danger border border-danger mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                      Pending: ₹<%= student.semA.dbBalancePending %>
                    </div>
                  <% } else if(student.semA.originalDue > 0) { %>
                    <div class="badge bg-success-subtle text-success border border-success mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                      Cleared
                    </div>
                  <% } %>
                </td>

                <!-- Sem B Column (ALWAYS ORIGINAL DUE + CONDITION BASED PENDING DISPLAY FROM DATABASE) -->
                <% if(query && query.modeSelection === 'both') { %>
                  <td class="text-center table-active text-dark fw-bold">
                    <% if(student.semB) { %>
                      <!-- Hamesha original fees hi dikhaye (due_amount) -->
                      <div class="fs-6 text-primary">₹<%= student.semB.originalDue %></div>
                      
                      <!-- CONDITION: Agar database se nikal kar balance_pending > 0 hai -->
                      <% if(student.semB.dbBalancePending > 0) { %>
                        <!-- Uske just upar ye line dikhaye previous amount_paid ki value -->
                        <div class="text-muted small fw-normal" style="font-size: 0.72rem; display: block; line-height: 1.1; margin-top: 2px;">
                          (Previous amount_paid: ₹<%= student.semB.dbAmountPaid %> cut in this semester)
                        </div>
                        <!-- Us column me balance_pending fees ko dikhaye -->
                        <div class="badge bg-danger-subtle text-danger border border-danger mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                          Pending: ₹<%= student.semB.dbBalancePending %>
                        </div>
                      <% } else if(student.semB.originalDue > 0) { %>
                        <div class="badge bg-success-subtle text-success border border-success mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                          Cleared
                        </div>
                      <% } %>
                    <% } else { %>
                      <span>₹0</span>
                    <% } %>
                  </td>
                <% } %>

                <!-- Settlement Column (Clean Ledger Info) -->
                <td class="text-center bg-light">
                  <div class="d-flex flex-column gap-1 align-items-center justify-content-center ledger-status-container">
                    
                    <!-- Database Wallet Advance Info Display -->
                    <% if (student.advanceBalance > 0) { %>
                      <div class="badge w-100 py-2 fs-7 shadow-sm border mb-1 text-wrap" style="background-color: #cff4fc !important; border-color: #b6effb !important; color: #055160 !important; display: inline-block !important;">
                        💎 ₹<span class="db-advance-val fw-bolder"><%= student.advanceBalance %></span> - Unallocated Advance Wallet
                      </div>
                    <% } %>

