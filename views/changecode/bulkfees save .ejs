<script>
  // Fast Danger Blink Animation injection logic
  if (!document.getElementById('custom-blink-styles')) {
    const style = document.createElement('style');
    style.id = 'custom-blink-styles';
    style.innerHTML = `
      @keyframes fastDangerBlink {
        0% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
        50% { opacity: 0.35; box-shadow: 0 0 2px rgba(176, 42, 55, 0.1); }
        100% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
      }
      .pulse-danger-blink {
        animation: fastDangerBlink 1s infinite ease-in-out !important;
        background-color: #b02a37 !important; 
        border-color: #842029 !important;
        color: #ffffff !important; 
        font-size: 0.95rem !important; 
        font-weight: 800 !important; 
        padding: 8px 12px !important;
      }
    `;
    document.head.appendChild(style);
  }

  function resetTargetRowValue(buttonElement) {
    const inputGroup = buttonElement.closest('.input-group');
    const targetInput = inputGroup.querySelector('.input-amount-to-pay');
    if (targetInput) {
      targetInput.value = 0;
      processRowLiveCalculations(targetInput);
    }
  }

  function processRowLiveCalculations(inputElement) {
    const enteredAmount = parseFloat(inputElement.value) || 0;
    const row = inputElement.closest('tr');

    const prevDues = parseFloat(inputElement.getAttribute('data-prev-dues')) || 0;
    const semADues = parseFloat(inputElement.getAttribute('data-sema-dues')) || 0;
    const semBDues = parseFloat(inputElement.getAttribute('data-semb-dues')) || 0;

    const totalOriginalDues = prevDues + semADues + semBDues;

    const statusBadge = row.querySelector('.live-status-badge');
    const projAdvanceBadge = row.querySelector('.projected-advance-badge');
    const projAdvanceVal = row.querySelector('.projected-advance-val');

    let workingCapital = enteredAmount;

    if (totalOriginalDues <= 0) {
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-success text-white";
      statusBadge.innerHTML = "🎉 Complete / Clear";
      if (enteredAmount > 0) {
        projAdvanceBadge.classList.remove('d-none');
        projAdvanceVal.innerText = enteredAmount.toFixed(2);
      } else {
        projAdvanceBadge.classList.add('d-none');
      }
    } else if (workingCapital >= totalOriginalDues) {
      const spilloverAdvance = workingCapital - totalOriginalDues;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-success text-white";
      statusBadge.innerHTML = "🎉 Fully Settled";

      if (spilloverAdvance > 0) {
        projAdvanceBadge.classList.remove('d-none');
        projAdvanceVal.innerText = spilloverAdvance.toFixed(2);
      } else {
        projAdvanceBadge.classList.add('d-none');
      }
    } else {
      const netPendingAfterPay = totalOriginalDues - workingCapital;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-danger-subtle text-danger border border-danger pulse-danger-blink";
      statusBadge.innerHTML = `⚠️ Balance Due: ₹${netPendingAfterPay.toFixed(2)}`;
      projAdvanceBadge.classList.add('d-none');
    }

    calculateLiveDashboardMetrics();
  }

  // Dropdown ranges utility
  function getRangeByClassName(name) {
    const upper = name.toUpperCase();
    if (upper.includes("1ST YEAR")) return [1, 2];
    if (upper.includes("2ND YEAR")) return [3, 4];
    if (upper.includes("3RD YEAR")) return [5, 6];
    if (upper.includes("4TH YEAR")) return [7, 8];
    return [1, 8];
  }

  // Dropdown sync utils
  function syncSemesterDropdown() {
    const classVal = document.getElementById('classSelect').value;
    const semesterSelect = document.getElementById('semesterSelect');
    if (!classVal) return;

    const range = getRangeByClassName(classVal);
    semesterSelect.innerHTML = '<option value="">Select...</option>';
    for (let i = range[0]; i <= range[1]; i++) {
      semesterSelect.innerHTML += `<option value="${i}">${i}</option>`;
    }
    syncTimelineScope();
  }

  function syncTimelineScope() {
    const classVal = document.getElementById('classSelect').value;
    const semVal = document.getElementById('semesterSelect').value;
    const timelineSelect = document.getElementById('timelineSelect');
    if (!classVal || !semVal) return;

    const range = getRangeByClassName(classVal);
    const currentSem = parseInt(semVal);
    const nextSem = (currentSem + 1 <= range[1]) ? currentSem + 1 : currentSem;

    timelineSelect.innerHTML = `
      <option value="single">Current Semester (Sem ${currentSem})</option>
      <option value="next">Next Current Semester (Sem ${nextSem})</option>
      <option value="both">Both Semesters of Current Year (Sem ${range[0]} & ${range[1]})</option>
    `;
  }

  function executeGlobalDuesClearance() {
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        const outstandingDues = parseFloat(targetInput.getAttribute('data-outstanding')) || 0;
        targetInput.value = outstandingDues;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  // Multi injectors allocation
  function executeCustomAmountInjection() {
    const injectionVal = parseFloat(document.getElementById('globalCustomValueInput').value) || 0;
    if (injectionVal <= 0) {
      alert("Alert: Please enter a positive custom amount allocation.");
      return;
    }
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        targetInput.value = injectionVal;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  function executeGlobalPaymentModeOverride(overrideValue) {
    if (!overrideValue) return;
    document.querySelectorAll('.select-row-payment-mode').forEach(dropdown => {
      if (!dropdown.disabled) {
        dropdown.value = overrideValue;
      }
    });
  }

  function calculateLiveDashboardMetrics() {
    let combinedAggregateCounter = 0;
    document.querySelectorAll('.input-amount-to-pay').forEach(input => {
      combinedAggregateCounter += (parseFloat(input.value) || 0);
    });
    const counterEl = document.getElementById('liveCollectionCounter');
    if (counterEl) {
      counterEl.innerText = '₹' + combinedAggregateCounter.toLocaleString('en-IN');
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    calculateLiveDashboardMetrics();

    const classInputEl = document.getElementById('metadataClassName');
    const semInputEl = document.getElementById('metadataSemester');

    const initialClass = classInputEl ? classInputEl.value : '';
    const initialSem = semInputEl ? semInputEl.value : '';

    if (initialClass && initialSem) {
      const range = getRangeByClassName(initialClass);
      const semesterSelect = document.getElementById('semesterSelect');
      if (semesterSelect) {
        semesterSelect.innerHTML = '';
        for (let i = range[0]; i <= range[1]; i++) {
          const selected = (i == initialSem) ? 'selected' : '';
          semesterSelect.innerHTML += `<option value="${i}" ${selected}>${i}</option>`;
        }
        syncTimelineScope();
      }
    }
  });
</script>






