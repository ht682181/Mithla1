                        </div>
                        <div class="badge bg-danger-subtle text-danger border border-danger mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                          Pending: ₹<%= student.semB.dbBalancePending %>
                        </div>
                      <% } else if(student.semB.originalDue > 0) { %>
                        <div class="badge bg-success-subtle text-success border border-success mt-1 px-2 py-1" style="font-size: 0.78rem; display: inline-block;">
                          Cleared
