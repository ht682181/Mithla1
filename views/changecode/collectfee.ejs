// Helper for Safe Currency Rounding (Fixes Floating-Point Bugs)
const round2 = (num) => Math.round((num + Number.EPSILON) * 100) / 100;

// ==========================================
// 1. GET ROUTE: High-Performance Fetch & Auto-Fill
// ==========================================
app.get("/add/student/fees", verifiedAny, WrapAsync(async (req, res) => {
  // Parallel DB Calls using Promise.all + Lean (Ultra-Fast execution)
  const [classData, sectionData] = await Promise.all([
    Class.find({}).lean(),
    Section.find({}).lean()
  ]);

  const currentYear = new Date().getFullYear();
  const { className, semester, section } = req.query;

  let students = [];
  let activeSemesters = [];

  if (className && semester && section) {
    const semNum = parseInt(semester);
    
    // Dynamic Academic Year Tracking (Pairing logic)
    const pairGroup = Math.ceil(semNum / 2); 
    activeSemesters = [(pairGroup * 2) - 1, pairGroup * 2];

    // Selective Projection: Fetching ONLY required fields to save Node.js RAM
    const studentsRaw = await Student.find({ 
      class: String(className).trim(),      
      semester: String(semester).trim(),   
      section: String(section).trim()      
    })
    .select("_id rollNo name fatherName  class semester section session")
    .lean();
  

    if (studentsRaw.length > 0) {
      const studentIds = studentsRaw.map(s => s._id);

      // Single Indexed Query Fetch
      const existingLedgers = await FeeLedger.find({ 
        student_id: { $in: studentIds } 
      })
      .select("student_id total_course_fees semesters")
      .lean();

      const ledgerMap = new Map(existingLedgers.map(l => [l.student_id.toString(), l]));

      // Structural Data Mapping
      students = studentsRaw.map(student => {
        const ledger = ledgerMap.get(student._id.toString());
        
        let semADue = 0;
        let semBDue = 0;
        let totalCourseFees = 0;

        if (ledger) {
          totalCourseFees = ledger.total_course_fees || 0;

          const semAData = ledger.semesters?.find(s => s.semNumber === activeSemesters[0]);
          const semBData = ledger.semesters?.find(s => s.semNumber === activeSemesters[1]);

          if (semAData || semBData) {
            semADue = semAData ? semAData.due_amount : 0;
            semBDue = semBData ? semBData.due_amount : 0;
          } else if (ledger.semesters && ledger.semesters.length > 0) {
            // Dynamic historical fetch fallback
            const sortedSemesters = [...ledger.semesters].sort((a, b) => b.semNumber - a.semNumber);
            const lastSavedSem = sortedSemesters[0];

            if (lastSavedSem) {
              semADue = lastSavedSem.due_amount || 0;
              semBDue = lastSavedSem.due_amount || 0;
            }
          }
        }

        return {
          ...student,
          total_course_fees: round2(totalCourseFees),
          semADue: round2(semADue),
          semBDue: round2(semBDue),
          existingYearTotal: round2(semADue + semBDue)
        };
      });
    }
  }

  res.render("admin/addFeesData", { 
    classData, 
    sectionData, 
    currentYear,
    students, 
    selectedSem: semester || null, 
    activeSemesters,
    query: req.query || {} 
  });
}));


app.post("/fees/save-bulk-ledger", verifiedAny, validateFeeData, WrapAsync(async (req, res) => {
  const { fees, semA, semB, className, section } = req.body;
  const sA = parseInt(semA);
  const sB = parseInt(semB);

  // 1. Initial Validation Check
  if (!className || !section || isNaN(sA) || isNaN(sB) || !fees || !Array.isArray(fees) || fees.length === 0) {
    req.flash("error", "⚠️ Security Error: Crucial input parameters are missing or invalid!");
    return res.redirect("/add/student/fees");
  }

  const cleanClass = className.trim();
  const cleanSection = section.trim();
  const currentCourseType = cleanClass.split(" ")[0].toUpperCase();

  // Helper for strict monetary rounding
  const round2 = (val) => Math.round((parseFloat(val) || 0 + Number.EPSILON) * 100) / 100;

  // MongoDB Transaction Session
  const dbSession = await mongoose.startSession();

  try {
    dbSession.startTransaction();

    // 2. Safe Mongoose ObjectId Conversion & Student Session Lookup
    const uniqueSubmittedIds = new Set(fees.map(f => f.student_id?.toString()).filter(Boolean));
    const studentObjectIds = Array.from(uniqueSubmittedIds).map(id => new mongoose.Types.ObjectId(id));

    // Fetch Session Info from Student Model
    const rawStudentList = await Student.find({ _id: { $in: studentObjectIds } })
      .select("_id session")
      .lean();
    
    const studentSessionMap = new Map(rawStudentList.map(s => [s._id.toString(), s.session]));

    // ⚡ 3. DYNAMIC ACADEMIC YEAR CALCULATION (WITH BUG-FREE FALLBACK)
    const sampleRecord = fees.find(f => f.status !== "Left College") || fees[0];
    const sampleSession = sampleRecord?.session || studentSessionMap.get(sampleRecord?.student_id?.toString()) || "";
    
    const parsedStartYear = parseInt((sampleSession || "").split("-")[0]);
    const startYear = !isNaN(parsedStartYear) ? parsedStartYear : new Date().getFullYear();
    const calculatedYearNum = startYear + Math.floor((sA - 1) / 2);

    // 4. GLOBAL DUPLICATE BATCH CHECK
    const globalBatchExists = await FeeLedger.findOne({
      "classesHistory": {
        $elemMatch: {
          className: cleanClass,
          section: cleanSection,
          academicYear: calculatedYearNum
        }
      }
    }).session(dbSession);

    if (globalBatchExists) {
      await dbSession.abortTransaction();
      req.flash(
        "error", 
        `🚨 DUPLICATE BATCH BLOCKED: Data for "${cleanClass} - Sec ${cleanSection}" for Year (${calculatedYearNum}) ALREADY EXISTS in database!`
      );
      return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
    }

    // Fetch existing ledgers for submitted students
    const existingLedgers = await FeeLedger.find({ 
      student_id: { $in: studentObjectIds } 
    }).session(dbSession);

    // 5. INDIVIDUAL STUDENT SEMESTER DUPLICATE CHECK
    for (let ledger of existingLedgers) {
      const semDuplicate = (ledger.semesters || []).some(
        s => s.semNumber === sA || s.semNumber === sB
      );

      if (semDuplicate) {
        await dbSession.abortTransaction();
        req.flash(
          "error", 
          `⚠️ Semester Conflict: Semester (${sA} or ${sB}) already exists for student ${ledger.studentName}!`
        );
        return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
      }
    }

    const ledgerMap = new Map(existingLedgers.map(l => [l.student_id.toString(), l]));
    const bulkOperations = [];

    // 6. BUILD BULK WRITE OPERATIONS
    for (let record of fees) {
      if (record.status === "Left College") continue;

      if (!record.student_id || !record.rollNumber || !record.studentName || 
          record.due_amount_A === undefined || record.due_amount_B === undefined) {
        throw new Error(`Grid data error for Roll No: ${record.rollNumber || 'Unknown'}`);
      }

      const dueA = round2(Math.max(0, parseFloat(record.due_amount_A) || 0));
      const dueB = round2(Math.max(0, parseFloat(record.due_amount_B) || 0));
      let ledger = ledgerMap.get(record.student_id.toString());
      
      const studentSession = record.session || studentSessionMap.get(record.student_id.toString()) || sampleSession || `${startYear}-${startYear+3}`;
      const indParsedYear = parseInt((studentSession || "").split("-")[0]);
      const individualStartYear = !isNaN(indParsedYear) ? indParsedYear : startYear;
      const individualYearNum = individualStartYear + Math.floor((sA - 1) / 2);

      if (!ledger) {
        // 🆕 NEW STUDENT LEDGER CREATION
        const initialTotal = round2(dueA + dueB);
        const newLedgerDoc = {
          student_id: new mongoose.Types.ObjectId(record.student_id.toString()),
          rollNumber: record.rollNumber,
          studentName: record.studentName,
          fatherName: record.fatherName || 'N/A',
          session: studentSession,
          currentCourse: currentCourseType,
          status: 'Active',
          classesHistory: [{ className: cleanClass, section: cleanSection, academicYear: individualYearNum }],
          
          semesters: [
            { semNumber: sA, due_amount: dueA, penalty_amount: 0, amount_paid: 0, balance_pending: dueA },
            { semNumber: sB, due_amount: dueB, penalty_amount: 0, amount_paid: 0, balance_pending: dueB }
          ],
          
          advance_balance: 0,
          total_course_fees: initialTotal,
          total_amount_paid: 0,
          overall_pending_balance: initialTotal
        };

        bulkOperations.push({
          insertOne: { document: newLedgerDoc }
        });
      } else {
        // 🔄 EXISTING STUDENT LEDGER UPDATE
        if (ledger.currentCourse && ledger.currentCourse !== currentCourseType) {
          throw new Error(`Course mismatch for ${record.studentName}. Expected ${ledger.currentCourse}, got ${currentCourseType}`);
        }

        let targetSemesters = [...(ledger.semesters || [])];

        // Add new semesters to existing list
        [ {num: sA, due: dueA}, {num: sB, due: dueB} ].forEach(item => {
          targetSemesters.push({ 
            semNumber: item.num, 
            due_amount: item.due, 
            penalty_amount: 0,
            amount_paid: 0, 
            balance_pending: item.due 
          });
        });

        targetSemesters.sort((a, b) => a.semNumber - b.semNumber);

        let tempAdvance = round2(ledger.advance_balance || 0);

        // Advance absorption taking PENALTY into account
        if (tempAdvance > 0) {
          for (let sItem of targetSemesters) {
            const semPenalty = round2(sItem.penalty_amount || sItem.penalty || 0);
            const semDue = round2(sItem.due_amount || 0);
            const totalSemDemand = round2(semDue + semPenalty);

            let pendingDues = round2(Math.max(0, totalSemDemand - (sItem.amount_paid || 0)));

            if (pendingDues > 0 && tempAdvance > 0) {
              let absorb = round2(Math.min(tempAdvance, pendingDues));
              sItem.amount_paid = round2((sItem.amount_paid || 0) + absorb);
              sItem.balance_pending = round2(Math.max(0, totalSemDemand - sItem.amount_paid));
              tempAdvance = round2(tempAdvance - absorb);
            }
          }
        }

        // ⚡ DEDUPLICATE History Array to Prevent Duplicate Entries
        let targetHistory = [...(ledger.classesHistory || [])];
        const isHistoryPresent = targetHistory.some(
          h => h.className === cleanClass && h.section === cleanSection && h.academicYear === individualYearNum
        );
        if (!isHistoryPresent) {
          targetHistory.push({ className: cleanClass, section: cleanSection, academicYear: individualYearNum });
        }

        // Recalculate Course Totals & Balances INCLUDING Penalties
        let totalCourseFeesAndPenalties = 0;
        let dynamicSumPaid = 0;

        targetSemesters.forEach(s => {
          const semDue = round2(s.due_amount || 0);
          const semPenalty = round2(s.penalty_amount || s.penalty || 0);
          totalCourseFeesAndPenalties += round2(semDue + semPenalty);
          dynamicSumPaid += round2(s.amount_paid || 0);
        });

        totalCourseFeesAndPenalties = round2(totalCourseFeesAndPenalties);
        dynamicSumPaid = round2(dynamicSumPaid);

        const finalAmountPaid = round2(dynamicSumPaid + tempAdvance); 
        const overallPending = round2(Math.max(0, totalCourseFeesAndPenalties - dynamicSumPaid));

        bulkOperations.push({
          updateOne: {
            filter: { student_id: new mongoose.Types.ObjectId(record.student_id.toString()) },
            update: {
              $set: {
                session: studentSession,
                semesters: targetSemesters,
                classesHistory: targetHistory,
                advance_balance: tempAdvance,
                total_course_fees: totalCourseFeesAndPenalties,
                total_amount_paid: finalAmountPaid,
                overall_pending_balance: overallPending
              }
            }
          }
        });
      }
    }

    if (bulkOperations.length > 0) {
      await FeeLedger.bulkWrite(bulkOperations, { session: dbSession });
    }

    await dbSession.commitTransaction();
    req.flash("success", "🎉 Success! Batch fee structure saved cleanly.");
    return res.redirect("/add/student/fees");

  } catch (dbError) {
    if (dbSession.inTransaction()) {
      await dbSession.abortTransaction();
    }
    req.flash("error", `❌ Database Refused: ${dbError.message}`);
    return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
  } finally {
    // ⚡ ALWAYS END SESSION IN FINALLY BLOCK
    dbSession.endSession();
  } 
}));


