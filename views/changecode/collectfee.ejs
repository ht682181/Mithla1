                    <!-- Projected Future Wallet Balance -->
                    <div class="projected-advance-badge badge w-100 py-2 fs-7 shadow-sm border d-none" style="background-color: #d1e7dd !important; border-color: #badbcc !important; color: #0f5132 !important;">
