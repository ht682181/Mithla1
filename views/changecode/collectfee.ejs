<!-- database    -->
const mongoose = require('mongoose');

// ==========================================
// 1. FEE LEDGER SCHEMA (Single Student Lifetime Ledger)
// ==========================================
const feeLedgerSchema = new mongoose.Schema({
  student_id: { 
    type: mongoose.Schema.Types.ObjectId, 
    ref: 'Student', 
    required: true, 
    unique: true 
  },
  rollNumber: { type: String, required: true, unique: true, index: true },
  studentName: { type: String, required: true },
  fatherName: { type: String, default: '' },
  
  // ⚡ Session / Batch Track (e.g. "2026-2029")
  session: { type: String, required: true, trim: true, index: true },

  currentCourse: { 
    type: String, 
    required: true, 
    uppercase: true, 
    trim: true 
  },
  
  classesHistory: [
    {
      className: { type: String, required: true }, 
      section: { type: String, required: true, uppercase: true },
      academicYear: { type: Number, required: true } 
    }
  ],

  status: { 
    type: String, 
    enum: ['Active', 'Left College'], 
    default: 'Active' 
  },

  semesters: [
    {
      semNumber: { type: Number, required: true, min: 1, max: 8 },
      due_amount: { type: Number, default: 0, min: 0 },
      amount_paid: { type: Number, default: 0, min: 0 },
     penalty_amount: { type: Number, default: 0, min: 0 },
      balance_pending: { type: Number, default: 0 }
    }
  ],

  // Advance / Excess Funds Management
  advance_balance: { type: Number, default: 0, min: 0 },

  // Overall Financial Lifetime Trackers
  total_course_fees: { type: Number, default: 0, min: 0 },
  total_amount_paid: { type: Number, default: 0, min: 0 },
  overall_pending_balance: { type: Number, default: 0 }
}, { timestamps: true });

// Compound Indexes for Super-Fast Lookup Queries
feeLedgerSchema.index({ "classesHistory.className": 1, "classesHistory.section": 1, "classesHistory.academicYear": 1 });
feeLedgerSchema.index({ session: 1, currentCourse: 1 });
feeLedgerSchema.index({ student_id: 1, status: 1 });


// ==========================================
// 2. FEE TRANSACTION SCHEMA (Passbook Logs)
// ==========================================
const feeTransactionSchema = new mongoose.Schema({
  receiptNumber: { type: String, required: true, unique: true, index: true }, 
  student_id: { type: mongoose.Schema.Types.ObjectId, ref: 'Student', required: true, index: true },
  rollNumber: { type: String, required: true },
  studentName: { type: String, required: true },
  fatherName: { type: String, default: 'N/A' },
  semNumber: { type: Number, required: true, min: 1, max: 8 }, 
  academicYear: { type: Number, required: true },
  amountPaid: { type: Number, required: true, min: 0 }, 
  isAdvanceLog: { type: Boolean, default: false }, 
  paymentMode: { 
    type: String, 
    enum: ['Cash', 'UPI', 'Net Banking', 'Cheque', 'Wallet Adjust', 'Online'], 
    required: true 
  },
  metadata: {
    type: mongoose.Schema.Types.Mixed,
    default: {}
  },
  paymentDate: { type: Date, default: Date.now } 
}, { timestamps: true });

feeTransactionSchema.index({ student_id: 1, academicYear: 1 });
feeTransactionSchema.index({ createdAt: -1 });

const FeeLedger = mongoose.model('FeeLedger', feeLedgerSchema);
const FeeTransaction = mongoose.model('FeeTransaction', feeTransactionSchema);

module.exports = { FeeLedger, FeeTransaction };           






<!-- fees   structure save karne wala route   -->



app.post("/fees/save-bulk-ledger", verifiedAny, validateFeeData, WrapAsync(async (req, res) => {
  const { fees, semA, semB, className, section } = req.body;
  const sA = parseInt(semA);
  const sB = parseInt(semB);

  // 1. Initial Validation Check
  if (!className || !section || isNaN(sA) || isNaN(sB) || !fees || !Array.isArray(fees) || fees.length === 0) {
    req.flash("error", "⚠️ Security Error: Crucial input parameters are missing or invalid!");
    return res.redirect("/add/student/fees");
  }

  const cleanClass = className.trim();
  const cleanSection = section.trim();
  const currentCourseType = cleanClass.split(" ")[0].toUpperCase();

  // MongoDB Transaction Session
  const dbSession = await mongoose.startSession();
  dbSession.startTransaction();

  try {
    // 2. Safe Mongoose ObjectId Conversion & Student Session Lookup
    const uniqueSubmittedIds = new Set(fees.map(f => f.student_id?.toString()).filter(Boolean));
    const studentObjectIds = Array.from(uniqueSubmittedIds).map(id => new mongoose.Types.ObjectId(id));

    // Fetch Session Info from Student Model
    const rawStudentList = await Student.find({ _id: { $in: studentObjectIds } })
      .select("_id session")
      .lean();
    
    const studentSessionMap = new Map(rawStudentList.map(s => [s._id.toString(), s.session]));

    // ⚡ 3. DYNAMIC ACADEMIC YEAR CALCULATION
    const sampleRecord = fees.find(f => f.status !== "Left College") || fees[0];
    const sampleSession = sampleRecord?.session || studentSessionMap.get(sampleRecord?.student_id?.toString()) || "NA";
    
    const startYear = parseInt(sampleSession.split("-")[0]) || new Date().getFullYear();
    const calculatedYearNum = startYear + Math.floor((sA - 1) / 2);

    // 4. GLOBAL DUPLICATE BATCH CHECK
    const globalBatchExists = await FeeLedger.findOne({
      "classesHistory": {
        $elemMatch: {
          className: cleanClass,
          section: cleanSection,
          academicYear: calculatedYearNum
        }
      }
    }).session(dbSession);

    if (globalBatchExists) {
      await dbSession.abortTransaction();
      dbSession.endSession();
      req.flash(
        "error", 
        `🚨 DUPLICATE BATCH BLOCKED: Data for "${cleanClass} - Sec ${cleanSection}" for Year (${calculatedYearNum}) ALREADY EXISTS in database!`
      );
      return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
    }

    // Fetch existing ledgers for submitted students
    const existingLedgers = await FeeLedger.find({ 
      student_id: { $in: studentObjectIds } 
    }).session(dbSession);

    // 5. INDIVIDUAL STUDENT SEMESTER DUPLICATE CHECK
    for (let ledger of existingLedgers) {
      const semDuplicate = (ledger.semesters || []).some(
        s => s.semNumber === sA || s.semNumber === sB
      );

      if (semDuplicate) {
        await dbSession.abortTransaction();
        dbSession.endSession();
        req.flash(
          "error", 
          `⚠️ Semester Conflict: Semester (${sA} or ${sB}) already exists for student!`
        );
        return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
      }
    }

    const ledgerMap = new Map(existingLedgers.map(l => [l.student_id.toString(), l]));
    const bulkOperations = [];

    // 6. BUILD BULK WRITE OPERATIONS
    for (let record of fees) {
      if (record.status === "Left College") continue;

      if (!record.student_id || !record.rollNumber || !record.studentName || 
          record.due_amount_A === undefined || record.due_amount_B === undefined) {
        throw new Error(`Grid data error for Roll No: ${record.rollNumber || 'Unknown'}`);
      }

      const dueA = round2(Math.max(0, parseFloat(record.due_amount_A) || 0));
      const dueB = round2(Math.max(0, parseFloat(record.due_amount_B) || 0));
      let ledger = ledgerMap.get(record.student_id.toString());
      
      const studentSession = record.session || studentSessionMap.get(record.student_id.toString()) || sampleSession;
      const individualStartYear = parseInt(studentSession.split("-")[0]) || startYear;
      const individualYearNum = individualStartYear + Math.floor((sA - 1) / 2);

      if (!ledger) {
        // 🆕 NEW STUDENT LEDGER CREATION
        const initialTotal = round2(dueA + dueB);
        const newLedgerDoc = {
          student_id: new mongoose.Types.ObjectId(record.student_id.toString()),
          rollNumber: record.rollNumber,
          studentName: record.studentName,
          fatherName: record.fatherName || 'N/A',
          session: studentSession,
          currentCourse: currentCourseType,
          status: 'Active',
          classesHistory: [{ className: cleanClass, section: cleanSection, academicYear: individualYearNum }],
          
          semesters: [
            { semNumber: sA, due_amount: dueA, penalty_amount: 0, amount_paid: 0, balance_pending: dueA },
            { semNumber: sB, due_amount: dueB, penalty_amount: 0, amount_paid: 0, balance_pending: dueB }
          ],
          
          advance_balance: 0,
          total_course_fees: initialTotal,
          total_amount_paid: 0,
          overall_pending_balance: initialTotal
        };

        bulkOperations.push({
          insertOne: { document: newLedgerDoc }
        });
      } else {
        // 🔄 EXISTING STUDENT LEDGER UPDATE
        if (ledger.currentCourse && ledger.currentCourse !== currentCourseType) {
          throw new Error(`Course mismatch for ${record.studentName}. Expected ${ledger.currentCourse}, got ${currentCourseType}`);
        }

        let targetSemesters = [...(ledger.semesters || [])];

        // Add new semesters to existing list
        [ {num: sA, due: dueA}, {num: sB, due: dueB} ].forEach(item => {
          targetSemesters.push({ 
            semNumber: item.num, 
            due_amount: item.due, 
            penalty_amount: 0,
            amount_paid: 0, 
            balance_pending: item.due 
          });
        });

        targetSemesters.sort((a, b) => a.semNumber - b.semNumber);

        let tempAdvance = round2(ledger.advance_balance || 0);

        // ⚡ FIX: Advance absorption taking PENALTY into account
        if (tempAdvance > 0) {
          for (let sItem of targetSemesters) {
            const semPenalty = round2(sItem.penalty_amount || sItem.penalty || 0);
            const semDue = round2(sItem.due_amount || 0);
            const totalSemDemand = round2(semDue + semPenalty);

            let pendingDues = round2(Math.max(0, totalSemDemand - (sItem.amount_paid || 0)));

            if (pendingDues > 0 && tempAdvance > 0) {
              let absorb = round2(Math.min(tempAdvance, pendingDues));
              sItem.amount_paid = round2((sItem.amount_paid || 0) + absorb);
              sItem.balance_pending = round2(Math.max(0, totalSemDemand - sItem.amount_paid));
              tempAdvance = round2(tempAdvance - absorb);
            }
          }
        }

        let targetHistory = [...(ledger.classesHistory || []), { className: cleanClass, section: cleanSection, academicYear: individualYearNum }];

        // ⚡ FIX: Recalculate Course Totals & Balances INCLUDING Penalties
        let totalCourseFeesAndPenalties = 0;
        let dynamicSumPaid = 0;

        targetSemesters.forEach(s => {
          const semDue = round2(s.due_amount || 0);
          const semPenalty = round2(s.penalty_amount || s.penalty || 0);
          totalCourseFeesAndPenalties += round2(semDue + semPenalty);
          dynamicSumPaid += round2(s.amount_paid || 0);
        });

        totalCourseFeesAndPenalties = round2(totalCourseFeesAndPenalties);
        dynamicSumPaid = round2(dynamicSumPaid);

        const finalAmountPaid = round2(dynamicSumPaid + tempAdvance); 
        const overallPending = round2(Math.max(0, totalCourseFeesAndPenalties - dynamicSumPaid));

        bulkOperations.push({
          updateOne: {
            filter: { student_id: new mongoose.Types.ObjectId(record.student_id.toString()) },
            update: {
              $set: {
                session: studentSession,
                semesters: targetSemesters,
                classesHistory: targetHistory,
                advance_balance: tempAdvance,
                total_course_fees: totalCourseFeesAndPenalties,
                total_amount_paid: finalAmountPaid,
                overall_pending_balance: overallPending
              }
            }
          }
        });
      }
    }

    if (bulkOperations.length > 0) {
      await FeeLedger.bulkWrite(bulkOperations, { session: dbSession });
    }

    await dbSession.commitTransaction();
    req.flash("success", "🎉 Success! Batch fee structure saved cleanly.");
    return res.redirect("/add/student/fees");

  } catch (dbError) {
    await dbSession.abortTransaction();
    req.flash("error", `❌ Database Refused: ${dbError.message}`);
    return res.redirect(`/add/student/fees?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}`);
  } finally {
    dbSession.endSession();
  }  
}));












app.post("/fees/process-bulk-payments", verifiedAny, validateBulkPayments, WrapAsync(async (req, res) => {
  const { payments, semA, semB, className, section, modeSelection, submitToken, academicYear } = req.body;
  if (!className || !payments || !Array.isArray(payments) || payments.length === 0 || !section || !academicYear || !semA || !modeSelection) {
    req.flash("error", "⚠️ Security Error: Crucial input parameters are missing!");
    return res.redirect("/fees/collect-bulk");
  }

  const sA = parseInt(semA);
  const sB = semB ? parseInt(semB) : null;
  const targetYear = parseInt(academicYear);

  // Strict Token Validation Check
  if (!req.session.lastFeeSubmitToken || req.session.lastFeeSubmitToken !== submitToken) {
    req.flash("error", "⚠️ Duplicate Transaction Prevented! Fresh Token required.");
    return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);
  }

  // Clear Token Immediately to prevent concurrency double-clicks
  req.session.lastFeeSubmitToken = null;

  const session = await mongoose.startSession();
  session.startTransaction();

  try {
    const studentIds = payments.map(p => p.student_id).filter(Boolean);
    const existingLedgers = await FeeLedger.find({ student_id: { $in: studentIds } }).session(session);
    const ledgerMap = new Map(existingLedgers.map(l => [l.student_id.toString(), l]));

    const bulkOperations = [];
    const transactionRecords = [];

    // Counter for guaranteeing bulletproof unique receipt sequence in the same millisecond loop
    let receiptCounter = 0;

    for (let payRow of payments) {
      if (payRow.status === "Left College") continue;

      let rawCashPaid = round2(parseFloat(payRow.amountToPay) || 0);
      let runtimeAllocation = rawCashPaid;
      
      let ledger = ledgerMap.get(payRow.student_id.toString());
      if (!ledger) throw new Error(`Student ledger not found for ID: ${payRow.student_id}`);

      let targetSemesters = [...(ledger.semesters || [])];
      targetSemesters.sort((a, b) => a.semNumber - b.semNumber);

      let currentAdvance = round2(ledger.advance_balance || 0);
      let initialAdvanceUsed = currentAdvance;
      
      let receiptBreakdown = [];

      // STAGE 1: Process current wallet advance balance across chronological timelines
      if (currentAdvance > 0) {
        for (let sItem of targetSemesters) {
          // ⚡ FIX: Total Demand = Due Amount + Penalty Amount
          let semPenalty = round2(sItem.penalty_amount || sItem.penalty || 0);
          let totalSemDemand = round2((sItem.due_amount || 0) + semPenalty);
          let historyPending = round2(Math.max(0, totalSemDemand - (sItem.amount_paid || 0)));

          if (historyPending > 0 && currentAdvance > 0) {
            let absorb = round2(Math.min(currentAdvance, historyPending));
            sItem.amount_paid = round2((sItem.amount_paid || 0) + absorb);
            
            // Recalculate Balance Pending including Penalty
            sItem.balance_pending = round2(Math.max(0, totalSemDemand - sItem.amount_paid));
            currentAdvance = round2(currentAdvance - absorb);
            
            receiptBreakdown.push({ semNumber: sItem.semNumber, amount: absorb, source: "Wallet Adjustment" });
          }
        }
      }

      // STAGE 2: Allocate fresh liquid incoming cash
      if (runtimeAllocation > 0) {
        for (let sItem of targetSemesters) {
          // ⚡ FIX: Total Demand = Due Amount + Penalty Amount
          let semPenalty = round2(sItem.penalty_amount || sItem.penalty || 0);
          let totalSemDemand = round2((sItem.due_amount || 0) + semPenalty);
          let pendingDues = round2(Math.max(0, totalSemDemand - (sItem.amount_paid || 0)));

          if (pendingDues > 0 && runtimeAllocation > 0) {
            let absorbCash = round2(Math.min(runtimeAllocation, pendingDues));
            sItem.amount_paid = round2((sItem.amount_paid || 0) + absorbCash);
            
            // Recalculate Balance Pending including Penalty
            sItem.balance_pending = round2(Math.max(0, totalSemDemand - sItem.amount_paid));
            runtimeAllocation = round2(runtimeAllocation - absorbCash);

            receiptBreakdown.push({ semNumber: sItem.semNumber, amount: absorbCash, source: "Liquid Cash" });
          }
        }

        // STAGE 3: Turn remaining extra cash into Wallet Advance Balance
        if (runtimeAllocation > 0) {
          currentAdvance = round2(currentAdvance + runtimeAllocation);
          receiptBreakdown.push({ semNumber: sB || sA, amount: runtimeAllocation, source: "Advance Spillover Saved" });
        }
      }

      // ⚡ RECONCILED ACCOUNTING FORMULA:
      // Total Paid = Sum of all semesters paid + unconsumed active advance in wallet
      const dynamicSumPaid = round2(targetSemesters.reduce((sum, s) => sum + (s.amount_paid || 0), 0));
      const overallAmountPaid = round2(dynamicSumPaid + currentAdvance);
      
      // ⚡ RECONCILED OVERALL DEMAND & BALANCE FORMULA:
      // Overall Fee Demand = Sum of (due_amount + penalty_amount) of all semesters
      const totalCourseFeesWithPenalty = round2(targetSemesters.reduce((sum, s) => {
        return sum + (s.due_amount || 0) + (s.penalty_amount || s.penalty || 0);
      }, 0));

      const compositePendingBalance = round2(Math.max(0, totalCourseFeesWithPenalty - dynamicSumPaid));

      const advanceAbsorbed = round2(initialAdvanceUsed - currentAdvance);

      // Create Transaction Receipt only if real cash came in OR advance was consumed
      if (rawCashPaid > 0 || advanceAbsorbed > 0) {
        receiptCounter++;
        // Bulletproof Receipt Number (Timestamp + Nanoseconds Sequence + Crypto Rand)
        const uniqueReceiptNo = `REC-${Date.now()}-${receiptCounter}-${crypto.randomBytes(3).toString('hex').toUpperCase()}`;

        transactionRecords.push({
          receiptNumber: uniqueReceiptNo,
          student_id: payRow.student_id,
          rollNumber: payRow.rollNumber,
          academicYear: targetYear,
          studentName: payRow.studentName,
          fatherName: ledger.fatherName,
          semNumber: sA, 
          amountPaid: rawCashPaid, 
          paymentMode: payRow.paymentMode || "Cash",
          metadata: {
            breakdown: receiptBreakdown,
            walletAdvanceSubtracted: advanceAbsorbed,
            retainedWalletAdvance: currentAdvance
          }
        });
      }

      bulkOperations.push({
        updateOne: {
          filter: { student_id: payRow.student_id },
          update: {
            $set: {
              semesters: targetSemesters,
              advance_balance: currentAdvance,
              total_amount_paid: overallAmountPaid,
              overall_pending_balance: compositePendingBalance
            }
          }
        }
      });
    }

    if (bulkOperations.length > 0) {
      if (transactionRecords.length > 0) {
        await FeeTransaction.insertMany(transactionRecords, { session });
      }
      await FeeLedger.bulkWrite(bulkOperations, { session });
    }

    await session.commitTransaction();
    req.flash("success", "🚀 Complete Ledger Sequence synced successfully with Single Token Clean Receipts.");
    return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);

  } catch (error) {
    await session.abortTransaction();
    req.flash("error", `Error encountered during batch sequence processing: ${error.message}`);
    return res.redirect(`/fees/collect-bulk?className=${encodeURIComponent(className)}&semester=${sA}&section=${encodeURIComponent(section)}&academicYear=${academicYear}&modeSelection=${modeSelection}`);
  } finally {
    // Memory leak protection
    session.endSession();
  }
}));

      <% layout("/layouts/boilerplate") -%>

<div class="container my-5">
  <h2 class="mb-4 text-dark fw-bold border-bottom pb-2">📦 Unified Batch Fee Collection (Live Ledger Sync)</h2>

  <!-- HIDDEN METADATA FOR JAVASCRIPT -->
  <input type="hidden" id="metadataClassName" value="<%= (query && query.className) ? query.className : '' %>">
  <input type="hidden" id="metadataSemester" value="<%= (query && query.semester) ? query.semester : '' %>">

  <!-- SEARCH CONTROLS FRAMEWORK -->
  <div class="card p-4 shadow-sm mb-4 bg-white border-0">
    <form action="/fees/collect-bulk" method="GET" class="row g-3 align-items-end needs-validation" novalidate id="filterForm">
      
      <!-- Class Selection Dropdown -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Class / Branch</label>
        <select name="className" id="classSelect" class="form-select" required onchange="syncSemesterDropdown()">
          <option value="">Select branch...</option>
          <% if (typeof classData !== 'undefined' && classData) { %>
            <% classData.forEach(c => { %>
              <option value="<%= c.class %>" <%= (query && query.className === c.class) ? 'selected' : '' %>><%= c.class %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Target Semester -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Semester</label>
        <select name="semester" id="semesterSelect" class="form-select" required onchange="syncTimelineScope()">
          <option value="">Select...</option>
          <% for(let i=1; i<=8; i++) { %>
            <option value="<%= i %>" <%= (query && query.semester == i) ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <!-- Section Selection -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Section</label>
        <select name="section" class="form-select" required>
          <option value="">Select...</option>
          <% if (typeof sectionData !== 'undefined' && sectionData) { %>
            <% sectionData.forEach(s => { %>
              <option value="<%= s.name %>" <%= (query && query.section === s.name) ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- DYNAMIC ACADEMIC YEAR INPUT WITH DATALIST -->
      <div class="col-md-2">
        <label for="academicYear" class="form-label fw-bold text-secondary">📅 Academic Year</label>
        <input 
          type="number" 
          placeholder="Session" 
          name="academicYear" 
          id="academicYear"
          class="form-select fw-bold" 
          value="<%= (query && query.academicYear) ? query.academicYear : '' %>"
          required 
          list="yearOptionsList"
        >
        <datalist id="yearOptionsList">
          <% if (typeof academicYearsList !== 'undefined' && academicYearsList.length > 0) { %>
            <% academicYearsList.forEach(year => { %>
              <option value="<%= year %>"><%= year %></option>
            <% }) %>
          <% } %>
        </datalist>
      </div>

      <!-- Timeline Scope Mode -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Timeline Scope</label>
        <select name="modeSelection" id="timelineSelect" class="form-select" required>
          <option value="single" <%= (query && query.modeSelection === 'single') ? 'selected' : '' %>>Current Sem</option>
          <option value="next" <%= (query && query.modeSelection === 'next') ? 'selected' : '' %>>Next Sem</option>
          <option value="both" <%= (query && query.modeSelection === 'both') ? 'selected' : '' %>>Both Sem</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div class="col-md-2">
        <button type="submit" class="btn w-100 fw-bold text-white py-2 shadow-sm" style="background-color: #0f766e;">Load Batch</button>
      </div>
    </form>
  </div>

  <% if (typeof students !== 'undefined' && students && students.length > 0) { %>

    <!-- MASTER CONTROL TOOLKIT -->
    <div class="card p-4 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <h5 class="fw-bold mb-3 border-bottom pb-2 text-warning">⚡ Core Automation Control Toolkit</h5>
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">1. OUTSTANDING INJECTOR</label>
          <button type="button" onclick="executeGlobalDuesClearance()" class="btn btn-warning w-100 fw-bold shadow-sm">
            Inject All Net Pending Dues
          </button>
        </div>
        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">2. CUSTOM VALUE MULTI-INJECTOR</label>
          <div class="input-group">
            <input type="number" id="globalCustomValueInput" min="0" step="0.01" class="form-control" placeholder="Enter custom amount...">
