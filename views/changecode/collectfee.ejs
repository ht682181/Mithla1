            </div>

            <div class="col-md-4 border-end border-secondary">
              <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Semester <%= activeSemesters[0] %> Collection</p>
              <h3 class="fw-bold text-info" id="grandSemATotal">₹0</h3>
            </div>

            <div class="col-md-4">
              <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Semester <%= activeSemesters[1] %> Collection</p>
              <h3 class="fw-bold text-info" id="grandSemBTotal">₹0</h3>
            </div>

          </div>
