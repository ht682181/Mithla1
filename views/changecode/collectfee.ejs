    <!-- MAIN STUDENT LEDGER MATRIX FORM -->
    <form action="/fees/save-bulk-ledger" method="POST" id="ledgerGridForm" onsubmit="return validateGridForm()" class="needs-validation" novalidate>
      <input type="hidden" name="semA" value="<%= activeSemesters[0] %>">
