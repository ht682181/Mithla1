      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="fw-bold text-muted ms-2 small text-uppercase">
          <i class="fa-solid fa-compass me-1"></i> Jump To Section:
        </span>
        <div class="d-flex gap-2">
          <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
            <button type="button" class="btn btn-dark fw-bold btn-sm px-3" onclick="scrollToSec('SEC_BLOCK_<%= sec %>')">
              🚩 Section <%= sec %>
            </button>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- 📦 ITERATE SECTIONS -->
    <% Object.keys(sectionwiseData).sort().forEach(sec => { %>
      <% const secInfo = sectionwiseData[sec]; %>
      <% const secSummary = secInfo.summary; %>
      <% const secStudents = secInfo.students; %>
      <% const yrData = secInfo.yearlyBreakdown; %>

      <div id="SEC_BLOCK_<%= sec %>" class="mb-5 pt-3 border-top">
        
        <!-- SUMMARY DASHBOARD CARDS -->
        <div class="mb-3">
          <h5 class="fw-bold text-dark mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><span class="badge bg-primary fs-6 me-1">Section <%= sec %></span> Summary Dashboard</span>
            <span class="badge bg-success fs-6 fw-bold">Section Total Collected: ₹<%= (secSummary.totalCollected || 0).toLocaleString('en-IN') %></span>
          </h5>
          <div class="row g-2">
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card bg-white">
                <span class="text-muted small fw-bold text-uppercase">Total Demand</span>
                <h4 class="fw-bold text-dark mb-0 mt-1">₹<%= (secSummary.totalFee || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-success bg-white">
                <span class="text-muted small fw-bold text-uppercase">Collected</span>
                <h4 class="fw-bold text-success mb-0 mt-1">₹<%= (secSummary.totalPaid || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-warning bg-white">
                <span class="text-muted small fw-bold text-uppercase">⚠️ Total Penalty</span>
                <h4 class="fw-bold text-warning mb-0 mt-1">₹<%= (secSummary.totalPenalty || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-2 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-info bg-white">
                <span class="text-muted small fw-bold text-uppercase">Advance</span>
                <h4 class="fw-bold text-info mb-0 mt-1">₹<%= (secSummary.totalAdvance || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="card shadow-sm border-0 p-3 stat-card stat-card-danger bg-white">
                <span class="text-muted small fw-bold text-uppercase">Net Pending</span>
                <h4 class="fw-bold text-danger mb-0 mt-1">₹<%= (secSummary.netPending || 0).toLocaleString('en-IN') %></h4>
              </div>
            </div>
          </div>
        </div>

        <!-- OVERVIEW BAR (YEAR-WISE SPLIT) -->
        <div class="card bg-light border-0 shadow-sm p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold m-0 text-dark">
              <span class="badge bg-dark me-1"><%= selectedBaseCourse %></span> Section <%= sec %> Overview (Year-wise Split)
            </h5>
          </div>
          <div class="row g-2 text-center">
            <% ["1ST YEAR", "2ND YEAR", "3RD YEAR", "4TH YEAR"].forEach(yTag => { %>
              <% const yMetrics = yrData[yTag]; %>
              <% if (yMetrics && (yMetrics.demand > 0 || yMetrics.paid > 0)) { %>
                <div class="col-md-3">
                  <div class="bg-white p-2 rounded border shadow-sm">
                    <span class="fw-bold text-primary border-bottom d-block mb-1"><%= yTag %></span>
                    <div class="d-flex justify-content-between px-2 small">
                      <span>Demand: <b>₹<%= yMetrics.demand.toLocaleString('en-IN') %></b></span>
                      <span class="text-success">Paid: <b>₹<%= yMetrics.paid.toLocaleString('en-IN') %></b></span>
                    </div>
                    <div class="d-flex justify-content-between px-2 small mt-1">
                      <span class="text-warning">Fine: <b>₹<%= yMetrics.penalty.toLocaleString('en-IN') %></b></span>
                      <span class="text-danger">Pending: <b>₹<%= yMetrics.pending.toLocaleString('en-IN') %></b></span>
                    </div>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>

        <!-- SECTION ACTION BAR -->
        <div class="card bg-dark text-white p-3 mb-3 shadow-sm border-0">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
              <div class="form-check m-0 ms-1">
                <input type="checkbox" class="form-check-input sec-master-cb" data-sec="<%= sec %>" id="masterSelect_<%= sec %>" style="transform: scale(1.2); cursor: pointer;">
                <label class="form-check-label fw-bold text-light ms-1" for="masterSelect_<%= sec %>" style="cursor: pointer;">Select All Section <%= sec %></label>
              </div>
              <span class="badge bg-warning text-dark fw-bold px-3 py-2" id="counter_<%= sec %>">0 Selected</span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button class="btn btn-warning btn-sm fw-bold px-3" onclick="togglePenaltyDrawer('<%= sec %>')">
                ⚠️ Add Penalty (Sec <%= sec %>)
              </button>
              <button class="btn btn-outline-light btn-sm fw-bold px-3" onclick="openBulkModal('<%= sec %>')">
                ✏️ Edit Structure (Bulk)
              </button>
              <button class="btn btn-outline-danger btn-sm fw-bold px-3" onclick="handleBulkDeleteStructure('<%= sec %>')">
                🗑️ Delete Structure
              </button>
              <button class="btn btn-outline-warning btn-sm fw-bold px-3" onclick="handleBulkWipePayments('<%= sec %>')">
                ⚠️ Wipe Payments
              </button>
            </div>
          </div>

          <!-- PENALTY DRAWER -->
          <div id="penaltyDrawer_<%= sec %>" class="bg-light p-3 mt-3 text-dark rounded d-none">
            <div class="row align-items-center g-2">
              <div class="col-md-3">
                <label class="fw-bold small mb-1">Target Semester:</label>
                <select id="penaltySem_<%= sec %>" class="form-select form-select-sm fw-bold">
                  <option value="1">Semester 1</option>
                  <option value="2">Semester 2</option>
                  <option value="3">Semester 3</option>
                  <option value="4">Semester 4</option>
                  <option value="5">Semester 5</option>
                  <option value="6">Semester 6</option>
                  <option value="7">Semester 7</option>
                  <option value="8">Semester 8</option>
                </select>
              </div>
              <div class="col-md-6">
                <span class="small text-muted fw-bold">Penalty enter karke "Save Penalties" par click karein.</span>
              </div>
              <div class="col-md-3 text-end">
                <button type="button" class="btn btn-success btn-sm fw-bold px-4" onclick="saveSectionPenalties('<%= sec %>', event)">
                  💾 Save Penalties
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- SEARCH & UNPAID PDF FILTER BAR -->
        <div class="card p-3 bg-white mb-3 shadow-sm border">
          <div class="row g-2 align-items-center">
            <div class="col-md-4">
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control fw-bold" id="searchInp_<%= sec %>" placeholder="Search Student Name / Roll No..." onkeyup="filterSectionTable('<%= sec %>')">
              </div>
            </div>

            <div class="col-md-6">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold small text-muted">Unpaid Fee Sem Filter:</span>
                <% [1,2,3,4,5,6,7,8].forEach(sNum => { %>
                  <div class="form-check form-check-inline m-0">
                    <input class="form-check-input sem-filter-cb-<%= sec %>" type="checkbox" value="<%= sNum %>" id="sem_<%= sec %>_<%= sNum %>" onchange="filterSectionTable('<%= sec %>')">
                    <label class="form-check-label small fw-bold" for="sem_<%= sec %>_<%= sNum %>">Sem <%= sNum %></label>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="col-md-2 text-end">
              <button class="btn btn-danger btn-sm fw-bold w-100" onclick="exportRouteUnpaidPDF('<%= sec %>')">
                <i class="fa-solid fa-file-pdf me-1"></i> Download PDF
              </button>
            </div>
          </div>
        </div>

        <!-- UNIFIED TABLE -->
        <div class="card shadow-sm border">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-bordered table-striped table-hover align-middle text-center table-fixed-layout mb-0" id="table_<%= sec %>">
                <thead class="table-dark">
                  <tr>
                    <th style="width: 40px;">#</th>
                    <th style="width: 110px;">Roll No</th>
                    <th class="text-start" style="width: 200px;">Student Details</th>
                    <th class="text-start" style="width: 40%;">Semesters, Dues & Penalty</th>
                    <th style="width: 25%;">Total Paid, Advance, Balance & Receipts</th>
                    <th class="action-col">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% secStudents.forEach((student) => { %>
                    <tr class="student-row-<%= sec %>" 
                        data-name="<%= (student.studentName || '').toLowerCase() %>" 
                        data-roll="<%= (student.rollNumber || '').toString().toLowerCase() %>">
                      <td>
                        <input type="checkbox" class="form-check-input student-cb-<%= sec %>" value="<%= student._id %>" onchange="updateSectionCount('<%= sec %>')">
                      </td>
                      <td class="fw-bold text-dark"><%= student.rollNumber %></td>
                      <td class="text-start">
                        <div class="fw-bold text-primary"><%= student.studentName %></div>
                        <small class="text-muted"><i class="fa-solid fa-user-group me-1"></i><%= student.fatherName || 'N/A' %></small>
                      </td>
                      
                      <!-- Semesters & Dues Row -->
                      <td class="text-start">
                        <% if (student.semesters && student.semesters.length > 0) { %>
                          <% student.semesters.forEach(sem => { %>
                            <% const penAmt = sem.penalty_amount || sem.penalty || 0; %>
                            <% const paidAmt = sem.amount_paid || 0; %>
                            <div class="sem-due-badge border bg-light mb-1 d-flex justify-content-between align-items-center" data-semnum="<%= sem.semNumber %>" data-sempending="<%= sem.calculated_pending %>">
                              <div>
                                <span class="badge bg-secondary me-1">Sem <%= sem.semNumber %></span>
                                <span class="fw-bold">Due: ₹<%= (sem.due_amount || 0).toLocaleString('en-IN') %></span>
                                <% if (penAmt > 0) { %>
                                  <span class="badge bg-danger ms-1 d-inline-flex align-items-center gap-1">
                                    +Fine: ₹<%= penAmt %>
                                    
                                    <!-- 🛑 SAFE DATA-ATTRIBUTE PENALTY REMOVE BUTTON -->
                                    <button type="button" 
                                            class="btn btn-dark text-white btn-remove-penalty ms-1" 
                                            title="Remove Penalty"
                                            data-studentid="<%= student._id %>"
                                            data-semnum="<%= sem.semNumber %>"
                                            data-paidamt="<%= paidAmt %>"
                                            onclick="handlePenaltyClick(this)">
                                      &times;
                                    </button>
                                  </span>
                                <% } %>
                              </div>
                              <span class="small text-muted">(Paid: ₹<%= paidAmt.toLocaleString('en-IN') %>)</span>
                            </div>
                          <% }); %>
                        <% } else { %>
                          <span class="text-muted small">No Structure Added</span>
                        <% } %>

                        <!-- Dynamic Penalty Input -->
                        <div class="penalty-input-box-<%= sec %> d-none mt-2">
                          <input type="number" 
                                 class="form-control form-control-sm border-danger penalty-val-<%= sec %>" 
                                 data-studentid="<%= student._id %>" 
                                 placeholder="Enter Penalty ₹" 
                                 min="0">
                        </div>
                      </td>

                      <!-- COMBINED COLUMN -->
                      <td>
                        <div class="fw-bold text-success fs-6">
                          Paid: ₹<%= (student.total_allocated_paid || 0).toLocaleString('en-IN') %>
                        </div>

                        <% if (student.advance_balance && student.advance_balance > 0) { %>
                          <div class="mt-1">
                            <span class="badge bg-info-subtle text-info border border-info px-2 py-1" style="font-size: 0.75rem;">
                              ⚡ Advance: ₹<%= student.advance_balance.toLocaleString('en-IN') %>
                            </span>
                          </div>
                        <% } %>

                        <div class="mt-1 fw-bold <%= student.overall_pending_balance > 0 ? 'text-danger' : 'text-success' %>" style="font-size: 0.9rem;">
                          Pending: ₹<%= (student.overall_pending_balance || 0).toLocaleString('en-IN') %>
                        </div>

                        <div class="mt-1">
                          <% if (student.paymentHistory && student.paymentHistory.length > 0) { %>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary border-0 p-0 fw-bold small text-decoration-underline" 
                                    data-stname="<%= student.studentName %>"
                                    data-stroll="<%= student.rollNumber %>"
                                    data-txs="<%= encodeURIComponent(JSON.stringify(student.paymentHistory)) %>"
                                    onclick="openReceiptsModal(this)">
                              <i class="fa-solid fa-receipt me-1"></i>Receipts (<%= student.paymentHistory.length %>)
                            </button>
                          <% } else { %>
                            <span class="text-muted small" style="font-size: 0.75rem;">No Receipts</span>
                          <% } %>
                        </div>

                        <!-- TOTAL PAID AMOUNT -->
                        <div class="mt-2 pt-1 border-top">
                          <span class="badge bg-dark text-warning border border-warning px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                            💰 Total Paid Amount: ₹<%= (student.total_amount_paid || 0).toLocaleString('en-IN') %>
                          </span>
                        </div>
                      </td>

                      <!-- Actions Column -->
                      <td>
                        <div class="d-flex flex-column gap-1">
                          <div class="btn-group btn-group-sm w-100">
                            <button class="btn btn-outline-primary fw-bold" onclick="editSingleStructure('<%= student._id %>')">✏️ Struct</button>
                            <button class="btn btn-outline-danger" onclick="deleteSingleStructure('<%= student._id %>')">🗑️</button>
                          </div>
                          <div class="btn-group btn-group-sm w-100">
                            <button class="btn btn-outline-success fw-bold" onclick="editSinglePayment('<%= student._id %>')">💳 Paid</button>
                            <button class="btn btn-outline-warning text-dark" onclick="deleteSinglePayment('<%= student._id %>')">🗑️</button>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    <% }); %>

  <% } else { %>
    <div class="card p-5 text-center text-muted shadow-sm border border-dashed">
      <h5 class="fw-bold mb-1 text-dark">Welcome to Fee Dashboard</h5>
      <p class="m-0 small">Select Course and Batch Session above to load Section-wise data.</p>
    </div>
  <% } %>

</div>

<!-- RECEIPT PASSBOOK MODAL -->
<div class="modal fade" id="receiptsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-receipt me-2 text-warning"></i>Payment Receipts
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="bg-light p-3 rounded mb-3 border d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0 text-dark" id="modalStudentName">--</h6>
            <small class="text-muted">Roll No: <span id="modalRollNo" class="fw-bold text-primary">--</span></small>
          </div>
          <span class="badge bg-primary px-3 py-2" id="modalReceiptCount">0 Receipts</span>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle text-center mb-0">
            <thead class="table-dark">
              <tr>
                <th>Receipt No</th>
                <th>Date</th>
                <th>Sem</th>
                <th>Amount Paid</th>
                <th>Mode</th>
              </tr>
            </thead>
            <tbody id="receiptsTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ✏️ EDIT STRUCTURE MODAL (Single & Bulk) -->
<div class="modal fade" id="editStructureModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-pen-to-square me-2"></i>Edit Fee Structure
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="structTargetStudentId">
        <input type="hidden" id="structTargetSection">
        <input type="hidden" id="structIsBulk" value="false">

        <div class="alert alert-info small fw-bold">
          <i class="fa-solid fa-circle-info me-1"></i>
          Note: Structure amount cannot be reduced lower than the already collected fees.
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold small">Select Semester:</label>
          <select id="structSemSelect" class="form-select fw-bold">
            <option value="1">Semester 1</option>
            <option value="2">Semester 2</option>
            <option value="3">Semester 3</option>
            <option value="4">Semester 4</option>
            <option value="5">Semester 5</option>
            <option value="6">Semester 6</option>
            <option value="7">Semester 7</option>
            <option value="8">Semester 8</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold small">New Base Fee Amount (₹):</label>
          <input type="number" id="structNewAmount" class="form-control fw-bold fs-5" placeholder="e.g. 45000" min="0">
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary fw-bold px-4" id="btnSaveStructure" onclick="submitStructureEdit()">
          💾 Update Structure
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 💳 EDIT PAYMENT / RECEIPT MODAL -->
<div class="modal fade" id="editPaymentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-credit-card me-2"></i>Edit Student Payment & Ledger
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="payStudentId">

        <div class="bg-light p-3 rounded mb-3 border">
          <div class="row align-items-center">
            <div class="col-md-6">
              <span class="text-muted small d-block">Student Name:</span>
              <strong class="text-dark fs-6" id="payModalStName">--</strong>
            </div>
            <div class="col-md-6 text-md-end">
              <span class="text-muted small d-block">Roll Number:</span>
              <strong class="text-primary fs-6" id="payModalStRoll">--</strong>
            </div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-bold small">Target Semester:</label>
            <select id="paySemSelect" class="form-select fw-bold">
              <option value="1">Semester 1</option>
              <option value="2">Semester 2</option>
              <option value="3">Semester 3</option>
              <option value="4">Semester 4</option>
              <option value="5">Semester 5</option>
              <option value="6">Semester 6</option>
              <option value="7">Semester 7</option>
              <option value="8">Semester 8</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-bold small">Receipt / Txn Number:</label>
            <input type="text" id="payReceiptNo" class="form-control fw-bold" placeholder="REC-10293">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-bold small">Paid Amount (₹):</label>
            <input type="number" id="payAmount" class="form-control fw-bold text-success fs-5" placeholder="e.g. 25000" min="0">
          </div>

          <div class="col-md-6">
            <label class="form-label fw-bold small">Payment Mode:</label>
            <select id="payMode" class="form-select fw-bold">
              <option value="Cash">Cash</option>
              <option value="Online / UPI">Online / UPI</option>
              <option value="Cheque">Cheque</option>
              <option value="DD">Demand Draft (DD)</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success fw-bold px-4" id="btnSavePayment" onclick="submitPaymentEdit()">
          💳 Save & Adjust Ledger
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // -------------------------------------------------------------
  // 1. STRUCTURE LOGIC (SINGLE & BULK EDIT/DELETE)
  // -------------------------------------------------------------

  // Single Edit Structure Trigger
  function editSingleStructure(studentId) {
    document.getElementById('structTargetStudentId').value = studentId;
    document.getElementById('structIsBulk').value = "false";
    document.getElementById('structNewAmount').value = "";
    
    const modal = new bootstrap.Modal(document.getElementById('editStructureModal'));
    modal.show();
  }

  // Bulk Edit Structure Trigger
  function openBulkModal(sec) {
    const selectedCBs = document.querySelectorAll(`.student-cb-${sec}:checked`);
    if (selectedCBs.length === 0) {
      return showToast("⚠️ Pehle kam se kam ek student select karein!", false);
    }

    document.getElementById('structTargetSection').value = sec;
    document.getElementById('structIsBulk').value = "true";
    document.getElementById('structNewAmount').value = "";

    const modal = new bootstrap.Modal(document.getElementById('editStructureModal'));
    modal.show();
  }

  // Submit Structure Edit (Single & Bulk)
  async function submitStructureEdit() {
    const isBulk = document.getElementById('structIsBulk').value === "true";
    const semNum = document.getElementById('structSemSelect').value;
    const newAmount = parseFloat(document.getElementById('structNewAmount').value);

    if (isNaN(newAmount) || newAmount < 0) {
      return showToast("⚠️ Valid fee amount daalein!", false);
    }

    let payload = {
      semNumber: semNum,
      newFeeAmount: newAmount,
      isBulk: isBulk
    };

    if (isBulk) {
      const sec = document.getElementById('structTargetSection').value;
      const studentIds = Array.from(document.querySelectorAll(`.student-cb-${sec}:checked`)).map(cb => cb.value);
      payload.studentIds = studentIds;
    } else {
      payload.studentId = document.getElementById('structTargetStudentId').value;
    }

    const btn = document.getElementById('btnSaveStructure');
    btn.disabled = true;
    btn.innerText = "⏳ Updating...";

    try {
      const response = await fetch('/update/fee/structure', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "🎉 Fee Structure Updated Successfully!", true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast("❌ Error: " + result.message, false);
        btn.disabled = false;
        btn.innerText = "💾 Update Structure";
      }
    } catch (err) {
      console.error("Structure Update Error:", err);
      showToast("❌ Server communication failed!", false);
      btn.disabled = false;
      btn.innerText = "💾 Update Structure";
    }
  }

  // Single Delete Structure
  async function deleteSingleStructure(studentId) {
    if (!confirm("⚠️ Kya aap is student ki un-paid Structure Demand delete karna chahte hain?")) return;

    try {
      const response = await fetch('/delete/fee/structure/single', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "🗑️ Structure Deleted Successfully!", true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast("🛑 Action Blocked: " + result.message, false);
      }
    } catch (err) {
      console.error("Single Structure Delete Error:", err);
      showToast("❌ Server communication failure!", false);
    }
  }

  // Bulk Delete Structure
  async function handleBulkDeleteStructure(sec) {
    const selectedCBs = document.querySelectorAll(`.student-cb-${sec}:checked`);
    if (selectedCBs.length === 0) {
      return showToast("⚠️ Select at least one student to delete structure!", false);
    }

    if (!confirm(`🛑 CRITICAL WARNING: Section ${sec} ke selected (${selectedCBs.length}) students ka Un-Paid Fee Structure DELETE kar rahe hain. Rule 1 apply hoga (Zero Paid candidates structure strictly reset ho jayenge). Continue?`)) return;

    const studentIds = Array.from(selectedCBs).map(cb => cb.value);

    try {
      const response = await fetch('/delete/fee/structure/bulk', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentIds })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "🗑️ Bulk Structure Deleted!", true);
        setTimeout(() => window.location.reload(), 1000000 );
      } else {
        showToast("🛑 Error: " + result.message, false);
      }
    } catch (err) {
      console.error("Bulk Structure Delete Error:", err);
      showToast("❌ Server communication failure!", false);
    }
  }


  // -------------------------------------------------------------
  // 2. PAYMENT / RECEIPT & LEDGER LOGIC (SINGLE & WIPE ROLLBACK)
  // -------------------------------------------------------------

  // Open Edit Payment Modal
  function editSinglePayment(studentId) {
    document.getElementById('payStudentId').value = studentId;

    // Fetch Student basic row data for display
    const row = document.querySelector(`input[value="${studentId}"]`)?.closest('tr');
    if (row) {
      const name = row.getAttribute('data-name')?.toUpperCase() || '--';
      const roll = row.getAttribute('data-roll')?.toUpperCase() || '--';
      document.getElementById('payModalStName').innerText = name;
      document.getElementById('payModalStRoll').innerText = roll;
    }

    document.getElementById('payAmount').value = "";
    document.getElementById('payReceiptNo').value = "";

    const modal = new bootstrap.Modal(document.getElementById('editPaymentModal'));
    modal.show();
  }

  // Submit Payment / Receipt
  async function submitPaymentEdit() {
    const studentId = document.getElementById('payStudentId').value;
    const semNumber = document.getElementById('paySemSelect').value;
    const receiptNumber = document.getElementById('payReceiptNo').value.trim();
    const amountPaid = parseFloat(document.getElementById('payAmount').value);
    const paymentMode = document.getElementById('payMode').value;

    if (isNaN(amountPaid) || amountPaid <= 0) {
      return showToast("⚠️ Valid positive amount enter karein!", false);
    }

    const btn = document.getElementById('btnSavePayment');
    btn.disabled = true;
    btn.innerText = "⏳ Adjusting Ledger...";

    try {
      const response = await fetch('/edit/fee/payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          studentId,
          semNumber,
          receiptNumber,
          amountPaid,
          paymentMode
        })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "💳 Payment saved & Ledger adjusted!", true);
        setTimeout(() => window.location.reload(), 100000);
      } else {
        showToast("❌ Error: " + result.message, false);
        btn.disabled = false;
        btn.innerText = "💳 Save & Adjust Ledger";
      }
    } catch (err) {
      console.error("Payment Edit Error:", err);
      showToast("❌ Server communication error!", false);
      btn.disabled = false;
      btn.innerText = "💳 Save & Adjust Ledger";
    }
  }

  // Delete / Wipe Single Student Payment (Rollback)
  async function deleteSinglePayment(studentId) {
    if (!confirm("🚨 DANGER ZONE: Kya aap is student ki SARI Jama Fees (Paid Receipts) KO WIPE / ROLLBACK karna chahte hain? Isse Pending Amount dobara full ho jayega!")) return;

    try {
      const response = await fetch('/wipe/fee/payment/single', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "⚠️ Payment Wiped & Ledger Rolled Back!", true);
        setTimeout(() => window.location.reload(), 100000);
      } else {
        showToast("❌ Error: " + result.message, false);
      }
    } catch (err) {
      console.error("Single Payment Wipe Error:", err);
      showToast("❌ Server communication error!", false);
    }
  }

  // Bulk Wipe Payments (Section Level)
  async function handleBulkWipePayments(sec) {
    const selectedCBs = document.querySelectorAll(`.student-cb-${sec}:checked`);
    if (selectedCBs.length === 0) {
      return showToast("⚠️ Pehle students select karein!", false);
    }

    if (!confirm(`🚨 EXTREME DANGER: Section ${sec} ke selected (${selectedCBs.length}) students ki SARI PAID RECEIPTS KO RESET / WIPE kiya ja raha hai. Kya aap sure hain?`)) return;

    const studentIds = Array.from(selectedCBs).map(cb => cb.value);

    try {
      const response = await fetch('/wipe/fee/payment/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentIds })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "⚠️ Bulk Payments Wiped Successfully!", true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast("❌ Error: " + result.message, false);
      }
    } catch (err) {
      console.error("Bulk Payment Wipe Error:", err);
      showToast("❌ Server communication failure!", false);
    }
  }



  // 🔔 CUSTOM DYNAMIC TOAST ALERT
  function showToast(message, isSuccess = true) {
    const toastEl = document.getElementById('dynamicToast');
    const msgEl = document.getElementById('toastMessage');
    
    msgEl.innerText = message;
    toastEl.className = `toast align-items-center text-white border-0 shadow ${isSuccess ? 'bg-success' : 'bg-danger'}`;
    
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
    toast.show();
  }

  function checkAndSubmitForm() {
    const classVal = document.getElementById('classSelector').value;
    const yearVal = document.getElementById('yearSelector').value;
    if (classVal && yearVal) {
      document.getElementById('feeFilterForm').submit();
    }
  }

  function scrollToSec(elementId) {
    const targetEl = document.getElementById(elementId);
    if (targetEl) {
      const yOffset = -70;
      const y = targetEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }
  }

  // Master Checkbox Logic
  document.querySelectorAll('.sec-master-cb').forEach(master => {
    master.addEventListener('change', function() {
      const sec = this.getAttribute('data-sec');
      document.querySelectorAll(`.student-cb-${sec}`).forEach(cb => cb.checked = this.checked);
      updateSectionCount(sec);
    });
  });

  function updateSectionCount(sec) {
    const selectedCount = document.querySelectorAll(`.student-cb-${sec}:checked`).length;
    const counterEl = document.getElementById(`counter_${sec}`);
    if (counterEl) counterEl.innerText = `${selectedCount} Selected`;
  }

  // Filter Section Table
  function filterSectionTable(sec) {
    const searchVal = document.getElementById(`searchInp_${sec}`).value.toLowerCase().trim().replace(/\s+/g, ' ');
    const checkedSems = Array.from(document.querySelectorAll(`.sem-filter-cb-${sec}:checked`)).map(cb => parseInt(cb.value));

    const rows = document.querySelectorAll(`.student-row-${sec}`);

    rows.forEach(row => {
      const name = (row.getAttribute('data-name') || '').replace(/\s+/g, ' ');
      const roll = (row.getAttribute('data-roll') || '').replace(/\s+/g, ' ');
      const matchesSearch = name.includes(searchVal) || roll.includes(searchVal);

      let matchesSem = true;
      if (checkedSems.length > 0) {
        matchesSem = false;
        const semBadges = row.querySelectorAll('.sem-due-badge');
        semBadges.forEach(badge => {
          const semNum = parseInt(badge.getAttribute('data-semnum'));
          const semPending = parseFloat(badge.getAttribute('data-sempending') || '0');
          if (checkedSems.includes(semNum) && semPending > 0) {
            matchesSem = true;
          }
        });
      }

      if (matchesSearch && matchesSem) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  function exportRouteUnpaidPDF(sec) {
    const baseCourse = "<%= selectedBaseCourse %>";
    const batchSession = "<%= selectedBatch %>";
    const checkedSems = Array.from(document.querySelectorAll(`.sem-filter-cb-${sec}:checked`)).map(cb => cb.value);

    let baseUrl = `${window.location.origin}/export/fee/unpaid-pdf`;
    let params = new URLSearchParams();

    params.append("baseCourse", baseCourse);
    params.append("batchSession", batchSession);
    params.append("section", sec);

    checkedSems.forEach(s => params.append("sem", s));

    window.location.href = `${baseUrl}?${params.toString()}`;
  }

  function togglePenaltyDrawer(sec) {
    document.getElementById(`penaltyDrawer_${sec}`).classList.toggle('d-none');
    document.querySelectorAll(`.penalty-input-box-${sec}`).forEach(box => box.classList.toggle('d-none'));
  }

  async function saveSectionPenalties(sec, event) {
    const semSelect = document.getElementById(`penaltySem_${sec}`);
    const semNum = semSelect ? semSelect.value : "1";
    
    const inputs = document.querySelectorAll(`.penalty-val-${sec}`);
    const payload = [];

    inputs.forEach(inp => {
      const val = parseFloat(inp.value);
      if (!isNaN(val) && val > 0) {
        payload.push({ 
          studentId: inp.getAttribute('data-studentid'), 
          penalty: val 
        });
      }
    });

    if (payload.length === 0) {
      return showToast("⚠️ No valid penalty amount (₹ > 0) was provided for any student.", false);
    }

    const btn = event.currentTarget || event.target;
    const originalTxt = btn.innerText;
    btn.innerText = "⏳ Saving...";
    btn.disabled = true;

    try {
      const response = await fetch('/add/fee/penalty', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetSem: semNum, penalties: payload })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "🎉 Penalties added successfully!", true);
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showToast("❌ Error: " + result.message, false);
        btn.innerText = originalTxt;
        btn.disabled = false;
      }
    } catch (err) {
      console.error("Penalty Add Error:", err);
      showToast("❌ Server connection issue!", false);
      btn.innerText = originalTxt;
      btn.disabled = false;
    }
  }

  // 🛑 SAFE HANDLER FOR PENALTY REMOVE BUTTON
  function handlePenaltyClick(btnEl) {
    const studentId = btnEl.getAttribute('data-studentid');
    const semNumber = btnEl.getAttribute('data-semnum');
    const paidAmount = parseFloat(btnEl.getAttribute('data-paidamt') || '0');

    if (!studentId || studentId === 'undefined' || studentId.trim() === '') {
      console.error("Missing or Invalid Student ID on Element:", btnEl);
      return showToast("❌ Error: Invalid Student ID! Please refresh the page.", false);
    }

    // Immediately disable button to prevent double clicks
    btnEl.disabled = true;
    btnEl.style.opacity = '0.5';

    removePenalty(studentId, semNumber, paidAmount, btnEl);
  }

  // 🛑 PENALTY REMOVE LOGIC WITH PAID FEES CHECK
  async function removePenalty(studentId, semNumber, paidAmount, btnEl) {
    if (!studentId || studentId === 'undefined') {
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      return showToast("❌ Invalid Student ID!", false);
    }

    if (paidAmount > 0) {
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      return showToast(`🚨 Cannot remove penalty! Fees (₹${paidAmount}) are already paid for Semester ${semNumber}.`, false);
    }

    try {
      const response = await fetch('/remove/fee/penalty', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, targetSem: semNumber })
      });

      const result = await response.json();

      if (result.success) {
        showToast(result.message || "✅ Penalty removed successfully!", true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast("❌ Error: " + result.message, false);
        if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
      }
    } catch (err) {
      console.error("Penalty Remove Error:", err);
      showToast("❌ Server communication failure!", false);
      if (btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
    }
  }

  function openReceiptsModal(btnEl) {
    const stName = btnEl.getAttribute('data-stname') || '--';
    const stRoll = btnEl.getAttribute('data-stroll') || '--';
    const txRaw = btnEl.getAttribute('data-txs');
    
    let transactions = [];
    try {
      if (txRaw) {
        transactions = JSON.parse(decodeURIComponent(txRaw));
      }
    } catch(err) {
      console.error("Receipt JSON Parsing Error:", err);
      showToast("⚠️ Could not load receipt history properly.", false);
    }

    document.getElementById('modalStudentName').innerText = stName;
    document.getElementById('modalRollNo').innerText = stRoll;
    document.getElementById('modalReceiptCount').innerText = `${transactions.length} Receipts`;

    const tbody = document.getElementById('receiptsTableBody');
    tbody.innerHTML = '';

    if (transactions && transactions.length > 0) {
      transactions.forEach(tx => {
        const dateStr = tx.paymentDate ? new Date(tx.paymentDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';
        tbody.innerHTML += `
          <tr>
            <td class="fw-bold text-primary">${tx.receiptNumber || 'N/A'}</td>
            <td class="small">${dateStr}</td>
            <td><span class="badge bg-secondary">Sem ${tx.semNumber || '-'}</span></td>
            <td class="fw-bold text-success">₹${(tx.amountPaid || 0).toLocaleString('en-IN')}</td>
            <td><span class="badge bg-info text-dark">${tx.paymentMode || 'Cash'}</span></td>
          </tr>
        `;
      });
    } else {
      tbody.innerHTML = `<tr><td colspan="5" class="text-muted p-3">No receipt transactions found.</td></tr>`;
    }

    new bootstrap.Modal(document.getElementById('receiptsModal')).show();
  }

  function editSingleStructure(id) { showToast("Edit Structure: " + id, true); }
  function deleteSingleStructure(id) { showToast("Deleted Structure: " + id, false); }
  function editSinglePayment(id) { showToast("Edit Payment: " + id, true); }
  function deleteSinglePayment(id) { showToast("Wiped Payment: " + id, false); }
</script>