                  <input type="hidden" name="fees[<%= index %>][fatherName]" value="<%= student.fatherName || 'N/A' %>">
                  <!-- ⚡ Hidden Session Passed Cleanly -->
                  <input type="hidden" name="fees[<%= index %>][session]" value="<%= student.session %>">
                  
                  <span class="badge bg-secondary fs-6"><%= student.rollNo %></span>
