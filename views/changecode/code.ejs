  </div>

  <script>

    // Is block ko apni script ke sabse upar ya script tag ke andar daal do
    if (!document.getElementById('custom-blink-styles')) {
      const style = document.createElement('style');
      style.id = 'custom-blink-styles';
      style.innerHTML = `
    @keyframes fastDangerBlink {
      0% { 
        opacity: 1; 
        box-shadow: 0 0 12px rgba(176, 42, 55, 0.6);
      }
      50% { 
        opacity: 0.25; /* Bhujega nahi, bas light ho jayega */
        box-shadow: 0 0 2px rgba(176, 42, 55, 0.1);
      }
      100% { 
        opacity: 1; 
        box-shadow: 0 0 12px rgba(176, 42, 55, 0.6);
      }
    }
    .pulse-danger-blink {
      animation: fastDangerBlink 1s infinite ease-in-out !important;
      
      /* Ekdam pakka, gahra laal solid rang (No bootstrap override) */
      background-color: #b02a37 !important; 
      border-color: #842029 !important;
      color: #ffffff !important; /* White text high contrast ke liye */
      
      /* Text bada aur mota karne ke liye styles */
      font-size: 1rem !important; /* Text ko bada kiya */
      font-weight: 900 !important; /* Text ko ekdam mota kiya */
      letter-spacing: 0.5px !important;
      padding: 10px 14px !important; /* Badge thoda bada aur premium lagega */
      display: inline-block !important;
    }
  `;
      document.head.appendChild(style);
    }

    function processRowLiveCalculations(inputElement) {
      const enteredAmount = parseFloat(inputElement.value) || 0;
      const row = inputElement.closest('tr');

      const dbAdvance = parseFloat(inputElement.getAttribute('data-db-advance')) || 0;
      const prevDues = parseFloat(inputElement.getAttribute('data-prev-dues')) || 0;
      const semADues = parseFloat(inputElement.getAttribute('data-sema-dues')) || 0;
      const semBDues = parseFloat(inputElement.getAttribute('data-semb-dues')) || 0;

      const totalOriginalDues = prevDues + semADues + semBDues;

      const statusBadge = row.querySelector('.live-status-badge');
      const projAdvanceBadge = row.querySelector('.projected-advance-badge');
      const projAdvanceVal = row.querySelector('.projected-advance-val');

      let workingCapital = enteredAmount + dbAdvance;
      let remainingDues = totalOriginalDues;

      if (workingCapital >= remainingDues) {
        const spilloverAdvance = workingCapital - remainingDues;
        statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-success text-white border border-success";
        statusBadge.innerHTML = "🎉 Fully Settled";

        if (spilloverAdvance > 0) {
          projAdvanceBadge.classList.remove('d-none');
          projAdvanceVal.innerText = spilloverAdvance;
        } else {
          projAdvanceBadge.classList.add('d-none');
        }
      }
      // else {
      //   const netPendingAfterPay = remainingDues - workingCapital;
      //   statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-warning-subtle text-warning border border-warning";
      //   statusBadge.innerHTML = `₹${netPendingAfterPay} - Balance Due after this payment`;
      //   projAdvanceBadge.classList.add('d-none');
      // }
      else {
        const netPendingAfterPay = remainingDues - workingCapital;
        // classes ko text-danger, border-danger aur pulse-warning-blink me change kiya hai
        statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-danger-subtle text-danger border border-danger pulse-danger-blink";
        statusBadge.innerHTML = `⚠️ ₹${netPendingAfterPay} - Balance Due after this payment`;
        projAdvanceBadge.classList.add('d-none');
      }

      calculateLiveDashboardMetrics();
    }

    function getRangeByClassName(name) {
      const upper = name.toUpperCase();
      if (upper.includes("1ST YEAR")) return [1, 2];
      if (upper.includes("2ND YEAR")) return [3, 4];
      if (upper.includes("3RD YEAR")) return [5, 6];
      if (upper.includes("4TH YEAR")) return [7, 8];
      return [1, 8];
    }

    function syncSemesterDropdown() {
      const classVal = document.getElementById('classSelect').value;
      const semesterSelect = document.getElementById('semesterSelect');
      if (!classVal) return;

      const range = getRangeByClassName(classVal);
      semesterSelect.innerHTML = '<option value="">Select...</option>';
      for (let i = range[0]; i <= range[1]; i++) {
        semesterSelect.innerHTML += `<option value="${i}">${i}</option>`;
      }
      syncTimelineScope();
    }

    function syncTimelineScope() {
      const classVal = document.getElementById('classSelect').value;
      const semVal = document.getElementById('semesterSelect').value;
      const timelineSelect = document.getElementById('timelineSelect');
      if (!classVal || !semVal) return;

      const range = getRangeByClassName(classVal);
      const currentSem = parseInt(semVal);
      const nextSem = (currentSem + 1 <= range[1]) ? currentSem + 1 : currentSem;

      timelineSelect.innerHTML = `
    <option value="single">Current Semester (Sem ${currentSem})</option>
    <option value="next">Next Current Semester (Sem ${nextSem})</option>
    <option value="both">Both Semesters of Current Year (Sem ${range[0]} & ${range[1]})</option>
  `;
    }

    function executeGlobalDuesClearance() {
      document.querySelectorAll('.payment-row-item').forEach(row => {
        const targetInput = row.querySelector('.input-amount-to-pay');
        if (targetInput) {
          const outstandingDues = parseFloat(targetInput.getAttribute('data-outstanding')) || 0;
          const dbAdvance = parseFloat(targetInput.getAttribute('data-db-advance')) || 0;

          const finalCollection = Math.max(0, outstandingDues - dbAdvance);
          targetInput.value = finalCollection;
          processRowLiveCalculations(targetInput);
        }
      });
    }

    function executeCustomAmountInjection() {
      const injectionVal = parseFloat(document.getElementById('globalCustomValueInput').value) || 0;
      if (injectionVal <= 0) {
        alert("Alert: Please enter a positive custom amount allocation.");
        return;
      }
      document.querySelectorAll('.payment-row-item').forEach(row => {
        const targetInput = row.querySelector('.input-amount-to-pay');
        if (targetInput) {
          targetInput.value = injectionVal;
          processRowLiveCalculations(targetInput);
        }
      });
    }

    // Fixed missing global payment override block
    function executeGlobalPaymentModeOverride(overrideValue) {
      if (!overrideValue) return;
      document.querySelectorAll('.select-row-payment-mode').forEach(dropdown => {
        if (!dropdown.disabled) {
          dropdown.value = overrideValue;
        }
      });
    }

    function calculateLiveDashboardMetrics() {
      let combinedAggregateCounter = 0;
      document.querySelectorAll('.input-amount-to-pay').forEach(input => {
        combinedAggregateCounter += (parseFloat(input.value) || 0);
      });
      const counterEl = document.getElementById('liveCollectionCounter');
      if (counterEl) {
        counterEl.innerText = '₹' + combinedAggregateCounter.toLocaleString('en-IN');
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      calculateLiveDashboardMetrics();

      const classInputEl = document.getElementById('metadataClassName');
      const semInputEl = document.getElementById('metadataSemester');

      const initialClass = classInputEl ? classInputEl.value : '';
      const initialSem = semInputEl ? semInputEl.value : '';

      if (initialClass && initialSem) {
        const range = getRangeByClassName(initialClass);
        const semesterSelect = document.getElementById('semesterSelect');
        if (semesterSelect) {
          semesterSelect.innerHTML = '';
          for (let i = range[0]; i <= range[1]; i++) {
            const selected = (i == initialSem) ? 'selected' : '';
            semesterSelect.innerHTML += `<option value="${i}" ${selected}>${i}</option>`;
          }
          syncTimelineScope();
        }
      }
    });
  </script>



<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
  <h2 class="mb-4 text-dark fw-bold border-bottom pb-2">📦 Unified Batch Fee Collection (Live Ledger Sync)</h2>

  <!-- HIDDEN METADATA FOR JAVASCRIPT (100% Safe Fallbacks) -->
  <input type="hidden" id="metadataClassName" value="<%= (query && query.className) ? query.className : '' %>">
  <input type="hidden" id="metadataSemester" value="<%= (query && query.semester) ? query.semester : '' %>">

  <!-- SEARCH CONTROLS FRAMEWORK -->
  <div class="card p-4 shadow-sm mb-4 bg-white border-0">
    <form action="/fees/collect-bulk" method="GET" class="row g-3 needs-validation" novalidate id="filterForm">

      <!-- Year Selection Dropdown -->
      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Class / Year Branch</label>
        <select name="className" id="classSelect" class="form-select" required onchange="syncSemesterDropdown()">
          <option value="">Select branch...</option>
          <% if (typeof classData !=='undefined' && classData) { %>
            <% classData.forEach(c=> { %>
              <option value="<%= c.class %>" <%=(query && query.className===c.class) ? 'selected' : '' %>><%= c.class %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Target Semester -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Target Semester</label>
        <select name="semester" id="semesterSelect" class="form-select" required onchange="syncTimelineScope()">
          <option value="">Select...</option>
          <% for(let i=1; i<=8; i++) { %>
            <option value="<%= i %>" <%=(query && query.semester==i) ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <!-- Section Selection -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Section</label>
        <select name="section" class="form-select" required>
          <option value="">Select section...</option>
          <% if (typeof sectionData !=='undefined' && sectionData) { %>
            <% sectionData.forEach(s=> { %>
              <option value="<%= s.name %>" <%=(query && query.section===s.name) ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Timeline Scope Mode -->
      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Timeline Scope Mode</label>
        <select name="modeSelection" id="timelineSelect" class="form-select" required>
          <option value="single" <%=(query && query.modeSelection==='single' ) ? 'selected' : '' %>>Current Semester</option>
          <option value="next" <%=(query && query.modeSelection==='next' ) ? 'selected' : '' %>>Next Current Semester</option>
          <option value="both" <%=(query && query.modeSelection==='both' ) ? 'selected' : '' %>>Both Semesters of Current Year</option>
        </select>
      </div>

      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn w-100 fw-bold text-white py-2 shadow-sm" style="background-color: #0f766e;">Load Batch Grid</button>
      </div>
    </form>
  </div>

  <% if (typeof students !=='undefined' && students && students.length> 0) { %>

    <!-- MASTER CONTROL TOOLKIT -->
    <div class="card p-4 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <h5 class="fw-bold mb-3 border-bottom pb-2 text-warning">⚡ Core Automation Control Toolkit</h5>
      <div class="row g-3 align-items-end">

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">1. OUTSTANDING INJECTOR</label>
          <button type="button" onclick="executeGlobalDuesClearance()" class="btn btn-warning w-100 fw-bold shadow-sm">
            Inject All Net Pending Dues
          </button>
        </div>

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">2. CUSTOM VALUE MULTI-INJECTOR</label>
          <div class="input-group">
            <input type="number" id="globalCustomValueInput" class="form-control" placeholder="Enter custom amount...">
            <button class="btn btn-dark fw-bold" type="button" onclick="executeCustomAmountInjection()">Inject Value</button>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">3. GLOBAL PAYMENT MODE OVERRIDE</label>
          <select id="globalPaymentModeSelector" class="form-select fw-bold" onchange="executeGlobalPaymentModeOverride(this.value)">
            <option value="">Select Mode Override...</option>
            <option value="Cash">Cash</option>
            <option value="UPI">UPI</option>
            <option value="Net Banking">Net Banking</option>
            <option value="Cheque">Cheque</option>
          </select>
        </div>

      </div>
    </div>

    <!-- DATA GRID FORM -->
    <form action="/fees/process-bulk-payments" method="POST" id="waterfallGridForm">
      <input type="hidden" name="semA" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %>">
      <input type="hidden" name="semB" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %>">
      <input type="hidden" name="className" value="<%= (query && query.className) ? query.className : '' %>">
      <input type="hidden" name="section" value="<%= (query && query.section) ? query.section : '' %>">
      <input type="hidden" name="modeSelection" value="<%= (query && query.modeSelection) ? query.modeSelection : '' %>">
      <input type="hidden" name="submitToken" value="<%= typeof submitToken !== 'undefined' ? submitToken : '' %>">

      <div class="table-responsive shadow rounded">
        <table class="table align-middle bg-white table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>Roll No</th>
              <th>Student Identity Meta</th>
              <th class="text-center text-warning bg-secondary">Prev Pending</th>
              <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !=='undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %> Dues</th>
              <% if(query && query.modeSelection==='both' ) { %>
                <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !=='undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %> Dues</th>
              <% } %>
              <th class="text-center" style="width: 25%;">Balance Settlement</th>
              <th class="text-center text-success" style="width: 18%;">Amount to Pay (₹)</th>
              <th style="width: 17%;">Payment Method</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach((student, index)=> { %>
              <tr class="payment-row-item <%= student.isLocked ? 'table-light opacity-75' : '' %>" data-index="<%= index %>">
                <td>
                  <input type="hidden" name="payments[<%= index %>][student_id]" value="<%= student.student_id %>">
                  <input type="hidden" name="payments[<%= index %>][rollNumber]" value="<%= student.rollNumber %>">
                  <input type="hidden" name="payments[<%= index %>][studentName]" value="<%= student.studentName %>">
                  <input type="hidden" name="payments[<%= index %>][status]" value="<%= student.status %>">
                  <span class="badge bg-dark fs-6"><%= student.rollNumber %></span>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= student.studentName %></div>
                  <small class="text-muted">F: <%= student.fatherName %></small>
                </td>

                <!-- Previous Pending Column -->
                <td class="text-center fw-semibold text-danger bg-light">
                  <span class="label-prev-pending">₹<%= student.previousPendingDues %></span>
                </td>

                <!-- Sem A Column -->
                <td class="text-center fw-semibold text-danger table-active">
                  <span class="label-sema-pending">₹<%= student.semA.pending %></span>
                </td>

                <!-- Sem B Column -->
                <% if(query && query.modeSelection==='both' ) { %>
                  <td class="text-center fw-semibold text-danger table-active">
                    <span class="label-semb-pending">₹<%= student.semB ? student.semB.pending : 0 %></span>
                  </td>
                <% } %>

                <!-- Dynamic Real-Time Settlement Box -->
                <td class="text-center bg-light">
                  <div class="d-flex flex-column gap-1 align-items-center justify-content-center ledger-status-container">
                    
                    <% if (student.originalAdvance > 0) { %>
                      <!-- Available Database Advance Balance -->
                      <div class="badge w-100 py-2 fs-7 shadow-sm border mb-1" style="background-color: #cff4fc !important; border-color: #b6effb !important; color: #055160 !important; display: inline-block !important;">
                        💎 ₹<span class="db-advance-val fw-bolder"><%= student.originalAdvance %></span> - Available Advance Balance
                      </div>
                    <% } %>

                    <!-- Live Calculation Status -->
                    <div class="live-status-badge badge w-100 py-2 fs-7 shadow-sm <%= student.isLocked ? 'bg-success-subtle text-success border border-success' : 'bg-warning-subtle text-warning border border-warning' %>">
                      <%= student.isLocked ? '🎉 Complete / Clear' : '⚠️ Pending: ₹' + student.totalYearDues %>
                    </div>

                    <!-- Projected Future Wallet Balance -->
                    <div class="projected-advance-badge badge w-100 py-2 fs-7 shadow-sm border d-none" style="background-color: #d1e7dd !important; border-color: #badbcc !important; color: #0f5132 !important;">
                      🚀 ₹<span class="projected-advance-val fw-bolder">0</span> - Projected Advance after this payment
                    </div>

                  </div>
                </td>

                <!-- Amount Input Matrix with New Reset Cross Icon Button -->
                <td>
                  <% if(student.isLocked) { %>
                    <div class="text-center">
                      <span class="badge bg-success py-2 px-3 shadow-sm rounded-pill">✔️ Cleared</span>
                    </div>
                    <input type="hidden" name="payments[<%= index %>][amountToPay]" value="0">
                  <% } else { %>
                    <div class="input-group shadow-sm rounded">
                      <input type="number" name="payments[<%= index %>][amountToPay]"
                        class="form-control text-center fw-bold input-amount-to-pay border-success text-success"
                        value="0" min="0" data-outstanding="<%= student.totalYearDues %>"
                        data-db-advance="<%= student.originalAdvance %>"
                        data-prev-dues="<%= student.previousPendingDues %>"
                        data-sema-dues="<%= student.semA.pending %>"
                        data-semb-dues="<%= student.semB ? student.semB.pending : 0 %>"
                        oninput="processRowLiveCalculations(this)">
                      <button class="btn btn-outline-danger border-success fw-bold reset-row-btn" type="button" onclick="resetRowToZero(this)" title="Clear payment row">✕</button>
                    </div>
                  <% } %>
                </td>

                <!-- Payment Method (Dynamic Enum Protection Safe Guard) -->
                <td>
                  <% if(student.isLocked) { %>
                    <input type="hidden" name="payments[<%= index %>][paymentMode]" value="Cash">
                    <select class="form-select form-select-sm fw-semibold select-row-payment-mode" disabled>
                      <option value="Cash" selected>Cash</option>
                    </select>
                  <% } else { %>
                    <!-- Fallback default selection prevents Enum mismatch at database layer if collection is 0 -->
                    <select name="payments[<%= index %>][paymentMode]" class="form-select form-select-sm fw-semibold select-row-payment-mode">
                      <option value="Cash" selected>Cash</option>
                      <option value="UPI">UPI</option>
                      <option value="Net Banking">Net Banking</option>
                      <option value="Cheque">Cheque</option>
                    </select>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- PIPELINE METRICS SUMMARY -->
      <div class="card my-4 border-0 shadow-sm text-white" style="background-color: #1e293b;">
        <div class="card-body p-4 text-center">
          <h5 class="fw-bold mb-3 text-warning border-bottom pb-2 text-start">📈 Live Pipeline Metrics Overview</h5>
          <div class="row g-3">
            <div class="col-md-6 border-end border-secondary">
              <p class="text-muted small mb-1 fw-bold text-uppercase">Total Amount Collecting Right Now</p>
              <h2 class="fw-bold text-success" id="liveCollectionCounter">₹0</h2>
            </div>
            <div class="col-md-6">
              <p class="text-muted small mb-1 fw-bold text-uppercase">Total Batch Track Nodes Loaded</p>
              <h2 class="fw-bold text-info"><%= students.length %> Profiles Active</h2>
            </div>
          </div>
        </div>
      </div>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow">Submit Batch Transaction</button>
      </div>
    </form>
  <% } %>
</div>

<script>
  // Global CSS Injection for Fast Danger Pulse Blinker
  if (!document.getElementById('custom-blink-styles')) {
    const style = document.createElement('style');
    style.id = 'custom-blink-styles';
    style.innerHTML = `
      @keyframes fastDangerBlink {
        0% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
        50% { opacity: 0.25; box-shadow: 0 0 2px rgba(176, 42, 55, 0.1); }
        100% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
      }
      .pulse-danger-blink {
        animation: fastDangerBlink 1s infinite ease-in-out !important;
        background-color: #b02a37 !important; 
        border-color: #842029 !important;
        color: #ffffff !important;
        font-size: 1rem !important;
        font-weight: 900 !important;
        letter-spacing: 0.5px !important;
        padding: 10px 14px !important;
        display: inline-block !important;
      }
    `;
    document.head.appendChild(style);
  }

  // Live Reset Function for Single Row (Input Reset Cross Button)
  function resetRowToZero(buttonElement) {
    const row = buttonElement.closest('tr');
    const inputElement = row.querySelector('.input-amount-to-pay');
    if (inputElement) {
      inputElement.value = "0";
      processRowLiveCalculations(inputElement);
    }
  }

  // Core Ledger calculation pipeline
  function processRowLiveCalculations(inputElement) {
    const enteredAmount = parseFloat(inputElement.value) || 0;
    const row = inputElement.closest('tr');

    const dbAdvance = parseFloat(inputElement.getAttribute('data-db-advance')) || 0;
    const prevDues = parseFloat(inputElement.getAttribute('data-prev-dues')) || 0;
    const semADues = parseFloat(inputElement.getAttribute('data-sema-dues')) || 0;
    const semBDues = parseFloat(inputElement.getAttribute('data-semb-dues')) || 0;

    const totalOriginalDues = prevDues + semADues + semBDues;

    const statusBadge = row.querySelector('.live-status-badge');
    const projAdvanceBadge = row.querySelector('.projected-advance-badge');
    const projAdvanceVal = row.querySelector('.projected-advance-val');
    const paymentModeSelect = row.querySelector('.select-row-payment-mode');

    let workingCapital = enteredAmount + dbAdvance;
    let remainingDues = totalOriginalDues;

    // Wallet Adjust Error Prevention logic:
    // If enteredAmount is exactly 0 but dues are settled using DB Advance, 
    // or if the remaining dues become zero, reset paymentMode dropdown to 'Cash' (or keep valid default), 
    // bypass the invalid 'Wallet Adjust' enum trigger at the schema level.
    if (enteredAmount === 0 && paymentModeSelect && !paymentModeSelect.disabled) {
      paymentModeSelect.value = "Cash";
    }

    if (workingCapital >= remainingDues) {
      const spilloverAdvance = workingCapital - remainingDues;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-success text-white border border-success";
      statusBadge.innerHTML = "🎉 Fully Settled";

      if (spilloverAdvance > 0) {
        projAdvanceBadge.classList.remove('d-none');
        projAdvanceVal.innerText = spilloverAdvance;
      } else {
        projAdvanceBadge.classList.add('d-none');
      }
    } else {
      const netPendingAfterPay = remainingDues - workingCapital;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-danger-subtle text-danger border border-danger pulse-danger-blink";
      statusBadge.innerHTML = `⚠️ ₹${netPendingAfterPay} - Balance Due after this payment`;
      projAdvanceBadge.classList.add('d-none');
    }

    calculateLiveDashboardMetrics();
  }

  function getRangeByClassName(name) {
    const upper = name.toUpperCase();
    if (upper.includes("1ST YEAR")) return [1, 2];
    if (upper.includes("2ND YEAR")) return [3, 4];
    if (upper.includes("3RD YEAR")) return [5, 6];
    if (upper.includes("4TH YEAR")) return [7, 8];
    return [1, 8];
  }

  function syncSemesterDropdown() {
    const classVal = document.getElementById('classSelect').value;
    const semesterSelect = document.getElementById('semesterSelect');
    if (!classVal) return;

    const range = getRangeByClassName(classVal);
    semesterSelect.innerHTML = '<option value="">Select...</option>';
    for (let i = range[0]; i <= range[1]; i++) {
      semesterSelect.innerHTML += `<option value="${i}">${i}</option>`;
    }
    syncTimelineScope();
  }

  function syncTimelineScope() {
    const classVal = document.getElementById('classSelect').value;
    const semVal = document.getElementById('semesterSelect').value;
    const timelineSelect = document.getElementById('timelineSelect');
    if (!classVal || !semVal) return;

    const range = getRangeByClassName(classVal);
    const currentSem = parseInt(semVal);
    const nextSem = (currentSem + 1 <= range[1]) ? currentSem + 1 : currentSem;

    timelineSelect.innerHTML = `
      <option value="single">Current Semester (Sem ${currentSem})</option>
      <option value="next">Next Current Semester (Sem ${nextSem})</option>
      <option value="both">Both Semesters of Current Year (Sem ${range[0]} & ${range[1]})</option>
    `;
  }

  function executeGlobalDuesClearance() {
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        const outstandingDues = parseFloat(targetInput.getAttribute('data-outstanding')) || 0;
        const dbAdvance = parseFloat(targetInput.getAttribute('data-db-advance')) || 0;

        const finalCollection = Math.max(0, outstandingDues - dbAdvance);
        targetInput.value = finalCollection;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  function executeCustomAmountInjection() {
    const injectionVal = parseFloat(document.getElementById('globalCustomValueInput').value) || 0;
    if (injectionVal <= 0) {
      alert("Alert: Please enter a positive custom amount allocation.");
      return;
    }
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        targetInput.value = injectionVal;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  function executeGlobalPaymentModeOverride(overrideValue) {
    if (!overrideValue) return;
    document.querySelectorAll('.select-row-payment-mode').forEach(dropdown => {
      if (!dropdown.disabled) {
        dropdown.value = overrideValue;
      }
    });
  }

  function calculateLiveDashboardMetrics() {
    let combinedAggregateCounter = 0;
    document.querySelectorAll('.input-amount-to-pay').forEach(input => {
      combinedAggregateCounter += (parseFloat(input.value) || 0);
    });
    const counterEl = document.getElementById('liveCollectionCounter');
    if (counterEl) {
      counterEl.innerText = '₹' + combinedAggregateCounter.toLocaleString('en-IN');
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    calculateLiveDashboardMetrics();

    const classInputEl = document.getElementById('metadataClassName');
    const semInputEl = document.getElementById('metadataSemester');

    const initialClass = classInputEl ? classInputEl.value : '';
    const initialSem = semInputEl ? semInputEl.value : '';

    if (initialClass && initialSem) {
      const range = getRangeByClassName(initialClass);
      const semesterSelect = document.getElementById('semesterSelect');
      if (semesterSelect) {
        semesterSelect.innerHTML = '';
        for (let i = range[0]; i <= range[1]; i++) {
          const selected = (i == initialSem) ? 'selected' : '';
          semesterSelect.innerHTML += `<option value="${i}" ${selected}>${i}</option>`;
        }
        syncTimelineScope();
      }
    }
  });
</script>




<!-- final code collectbulkfees.ejs -->

<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
  <h2 class="mb-4 text-dark fw-bold border-bottom pb-2">📦 Unified Batch Fee Collection (Live Ledger Sync)</h2>

  <!-- HIDDEN METADATA FOR JAVASCRIPT (100% Safe Fallbacks) -->
  <input type="hidden" id="metadataClassName" value="<%= (query && query.className) ? query.className : '' %>">
  <input type="hidden" id="metadataSemester" value="<%= (query && query.semester) ? query.semester : '' %>">

  <!-- SEARCH CONTROLS FRAMEWORK -->
  <div class="card p-4 shadow-sm mb-4 bg-white border-0">
    <form action="/fees/collect-bulk" method="GET" class="row g-3 needs-validation" novalidate id="filterForm">

      <!-- Year Selection Dropdown -->
      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Class / Year Branch</label>
        <select name="className" id="classSelect" class="form-select" required onchange="syncSemesterDropdown()">
          <option value="">Select branch...</option>
          <% if (typeof classData !== 'undefined' && classData) { %>
            <% classData.forEach(c => { %>
              <option value="<%= c.class %>" <%= (query && query.className === c.class) ? 'selected' : '' %>><%= c.class %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Target Semester -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Target Semester</label>
        <select name="semester" id="semesterSelect" class="form-select" required onchange="syncTimelineScope()">
          <option value="">Select...</option>
          <% for(let i=1; i<=8; i++) { %>
            <option value="<%= i %>" <%= (query && query.semester == i) ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <!-- Section Selection -->
      <div class="col-md-2">
        <label class="form-label fw-bold text-secondary">Section</label>
        <select name="section" class="form-select" required>
          <option value="">Select section...</option>
          <% if (typeof sectionData !== 'undefined' && sectionData) { %>
            <% sectionData.forEach(s => { %>
              <option value="<%= s.name %>" <%= (query && query.section === s.name) ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Timeline Scope Mode -->
      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Timeline Scope Mode</label>
        <select name="modeSelection" id="timelineSelect" class="form-select" required>
          <option value="single" <%= (query && query.modeSelection === 'single') ? 'selected' : '' %>>Current Semester</option>
          <option value="next" <%= (query && query.modeSelection === 'next') ? 'selected' : '' %>>Next Current Semester</option>
          <option value="both" <%= (query && query.modeSelection === 'both') ? 'selected' : '' %>>Both Semesters of Current Year</option>
        </select>
      </div>

      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn w-100 fw-bold text-white py-2 shadow-sm" style="background-color: #0f766e;">Load Batch Grid</button>
      </div>
    </form>
  </div>

  <% if (typeof students !== 'undefined' && students && students.length > 0) { %>

    <!-- MASTER CONTROL TOOLKIT -->
    <div class="card p-4 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <h5 class="fw-bold mb-3 border-bottom pb-2 text-warning">⚡ Core Automation Control Toolkit</h5>
      <div class="row g-3 align-items-end">

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">1. OUTSTANDING INJECTOR</label>
          <button type="button" onclick="executeGlobalDuesClearance()" class="btn btn-warning w-100 fw-bold shadow-sm">
            Inject All Net Pending Dues
          </button>
        </div>

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">2. CUSTOM VALUE MULTI-INJECTOR</label>
          <div class="input-group">
            <input type="number" id="globalCustomValueInput" class="form-control" placeholder="Enter custom amount...">
            <button class="btn btn-dark fw-bold" type="button" onclick="executeCustomAmountInjection()">Inject Value</button>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label small text-light fw-bold">3. GLOBAL PAYMENT MODE OVERRIDE</label>
          <select id="globalPaymentModeSelector" class="form-select fw-bold" onchange="executeGlobalPaymentModeOverride(this.value)">
            <option value="">Select Mode Override...</option>
            <option value="Cash">Cash</option>
            <option value="UPI">UPI</option>
            <option value="Net Banking">Net Banking</option>
            <option value="Cheque">Cheque</option>
          </select>
        </div>

      </div>
    </div>

    <!-- DATA GRID FORM -->
    <form action="/fees/process-bulk-payments" method="POST" id="waterfallGridForm">
      <input type="hidden" name="semA" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %>">
      <input type="hidden" name="semB" value="<%= (typeof activeSemesters !== 'undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %>">
      <input type="hidden" name="className" value="<%= (query && query.className) ? query.className : '' %>">
      <input type="hidden" name="section" value="<%= (query && query.section) ? query.section : '' %>">
      <input type="hidden" name="modeSelection" value="<%= (query && query.modeSelection) ? query.modeSelection : '' %>">
      <input type="hidden" name="submitToken" value="<%= typeof submitToken !== 'undefined' ? submitToken : '' %>">

      <div class="table-responsive shadow rounded">
        <table class="table align-middle bg-white table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>Roll No</th>
              <th>Student Identity Meta</th>
              <th class="text-center text-warning bg-secondary">Prev Pending</th>
              <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !== 'undefined' && activeSemesters[0]) ? activeSemesters[0] : '' %> Dues</th>
              <% if(query && query.modeSelection === 'both') { %>
                <th class="text-center text-warning bg-secondary">Sem-<%= (typeof activeSemesters !== 'undefined' && activeSemesters[1]) ? activeSemesters[1] : '' %> Dues</th>
              <% } %>
              <th class="text-center" style="width: 28%;">Balance Settlement</th>
              <th class="text-center text-success" style="width: 15%;">Amount to Pay (₹)</th>
              <th style="width: 15%;">Payment Method</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach((student, index) => { %>
              <tr class="payment-row-item <%= student.isLocked ? 'table-light opacity-75' : '' %>" data-index="<%= index %>">
                <td>
                  <input type="hidden" name="payments[<%= index %>][student_id]" value="<%= student.student_id %>">
                  <input type="hidden" name="payments[<%= index %>][rollNumber]" value="<%= student.rollNumber %>">
                  <input type="hidden" name="payments[<%= index %>][studentName]" value="<%= student.studentName %>">
                  <input type="hidden" name="payments[<%= index %>][status]" value="<%= student.status %>">
                  <span class="badge bg-dark fs-6">
                    <%= student.rollNumber %>
                  </span>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= student.studentName %></div>
                  <small class="text-muted">F: <%= student.fatherName %></small>
                </td>

                <!-- Previous Pending Column -->
                <td class="text-center fw-semibold text-danger bg-light">
                  <span class="label-prev-pending">₹<%= student.previousPendingDues %></span>
                </td>

                <!-- Sem A Column -->
                <td class="text-center fw-semibold text-danger table-active">
                  <span class="label-sema-pending">₹<%= student.semA.pending %></span>
                </td>

                <!-- Sem B Column -->
                <% if(query && query.modeSelection === 'both') { %>
                  <td class="text-center fw-semibold text-danger table-active">
                    <span class="label-semb-pending">₹<%= student.semB ? student.semB.pending : 0 %></span>
                  </td>
                <% } %>

                <!-- Dynamic Real-Time Settlement Box -->
                <td class="text-center bg-light">
                  <div class="d-flex flex-column gap-1 align-items-center justify-content-center ledger-status-container">

                    <!-- Advance successfully cut and distributed into future hidden semesters -->
                    <% if (student.implicitAdvanceSpilloverLogs && student.implicitAdvanceSpilloverLogs.length > 0) { %>
                      <% student.implicitAdvanceSpilloverLogs.forEach(log => { %>
                        <div class="badge w-100 py-1 fs-8 text-wrap text-start text-dark fw-bold border" style="background-color: #e2e8f0; border-color: #cbd5e1;">
                          ⚙️ Sem-<%= log.semNumber %>: ₹<%= log.absorbed %> Advance Adjusted (Pending: ₹<%= log.remainingDues %>)
                        </div>
                      <% }) %>
                    <% } %>

                    <!-- Available Unallocated Database Advance Balance -->
                    <% if (student.advanceBalance > 0) { %>
                      <div class="badge w-100 py-2 fs-7 shadow-sm border mb-1 text-wrap" style="background-color: #cff4fc !important; border-color: #b6effb !important; color: #055160 !important; display: inline-block !important;">
                        💎 ₹<span class="db-advance-val fw-bolder"><%= student.advanceBalance %></span> - Unallocated Advance Wallet
                      </div>
                    <% } %>

                    <!-- Live Calculation Status Display Badge -->
                    <div class="live-status-badge badge w-100 py-2 fs-7 shadow-sm <%= student.isLocked ? 'bg-success text-white' : 'bg-warning-subtle text-warning border border-warning' %>">
                      <%= student.isLocked ? '🎉 Complete / Clear' : '⚠️ Pending Total: ₹' + student.totalYearDues %>
                    </div>

                    <!-- Projected Future Wallet Balance -->
                    <div class="projected-advance-badge badge w-100 py-2 fs-7 shadow-sm border d-none" style="background-color: #d1e7dd !important; border-color: #badbcc !important; color: #0f5132 !important;">
                      🚀 ₹<span class="projected-advance-val fw-bolder">0</span> - Projected Advance
                    </div>

                  </div>
                </td>

                <!-- Amount Input Matrix -->
                <td>
                  <% if(student.isLocked) { %>
                    <div class="text-center">
                      <span class="badge bg-success py-2 px-3 shadow-sm rounded-pill">✔️ Cleared</span>
                    </div>
                    <input type="hidden" name="payments[<%= index %>][amountToPay]" value="0">
                  <% } else { %>
                    <input type="number" name="payments[<%= index %>][amountToPay]"
                      class="form-control text-center fw-bold input-amount-to-pay border-success text-success shadow-sm"
                      value="0" min="0" data-outstanding="<%= student.totalYearDues %>"
                      data-db-advance="<%= student.advanceBalance %>"
                      data-prev-dues="<%= student.previousPendingDues %>"
                      data-sema-dues="<%= student.semA.pending %>"
                      data-semb-dues="<%= student.semB ? student.semB.pending : 0 %>"
                      oninput="processRowLiveCalculations(this)">
                  <% } %>
                </td>

                <!-- Payment Method -->
                <td>
                  <% if(student.isLocked) { %>
                    <input type="hidden" name="payments[<%= index %>][paymentMode]" value="Cash">
                    <select class="form-select form-select-sm fw-semibold select-row-payment-mode" disabled>
                      <option value="Cash" selected>Cash</option>
                    </select>
                  <% } else { %>
                    <select name="payments[<%= index %>][paymentMode]" class="form-select form-select-sm fw-semibold select-row-payment-mode">
                      <option value="Cash" selected>Cash</option>
                      <option value="UPI">UPI</option>
                      <option value="Net Banking">Net Banking</option>
                      <option value="Cheque">Cheque</option>
                    </select>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- PIPELINE METRICS SUMMARY -->
      <div class="card my-4 border-0 shadow-sm text-white" style="background-color: #1e293b;">
        <div class="card-body p-4 text-center">
          <h5 class="fw-bold mb-3 text-warning border-bottom pb-2 text-start">📈 Live Pipeline Metrics Overview</h5>
          <div class="row g-3">
            <div class="col-md-6 border-end border-secondary">
              <p class="text-muted small mb-1 fw-bold text-uppercase">Total Amount Collecting Right Now</p>
              <h2 class="fw-bold text-success" id="liveCollectionCounter">₹0</h2>
            </div>
            <div class="col-md-6">
              <p class="text-muted small mb-1 fw-bold text-uppercase">Total Batch Track Nodes Loaded</p>
              <h2 class="fw-bold text-info">
                <%= students.length %> Profiles Active
              </h2>
            </div>
          </div>
        </div>
      </div>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow">Submit Batch Transaction</button>
      </div>
    </form>
  <% } %>
</div>

<script>
  // Fast Danger Blink Animation injection logic
  if (!document.getElementById('custom-blink-styles')) {
    const style = document.createElement('style');
    style.id = 'custom-blink-styles';
    style.innerHTML = `
      @keyframes fastDangerBlink {
        0% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
        50% { opacity: 0.35; box-shadow: 0 0 2px rgba(176, 42, 55, 0.1); }
        100% { opacity: 1; box-shadow: 0 0 12px rgba(176, 42, 55, 0.6); }
      }
      .pulse-danger-blink {
        animation: fastDangerBlink 1s infinite ease-in-out !important;
        background-color: #b02a37 !important; 
        border-color: #842029 !important;
        color: #ffffff !important; 
        font-size: 0.95rem !important; 
        font-weight: 800 !important; 
        padding: 8px 12px !important;
      }
    `;
    document.head.appendChild(style);
  }

  function processRowLiveCalculations(inputElement) {
    const enteredAmount = parseFloat(inputElement.value) || 0;
    const row = inputElement.closest('tr');

    const dbAdvance = parseFloat(inputElement.getAttribute('data-db-advance')) || 0;
    const prevDues = parseFloat(inputElement.getAttribute('data-prev-dues')) || 0;
    const semADues = parseFloat(inputElement.getAttribute('data-sema-dues')) || 0;
    const semBDues = parseFloat(inputElement.getAttribute('data-semb-dues')) || 0;

    const totalOriginalDues = prevDues + semADues + semBDues;

    const statusBadge = row.querySelector('.live-status-badge');
    const projAdvanceBadge = row.querySelector('.projected-advance-badge');
    const projAdvanceVal = row.querySelector('.projected-advance-val');

    let workingCapital = enteredAmount + dbAdvance;

    if (workingCapital >= totalOriginalDues) {
      const spilloverAdvance = workingCapital - totalOriginalDues;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-success text-white";
      statusBadge.innerHTML = "🎉 Fully Settled";

      if (spilloverAdvance > 0) {
        projAdvanceBadge.classList.remove('d-none');
        projAdvanceVal.innerText = spilloverAdvance.toFixed(2);
      } else {
        projAdvanceBadge.classList.add('d-none');
      }
    } else {
      const netPendingAfterPay = totalOriginalDues - workingCapital;
      statusBadge.className = "live-status-badge badge w-100 py-2 fs-7 shadow-sm bg-danger-subtle text-danger border border-danger pulse-danger-blink";
      statusBadge.innerHTML = `⚠️ Balance Due: ₹${netPendingAfterPay.toFixed(2)}`;
      projAdvanceBadge.classList.add('d-none');
    }

    calculateLiveDashboardMetrics();
  }

  function getRangeByClassName(name) {
    const upper = name.toUpperCase();
    if (upper.includes("1ST YEAR")) return [1, 2];
    if (upper.includes("2ND YEAR")) return [3, 4];
    if (upper.includes("3RD YEAR")) return [5, 6];
    if (upper.includes("4TH YEAR")) return [7, 8];
    return [1, 8];
  }

  function syncSemesterDropdown() {
    const classVal = document.getElementById('classSelect').value;
    const semesterSelect = document.getElementById('semesterSelect');
    if (!classVal) return;

    const range = getRangeByClassName(classVal);
    semesterSelect.innerHTML = '<option value="">Select...</option>';
    for (let i = range[0]; i <= range[1]; i++) {
      semesterSelect.innerHTML += `<option value="${i}">${i}</option>`;
    }
    syncTimelineScope();
  }

  function syncTimelineScope() {
    const classVal = document.getElementById('classSelect').value;
    const semVal = document.getElementById('semesterSelect').value;
    const timelineSelect = document.getElementById('timelineSelect');
    if (!classVal || !semVal) return;

    const range = getRangeByClassName(classVal);
    const currentSem = parseInt(semVal);
    const nextSem = (currentSem + 1 <= range[1]) ? currentSem + 1 : currentSem;

    timelineSelect.innerHTML = `
      <option value="single">Current Semester (Sem ${currentSem})</option>
      <option value="next">Next Current Semester (Sem ${nextSem})</option>
      <option value="both">Both Semesters of Current Year (Sem ${range[0]} & ${range[1]})</option>
    `;
  }

  function executeGlobalDuesClearance() {
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        const outstandingDues = parseFloat(targetInput.getAttribute('data-outstanding')) || 0;
        const dbAdvance = parseFloat(targetInput.getAttribute('data-db-advance')) || 0;

        const finalCollection = Math.max(0, outstandingDues - dbAdvance);
        targetInput.value = finalCollection;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  function executeCustomAmountInjection() {
    const injectionVal = parseFloat(document.getElementById('globalCustomValueInput').value) || 0;
    if (injectionVal <= 0) {
      alert("Alert: Please enter a positive custom amount allocation.");
      return;
    }
    document.querySelectorAll('.payment-row-item').forEach(row => {
      const targetInput = row.querySelector('.input-amount-to-pay');
      if (targetInput) {
        targetInput.value = injectionVal;
        processRowLiveCalculations(targetInput);
      }
    });
  }

  function executeGlobalPaymentModeOverride(overrideValue) {
    if (!overrideValue) return;
    document.querySelectorAll('.select-row-payment-mode').forEach(dropdown => {
      if (!dropdown.disabled) {
        dropdown.value = overrideValue;
      }
    });
  }

  function calculateLiveDashboardMetrics() {
    let combinedAggregateCounter = 0;
    document.querySelectorAll('.input-amount-to-pay').forEach(input => {
      combinedAggregateCounter += (parseFloat(input.value) || 0);
    });
    const counterEl = document.getElementById('liveCollectionCounter');
    if (counterEl) {
      counterEl.innerText = '₹' + combinedAggregateCounter.toLocaleString('en-IN');
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    calculateLiveDashboardMetrics();

    const classInputEl = document.getElementById('metadataClassName');
    const semInputEl = document.getElementById('metadataSemester');

    const initialClass = classInputEl ? classInputEl.value : '';
    const initialSem = semInputEl ? semInputEl.value : '';

    if (initialClass && initialSem) {
      const range = getRangeByClassName(initialClass);
      const semesterSelect = document.getElementById('semesterSelect');
      if (semesterSelect) {
        semesterSelect.innerHTML = '';
        for (let i = range[0]; i <= range[1]; i++) {
          const selected = (i == initialSem) ? 'selected' : '';
          semesterSelect.innerHTML += `<option value="${i}" ${selected}>${i}</option>`;
        }
        syncTimelineScope();
      }
    }
  });
</script>









