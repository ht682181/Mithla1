  <% } %>

</div>

<!-- SMART CONTROLLER ENGINE SCRIPT -->
<script>
// 📊 Grand Total Calculation Engine
function updateGrandTotals() {
  let totalYear = 0;
  let totalSemA = 0;
  let totalSemB = 0;

  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    // Sirf 'Active' status wale bacchon ka aggregation count hoga
    if (row.querySelector('.row-status-select').value === "Active") {
      const yearVal = parseFloat(row.querySelector('.row-year-total').value) || 0;
      const semAVal = parseFloat(row.querySelector('.row-semA-input').value) || 0;
      const semBVal = parseFloat(row.querySelector('.row-semB-input').value) || 0;

      totalYear += yearVal;
      totalSemA += semAVal;
      totalSemB += semBVal;
    }
  });

  // UI Allocation Update Rendering
  document.getElementById('grandYearTotal').innerText = '₹' + totalYear.toLocaleString('en-IN');
  document.getElementById('grandSemATotal').innerText = '₹' + totalSemA.toLocaleString('en-IN');
  document.getElementById('grandSemBTotal').innerText = '₹' + totalSemB.toLocaleString('en-IN');
}

// Global Injector: Target dynamic year split 50-50 logic
function applyGlobalYearFee() {
  const annualAmount = parseFloat(document.getElementById('masterYearFee').value) || 0;
  if(annualAmount <= 0) {
    alert("Kripya valid year amount enter karein split karne ke liye!");
    return;
  }
  
  const splitShare = annualAmount / 2;
  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      row.querySelector('.row-year-total').value = annualAmount;
      row.querySelector('.row-semA-input').value = splitShare;
      row.querySelector('.row-semB-input').value = splitShare;
    }
  });
  
  updateGrandTotals();
}

// Row-level equal split execution
function divideRowFeesEqually(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const totalAmt = parseFloat(inputElement.value) || 0;
  row.querySelector('.row-semA-input').value = totalAmt / 2;
  row.querySelector('.row-semB-input').value = totalAmt / 2;
  
  updateGrandTotals();
}

// Row-level reverse evaluation mapping
function recalculateRowTotal(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const sA = parseFloat(row.querySelector('.row-semA-input').value) || 0;
  const sB = parseFloat(row.querySelector('.row-semB-input').value) || 0;
  row.querySelector('.row-year-total').value = sA + sB;
  
  updateGrandTotals();
}

// Opacity toggle and disables fields for left college students
function toggleRowState(selectElement) {
  const row = selectElement.closest('.student-row-item');
  const inputs = row.querySelectorAll('input[type="number"]');
  if(selectElement.value === "Left College") {
    row.style.opacity = "0.5";
    inputs.forEach(i => i.disabled = true);
  } else {
    row.style.opacity = "1";
    inputs.forEach(i => i.disabled = false);
  }
  
  updateGrandTotals();
}

// Form validation matrix constraint checks
function validateGridForm() {
  const rows = document.querySelectorAll('.student-row-item');
  let valid = true;

  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      const yearFee = parseFloat(row.querySelector('.row-year-total').value) || 0;
      if(yearFee <= 0) {
        valid = false;
        row.querySelector('.row-year-total').style.border = "2px solid red";
      } else {
        row.querySelector('.row-year-total').style.border = "1px solid #dee2e6";
      }
    }
  });

  if(!valid) {
    alert("⚠️ Validation Error: Sabhi active bacchon ki fees zero se badi honi chahiye save karne ke liye!");
    return false;
  }
  return true;
}

// Initialize calculations on DOM ready
document.addEventListener("DOMContentLoaded", () => {
  updateGrandTotals();
});
</script>






































