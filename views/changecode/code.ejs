  student_id: { type: mongoose.Schema.Types.ObjectId, ref: 'Student', required: true },
  rollNumber: { type: String, required: true },
  studentName: { type: String, required: true },
  fatherName: { type: String, default: '' }, // 👈 [ADD] Kyunki hum EJS par dikha rahe hain, toh ledger me bhi store karna safe rahega
  className: String,
  section: String,
  
  // 2. Student Status Operational Control
  status: { type: String, enum: ['Active', 'Left College'], default: 'Active' }, // 👈 [ADD] Jo baccha beech me chhod gaya, uska status yahan save hoga taaki next time filtering me yaad rahe

  // 3. 6 ya 8 semesters ka dynamic array tracker (Absolutely Perfect)
  semesters: [
    {
      semNumber: { type: Number, required: true },
      due_amount: { type: Number, default: 0 },
      amount_paid: { type: Number, default: 0 },
      balance_pending: { type: Number, default: 0 }
    }
  ],

  // 4. Pure course ka lifetime calculations summary (Lifetime Tracker)
  total_course_fees: { type: Number, default: 0 },
  total_amount_paid: { type: Number, default: 0 },
  overall_pending_balance: { type: Number, default: 0 }
}, { timestamps: true });

module.exports = mongoose.model('FeeLedger', feeLedgerSchema);







const Joi = require('joi');

const feeBulkSchema = Joi.object({
  className: Joi.string().required(),
  section: Joi.string().required(),
  semA: Joi.number().integer().min(1).max(8).required(),
  semB: Joi.number().integer().min(1).max(8).required(),
  fees: Joi.array().items(
    Joi.object({
      student_id: Joi.string().hex().length(24).required(),
      rollNumber: Joi.string().required(),
      studentName: Joi.string().required(),
      due_amount_A: Joi.number().min(0).required(),
      due_amount_B: Joi.number().min(0).required(),
      status: Joi.string().valid('Active', 'Left College').required()
    })
  ).min(1).required()
});

const validateFeeData = (req, res, next) => {
  const { error } = feeBulkSchema.validate(req.body);
  if (error) {
    console.error("Joi Validation Error Details:", error.details);
    req.flash("error", "⚠️ Security Alert: Data tampering detected!");
    return res.redirect("/add/student/fees");
  }
  next();
};

// Yeh export hona zaroori hai!
module.exports = validateFeeData;













