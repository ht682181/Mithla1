<%- layout("/layouts/boilerplate") -%>

<!-- SweetAlert2 CSS & JS (Screen-Based Modern Alerts) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container my-5">
  
  <!-- 📢 Header & Top Action Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold text-primary mb-1">📋 All Exam Configurations</h2>
      <p class="text-muted mb-0">Manage exam rules, passing marks, and exam structures by class.</p>
    </div>
    <div class="d-flex gap-2">
      <!-- Bulk Delete Trigger Button -->
      <button 
        id="bulkDeleteBtn" 
        class="btn btn-danger fw-bold shadow-sm px-3 py-2 d-none"
        onclick="executeBulkDelete()"
      >
        🗑️ Delete Selected (<span id="selectedCount">0</span>)
      </button>

      <a href="/admin/save/exam/data" class="btn btn-success fw-bold shadow-sm px-3 py-2">
        ➕ Add New Exam Rule
      </a>
    </div>
  </div>

  <!-- 🎯 Dashboard Class Selection Card (Prevents Page Crash) -->
  <div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary text-white">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-md-7">
          <h5 class="fw-bold mb-1">🏫 Class Selection Dashboard</h5>
          <p class="mb-0 text-white-50">Select a class from database records to view and manage its exam configurations.</p>
        </div>
        <div class="col-md-5">
          <select id="mainClassSelector" class="form-select form-select-lg shadow-sm fw-bold border-0" onchange="handleClassSelection(this.value)">
            <option value="" selected disabled>-- Select Class to View Data --</option>
            <% if (uniqueClasses && uniqueClasses.length > 0) { %>
              <% uniqueClasses.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- 🔍 Secondary Filter & Analytics Card (Shown after selection) -->
  <div id="secondaryFilterCard" class="card border-0 shadow-sm rounded-3 mb-4 d-none">
    <div class="card-body p-3 bg-light rounded-3">
      <div class="row align-items-center g-3">
        <div class="col-md-6 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0">🔍</span>
            <input 
              type="text" 
              id="classFilterInput" 
              class="form-control border-start-0 ps-0 shadow-none" 
              placeholder="Refine search by class name..." 
              onkeyup="filterByClass()"
            />
          </div>
        </div>
        <div class="col-md-6 col-lg-7 text-md-end">
          <span class="badge bg-primary fs-6 px-3 py-2">
            Active Class: <span id="selectedClassName" class="fw-bold text-warning">None</span>
          </span>
          <span class="badge bg-secondary fs-6 px-3 py-2 ms-2">
            Visible Groups: <span id="visibleCount">0</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 📁 Placeholder Prompt (Before Class Selection) -->
  <div id="selectPromptCard" class="card shadow border-0 p-5 text-center text-muted fw-bold fs-5 rounded-3">
    🎯 Please select a Class from the dashboard above to view its exam rules.
  </div>

  <!-- 📊 Data Tables Card List (Hidden initially, shown after selection) -->
  <div id="examConfigsContainer" class="d-none">
    <% if (examConfigs.length === 0) { %>
      <div class="card shadow border-0 p-5 text-center text-muted fw-bold fs-5">
        📁 No exam rules configured yet. 
        <br/>
        <a href="/admin/save/exam/data" class="btn btn-primary btn-sm mt-3 w-auto mx-auto px-4">Create First Rule</a>
      </div>
    <% } else { %>
      <% examConfigs.forEach((config) => { %>
        <div class="card border-0 shadow rounded-3 mb-4 config-card" id="parent-card-<%= config._id %>" data-class-name="<%= config.className %>">
          
          <!-- Card Header: Class Metadata & Group Checkbox -->
          <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
              <input 
                type="checkbox" 
                class="form-check-input group-checkbox border-secondary" 
                data-parent-id="<%= config._id %>"
                onchange="toggleGroupSelection('<%= config._id %>', this)"
                title="Select whole group"
              />
              <span class="badge bg-info text-dark fs-6 class-name-badge"><%= config.className %></span>
              <span class="fw-semibold">Semester <%= config.semester %></span> |
              <span class="badge bg-secondary">Section <%= config.section %></span> |
              <span class="text-warning fw-bold">Session: <%= config.academicYear %></span>
            </div>
            <button 
              class="btn btn-outline-light btn-sm fw-bold shadow-sm"
              onclick="deleteParentGroup('<%= config._id %>')"
              id="btn-parent-<%= config._id %>"
            >
              🗑️ Delete Group
            </button>
          </div>

          <!-- Card Body: Array of Exams with Checkboxes -->
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light text-uppercase small">
                  <tr>
                    <th style="width: 40px;">Select</th>
                    <th>#</th>
                    <th>Exam Name</th>
                    <th>Max Marks</th>
                    <th>Passing Marks</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% config.exams.forEach((exam, idx) => { %>
                    <tr id="exam-row-<%= exam._id %>">
                      <td>
                        <input 
                          type="checkbox" 
                          class="form-check-input exam-checkbox exam-check-parent-<%= config._id %>" 
                          data-parent-id="<%= config._id %>"
                          data-exam-id="<%= exam._id %>"
                          onchange="updateBulkDeleteState()"
                        />
                      </td>
                      <td class="fw-bold text-secondary"><%= idx + 1 %></td>
                      <td>
                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1 fs-6">
                          <%= exam.examName %>
                        </span>
                      </td>
                      <td class="fw-bold text-dark"><%= exam.maxMarks %></td>
                      <td class="fw-bold text-success"><%= exam.passingMarks %></td>
                      <td>
                        <button 
                          class="btn btn-outline-danger btn-sm px-3 fw-bold shadow-sm"
                          onclick="deleteSubExam('<%= config._id %>', '<%= exam._id %>')"
                          id="btn-sub-<%= exam._id %>"
                        >
                          ❌ Remove
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      <% }) %>
    <% } %>
  </div>

</div>

<!-- ⚡ Client-Side Filter, Delete & Bulk Action Script (Crash Proof & Bug Free) -->
<script>
  // Screen-based Toast Config
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    didOpen: (toast) => {
      toast.addEventListener('mouseenter', Swal.stopTimer);
      toast.addEventListener('mouseleave', Swal.resumeTimer);
    }
  });

  // 0. Primary Dashboard Class Selector Switcher
  function handleClassSelection(selectedClass) {
    if (!selectedClass) return;

    const selectPromptCard = document.getElementById('selectPromptCard');
    const examConfigsContainer = document.getElementById('examConfigsContainer');
    const secondaryFilterCard = document.getElementById('secondaryFilterCard');
    const selectedClassName = document.getElementById('selectedClassName');
    const classFilterInput = document.getElementById('classFilterInput');

    if (selectPromptCard) selectPromptCard.classList.add('d-none');
    if (examConfigsContainer) examConfigsContainer.classList.remove('d-none');
    if (secondaryFilterCard) secondaryFilterCard.classList.remove('d-none');
    if (selectedClassName) selectedClassName.innerText = selectedClass;

    if (classFilterInput) {
      classFilterInput.value = selectedClass;
      filterByClass();
    }
  }

  // 1. Filter by Class Name (Safe Loop)
  function filterByClass() {
    const classFilterInput = document.getElementById('classFilterInput');
    if (!classFilterInput) return;

    const filterValue = classFilterInput.value.toUpperCase().trim();
    const cards = document.querySelectorAll('.config-card');
    let visibleCount = 0;

    cards.forEach(card => {
      if (!card) return;
      const classNameBadge = card.querySelector('.class-name-badge');
      if (classNameBadge) {
        const textValue = classNameBadge.textContent || classNameBadge.innerText || "";
        if (textValue.toUpperCase().indexOf(filterValue) > -1) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      }
    });

    const visibleCountElem = document.getElementById('visibleCount');
    if (visibleCountElem) visibleCountElem.innerText = visibleCount;
  }

  // 2. Toggle Group Selection Checkbox
  function toggleGroupSelection(parentId, masterCheckbox) {
    if (!masterCheckbox) return;
    const subCheckboxes = document.querySelectorAll(`.exam-check-parent-${parentId}`);
    subCheckboxes.forEach(cb => {
      if (cb) cb.checked = masterCheckbox.checked;
    });
    updateBulkDeleteState();
  }

  // 3. Update Bulk Delete Button Visibility & Count
  function updateBulkDeleteState() {
    const checkedExamBoxes = document.querySelectorAll('.exam-checkbox:checked');
    const bulkBtn = document.getElementById('bulkDeleteBtn');
    const countSpan = document.getElementById('selectedCount');

    if (countSpan) countSpan.innerText = checkedExamBoxes.length;

    if (bulkBtn) {
      if (checkedExamBoxes.length > 0) {
        bulkBtn.classList.remove('d-none');
      } else {
        bulkBtn.classList.add('d-none');
      }
    }
  }

  // 4. Delete Single Sub-Exam (Bug-Free & Safe DOM Removal)
  async function deleteSubExam(parentId, examId) {
    const confirmRes = await Swal.fire({
      title: 'Remove Exam?',
      text: "Are you sure you want to remove this exam rule?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, remove it!',
      cancelButtonText: 'Cancel'
    });

    if (!confirmRes.isConfirmed) return;

    const btn = document.getElementById(`btn-sub-${examId}`);
    if (btn) {
      btn.disabled = true;
      btn.innerText = "Removing...";
    }

    try {
      const response = await fetch(`/admin/delete/exam/sub/${parentId}/${examId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });

      const result = await response.json();

      if (response.ok && result.success) {
        // Safe DOM Removal with Null Protection
        if (result.isParentDeleted) {
          const parentCard = document.getElementById(`parent-card-${parentId}`);
          if (parentCard) parentCard.remove();
        } else {
          const examRow = document.getElementById(`exam-row-${examId}`);
          if (examRow) examRow.remove();
        }

        // Re-evaluate State Safe
        try {
          updateBulkDeleteState();
          filterByClass();
        } catch (domErr) {
          console.warn("DOM sync warning:", domErr);
        }

        // 🟢 Screen Toast Output
        Toast.fire({
          icon: 'success',
          title: result.message || 'Exam removed successfully!'
        });
      } else {
        // 🔴 Screen Server Error
        Swal.fire('Error!', result.message || "Failed to remove exam!", 'error');
        if (btn) {
          btn.disabled = false;
          btn.innerText = "❌ Remove";
        }
      }
    } catch (err) {
      console.error("Delete Sub Exam Client Exception:", err);
      Swal.fire('Server Error!', "Error occurred while removing exam!", 'error');
      if (btn) {
        btn.disabled = false;
        btn.innerText = "❌ Remove";
      }
    }
  }

  // 5. Delete Entire Parent Group
  async function deleteParentGroup(parentId) {
    const confirmRes = await Swal.fire({
      title: 'Delete Entire Group?',
      text: "This will delete all exam rules inside this class group!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, delete whole group!',
      cancelButtonText: 'Cancel'
    });

    if (!confirmRes.isConfirmed) return;

    const btn = document.getElementById(`btn-parent-${parentId}`);
    if (btn) {
      btn.disabled = true;
      btn.innerText = "Deleting...";
    }

    try {
      const response = await fetch(`/admin/delete/exam/parent/${parentId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });

      const result = await response.json();

      if (response.ok && result.success) {
        const parentCard = document.getElementById(`parent-card-${parentId}`);
        if (parentCard) parentCard.remove();

        try {
          updateBulkDeleteState();
          filterByClass();
        } catch (domErr) {
          console.warn("DOM sync warning:", domErr);
        }

        // 🟢 Screen Toast Output
        Toast.fire({
          icon: 'success',
          title: result.message || 'Class group deleted successfully!'
        });
      } else {
        // 🔴 Screen Server Error
        Swal.fire('Error!', result.message || "Failed to delete group!", 'error');
        if (btn) {
          btn.disabled = false;
          btn.innerText = "🗑️ Delete Group";
        }
      }
    } catch (err) {
      console.error("Delete Parent Group Client Exception:", err);
      Swal.fire('Server Error!', "Error occurred while deleting group!", 'error');
      if (btn) {
        btn.disabled = false;
        btn.innerText = "🗑️ Delete Group";
      }
    }
  }

  // 6. Execute Bulk Delete Selected Exams
  async function executeBulkDelete() {
    const checkedBoxes = document.querySelectorAll('.exam-checkbox:checked');
    
    if (checkedBoxes.length === 0) {
      Swal.fire({
        title: 'No Selection',
        text: 'Please select at least one exam entry to delete.',
        icon: 'info',
        confirmButtonColor: '#0d6efd'
      });
      return;
    }

    const confirmRes = await Swal.fire({
      title: 'Bulk Delete?',
      text: `Are you sure you want to delete ${checkedBoxes.length} selected exam entries?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, delete selected!',
      cancelButtonText: 'Cancel'
    });

    if (!confirmRes.isConfirmed) return;

    const bulkBtn = document.getElementById('bulkDeleteBtn');
    if (bulkBtn) {
      bulkBtn.disabled = true;
      bulkBtn.innerText = "⌛ Deleting...";
    }

    const itemsToDelete = [];
    checkedBoxes.forEach(cb => {
      itemsToDelete.push({
        parentId: cb.getAttribute('data-parent-id'),
        examId: cb.getAttribute('data-exam-id')
      });
    });

    let successCount = 0;

    for (const item of itemsToDelete) {
      try {
        const response = await fetch(`/admin/delete/exam/sub/${item.parentId}/${item.examId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();

        if (response.ok && result.success) {
          successCount++;
          if (result.isParentDeleted) {
            const parentCard = document.getElementById(`parent-card-${item.parentId}`);
            if (parentCard) parentCard.remove();
          } else {
            const examRow = document.getElementById(`exam-row-${item.examId}`);
            if (examRow) examRow.remove();
          }
        }
      } catch (err) {
        console.error("Bulk Delete Error for item:", item, err);
      }
    }

    if (bulkBtn) bulkBtn.disabled = false;

    try {
      updateBulkDeleteState();
      filterByClass();
    } catch (domErr) {
      console.warn("DOM sync warning:", domErr);
    }

    if (successCount > 0) {
      // 🟢 Screen Toast Output
      Toast.fire({
        icon: 'success',
        title: `${successCount} exam entries deleted successfully!`
      });
    } else {
      // 🔴 Screen Error
      Swal.fire('Error!', 'Failed to delete selected items.', 'error');
    }
  }
</script>