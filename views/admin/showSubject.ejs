<% layout("/layouts/boilerplate") -%>

<style>
  /* 💎 Semester & Section Badges (Keeping your cool style untouched) */
  .badge-semester {
    background: linear-gradient(135deg, #00d2ff 0%, #0066eb 100%);
    color: #ffffff !important;
    font-weight: 700;
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(0, 102, 235, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* 🍃 New Clean & Spacious Subject Typography Layout */
  .clean-subject-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    padding: 6px 0;
  }

  .clean-subject-text {
    color: #334155;
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: 0.8px;
    padding: 2px 0;
    position: relative;
  }

  .clean-subject-text:not(:last-child)::after {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    background-color: #cbd5e1;
    margin: 6px auto 0 auto;
    opacity: 0.7;
  }

  /* Table Title Header Style */
  .table-main-header {
    background-color: #2c3e50;
    color: #ffffff;
    font-family: monospace;
    font-size: 1.05rem;
    letter-spacing: 0.5px;
  }

  .btn-nav {
    background-color: #334155;
    color: #ffffff;
    border-radius: 50px;
    font-weight: 500;
    padding: 0.4rem 1.2rem;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-nav:hover {
    background-color: #1e293b;
    color: white;
  }

  /* Custom Clean Search UI adjustments */
  .search-wrapper {
    background: #f8f9fa;
    border: 1px solid #e2e8f0;
  }
</style>

<div class="container my-2">

  <div class="text-center mb-5">
    <h2 class="fw-bold text-primary"> 📘 Subject Management</h2>
    <p class="text-muted">Add, Search & Manage Subject Information</p>
  </div>

  <div class="row align-items-center g-3 mb-4 mt-2">
    <div class="col-md-8 col-lg-6">
      <div class="input-group shadow-sm rounded-pill overflow-hidden search-wrapper bg-white">
        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="text" id="subjectLiveSearch" class="form-control border-0 py-2 small shadow-none" placeholder="Live search by Name, Code, Course, or Semester...">
        <button class="btn btn-outline-secondary border-0 bg-white text-muted small px-3" type="button" id="clearSearchBtn" style="display: none;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
    
    <div class="col-md-4 col-lg-6 text-md-end text-start">
      <a href="/add/subjectData" 
         class="btn btn-dark shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2"
         style="transition:0.3s; font-size:15px; min-height: 40px;">
         <i class="fa-solid fa-plus"></i> Add Subject
      </a>
    </div>
  </div>

  <div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header bg-dark text-white rounded-top-4">
      <h4 class="mb-0 fw-bold text-center">📋 Subject Details</h4>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle text-center shadow-sm" id="subjectTable">
          <thead class="table-primary">
            <tr>
              <th>Name</th>
              <th>Code</th>
              <th>Course</th>
              <th>Semester</th>
              <th>MaxMarks</th>
              <th>MinMarks</th>
              <th>SubjectType</th>
              <th>Edit</th>
              <th>Delete</th>
            </tr>
          </thead>
          
          <tbody class="small">
            <% if(!datas || datas.length === 0) { %>
              <tr id="noDataRow">
                <td colspan="9" class="py-5 text-muted fw-semibold">
                  No subjects found in the database.
                </td>
              </tr>
            <% } else { %>
              <% for (let data of datas) { %>
                <tr class="subject-row" 
                    data-name="<%= data.name.toLowerCase() %>" 
                    data-code="<%= data.code.toLowerCase() %>" 
                    data-course="<%= data.course.toLowerCase() %>" 
                    data-semester="<%= data.semester.toString().toLowerCase() %>">
                  <td><%= data.name %></td>
                  <td><%= data.code %></td>
                  <td><%= data.course %></td>
                  <td><%= data.semester %></td>
                  <td><%= data.maxMarks %></td>
                  <td><%= data.minMarks %></td>
                  <td><%= data.subjectType %></td>
                  <td>
                    <a href="/edit/subject/<%= data._id %>" class="btn btn-sm btn-outline-warning"><i class="fa-solid fa-pen"></i></a>
                  </td>
                  <td>
                    <form action="/delete/subject/<%= data._id %>?_method=Delete" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this subject data?');">
                      <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% } %>
            <% } %>

            <tr id="noResultsRow" style="display: none;">
              <td colspan="9" class="py-5 text-muted fw-semibold">
                <i class="fa-solid fa-book-bookmark me-1 text-danger"></i> No matching subjects found.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  const subjectLiveSearch = document.getElementById("subjectLiveSearch");
  const clearSearchBtn = document.getElementById("clearSearchBtn");
  const subjectRows = document.querySelectorAll(".subject-row");
  const noResultsRow = document.getElementById("noResultsRow");

  if (subjectLiveSearch) {
    subjectLiveSearch.addEventListener("input", function() {
      const query = this.value.toLowerCase().trim();
      let matchCount = 0;

      clearSearchBtn.style.display = (query.length > 0) ? "block" : "none";

      subjectRows.forEach(row => {
        const name = row.getAttribute("data-name") || "";
        const code = row.getAttribute("data-code") || "";
        const course = row.getAttribute("data-course") || "";
        const semester = row.getAttribute("data-semester") || "";

        if (name.includes(query) || code.includes(query) || course.includes(query) || semester.includes(query)) {
          row.style.display = ""; 
          matchCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResultsRow) {
        noResultsRow.style.display = (matchCount === 0 && subjectRows.length > 0) ? "" : "none";
      }
    });
  }

  if (clearSearchBtn) {
    clearSearchBtn.addEventListener("click", function() {
      subjectLiveSearch.value = "";
      this.style.display = "none";
      if (noResultsRow) noResultsRow.style.display = "none";
      subjectRows.forEach(row => row.style.display = "");
    });
  }
</script>