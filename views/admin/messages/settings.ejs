<% layout("layouts/boilerplate") %>

<style>
  :root {
    --primary-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #3b82f6 100%);
    --accent-blue: #2563eb;
    --accent-emerald: #10b981;
    --card-bg: #ffffff;
    --border-color: #e2e8f0;
    --radius-lg: 16px;
    --radius-md: 12px;
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
  }

  body {
    background-color: #f1f5f9;
  }

  .settings-wrapper {
    max-width: 1140px;
    margin: 0 auto;
  }

  .glass-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glass-card:hover {
    box-shadow: var(--shadow-lg);
  }

  .custom-switch-card {
    padding: 24px;
    border-radius: var(--radius-md);
    background: #ffffff;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .custom-switch-card:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  .status-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .status-badge-active {
    background-color: #d1fae5;
    color: #047857;
  }

  .status-badge-disabled {
    background-color: #fee2e2;
    color: #b91c1c;
  }

  .btn-toggle-switch {
    min-width: 180px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 0.85rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .toast-container-custom {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 9999;
  }
</style>

<script>window.CURRENT_USER_ROLE = "Admin";</script>

<!-- Auto-Dismissing Flash Toast Notifications -->
<div class="toast-container-custom">
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <% success.forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-3 mb-2 auto-dismiss-alert" role="alert">
        <div class="d-flex align-items-center">
          <i class="bi bi-check-circle-fill fs-5 me-2"></i>
          <div><%= msg %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <% error.forEach(function(msg) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-lg border-0 rounded-3 mb-2 auto-dismiss-alert" role="alert">
        <div class="d-flex align-items-center">
          <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
          <div><%= msg %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% }) %>
  <% } %>
</div>

<div class="container-fluid py-4 settings-wrapper">
  <%- include("./_nav.ejs", { active: "settings" }) %>

  <!-- Hero Header -->
  <div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-lg position-relative overflow-hidden" style="background: var(--primary-gradient);">
    <div class="position-relative z-1 max-w-2xl">
      <span class="badge bg-white text-dark mb-2 px-3 py-2 rounded-pill fw-bold text-uppercase tracking-wider fs-12">
        <i class="bi bi-gear-wide-connected text-primary me-1"></i> Admin Governance
      </span>
      <h2 class="fw-bold display-6 mb-1">Messaging Configuration</h2>
      <p class="text-slate-300 mb-0 opacity-87 fs-6">Manage separate reply permissions across student, teacher, and admin channels.</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Main Controls Column -->
    <div class="col-lg-8">
      <div class="glass-card p-4 p-md-5">
        
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
          <div>
            <h5 class="fw-bold text-dark mb-1">Granular Reply Permissions</h5>
            <p class="text-muted small mb-0">Toggle independent reply channels across roles.</p>
          </div>
          <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold fs-12">
            <i class="bi bi-shield-lock-fill text-primary me-1"></i> System Rules
          </span>
        </div>

        <div class="d-flex flex-column gap-3">
          
          <!-- 1. Student to Admin Permission -->
          <div class="custom-switch-card d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-start gap-3">
              <div class="p-3 bg-light rounded-3 text-primary d-none d-sm-block">
                <i class="bi bi-mortarboard-fill fs-4"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <h6 class="fw-bold text-dark mb-0">Student Reply → Admin</h6>
                  <% if (messagesettings && messagesettings.allowStudentToAdminReply) { %>
                    <span class="status-badge status-badge-active"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                  <% } else { %>
                    <span class="status-badge status-badge-disabled"><i class="bi bi-x-circle-fill me-1"></i> Disabled</span>
                  <% } %>
                </div>
                <p class="text-muted small mb-0">Enables or disables students' ability to send direct reply messages back to Admin broadcasts.</p>
              </div>
            </div>

            <form action="/admin/message/settings/toggle-student-admin-reply" method="POST" class="ms-auto me-0 toggleForm">
              <% if (messagesettings && messagesettings.allowStudentToAdminReply) { %>
                <button type="submit" class="btn btn-danger btn-toggle-switch shadow-sm">
                  <i class="bi bi-toggle-on fs-5"></i> Disable Reply
                </button>
              <% } else { %>
                <button type="submit" class="btn btn-success btn-toggle-switch shadow-sm" style="background-color: var(--accent-emerald);">
                  <i class="bi bi-toggle-off fs-5"></i> Enable Reply
                </button>
              <% } %>
            </form>
          </div>

          <!-- 2. Student to Teacher Permission -->
          <div class="custom-switch-card d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-start gap-3">
              <div class="p-3 bg-light rounded-3 text-primary d-none d-sm-block">
                <i class="bi bi-book-fill fs-4"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <h6 class="fw-bold text-dark mb-0">Student Reply → Teacher</h6>
                  <% if (messagesettings && messagesettings.allowStudentToTeacherReply) { %>
                    <span class="status-badge status-badge-active"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                  <% } else { %>
                    <span class="status-badge status-badge-disabled"><i class="bi bi-x-circle-fill me-1"></i> Disabled</span>
                  <% } %>
                </div>
                <p class="text-muted small mb-0">Enables or disables students' ability to respond to faculty assignment and notice broadcasts.</p>
              </div>
            </div>

            <form action="/admin/message/settings/toggle-student-teacher-reply" method="POST" class="ms-auto me-0 toggleForm">
              <% if (messagesettings && messagesettings.allowStudentToTeacherReply) { %>
                <button type="submit" class="btn btn-danger btn-toggle-switch shadow-sm">
                  <i class="bi bi-toggle-on fs-5"></i> Disable Reply
                </button>
              <% } else { %>
                <button type="submit" class="btn btn-success btn-toggle-switch shadow-sm" style="background-color: var(--accent-emerald);">
                  <i class="bi bi-toggle-off fs-5"></i> Enable Reply
                </button>
              <% } %>
            </form>
          </div>

          <!-- 3. Teacher to Admin Permission -->
          <div class="custom-switch-card d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-start gap-3">
              <div class="p-3 bg-light rounded-3 d-none d-sm-block" style="color: var(--accent-emerald);">
                <i class="bi bi-person-badge-fill fs-4"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <h6 class="fw-bold text-dark mb-0">Teacher Reply → Admin</h6>
                  <% if (messagesettings && messagesettings.allowTeacherToAdminReply) { %>
                    <span class="status-badge status-badge-active"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                  <% } else { %>
                    <span class="status-badge status-badge-disabled"><i class="bi bi-x-circle-fill me-1"></i> Disabled</span>
                  <% } %>
                </div>
                <p class="text-muted small mb-0">Enables or disables faculty members' ability to reply directly to admin directives.</p>
              </div>
            </div>

            <form action="/admin/message/settings/toggle-teacher-admin-reply" method="POST" class="ms-auto me-0 toggleForm">
              <% if (messagesettings && messagesettings.allowTeacherToAdminReply) { %>
                <button type="submit" class="btn btn-danger btn-toggle-switch shadow-sm">
                  <i class="bi bi-toggle-on fs-5"></i> Disable Reply
                </button>
              <% } else { %>
                <button type="submit" class="btn btn-success btn-toggle-switch shadow-sm" style="background-color: var(--accent-emerald);">
                  <i class="bi bi-toggle-off fs-5"></i> Enable Reply
                </button>
              <% } %>
            </form>
          </div>

        </div>

      </div>
    </div>

    <!-- Sidebar Policy & Live Status Widget -->
    <div class="col-lg-4">
      <div class="sticky-top" style="top: 24px;">
        
        <!-- Status Overview Card -->
        <div class="glass-card p-4 mb-4">
          <h6 class="fw-bold text-dark mb-3">
            <i class="bi bi-sliders me-1.5 text-primary"></i> Current Portal Policy
          </h6>

          <div class="p-3 rounded-3 bg-light mb-3 border">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="small fw-semibold text-dark"><i class="bi bi-mortarboard me-1"></i> Student → Admin</span>
              <% if (messagesettings && messagesettings.allowStudentToAdminReply) { %>
                <span class="badge bg-success rounded-pill px-2.5 py-1 fs-12">Allowed</span>
              <% } else { %>
                <span class="badge bg-secondary rounded-pill px-2.5 py-1 fs-12">Blocked</span>
              <% } %>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="small fw-semibold text-dark"><i class="bi bi-book me-1"></i> Student → Teacher</span>
              <% if (messagesettings && messagesettings.allowStudentToTeacherReply) { %>
                <span class="badge bg-success rounded-pill px-2.5 py-1 fs-12">Allowed</span>
              <% } else { %>
                <span class="badge bg-secondary rounded-pill px-2.5 py-1 fs-12">Blocked</span>
              <% } %>
            </div>

            <div class="d-flex align-items-center justify-content-between">
              <span class="small fw-semibold text-dark"><i class="bi bi-person-badge me-1"></i> Teacher → Admin</span>
              <% if (messagesettings && messagesettings.allowTeacherToAdminReply) { %>
                <span class="badge bg-success rounded-pill px-2.5 py-1 fs-12">Allowed</span>
              <% } else { %>
                <span class="badge bg-secondary rounded-pill px-2.5 py-1 fs-12">Blocked</span>
              <% } %>
            </div>
          </div>

          <p class="text-muted fs-12 mb-0">Changes apply immediately system-wide. Users will see updated reply inputs upon page refresh.</p>
        </div>

        <!-- Security Note -->
        <div class="glass-card p-4 bg-white border-start border-4 border-primary">
          <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check me-1.5 text-primary"></i> Security Note</h6>
          <ul class="text-muted small ps-3 mb-0">
            <li class="mb-1">Disabling replies hides reply inputs for the specified role.</li>
            <li class="mb-1">Admin broadcast dispatch capabilities remain unaffected.</li>
            <li>All toggle updates redirect cleanly back to `/admin/message/settings`.</li>
          </ul>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    'use strict';

    // Form Double Submission Protection & Loading State
    document.querySelectorAll(".toggleForm").forEach(form => {
      form.addEventListener("submit", function (e) {
        const btn = form.querySelector("button[type='submit']");
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Updating...`;
        }
      });
    });

    // Auto dismiss toast alerts after 4 seconds
    document.addEventListener("DOMContentLoaded", () => {
      const alerts = document.querySelectorAll(".auto-dismiss-alert");
      alerts.forEach((alertEl) => {
        setTimeout(() => {
          if (typeof bootstrap !== 'undefined' && bootstrap.Alert) {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
            if (bsAlert) bsAlert.close();
          } else {
            alertEl.remove();
          }
        }, 4000);
      });
    });

  })();
</script>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/socketClient.js"></script>