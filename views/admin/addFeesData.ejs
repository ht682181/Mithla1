<%- layout("/layouts/boilerplate") %>

<div class="container my-5">


  
  <h2 class="mb-4 text-dark fw-bold border-bottom pb-2"> 🚩 Student Fees Initialization Board </h2>

   <div class="d-flex gap-2 flex-wrap mt-3">

        <a href="/show/student" class="btn btn-dark shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 btn-premium-action" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: none;">
        <i class="fa-solid fa-plus" style="font-size: 12px;"></i> Show Student
      </a>

    <a href="/fees/collect-bulk" class="btn btn-dark  border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-eye" style="font-size: 12px;"></i>Collect  Fee
      </a>

      <a href="/show/fee/dashboard" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-link" style="font-size: 12px;"></i> Show Collection
      </a>
    </div>
  

  <!-- SEARCH FILTERS PANEL -->
  <div class="card p-4 shadow-sm mb-4 bg-white border-0  mt-4">
    <form action="/add/student/fees" method="GET" class="row g-3 needs-validation" novalidate>
      
      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Class / Branch</label>
        <select name="className" class="form-select" required>
          <option value="">Choose class...</option>
          <% classData.forEach(c => { %>
            <option value="<%= c.class %>" <%= (query.className === c.class || query.baseCourse === c.class) ? 'selected' : '' %>><%= c.class %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Semester</label>
        <select name="semester" class="form-select" required>
          <option value="">Choose semester...</option>
          <% for(let i=1; i<=8; i++) { %>
            <option value="<%= i %>" <%= (query.semester == i || selectedSem == i) ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label fw-bold text-secondary">Section</label>
        <select name="section" class="form-select" required>
          <option value="">Choose section...</option>
          <% sectionData.forEach(s => { %>
            <option value="<%= s.name %>" <%= query.section === s.name ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn w-100 fw-bold py-2 shadow-sm text-white" style="background-color: #0f766e;">
          Load Batch Ledger
        </button>
      </div>
    </form>
  </div>

  <% if (students && students.length > 0) { %>

    <!-- ⚡ Dynamic Header Summary Badges (Class, Sec, Semesters, Mode) -->
    <div class="card p-3 mb-4 bg-light border-0 shadow-sm rounded-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge bg-dark fs-6 px-3 py-2">
            🏫 Class: <span class="text-warning"><%= query.className || query.baseCourse || 'N/A' %></span>
          </span>
          <span class="badge bg-secondary fs-6 px-3 py-2">
            📌 Section: <span class="text-info"><%= query.section || 'N/A' %></span>
          </span>
          <span class="badge bg-primary fs-6 px-3 py-2">
            📚 Target Semesters: <span class="text-white">Sem-<%= activeSemesters[0] %> & Sem-<%= activeSemesters[1] %></span>
          </span>
          <% if (query.batchSession) { %>
            <span class="badge bg-info text-dark fs-6 px-3 py-2">
              📅 Session: <%= query.batchSession %>
            </span>
          <% } %>
        </div>

        <div>
          <% if (isEditMode) { %>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2 border border-dark fw-bold">
              ✏️ EDIT MODE
            </span>
          <% } else { %>
            <span class="badge bg-success fs-6 px-3 py-2 fw-bold">
              ✨ NEW INITIALIZATION
            </span>
          <% } %>
        </div>
      </div>
    </div>
    
    <!-- SINGLE INJECTOR ENGINE -->
    <div class="card p-3 mb-4 text-white border-0 shadow-sm" style="background-color: #0f766e;">
      <div class="row align-items-center g-3">
        <div class="col-lg-5">
          <span class="fw-bold fs-5">⚡ Global Year-Fees Injector (Sem-<%= activeSemesters[0] %> & Sem-<%= activeSemesters[1] %>):</span>
        </div>
        <div class="col-lg-4">
          <input type="number" id="masterYearFee" class="form-control" placeholder="Enter Full Year Fees Amount (e.g. 40000)">
        </div>
        <div class="col-lg-3">
          <button type="button" onclick="applyGlobalYearFee()" class="btn btn-dark w-100 fw-bold">Inject & Auto-Divide</button>
        </div>
      </div>
    </div>

    <!-- MAIN STUDENT LEDGER MATRIX FORM -->
    <form action="/fees/save-bulk-ledger" method="POST" id="ledgerGridForm" onsubmit="return validateGridForm()" class="needs-validation" novalidate>
      <input type="hidden" name="semA" value="<%= activeSemesters[0] %>">
      <input type="hidden" name="semB" value="<%= activeSemesters[1] %>">
      <input type="hidden" name="className" value="<%= query.className || query.baseCourse %>">
      <input type="hidden" name="section" value="<%= query.section %>">
      <!-- ⚡ Hidden Flag for Edit Mode Detection -->
      <input type="hidden" name="isEditMode" value="<%= isEditMode ? 'true' : 'false' %>">

      <% if (isEditMode) { %>
        <div class="alert alert-warning fw-bold d-flex align-items-center justify-content-between mb-3 shadow-sm border border-warning">
          <span>✏️ EDIT MODE ACTIVE: Updating existing fee structure for Semester <%= activeSemesters[0] %> & <%= activeSemesters[1] %>.</span>
          <span class="badge bg-dark">Recalculation On Save</span>
        </div>
      <% } %>

      <div class="table-responsive shadow-sm rounded">
        <table class="table align-middle bg-white table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th style="width: 10%;">Admin No</th>
              <th style="width: 15%;">Student Name</th>
              <th style="width: 15%;">Father Name</th>
              <th style="width: 10%;">Session</th>
              <th style="width: 12%;">Year Total Fees (₹)</th>
              <th style="width: 13%;">Semester <%= activeSemesters[0] %> (₹)</th>
              <th style="width: 13%;">Semester <%= activeSemesters[1] %> (₹)</th>
              <th style="width: 12%;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach((student, index) => { %>
              <tr class="student-row-item">
                <td>
                  <input type="hidden" name="fees[<%= index %>][student_id]" value="<%= student._id %>">
                  <input type="hidden" name="fees[<%= index %>][rollNumber]" value="<%= student.rollNo %>">
                  <input type="hidden" name="fees[<%= index %>][studentName]" value="<%= student.name %>">
                  <input type="hidden" name="fees[<%= index %>][fatherName]" value="<%= student.fatherName || 'N/A' %>">
                  <input type="hidden" name="fees[<%= index %>][session]" value="<%= student.session %>">
                  
                  <span class="badge bg-secondary fs-6"><%= student.rollNo %></span>
                </td>
                <td class="fw-semibold text-dark">
                  <%= student.name %>
                  <% if (student.hasPaidInTargetSems) { %>
                    <span class="badge bg-success ms-1" style="font-size: 0.65rem;" title="Fees already paid for these sem(s)">Paid</span>
                  <% } %>
                </td>
                <td class="text-secondary"><%= student.fatherName || 'N/A' %></td>
                
                <td>
                  <span class="badge bg-info text-dark fw-bold"><%= student.session || 'N/A' %></span>
                </td>
                
                <td>
                  <input type="number" class="form-control form-control-sm row-year-total" value="<%= student.existingYearTotal %>" oninput="divideRowFeesEqually(this)">
                </td>
                
                <td>
                  <input type="number" name="fees[<%= index %>][due_amount_A]" class="form-control form-control-sm row-semA-input" value="<%= student.semADue %>" oninput="recalculateRowTotal(this)">
                </td>
                <td>
                  <input type="number" name="fees[<%= index %>][due_amount_B]" class="form-control form-control-sm row-semB-input" value="<%= student.semBDue %>" oninput="recalculateRowTotal(this)">
                </td>
                
                <td>
                  <select name="fees[<%= index %>][status]" class="form-select form-select-sm row-status-select" onchange="toggleRowState(this)">
                    <option value="Active">Active</option>
                    <option value="Left College">Left College</option>
                  </select>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- LIVE EXPECTED COLLECTION DASHBOARD -->
      <div class="card my-4 border-0 shadow-sm text-white" style="background-color: #1e293b;">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3 text-warning border-bottom pb-2">📈 Live Grid Summary (Expected Collection)</h5>
          <div class="row g-3 text-center">
            
            <div class="col-md-4 border-end border-secondary">
              <p class="text-muted small mb-1 fw-semibold text-uppercase">Grand Total Year Collection</p>
              <h3 class="fw-bold text-success" id="grandYearTotal">₹0</h3>
            </div>

            <div class="col-md-4 border-end border-secondary">
              <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Semester <%= activeSemesters[0] %> Collection</p>
              <h3 class="fw-bold text-info" id="grandSemATotal">₹0</h3>
            </div>

            <div class="col-md-4">
              <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Semester <%= activeSemesters[1] %> Collection</p>
              <h3 class="fw-bold text-info" id="grandSemBTotal">₹0</h3>
            </div>

          </div>
        </div>
      </div>

      <div class="text-end mt-4">
        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow">
          <%= isEditMode ? 'Update & Recalculate Ledger' : 'Save Batch Matrix Allocations' %>
        </button>
      </div>
    </form>

  <% } else if (selectedSem) { %>
    <div class="alert alert-warning text-center fw-semibold">No active student profiles discovered matching the requested query parameters.</div>
  <% } %>

</div>

<!-- GRID CONTROLLER LOGIC SCRIPTS -->
<script>
function updateGrandTotals() {
  let totalYear = 0;
  let totalSemA = 0;
  let totalSemB = 0;

  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    if (row.querySelector('.row-status-select').value === "Active") {
      const yearVal = parseFloat(row.querySelector('.row-year-total').value) || 0;
      const semAVal = parseFloat(row.querySelector('.row-semA-input').value) || 0;
      const semBVal = parseFloat(row.querySelector('.row-semB-input').value) || 0;

      totalYear += yearVal;
      totalSemA += semAVal;
      totalSemB += semBVal;
    }
  });

  document.getElementById('grandYearTotal').innerText = '₹' + totalYear.toLocaleString('en-IN');
  document.getElementById('grandSemATotal').innerText = '₹' + totalSemA.toLocaleString('en-IN');
  document.getElementById('grandSemBTotal').innerText = '₹' + totalSemB.toLocaleString('en-IN');
}

function applyGlobalYearFee() {
  const annualAmount = parseFloat(document.getElementById('masterYearFee').value) || 0;
  if(annualAmount <= 0) {
    alert("Kripya ek valid price enter karein!");
    return;
  }
  
  const splitShare = annualAmount / 2;
  const rows = document.querySelectorAll('.student-row-item');
  
  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      row.querySelector('.row-year-total').value = annualAmount;
      row.querySelector('.row-semA-input').value = splitShare;
      row.querySelector('.row-semB-input').value = splitShare;
    }
  });
  
  updateGrandTotals();
}

function divideRowFeesEqually(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const totalAmt = parseFloat(inputElement.value) || 0;
  row.querySelector('.row-semA-input').value = totalAmt / 2;
  row.querySelector('.row-semB-input').value = totalAmt / 2;
  
  updateGrandTotals();
}

function recalculateRowTotal(inputElement) {
  const row = inputElement.closest('.student-row-item');
  const sA = parseFloat(row.querySelector('.row-semA-input').value) || 0;
  const sB = parseFloat(row.querySelector('.row-semB-input').value) || 0;
  row.querySelector('.row-year-total').value = sA + sB;
  
  updateGrandTotals();
}

function toggleRowState(selectElement) {
  const row = selectElement.closest('.student-row-item');
  const inputs = row.querySelectorAll('input[type="number"]');
  if(selectElement.value === "Left College") {
    row.style.opacity = "0.4";
    inputs.forEach(i => {
      i.readOnly = true;
      i.style.backgroundColor = "#e9ecef";
    });
  } else {
    row.style.opacity = "1";
    inputs.forEach(i => {
      i.readOnly = false;
      i.style.backgroundColor = "#fff";
    });
  }
  
  updateGrandTotals();
}

function validateGridForm() {
  const rows = document.querySelectorAll('.student-row-item');
  let valid = true;

  rows.forEach(row => {
    if(row.querySelector('.row-status-select').value === "Active") {
      const yearFee = parseFloat(row.querySelector('.row-year-total').value) || 0;
      if(yearFee <= 0) {
        valid = false;
        row.querySelector('.row-year-total').style.border = "2px solid red";
      } else {
        row.querySelector('.row-year-total').style.border = "1px solid #dee2e6";
      }
    }
  });

  if(!valid) {
    alert("⚠️ Validation Warning: The fee amount for all active students must be greater than ₹0.");
    return false;
  }
  return true;
}

document.addEventListener("DOMContentLoaded", () => {
  updateGrandTotals();
});
</script>