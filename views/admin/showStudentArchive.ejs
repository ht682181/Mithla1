<%- layout("/layouts/boilerplate") -%>

<style>
  /* 🌟 Premium Slate-Grey Archival Vibe */
  body {
    background: linear-gradient(135deg, #f4f7fa 0%, #e9eff5 100%);
    color: #1e293b;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    min-height: 100vh;
  }

  /* ✨ Core Entrance Transition */
  .animate-entrance {
    animation: smoothSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes smoothSlideUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 💎 Glossy Premium Soft Cards */
  .premium-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.8) !important;
    border-radius: 16px !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02) !important;
    transition: all 0.3s ease;
  }

  /* 🎛️ Modern Form Controls */
  .premium-control {
    border: 1px solid #cbd5e1 !important;
    border-radius: 10px !important;
    padding: 11px 16px !important;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .premium-control:focus {
    border-color: #475569 !important;
    box-shadow: 0 0 0 4px rgba(71, 85, 105, 0.1) !important;
  }

  /* 🚀 Action Buttons */
  .btn-premium-action {
    border-radius: 10px !important;
    font-weight: 600;
    font-size: 14px;
    padding: 11px 24px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-premium-action:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  /* 📊 High-End Table System */
  .grid-header-gradient {
    background: linear-gradient(90deg, #334155 0%, #1e293b 100%) !important;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 18px !important;
  }

  .premium-table th {
    background-color: #f8fafc !important;
    color: #475569 !important;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 14px !important;
    border-bottom: 2px solid #e2e8f0 !important;
  }

  .premium-table td {
    padding: 16px 14px !important;
    border-bottom: 1px solid #f1f5f9 !important;
    font-size: 14px;
    color: #334155;
  }

  /* 📄 Minimalist Pagination Controls */
  .premium-page-link {
    color: #475569;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 9px 16px;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .premium-page-link:hover {
    background-color: #f8fafc;
    color: #1e293b;
  }

  .premium-page-item.active .premium-page-link {
    background-color: #475569;
    border-color: #475569;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(71, 85, 105, 0.25);
  }

  .premium-dots {
    padding: 8px 10px;
    color: #94a3b8;
    font-weight: 700;
  }

  /* ⚠️ Float Error Bar */
  .validation-banner {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: #c2410c;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fed7aa;
    padding: 12px 20px;
    border-radius: 10px;
    animation: smoothSlideUp 0.3s ease forwards;
  }
</style>

<div class="container my-5 animate-entrance">

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold text-dark m-0" style="letter-spacing: -0.8px;">📦 Student Archive Registry</h2>
      <p class="text-muted small mb-0 mt-1">Manage, Track & Audit Permanent Passout Student Records</p>
    </div>
    
    <div class="d-flex gap-2">
      <a href="/archive/student/record" class="btn btn-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 btn-premium-action" style="background: #475569; border: none;">
        <i class="fa-solid fa-box-archive" style="font-size: 12px;"></i> Archive Action 
      </a>
    </div>
  </div>

  <div class="card p-4 premium-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="fw-bold text-secondary text m-0">🔍 Historical Search Index</h3>
        <p class="text-muted small m-0 mt-1">Matching Records: <span class="badge bg-secondary text-white fw-bold px-2 py-1 fs-6 ms-1"><%= totalRecords %></span></p>
      </div>
      
      <% if(searchName || searchClass || searchSession) { %>
        <a href="/show/archive/student/record" class="btn btn-sm btn-danger px-3 py-1.5 rounded-pill fw-semibold d-inline-flex align-items-center gap-1 shadow-sm btn-premium-action" style="font-size: 13px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
          <i class="fa-solid fa-arrow-rotate-left"></i> Back to Default
        </a>
      <% } %>
    </div>
    
    <form action="/show/archive/student/record" method="GET" class="row justify-content-center g-3" id="searchForm" novalidate>
      
      <div class="col-12">
        <div class="validation-banner" id="validationAlert">
          <i class="fa-solid fa-triangle-exclamation me-2 text-warning"></i> Error: Please provide at least one search criterion (Name, Class or Session).
        </div>
      </div>

      <div class="col-md-4">
        <label class="form-label small fw-bold text-secondary">Student Name</label>
        <input type="text" name="name" id="searchNameField" value="<%= searchName %>" class="form-control shadow-none premium-control" placeholder="Search by name string...">
      </div>
      
      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary">Core Class Stream</label>
        <select name="class" id="searchClassField" class="form-select shadow-none premium-control">
          <option value="">Choose Class</option>
          <% for(let classOpt of uniqueClasses){ %>
            <option value="<%= classOpt %>" <%= searchClass === classOpt ? 'selected' : '' %>><%= classOpt %></option>
          <% } %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary">Batch Session</label>
        <select name="session" id="searchSessionField" class="form-select shadow-none premium-control">
          <option value="">Choose Session</option>
          <% for(let sessionOpt of uniqueSessions){ %>
            <option value="<%= sessionOpt %>" <%= searchSession === sessionOpt ? 'selected' : '' %>><%= sessionOpt %></option>
          <% } %>
        </select>
      </div>
      
      <div class="col-md-2 d-grid align-items-end">
        <button type="submit" class="btn btn-secondary btn-premium-action shadow-sm text-white" style="background: linear-gradient(135deg, #475569 0%, #1e293b 100%); border: none;">Execute Query</button>
      </div>
    </form>
  </div>

  <div class="card premium-card overflow-hidden">
    <div class="grid-header-gradient text-center">
      <h5 class="mb-0 fw-bold text-white" style="letter-spacing: 0.5px;">Student Archive Database Logs</h5>
    </div>
    
    <div class="table-responsive">
      <table class="table table-hover premium-table align-middle text-center mb-0">
        <thead>
          <tr>
            <th class="p-3">Roll No</th>
            <th>Name</th>
            <th>Father's Name</th>
            <th>Class Core</th>
            <th>Sem Data</th>
            <th>Section</th>
            <th>Session</th>
            <th>Email Backup</th>
            <th>Attendance Tracker</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if(datas && datas.length > 0) { %>
            <% for (let data of datas) { %>
              <tr>
                <td class="fw-bold text-secondary" style="font-size: 13.5px;"><%= data.rollNo %></td>
                <td><span class="fw-bold text-dark"><%= data.name %></span></td>
                <td><%= data.fatherName %></td>
                <td><span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-2 fw-semibold" style="border-color: #cbd5e1 !important;"><%= data.class %></span></td>
                <td class="text-muted fw-semibold">Sem-<%= data.semester || "N/A" %></td>
                <td class="text-uppercase fw-bold text-secondary"><%= data.section || "N/A" %></td>
                <td class="text-muted small"><%= data.session %></td>
                <td class="small text-muted"><%= data.email || "N/A" %></td>
                <td>
                  <a href="/archive/student/status/<%= data.rollNo %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold btn-premium-action" style="font-size: 12px; padding: 5px 14px;">View Logs</a>
                </td>
                <td>
                  <span class="badge bg-success-subtle text-success border px-2.5 py-1.5 rounded-pill fw-bold text-uppercase" style="font-size: 11px;"><%= data.status || "passout" %></span>
                </td>
              </tr>
            <% } %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                <i class="fa-solid fa-box-open fs-2 d-block mb-2 opacity-40"></i>
                No matching archival logs found inside the system repository stack.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="card-footer bg-white border-0 py-4 d-flex justify-content-center border-top">
        <nav>
          <ul class="pagination pagination-sm gap-2 mb-0 align-items-center">
            
            <% if (currentPage > 1) { %>
              <li class="premium-page-item">
                <a class="premium-page-link btn-premium-action" style="padding: 8px 14px;" href="?page=<%= currentPage - 1 %>&name=<%= searchName %>&class=<%= searchClass %>&session=<%= searchSession %>">Previous</a>
              </li>
            <% } %>

            <% 
              let delta = 1; 
              let left = currentPage - delta;
              let right = currentPage + delta + 1;
              let range = [];
              let rangeWithDots = [];
              let l;

              for (let i = 1; i <= totalPages; i++) {
                  if (i == 1 || i == totalPages || (i >= left && i < right)) {
                      range.push(i);
                  }
              }

              for (let i of range) {
                  if (l) {
                      if (i - l === 2) {
                          rangeWithDots.push(l + 1);
                      } else if (i - l !== 1) {
                          rangeWithDots.push('...');
                      }
                  }
                  rangeWithDots.push(i);
                  l = i;
              }
            %>

            <% for(let pageNumber of rangeWithDots) { %>
              <% if(pageNumber === '...') { %>
                <li class="premium-dots">...</li>
              <% } else { %>
                <li class="premium-page-item <%= currentPage === pageNumber ? 'active' : '' %>">
                  <a class="premium-page-link" href="?page=<%= pageNumber %>&name=<%= searchName %>&class=<%= searchClass %>&session=<%= searchSession %>"><%= pageNumber %></a>
                </li>
              <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <li class="premium-page-item">
                <a class="premium-page-link btn-premium-action" style="padding: 8px 14px;" href="?page=<%= currentPage + 1 %>&name=<%= searchName %>&class=<%= searchClass %>&session=<%= searchSession %>">Next</a>
              </li>
            <% } %>

          </ul>
        </nav>
      </div>
    <% } %>

  </div>
</div>

<script>
  // 🔍 3-Way Independent Choice Validation Engine
  document.getElementById('searchForm').addEventListener('submit', function (e) {
    const nameInput = document.getElementById('searchNameField');
    const classSelect = document.getElementById('searchClassField');
    const sessionSelect = document.getElementById('searchSessionField');
    const alertBanner = document.getElementById('validationAlert');

    const nameVal = nameInput.value.trim();
    const classVal = classSelect.value;
    const sessionVal = sessionSelect.value;

    // Reset layout formats
    nameInput.style.borderColor = "#cbd5e1";
    classSelect.style.borderColor = "#cbd5e1";
    sessionSelect.style.borderColor = "#cbd5e1";
    alertBanner.style.display = "none";

    // Block logic agar teeno filter fields pure khali hain
    if (!nameVal && !classVal && !sessionVal) {
      e.preventDefault(); 

      nameInput.style.borderColor = "#fca5a5";
      classSelect.style.borderColor = "#fca5a5";
      sessionSelect.style.borderColor = "#fca5a5";
      alertBanner.style.display = "block";
    }
  });
</script>







