<%- layout("/layouts/boilerplate") -%>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: #f4f6f9;
}

.delete-card {
  background: #ffffff;
  border-radius: 24px !important;
  padding: 45px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(226, 232, 240, 0.8);
}

.delete-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
  background: #dc2626;
}

.danger-icon {
  width: 90px;
  height: 90px;
  margin: auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dc2626;
  color: white;
  font-size: 36px;
  box-shadow: 0 15px 30px rgba(220, 38, 38, 0.2);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.06); box-shadow: 0 15px 35px rgba(220, 38, 38, 0.35); }
  100% { transform: scale(1); }
}

.premium-input {
  height: 56px;
  border-radius: 14px !important;
  border: 2px solid #e2e8f0;
  font-weight: 600;
  color: #334155;
  transition: all 0.3s ease;
}

.premium-input:focus {
  border-color: #dc2626 !important;
  box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.15) !important;
}

.warning-box {
  background: #fff5f5;
  padding: 20px;
  border-left: 5px solid #dc2626;
  border-radius: 16px;
}

.delete-btn {
  border: none;
  padding: 16px 55px;
  font-size: 16px;
  font-weight: 700;
  border-radius: 50px;
  color: white !important;
  background: #dc2626;
  box-shadow: 0 12px 30px rgba(220, 38, 38, 0.25);
  transition: all 0.3s ease;
}

.delete-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 35px rgba(220, 38, 38, 0.4);
}

.form-label {
  color: #475569;
  font-size: 0.95rem;
}
</style>

<div class="container my-5 animate-entrance" style="max-width: 850px;">
  
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-start">
      <a href="/show/archive/student/record" class="btn btn-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2" style="background: #475569; border: none;">
        <i class="fa-solid fa-box-archive" style="font-size: 12px;"></i> Show Archive Students 
      </a>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      
      <div class="card delete-card">

        <div class="text-center mb-5">
          <div class="danger-icon">
            <i class="fa-solid fa-trash-can"></i>
          </div>
          <h3 class="fw-800 text-uppercase tracking-wide mt-4 mb-2" style="color: #dc2626; font-size: 1.8rem; font-weight: 800;">
            Bulk Delete & Archive Batch
          </h3>
          <p class="text-secondary fw-medium small mb-0">
            Move student profiles and attendance logs to safety archive before wiping out live records.
          </p>
        </div>

        <form id="deleteForm" action="/archive/student/record" method="POST" class="needs-validation" novalidate>
          
          <input type="hidden" name="adminPassword" id="adminPassword">

          <div class="row g-4">
            <div class="col-md-6">
              <label class="form-label fw-bold mb-2">
                <i class="fa-solid fa-building-columns text-danger me-2"></i>Target Class
              </label>
              <select name="data[currentClass]" class="form-select premium-input" required>
                <option value="">Choose Class</option>
                <% for(let data of classData){ %>
                  <option value="<%= data.class %>"><%= data.class %></option>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold mb-2">
                <i class="fa-solid fa-layer-group text-danger me-2"></i>Target Semester
              </label>
              <select name="data[currentSemester]" class="form-select premium-input" required>
                <option value="">Choose Semester</option>
                <% for(let i=1; i<=8; i++){ %>
                  <option value="<%= i %>">Semester <%= i %></option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="warning-box mt-5">
            <div class="d-flex align-items-center">
              <i class="fa-solid fa-triangle-exclamation fs-3 text-danger me-3"></i>
              <div>
                <h6 class="fw-bold mb-1 text-dark">Security Action Required</h6>
                <p class="mb-0 text-secondary small">
                  This process requires Admin Password confirmation. Records will be detached immediately.
                </p>
              </div>
            </div>
          </div>

          <div class="text-center mt-5">
            <button type="submit" class="delete-btn">
              <i class="fa-solid fa-trash-can me-2"></i> Confirm & Proceed
            </button>
          </div>

        </form>

      </div> </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const form = document.getElementById("deleteForm");

  form.addEventListener("submit", function (e) {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.classList.add('was-validated');
      return;
    }

    // First Warning Popup
    Swal.fire({
      title: "Are you absolutely sure?",
      text: "This batch will be moved to history archive and deleted from live dashboard!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#dc2626",
      cancelButtonColor: "#718096",
      confirmButtonText: "Next",
      cancelButtonText: "Cancel",
      reverseButtons: true,
      customClass: { popup: 'rounded-4' }
    }).then((result) => {
      if (result.isConfirmed) {
        
        // Second Popup: Password Protection Verification
        Swal.fire({
          title: "Enter Admin Password",
          text: "Please verify security credentials to finalize operation.",
          input: "password",
          inputAttributes: {
            autocapitalize: "off",
            autocorrect: "off"
          },
          showCancelButton: true,
          confirmButtonColor: "#dc2626",
          cancelButtonColor: "#718096",
          confirmButtonText: "Verify & Execute",
          cancelButtonText: "Abort",
          reverseButtons: true,
          inputValidator: (value) => {
            if (!value) {
              return "You need to enter password to proceed!";
            }
          },
          customClass: { popup: 'rounded-4' }
        }).then((pwdResult) => {
          if (pwdResult.isConfirmed) {
            // Put password into hidden input field and submit form
            document.getElementById("adminPassword").value = pwdResult.value;
            form.submit();
          }
        });

      }
    });
  });
</script>