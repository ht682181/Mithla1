<%- layout("/layouts/boilerplateTeacher") -%>

<style>
  /* Base Container Responsiveness */
  .admin-panel-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: none;
  }
  
  .filter-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    border-radius: 12px 12px 0 0;
  }

  .section-banner {
    background: #f8fafc;
    border-left: 5px solid #2563eb;
    border-radius: 8px 8px 0 0;
  }

  /* Matrix Table & Overflow Responsive Engine */
  .table-responsive-custom {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid #cbd5e1;
  }

  /* Custom Smooth Scrollbar for Mobile/Inspect Mode */
  .table-responsive-custom::-webkit-scrollbar {
    height: 8px;
  }
  .table-responsive-custom::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  .table-responsive-custom::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 4px;
  }
  .table-responsive-custom::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }

  .table-matrix {
    font-size: 0.85rem;
    min-width: 1050px; /* Forces minimum readable width on mobile inspect */
    width: 100%;
    margin-bottom: 0 !important;
  }

  .table-matrix th {
    background-color: #f1f5f9;
    color: #334155;
    font-weight: 700;
    vertical-align: middle;
    text-align: center;
    border-bottom: 2px solid #cbd5e1;
    white-space: nowrap;
  }

  .table-matrix td {
    vertical-align: middle;
    text-align: center;
    white-space: nowrap;
  }

  .cell-marks {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .badge-absent {
    background-color: #fee2e2;
    color: #991b1b;
  }

  .badge-present {
    background-color: #dcfce7;
    color: #166534;
  }

  .summary-col {
    background-color: #f8fafc;
  }

  /* Mobile Inspect Adaptations */
  @media (max-width: 768px) {
    .filter-header h4 {
      font-size: 1.1rem;
    }
    .section-banner-controls {
      width: 100%;
      flex-direction: column;
      align-items: stretch !important;
    }
    .section-banner-controls input,
    .section-banner-controls button {
      width: 100% !important;
    }
  }
</style>

<div class="container-fluid px-2 px-md-4 py-3">
  
  <!-- 1. FILTER PANEL -->
  <div class="card admin-panel-card mb-4">
    <div class="filter-header p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <h4 class="m-0 fw-bold"><i class="bi bi-sliders me-2"></i>Admin Marks Management Panel</h4>
      <span class="badge bg-primary px-3 py-2">System Live</span>
    </div>
    <div class="card-body p-3 p-md-4">
      <form id="filterForm" class="row g-3">
        <!-- Step 1: Class Select -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label fw-bold small">1. Class</label>
          <select id="selectClass" class="form-select form-select-sm" required>
            <option value="" selected disabled>-- Select Class --</option>
            <% classes.forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>

        <!-- Step 2: Semester Select -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label fw-bold small">2. Semester</label>
          <select id="selectSemester" class="form-select form-select-sm" disabled required>
            <option value="" selected disabled>-- Semester --</option>
          </select>
        </div>

        <!-- Step 3: Academic Year Select -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label fw-bold small">3. Academic Year</label>
          <select id="selectAcademicYear" class="form-select form-select-sm" disabled required>
            <option value="" selected disabled>-- Academic Year --</option>
          </select>
        </div>

        <!-- Step 4: Exam Select -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label fw-bold small">4. Exam</label>
          <select id="selectExam" class="form-select form-select-sm" disabled required>
            <option value="" selected disabled>-- Exam --</option>
          </select>
        </div>

        <!-- Step 5: Search Button -->
        <div class="col-12 col-md-2 d-flex align-items-end">
          <button type="submit" id="btnSearch" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm py-2" disabled>
            <i class="bi bi-search me-1"></i> Show Records
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- CONTAINER FOR DYNAMIC SECTION TABLES -->
  <div id="sectionsContainer"></div>

</div>

<!-- EDIT MARKS MODAL -->
<div class="modal fade" id="editMarkModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title fs-6"><i class="bi bi-pencil-square me-2"></i>Edit Student Mark</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editMarkForm">
        <div class="modal-body">
          <input type="hidden" id="editRegisterId">
          <input type="hidden" id="editStudentId">
          <input type="hidden" id="editMaxMarks">

          <div class="mb-3">
            <label class="form-label fw-bold small">Student Name</label>
            <input type="text" id="editStudentName" class="form-control form-control-sm" readonly>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small">Attendance Status</label>
            <select id="editAttendance" class="form-select form-select-sm" required>
              <option value="Present">Present</option>
              <option value="Absent">Absent</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small">Obtained Marks (Max: <span id="maxMarksLabel"></span>)</label>
            <input type="number" id="editObtainedMarks" class="form-control form-control-sm" step="0.01" min="0" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold small">Remark</label>
            <input type="text" id="editRemarks" class="form-control form-control-sm" placeholder="Optional remark">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success btn-sm fw-bold">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title fs-6"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="deleteModalMessage" class="fw-semibold text-dark m-0 small"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light btn-sm border" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnExecuteDelete" class="btn btn-danger btn-sm fw-bold">Delete Permanently</button>
      </div>
    </div>
  </div>
</div>

<!-- CLIENT JAVASCRIPT ENGINE -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const selectClass = document.getElementById("selectClass");
  const selectSemester = document.getElementById("selectSemester");
  const selectAcademicYear = document.getElementById("selectAcademicYear");
  const selectExam = document.getElementById("selectExam");
  const btnSearch = document.getElementById("btnSearch");
  const sectionsContainer = document.getElementById("sectionsContainer");

  let currentRecords = [];
  let deleteActionType = null; // 'SECTION' or 'SUBJECT'
  let deletePayload = null;

  // STEP 1: Class Selection -> Load Semesters
  selectClass.addEventListener("change", async () => {
    resetSelects([selectSemester, selectAcademicYear, selectExam], btnSearch);
    const res = await fetch(`/api/marks/semesters?className=${encodeURIComponent(selectClass.value)}`);
    const sems = await res.json();
    populateSelect(selectSemester, sems, "Semester");
    selectSemester.disabled = false;
  });

  // STEP 2: Semester Selection -> Load Academic Years
  selectSemester.addEventListener("change", async () => {
    resetSelects([selectAcademicYear, selectExam], btnSearch);
    const url = `/api/marks/academic-years?className=${encodeURIComponent(selectClass.value)}&semester=${selectSemester.value}`;
    const res = await fetch(url);
    const years = await res.json();
    populateSelect(selectAcademicYear, years, "Academic Year");
    selectAcademicYear.disabled = false;
  });

  // STEP 3: Academic Year Selection -> Load Exams
  selectAcademicYear.addEventListener("change", async () => {
    resetSelects([selectExam], btnSearch);
    const url = `/api/marks/exams?className=${encodeURIComponent(selectClass.value)}&semester=${selectSemester.value}&academicYear=${selectAcademicYear.value}`;
    const res = await fetch(url);
    const exams = await res.json();
    populateSelect(selectExam, exams, "Exam");
    selectExam.disabled = false;
  });

  // STEP 4: Exam Selection -> Enable Search Button
  selectExam.addEventListener("change", () => {
    btnSearch.disabled = false;
  });

  // SEARCH FORM SUBMISSION & RENDERING
  document.getElementById("filterForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    fetchAndRenderRecords();
  });

  async function fetchAndRenderRecords() {
    const url = `/api/marks/records?className=${encodeURIComponent(selectClass.value)}&semester=${selectSemester.value}&academicYear=${selectAcademicYear.value}&examName=${encodeURIComponent(selectExam.value)}`;
    const res = await fetch(url);
    const data = await res.json();

    if (!data.success || data.records.length === 0) {
      sectionsContainer.innerHTML = `<div class="alert alert-warning text-center fw-bold my-4">No records found for the selected filter criteria.</div>`;
      return;
    }

    currentRecords = data.records;
    renderSections(currentRecords);
  }

  // CORE MATRIX ENGINE: PIVOT SUBJECT REGISTERS TO SECTION-WISE TABLES
  function renderSections(records) {
    sectionsContainer.innerHTML = "";

    // Group records by Section
    const sectionsMap = {};
    records.forEach(r => {
      if (!sectionsMap[r.section]) sectionsMap[r.section] = [];
      sectionsMap[r.section].push(r);
    });

    Object.keys(sectionsMap).sort().forEach(secName => {
      const secRegisters = sectionsMap[secName];
      const sectionStatus = secRegisters.every(r => r.status === "LOCKED") ? "LOCKED" : "OPEN";

      // Consolidate unique students list
      const studentsMap = {};
      secRegisters.forEach(reg => {
        reg.students.forEach(s => {
          if (!studentsMap[s.studentId || s.rollNumber]) {
            studentsMap[s.studentId || s.rollNumber] = {
              studentId: s.studentId,
              rollNumber: s.rollNumber,
              studentName: s.studentName,
              fatherName: s.fatherName || ""
            };
          }
        });
      });

      const studentsList = Object.values(studentsMap).sort((a,b) => a.rollNumber.localeCompare(b.rollNumber, undefined, {numeric: true}));

      // Section Wrapper Card
      const card = document.createElement("div");
      card.className = "card admin-panel-card mb-4 shadow-sm";
      
      card.innerHTML = `
        <!-- Section Header Banner (Responsive Flexbox) -->
        <div class="card-header section-banner p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
              <span class="badge bg-dark fs-6">Section: ${secName}</span>
              <span class="badge ${sectionStatus === 'LOCKED' ? 'bg-danger' : 'bg-success'} fs-6">
                Status: ${sectionStatus}
              </span>
            </div>
            <div class="text-secondary small fw-bold">Class: ${selectClass.value} | Sem: ${selectSemester.value} | Year: ${selectAcademicYear.value} | Exam: ${selectExam.value}</div>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap section-banner-controls">
            <!-- Search Box per Section -->
            <input type="text" class="form-control form-control-sm search-student-input" placeholder="🔍 Search Roll / Name..." data-section="${secName}" style="width: 180px;">
            
            <!-- Export PDF Button -->
            <button class="btn btn-sm btn-outline-danger fw-bold btn-export-pdf" data-section="${secName}">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
            </button>

            <!-- Lock Toggle Button -->
            <button class="btn btn-sm ${sectionStatus === 'LOCKED' ? 'btn-warning' : 'btn-dark'} fw-bold btn-toggle-lock" 
                    data-section="${secName}" data-target="${sectionStatus === 'LOCKED' ? 'OPEN' : 'LOCKED'}">
              <i class="bi ${sectionStatus === 'LOCKED' ? 'bi-unlock-fill' : 'bi-lock-fill'} me-1"></i>
              ${sectionStatus === 'LOCKED' ? 'Unlock Section' : 'Lock Section'}
            </button>

            <!-- Delete Section Button -->
            <button class="btn btn-sm btn-danger fw-bold btn-delete-section" data-section="${secName}">
              <i class="bi bi-trash-fill me-1"></i> Delete Section
            </button>
          </div>
        </div>

        <!-- Responsive Table Container -->
        <div class="card-body p-0">
          <div class="table-responsive-custom">
            <table class="table table-bordered table-matrix align-middle" id="table-sec-${secName}">
              <thead>
                <!-- Header Row 1: Columns & Subject Headers -->
                <tr>
                  <th rowspan="2" style="width: 80px;">Roll No</th>
                  <th rowspan="2" style="width: 180px;">Student Name</th>
                  <th rowspan="2" style="width: 150px;">Father Name</th>
                  ${secRegisters.map(reg => `
                    <th colspan="1" style="min-width: 140px;">
                      <div class="fw-bold text-primary">${reg.subject}</div>
                      <div class="text-muted border-bottom pb-1 mb-1" style="font-size:0.75rem">
                        Max: ${reg.maxMarks} | Pass: ${reg.passMarks}
                      </div>
                      <div class="d-flex justify-content-center gap-1">
                        <button class="btn btn-sm btn-outline-danger p-0 px-1 btn-delete-subject" data-id="${reg._id}" title="Delete Subject">
                          <i class="bi bi-x-circle"></i> Delete
                        </button>
                      </div>
                    </th>
                  `).join('')}
                  <!-- Summary Column Headers -->
                  <th rowspan="2" class="summary-col">Max Marks</th>
                  <th rowspan="2" class="summary-col">Obtained</th>
                  <th rowspan="2" class="summary-col">% Percentage</th>
                  <th rowspan="2" class="summary-col">Average</th>
                  <th rowspan="2" class="summary-col">Grade Remark</th>
                </tr>
                <!-- Header Row 2: Teacher Names -->
                <tr>
                  ${secRegisters.map(reg => `
                    <th class="bg-light text-secondary" style="font-size: 0.75rem;">
                      👨‍🏫 ${reg.teacherName || 'N/A'}
                    </th>
                  `).join('')}
                </tr>
              </thead>
              <tbody>
                ${studentsList.map(st => {
                  let grandMax = 0;
                  let grandObtained = 0;

                  const subjectCellsHtml = secRegisters.map(reg => {
                    grandMax += Number(reg.maxMarks);
                    const stRecord = reg.students.find(s => String(s.studentId) === String(st.studentId) || s.rollNumber === st.rollNumber);

                    if (!stRecord) {
                      return `<td><span class="text-muted">N/A</span></td>`;
                    }

                    const isAbsent = stRecord.attendanceStatus === "Absent";
                    const marksVal = isAbsent ? 0 : Number(stRecord.obtainedMarks);
                    grandObtained += marksVal;

                    return `
                      <td class="cell-marks" data-regid="${reg._id}" data-studentid="${stRecord.studentId || stRecord._id}">
                        <div class="d-flex flex-column align-items-center">
                          <span class="${isAbsent ? 'text-danger' : 'text-dark'}">${marksVal}</span>
                          <span class="badge ${isAbsent ? 'badge-absent' : 'badge-present'} mt-1" style="font-size: 0.65rem;">
                            ${stRecord.attendanceStatus}
                          </span>
                          ${stRecord.remarks ? `<small class="text-muted italic" style="font-size: 0.65rem;">"${stRecord.remarks}"</small>` : ''}
                          
                          ${sectionStatus === 'OPEN' ? `
                            <button class="btn btn-link btn-sm text-decoration-none p-0 mt-1 btn-edit-cell" 
                                    data-regid="${reg._id}" 
                                    data-studentid="${stRecord.studentId || stRecord._id}"
                                    data-studentname="${st.studentName}"
                                    data-maxmarks="${reg.maxMarks}"
                                    data-obtained="${stRecord.obtainedMarks}"
                                    data-attendance="${stRecord.attendanceStatus}"
                                    data-remarks="${stRecord.remarks || ''}"
                                    style="font-size:0.7rem;">
                              <i class="bi bi-pencil"></i> Edit
                            </button>
                          ` : ''}
                        </div>
                      </td>
                    `;
                  }).join('');

                  // Calculate Totals & Automatic Grade Remarks
                  const percentage = grandMax > 0 ? ((grandObtained / grandMax) * 100).toFixed(2) : "0.00";
                  const average = secRegisters.length > 0 ? (grandObtained / secRegisters.length).toFixed(2) : "0.00";
                  const gradeRemark = getGradeRemark(percentage);

                  return `
                    <tr class="student-row" data-roll="${st.rollNumber.toLowerCase()}" data-name="${st.studentName.toLowerCase()}">
                      <td class="fw-bold">${st.rollNumber}</td>
                      <td class="fw-semibold text-start ps-3">${st.studentName}</td>
                      <td class="text-start ps-3 text-muted">${st.fatherName || '-'}</td>
                      ${subjectCellsHtml}
                      <!-- Summary Calculations -->
                      <td class="fw-bold summary-col">${grandMax}</td>
                      <td class="fw-bold text-primary summary-col">${grandObtained}</td>
                      <td class="fw-bold summary-col ${percentage < 40 ? 'text-danger' : 'text-success'}">${percentage}%</td>
                      <td class="fw-bold summary-col">${average}</td>
                      <td class="summary-col">
                        <span class="badge ${getGradeBadgeClass(gradeRemark)}">${gradeRemark}</span>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;

      sectionsContainer.appendChild(card);
    });

    attachSectionEventListeners();
  }

  // AUTOMATIC GRADE & REMARK LOGIC MATRIX
  function getGradeRemark(pct) {
    const val = parseFloat(pct);
    if (val >= 90) return "Outstanding";
    if (val >= 80) return "Excellent";
    if (val >= 70) return "Very Good";
    if (val >= 60) return "Good";
    if (val >= 50) return "Average";
    if (val >= 40) return "Pass";
    return "Fail";
  }

  function getGradeBadgeClass(remark) {
    switch(remark) {
      case "Outstanding": return "bg-success";
      case "Excellent": return "bg-primary";
      case "Very Good": return "bg-info text-dark";
      case "Good": return "bg-secondary";
      case "Average": return "bg-warning text-dark";
      case "Pass": return "bg-dark";
      default: return "bg-danger";
    }
  }

  // EVENT LISTENERS FOR SECTION ACTIONS
  function attachSectionEventListeners() {
    // Search Filter
    document.querySelectorAll(".search-student-input").forEach(input => {
      input.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase().trim();
        const sec = e.target.getAttribute("data-section");
        const rows = document.querySelectorAll(`#table-sec-${sec} .student-row`);

        rows.forEach(row => {
          const roll = row.getAttribute("data-roll");
          const name = row.getAttribute("data-name");
          if (roll.includes(query) || name.includes(query)) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });
    });

    // Toggle Lock
    document.querySelectorAll(".btn-toggle-lock").forEach(btn => {
      btn.addEventListener("click", async () => {
        const section = btn.getAttribute("data-section");
        const targetStatus = btn.getAttribute("data-target");

        const res = await fetch("/api/marks/toggle-lock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            className: selectClass.value,
            semester: selectSemester.value,
            academicYear: selectAcademicYear.value,
            examName: selectExam.value,
            section,
            targetStatus
          })
        });

        const data = await res.json();
        if (data.success) fetchAndRenderRecords();
      });
    });

    // Edit Marks
    document.querySelectorAll(".btn-edit-cell").forEach(btn => {
      btn.addEventListener("click", () => {
        document.getElementById("editRegisterId").value = btn.getAttribute("data-regid");
        document.getElementById("editStudentId").value = btn.getAttribute("data-studentid");
        document.getElementById("editStudentName").value = btn.getAttribute("data-studentname");
        
        const maxM = btn.getAttribute("data-maxmarks");
        document.getElementById("editMaxMarks").value = maxM;
        document.getElementById("maxMarksLabel").innerText = maxM;

        document.getElementById("editObtainedMarks").value = btn.getAttribute("data-obtained");
        document.getElementById("editAttendance").value = btn.getAttribute("data-attendance");
        document.getElementById("editRemarks").value = btn.getAttribute("data-remarks");

        const modal = new bootstrap.Modal(document.getElementById("editMarkModal"));
        modal.show();
      });
    });

    // Delete Section
    document.querySelectorAll(".btn-delete-section").forEach(btn => {
      btn.addEventListener("click", () => {
        const section = btn.getAttribute("data-section");
        deleteActionType = 'SECTION';
        deletePayload = { section };

        document.getElementById("deleteModalMessage").innerText = `Are you sure? This will permanently delete all subject marks for Section "${section}".`;
        const modal = new bootstrap.Modal(document.getElementById("deleteConfirmModal"));
        modal.show();
      });
    });

    // Delete Subject
    document.querySelectorAll(".btn-delete-subject").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        deleteActionType = 'SUBJECT';
        deletePayload = { id };

        document.getElementById("deleteModalMessage").innerText = `Are you sure? This will permanently remove this Subject Register and all its associated student marks.`;
        const modal = new bootstrap.Modal(document.getElementById("deleteConfirmModal"));
        modal.show();
      });
    });

    // PDF Export
    document.querySelectorAll(".btn-export-pdf").forEach(btn => {
      btn.addEventListener("click", () => {
        const sec = btn.getAttribute("data-section");
        exportSectionPDF(sec);
      });
    });
  }

  // Absent check
  document.getElementById("editAttendance").addEventListener("change", (e) => {
    const marksInput = document.getElementById("editObtainedMarks");
    if (e.target.value === "Absent") {
      marksInput.value = 0;
      marksInput.readOnly = true;
    } else {
      marksInput.readOnly = false;
    }
  });

  // Submit Edit Form
  document.getElementById("editMarkForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const maxM = parseFloat(document.getElementById("editMaxMarks").value);
    const obtM = parseFloat(document.getElementById("editObtainedMarks").value);

    if (obtM > maxM) {
      alert(`Obtained marks (${obtM}) cannot be greater than Maximum marks (${maxM})`);
      return;
    }

    const payload = {
      registerId: document.getElementById("editRegisterId").value,
      studentId: document.getElementById("editStudentId").value,
      obtainedMarks: obtM,
      attendanceStatus: document.getElementById("editAttendance").value,
      remarks: document.getElementById("editRemarks").value
    };

    const res = await fetch("/api/marks/edit-student-mark", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    if (data.success) {
      bootstrap.Modal.getInstance(document.getElementById("editMarkModal")).hide();
      fetchAndRenderRecords();
    } else {
      alert(data.message);
    }
  });

  // Delete Action
  document.getElementById("btnExecuteDelete").addEventListener("click", async () => {
    if (deleteActionType === 'SECTION') {
      const res = await fetch("/api/marks/delete-section", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          className: selectClass.value,
          semester: selectSemester.value,
          academicYear: selectAcademicYear.value,
          examName: selectExam.value,
          section: deletePayload.section
        })
      });
      const data = await res.json();
      if (data.success) fetchAndRenderRecords();
    } else if (deleteActionType === 'SUBJECT') {
      const res = await fetch(`/api/marks/delete-subject/${deletePayload.id}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) fetchAndRenderRecords();
    }
    bootstrap.Modal.getInstance(document.getElementById("deleteConfirmModal")).hide();
  });

  function resetSelects(selects, button) {
    selects.forEach(s => {
      s.innerHTML = `<option value="" selected disabled>-- Select --</option>`;
      s.disabled = true;
    });
    if (button) button.disabled = true;
  }

  function populateSelect(elem, array, label) {
    elem.innerHTML = `<option value="" selected disabled>-- Select ${label} --</option>`;
    array.forEach(val => {
      const opt = document.createElement("option");
      opt.value = val;
      opt.innerText = val;
      elem.appendChild(opt);
    });
  }

  // Print Window Engine
  function exportSectionPDF(secName) {
    const tableHtml = document.getElementById(`table-sec-${secName}`).outerHTML;
    const printWindow = window.open('', '', 'height=700,width=1100');
    
    printWindow.document.write(`
      <html>
        <head>
          <title>Section Result - ${secName}</title>
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
          <style>
            body { font-family: sans-serif; padding: 20px; }
            .btn-edit-cell, .btn-delete-subject { display: none !important; }
            table { font-size: 10pt !important; width: 100% !important; min-width: auto !important; }
            th, td { text-align: center; vertical-align: middle; }
          </style>
        </head>
        <body>
          <h2 class="text-center fw-bold mb-1">SECTION RESULT SHEET</h2>
          <p class="text-center text-muted mb-4">
            Class: ${selectClass.value} | Semester: ${selectSemester.value} | Section: ${secName} | Year: ${selectAcademicYear.value} | Exam: ${selectExam.value}
          </p>
          ${tableHtml}
        </body>
      </html>
    `);
    
    printWindow.document.close();
    printWindow.focus();
    setTimeout(() => {
      printWindow.print();
      printWindow.close();
    }, 500);
  }
});
</script>