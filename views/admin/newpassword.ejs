<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mithla | Create New Password</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="website icon" type="png" href="/images/logo.png">

    <style>
        /* Modern Space Gradient Background with Moving Animation */
        body {
            background: linear-gradient(-45deg, #eef2ff, #e0e7ff, #f3e8ff, #f8fafc);
            background-size: 400% 400%;
            animation: gradientMove 15s ease infinite;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            padding: 20px;
            overflow-x: hidden;
        }

        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Ambient Pastel Glowing Circles */
        .bg-glow-1 {
            position: absolute;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(0,0,0,0) 70%);
            top: 15%;
            left: 20%;
            z-index: 1;
            animation: floatGlow 8s ease-in-out infinite alternate;
        }

        .bg-glow-2 {
            position: absolute;
            width: 360px;
            height: 360px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.2) 0%, rgba(0,0,0,0) 70%);
            bottom: 15%;
            right: 20%;
            z-index: 1;
            animation: floatGlow 10s ease-in-out infinite alternate-reverse;
        }

        @keyframes floatGlow {
            0% { transform: translateY(0px) scale(1); }
            100% { transform: translateY(25px) scale(1.05); }
        }

        /* Premium LIGHT Glassmorphic Card with Pop-in Animation */
        .password-card {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.1), 
                        0 0 30px rgba(168, 85, 247, 0.05);
            width: 100%;
            max-width: 440px;
            z-index: 2;
            opacity: 0;
            transform: translateY(30px);
            animation: cardFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes cardFadeIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .form-heading { color: #1e1b4b; font-weight: 800; letter-spacing: -0.5px; }
        .form-label { color: #475569; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; }

        /* Icon Box Header */
        .password-icon-box {
            width: 76px;
            height: 76px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 15px;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
        }

        /* Password Input Area & Eye Button Layout */
        .password-wrapper { position: relative; }
        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #64748b;
            transition: color 0.2s ease;
            z-index: 10;
        }
        .toggle-password:hover { color: #4f46e5; }

        .form-control {
            background: rgba(255, 255, 255, 0.8) !important;
            border: 1.5px solid #cbd5e1 !important;
            color: #0f172a !important;
            height: 50px;
            border-radius: 12px;
            padding-right: 45px;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #4f46e5 !important;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15) !important;
            background: #ffffff !important;
        }

        /* Password Requirements Checklists */
        .requirements-list {
            list-style: none;
            padding-left: 0;
            margin-top: 12px;
        }
        .requirements-list li {
            font-size: 0.82rem;
            color: #64748b;
            margin-bottom: 6px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .requirements-list li i { font-size: 0.75rem; }
        .requirements-list li.valid { color: #10b981; font-weight: 500; }
        
        /* Modern Button with Hover Transition Effect */
        .btn-gradient {
            background: linear-gradient(135deg, #4f46e5, #6366f1);
            border: none;
            color: #ffffff;
            font-weight: 600;
            padding: 14px 20px;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .btn-gradient::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            z-index: -1; opacity: 0; transition: opacity 0.4s ease;
        }

        .btn-gradient:hover::before { opacity: 1; }
        .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3); color: #ffffff; }

        .alert-holder { width: 100%; max-width: 440px; z-index: 3; }
        .alert { border-radius: 14px; border: 1px solid rgba(0,0,0,0.05); backdrop-filter: blur(10px); }
        .invalid-feedback { font-size: 0.82rem; font-weight: 500; margin-top: 6px; }
    </style>
</head>

<body>

    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="alert-holder mb-2">
        <% if (success && success.length) { %>
        <div class="alert alert-success alert-dismissible fade show text-success bg-success bg-opacity-10" role="alert">
            <strong>Success!</strong> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>

        <% if (error && error.length) { %>
        <div class="alert alert-danger alert-dismissible fade show text-danger bg-danger bg-opacity-10" role="alert">
            <strong>Error!</strong> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
    </div>

    <div class="password-card p-4 p-md-5">
        <div class="text-center">
            <div class="password-icon-box">🛡️</div>
            <h2 class="form-heading mb-2">Secure Account</h2>
            <p class="text-muted small">Enter a strong new password below to reset your credentials.</p>
        </div>

   <form id="loginForm" action="/save/new/password?_method=PUT" method="post" novalidate class="needs-validation mt-4">
            <div class="mb-3">
                <label for="password" class="form-label">New Password</label>
                <div class="password-wrapper">
                    <input 
                        type="password" 
                        name="password" 
                        class="form-control shadow-sm" 
                        id="password" 
                        placeholder="Create strong password" 
                        minlength="8"
                        pattern="(?=.*[\d!@#$%^&*(),.?':{}|<>_]).{8,}"
                        required
                        autocomplete="new-password"
                    >
                    <i class="fa-solid fa-eye-slash toggle-password" id="togglePasswordBtn"></i>
                    
                    <div class="invalid-feedback">
                        Please fulfill all password requirements before saving!
                    </div>
                </div>
                
                <ul class="requirements-list" id="reqList">
                    <li id="lengthReq"><i class="fa-solid fa-circle-xmark text-secondary"></i> At least 8 characters</li>
                    <li id="numberReq"><i class="fa-solid fa-circle-xmark text-secondary"></i> At least 1 number or special symbol</li>
                </ul>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="w-100 btn btn-gradient fw-semibold">Save Password & Login</button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // 🔥 Strict UI Engine Constraints Validation Logic
        (() => {
            'use strict'
            const form = document.getElementById('loginForm');
            const passwordInput = document.getElementById('password');

            form.addEventListener('submit', event => {
                const val = passwordInput.value;
                
                const isLengthValid = val.length >= 8;
                const hasNumberOrSpecial = /[\d!@#$%^&*(),.?":{}|<>_]/.test(val);

                // Blocks submissions strictly until both conditional properties returns true
                if (!form.checkValidity() || !isLengthValid || !hasNumberOrSpecial) {
                    event.preventDefault(); 
                    event.stopPropagation();
                    passwordInput.setCustomValidity("Requirements Not Met");
                } else {
                    passwordInput.setCustomValidity("");
                }

                form.classList.add('was-validated');
            }, false);
        })();

        // 👁️ Show/Hide Plain Text Input Toggle Visibility Utility
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('password');

        togglePasswordBtn.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        // ⚡ Live UI State Feedback Stream Observer
        passwordInput.addEventListener('input', function() {
            const val = this.value;
            this.setCustomValidity(""); // Clear standard custom checks state during active input stream

            // Rule 1 Verification: Length constraint check
            const lengthReq = document.getElementById('lengthReq');
            if(val.length >= 8) {
                lengthReq.classList.add('valid');
                lengthReq.querySelector('i').className = "fa-solid fa-circle-check text-success";
            } else {
                lengthReq.classList.remove('valid');
                lengthReq.querySelector('i').className = "fa-solid fa-circle-xmark text-secondary";
            }

            // Rule 2 Verification: Regex evaluation checking numbers/symbols
            const numberReq = document.getElementById('numberReq');
            const hasNumberOrSpecial = /[\d!@#$%^&*(),.?":{}|<>_]/.test(val);
            if(hasNumberOrSpecial) {
                numberReq.classList.add('valid');
                numberReq.querySelector('i').className = "fa-solid fa-circle-check text-success";
            } else {
                numberReq.classList.remove('valid');
                numberReq.querySelector('i').className = "fa-solid fa-circle-xmark text-secondary";
            }
        });
    </script>
</body>
</html>