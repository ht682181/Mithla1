<%- layout("/layouts/boilerplate") %>

  <style>
    /* Table Alignment & Layout */
    .table-fixed-layout th,
    .table-fixed-layout td {
      min-width: 160px;
      max-width: 200px;
      word-wrap: break-word;
      white-space: normal;
      vertical-align: middle;
      padding: 12px 8px !important;
    }

    .day-col-width {
      min-width: 90px !important;
      max-width: 100px !important;
      font-weight: 700;
    }

    .action-col-width {
      min-width: 90px !important;
      max-width: 100px !important;
    }

    .time-header-text {
      font-size: 0.95rem !important;
      font-weight: 400;
      color: #cbd5e1 !important;
      margin-top: 2px;
    }

    .subject-display {
      font-size: 1rem;
      font-weight: 700;
      color: #1e293b;
      display: block;
    }

    .teacher-display {
      font-size: 0.85rem;
      font-weight: 600;
      color: #475569;
      background-color: #f1f5f9;
      padding: 2px 6px;
      border-radius: 4px;
      display: inline-block;
      margin-top: 4px;
    }

    /* 🌟 ENHANCED HOD CARD STYLING */
    .hod-badge-card {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      border-left: 5px solid #f59e0b; /* Amber Accent */
      border-radius: 12px;
      padding: 10px 20px;
      display: inline-flex;
      align-items: center;
      gap: 14px;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
    }

    .hod-icon-box {
      width: 42px;
      height: 42px;
      background: rgba(245, 158, 11, 0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 🌟 ENHANCED CLASS INCHARGE BADGE STYLING */
    .incharge-badge-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid #e2e8f0;
      color: #0f172a;
      border-radius: 30px;
      padding: 5px 14px;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    .incharge-badge-card i {
      color: #2563eb; /* Bright Blue Icon */
    }

    /* Custom hover effect for buttons */
    .btn-premium-action {
      transition: all 0.2s ease-in-out;
    }
    .btn-premium-action:hover {
      transform: translateY(-2px);
    }
      .page-container {
    max-width: 1320px;
    margin: 0 auto;
  }
  
  </style>

<div class="page-container my-4 px-3">

    <!-- Header & Course Selection Card -->
    <div class="card shadow-sm border-0 bg-white p-4 mb-4 rounded-3">
      <div class="row align-items-center">
        <div class="col-md-7 text-center text-md-start">
          <h3 class="fw-bold text-dark m-0">Timetable Dashboard</h3>
          <p class="text-muted small m-0">Select a course to view and manage all active schedules.</p>
          
          <!-- Dynamic HOD Container -->
          <div id="hodContainer" class="mt-3" style="display: none;">
            <div class="hod-badge-card">
              <div class="hod-icon-box">
                <i class="fa-solid fa-user-tie text-warning fs-5"></i>
              </div>
              <div>
                <small class="text-uppercase text-warning d-block fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">Head of Department (HOD)</small>
                <span id="hodTeacherName" class="fw-bold text-white fs-6">Loading...</span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-5 mt-3 mt-md-0">
          <select id="courseSelector" class="form-select form-select-lg fw-bold border-2 shadow-sm">
            <option value="" <%= !selectedCourse ? 'selected' : '' %> disabled>-- Select Course (BCA / BTech) --</option>
            <% allCourses.forEach(course => { %>
              <option value="<%= course %>" <%= selectedCourse === course ? 'selected' : '' %>><%= course %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <!-- Quick Action Navigation Buttons -->
    <div class="d-flex gap-2 flex-wrap mt-4">
      <a href="/add/teacherData" class="btn btn-dark shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 btn-premium-action" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: none;">
        <i class="fa-solid fa-plus" style="font-size: 12px;"></i> Add Teacher
      </a>
      <a href="/show/teacher" class="btn btn-dark border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-eye" style="font-size: 12px;"></i> Show Teacher
      </a>
      <a href="/assign/teacher/subject/class" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-link" style="font-size: 12px;"></i> Manage Timetable & Assign  
      </a>
      <a href="/admin/show-all-teachers-assignments" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-eye" style="font-size: 12px;"></i> Show Teachers Subject
      </a>
      <a href="/temporary/assign/teacher/subject/class" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-link" style="font-size: 12px;"></i> Add Temporary Assign  
      </a>
      <a href="/show-temporary-teachers-assignments" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-eye" style="font-size: 12px;"></i> Show Temporary Assign
      </a>
      <a href="/timetable/dashboard" class="btn btn-light border shadow-sm px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2 bg-white text-secondary btn-premium-action">
        <i class="fa-solid fa-rotate me-1"></i> Refresh page
      </a>
    </div> 

    <!-- Timetable Displays -->
    <% if (selectedCourse && Object.keys(groupedTimetable).length > 0) { %>

      <% Object.keys(groupedTimetable).sort().forEach(sem => { %>
        <% Object.keys(groupedTimetable[sem]).sort().forEach(sec => { %>

          <div class="card shadow border-0 mb-5 mt-4 overflow-hidden rounded-3">

            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
              <div class="d-flex align-items-center flex-wrap gap-3">
                <h5 class="m-0 fw-bold fs-5">
                  <%= selectedCourse %> — Semester <%= sem %> 
                  <span class="badge bg-warning text-dark ms-2 fw-bold">Section <%= sec %></span>
                </h5>

                <!-- Dynamic Incharge Container for this specific Section -->
                <div class="incharge-badge-card" 
                     data-incharge-card 
                     data-classname="<%= selectedCourse %>" 
                     data-semester="<%= sem %>" 
                     data-section="<%= sec %>">
                  <i class="fa-solid fa-user-shield"></i>
                  <span class="fw-semibold text-secondary">Incharge:</span>
                  <span class="incharge-name fw-bold text-dark">Loading...</span>
                </div>
              </div>

              <!-- Bulk Action Delete Section -->
              <form action="/timetable/delete-section" method="POST"
                onsubmit="return confirm('⚠️ Warning: Are you sure you want to delete this section complete schedule? All weekly timetable data and linked teacher assignments will be removed.');"
                class="m-0">
                <input type="hidden" name="className" value="<%= selectedCourse %>">
                <input type="hidden" name="semester" value="<%= sem %>">
                <input type="hidden" name="section" value="<%= sec %>">
                <button type="submit" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill">✕ Delete Entire Section</button>
              </form>
            </div>

            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle table-fixed-layout mb-0">
                  <thead class="table-dark">
                    <tr>
                      <th class="day-col-width">Day</th>
                      <% groupedTimetable[sem][sec].periods.forEach(period => { %>
                        <th>
                          <div class="fs-6 fw-bold">Lecture <%= period.id %></div>
                          <div class="time-header-text"><%= period.displayTime %></div>
                        </th>
                      <% }); %>
                      <th class="action-col-width">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% days.forEach(day => { %>
                      <tr>
                        <td class="fw-bold bg-light text-start ps-3 day-col-width">
                          <%= dayNames[day] %>
                        </td>

                        <% groupedTimetable[sem][sec].periods.forEach(period => { %>
                          <% let slot = groupedTimetable[sem][sec].timetableMap[day][period.id]; %>

                          <% if (slot) { %>
                            <% if (slot.subject.includes('LUNCH')) { %>
                              <td class="table-warning fw-bold text-warning-emphasis">
                                🍔 LUNCH BREAK
                              </td>
                            <% } else { %>
                              <td>
                                <span class="subject-display"><%= slot.subject %></span>
                                <span class="teacher-display"><%= slot.teacher %></span>
                              </td>
                            <% } %>
                          <% } else { %>
                            <td class="text-muted fw-light">-</td>
                          <% } %>
                        <% }); %>

                        <td class="action-col-width">
                          <a href="/assign/teacher/subject/class?className=<%= encodeURIComponent(selectedCourse) %>&semester=<%= encodeURIComponent(sem) %>&section=<%= encodeURIComponent(sec) %>&day=<%= day %>&mode=edit"
                            class="btn btn-sm btn-outline-primary fw-bold w-100 rounded-2">
                            ✏️ Edit
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>

        <% }); %>
      <% }); %>

    <% } else if (selectedCourse) { %>
      <div class="alert alert-warning text-center mt-4 p-4 shadow-sm rounded-3">
        <h5>No Timetable Found</h5>
        <p class="m-0 text-muted">No records found for this course.</p>
      </div>
    <% } else { %>
      <div class="card p-5 text-center text-muted shadow-sm border border-dashed mt-4 rounded-3">
        <h5 class="fw-bold mb-1 text-dark">Welcome to Timetable Portal</h5>
        <p class="m-0 small">Choose your course from the dropdown above to load the full schedule.</p>
      </div>
    <% } %>

  </div>

  <script>
  document.addEventListener("DOMContentLoaded", function () {
    const selectedCourse = "<%= selectedCourse || '' %>";

    // 1. Course Selector Change Handler
    const courseSelector = document.getElementById('courseSelector');
    if (courseSelector) {
      courseSelector.addEventListener('change', function () {
        if (this.value) {
          window.location.href = `/timetable/dashboard?className=${encodeURIComponent(this.value)}`;
        }
      });
    }

    if (!selectedCourse) return;

    // Helper: Clean Base Course Name for HOD
    function cleanCourseForHod(fullCourseName) {
      if (!fullCourseName) return "";
      return fullCourseName
        .replace(/\s*[-_]?\s*(?:1ST|2ND|3RD|4TH|5TH|6TH|7TH|8TH)\s*(?:YEAR)?\s*$/i, "")
        .replace(/\s*[-_]?\s*(?:YEAR|SEM|SEMESTER)\s*\d+\s*$/i, "")
        .replace(/\s+/g, " ")
        .trim();
    }

    // Helper: Normalize Strings for Exact Section/Semester Match (Prevents Bugs)
    function normalizeText(text) {
      if (!text) return "";
      return String(text)
        .toUpperCase()
        .replace(/SECTION|SEC|SEMESTER|SEM/g, "") // Extra keywords hata deta hai
        .replace(/\s+/g, "")                       // Saare spaces remove kar deta hai
        .trim();
    }

    // -------------------------------------------------------------
    // 2. Fetch HOD
    // -------------------------------------------------------------
    const hodContainer = document.getElementById("hodContainer");
    const hodTeacherName = document.getElementById("hodTeacherName");
    const baseCourse = cleanCourseForHod(selectedCourse);

    if (baseCourse) {
      fetch(`/api/get-hod?courseName=${encodeURIComponent(baseCourse)}`)
        .then(res => res.json())
        .then(data => {
          if (data.success && data.hod && data.hod.teacher) {
            hodTeacherName.textContent = data.hod.teacher.name;
            hodContainer.style.display = "block";
          } else {
            hodContainer.style.display = "none";
          }
        })
        .catch(err => {
          console.error("Error fetching HOD:", err);
          hodContainer.style.display = "none";
        });
    }

    // -------------------------------------------------------------
    // 3. Fetch Class Incharges (Section-Wise Precise Mapping)
    // -------------------------------------------------------------
    const inchargeCards = document.querySelectorAll("[data-incharge-card]");

    if (inchargeCards.length > 0) {
      fetch(`/api/get-class-incharge?className=${encodeURIComponent(selectedCourse)}`)
        .then(res => res.json())
        .then(data => {
          const inchargesList = data.incharges || data.incharge || (Array.isArray(data.data) ? data.data : []);

          inchargeCards.forEach(card => {
            // EJS Attributes Normalize
            const cardSem = normalizeText(card.getAttribute("data-semester"));
            const cardSec = normalizeText(card.getAttribute("data-section"));
            const nameSpan = card.querySelector(".incharge-name");

            if (!Array.isArray(inchargesList)) return;

            // Exact Match Finding (Filter multiple if exists)
            const matchedIncharges = inchargesList.filter(item => {
              const itemSem = normalizeText(item.semester || item.sem);
              const itemSec = normalizeText(item.sectionName || item.section);
              return itemSem === cardSem && itemSec === cardSec;
            });

            if (matchedIncharges.length > 0) {
              // Get names of all matched incharges for this Section
              const names = matchedIncharges.map(inc => {
                if (typeof inc.teacher === "object" && inc.teacher !== null) {
                  return inc.teacher.name;
                } else if (typeof inc.teacher === "string") {
                  return inc.teacher;
                }
                return inc.teacherName || "Assigned";
              }).filter(Boolean);

              if (nameSpan) {
                nameSpan.textContent = names.join(", ") || "Assigned";
                nameSpan.classList.add("text-dark");
                nameSpan.classList.remove("text-muted");
              }
            } else {
              if (nameSpan) {
                nameSpan.textContent = "Not Assigned";
                nameSpan.classList.add("text-muted");
                nameSpan.classList.remove("text-dark");
              }
            }
          });
        })
        .catch(err => {
          console.error("Error fetching Class Incharges:", err);
          inchargeCards.forEach(card => {
            const nameSpan = card.querySelector(".incharge-name");
            if (nameSpan) nameSpan.textContent = "N/A";
          });
        });
    }
  });
</script>