<%- layout("/layouts/boilerplateStudent") -%>

<style>
  :root {
    --primary-gradient: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    --success-gradient: linear-gradient(135deg, #198754 0%, #146c43 100%);
    --warning-gradient: linear-gradient(135deg, #ffc107 0%, #d39e00 100%);
    --danger-gradient: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
    --glass-bg: rgba(255, 255, 255, 0.9);
    --glass-border: rgba(220, 224, 230, 0.7);
  }

  body {
    background: #f4f6f9;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Glassmorphism Cards */
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.06);
    transition: all 0.3s ease;
  }

  .glass-card:hover {
    box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.1);
  }

  /* Header Banner */
  .portal-header-banner {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 16px;
    color: #ffffff;
    padding: 24px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }

  /* Metric Stat Box */
  .stat-box {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    padding: 20px;
    color: #fff;
  }

  .stat-box .stat-icon {
    position: absolute;
    right: 15px;
    bottom: 10px;
    font-size: 3.5rem;
    opacity: 0.18;
  }

  .bg-grad-primary { background: var(--primary-gradient); }
  .bg-grad-success { background: var(--success-gradient); }
  .bg-grad-warning { background: var(--warning-gradient); color: #212529 !important; }
  .bg-grad-danger { background: var(--danger-gradient); }

  /* Semester Cards */
  .sem-card {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
    transition: transform 0.2s;
  }

  .sem-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
  }

  /* Receipt Passbook Badge */
  .badge-status-active {
    background-color: #d1e7dd;
    color: #0f5132;
    border: 1px solid #badbcc;
  }

  .badge-status-cancelled {
    background-color: #f8d7da;
    color: #842029;
    border: 1px solid #f5c2c7;
  }

  /* Print Formatting */
  @media print {
    body * { visibility: hidden; }
    #printableReceiptModal, #printableReceiptModal * { visibility: visible; }
    #printableReceiptModal { position: absolute; left: 0; top: 0; width: 100%; }
    .btn-close, .modal-footer, .no-print { display: none !important; }
  }
</style>

<div class="container-fluid py-4 px-3 px-md-4">

  <!-- 🏛️ TOP MAIN HEADING BANNER -->
  <div class="portal-header-banner mb-4">
    <div class="row align-items-center">
      <div class="col-md-7">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 text-uppercase mb-2" style="letter-spacing: 0.5px;">
          <i class="fa-solid fa-graduation-cap me-1"></i> Student Self-Service Portal
        </span>
        <h2 class="fw-bold m-0 text-white">Fee Ledger & Payment Receipts</h2>
        <p class="text-light opacity-75 small m-0 mt-1">
          Aligarh College of Engineering & Technology • Real-Time Account Statement
        </p>
      </div>
      <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <div class="d-inline-flex align-items-center bg-white bg-opacity-10 rounded-3 p-2 px-3 border border-white border-opacity-25">
          <i class="fa-solid fa-shield-halved text-warning fs-3 me-3"></i>
          <div class="text-start">
            <span class="d-block small text-light opacity-75">Account Status</span>
            <span class="fw-bold <%= (feeLedger.overall_pending_balance || 0) <= 0 ? 'text-success' : 'text-warning' %>">
              <%= (feeLedger.overall_pending_balance || 0) <= 0 ? '✅ All Dues Cleared' : '⚠️ Pending Balance Remaining' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🌟 STUDENT PROFILE DETAILS CARD -->
  <div class="glass-card p-4 mb-4 bg-white">
    <div class="row align-items-center">
      <div class="col-md-8">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; font-size: 1.5rem; font-weight: bold;">
            <%= (feeLedger.studentName || 'S').charAt(0).toUpperCase() %>
          </div>
          <div>
            <h4 class="fw-bold text-dark m-0"><%= feeLedger.studentName %></h4>
            <p class="text-muted mb-0 small">
              S/O: <b><%= feeLedger.fatherName || 'N/A' %></b> | 
              Admin No: <span class="badge bg-dark text-warning"><%= feeLedger.rollNumber %></span>
            </p>
          </div>
        </div>
      </div>
      <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-primary fs-6 px-3 py-2 me-1 mb-1"><%= feeLedger.currentCourse %></span>
        <span class="badge bg-secondary fs-6 px-3 py-2 mb-1">Batch: <%= feeLedger.session %></span>
        <div>
          <span class="badge <%= feeLedger.status === 'Active' ? 'bg-success' : 'bg-danger' %> mt-1 px-3 py-1">
            <i class="fa-solid fa-circle-dot me-1"></i> <%= feeLedger.status %> Student
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 📊 LIFETIME OVERALL SUMMARY CARDS -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-box bg-grad-primary shadow-sm">
        <div class="stat-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        <span class="text-uppercase small fw-bold opacity-75">Total Course Demand</span>
        <h3 class="fw-bold m-0 mt-1">₹<%= (feeLedger.total_course_fees || 0).toLocaleString('en-IN') %></h3>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-box bg-grad-success shadow-sm">
        <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
        <span class="text-uppercase small fw-bold opacity-75">Total Paid Amount</span>
        <h3 class="fw-bold m-0 mt-1">₹<%= (feeLedger.total_amount_paid || 0).toLocaleString('en-IN') %></h3>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-box bg-grad-danger shadow-sm">
        <div class="stat-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <span class="text-uppercase small fw-bold opacity-75">Net Pending Balance</span>
        <h3 class="fw-bold m-0 mt-1">₹<%= (feeLedger.overall_pending_balance || 0).toLocaleString('en-IN') %></h3>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-box bg-grad-warning shadow-sm">
        <div class="stat-icon"><i class="fa-solid fa-wallet"></i></div>
        <span class="text-uppercase small fw-bold text-dark opacity-75">Wallet / Advance</span>
        <h3 class="fw-bold text-dark m-0 mt-1">₹<%= (feeLedger.advance_balance || 0).toLocaleString('en-IN') %></h3>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- 📚 SEMESTER-WISE FEE BREAKDOWN -->
    <div class="col-lg-7">
      <div class="glass-card p-4 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <h5 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-list-check text-primary me-2"></i>Semester Fee Breakdown
          </h5>
          <span class="badge bg-light text-dark border"><%= (feeLedger.semesters || []).length %> Semesters Configured</span>
        </div>

        <% if (feeLedger.semesters && feeLedger.semesters.length > 0) { %>
          <div class="row g-3">
            <% feeLedger.semesters.forEach(sem => { %>
              <div class="col-md-6 col-12">
                <div class="sem-card p-3 shadow-sm">
                  <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                    <span class="fw-bold text-primary fs-6">Semester <%= sem.semNumber %></span>
                    <% if ((sem.balance_pending || 0) <= 0) { %>
                      <span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="fa-solid fa-check me-1"></i>Cleared</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1"><i class="fa-solid fa-clock me-1"></i>Due</span>
                    <% } %>
                  </div>

                  <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Due Amount:</span>
                    <span class="fw-bold">₹<%= (sem.due_amount || 0).toLocaleString('en-IN') %></span>
                  </div>

                  <% if ((sem.penalty_amount || 0) > 0) { %>
                    <div class="d-flex justify-content-between small mb-1 text-danger">
                      <span>Fine / Penalty:</span>
                      <span class="fw-bold">+ ₹<%= sem.penalty_amount.toLocaleString('en-IN') %></span>
                    </div>
                  <% } %>

                  <div class="d-flex justify-content-between small mb-1 text-success">
                    <span>Paid Amount:</span>
                    <span class="fw-bold">₹<%= (sem.amount_paid || 0).toLocaleString('en-IN') %></span>
                  </div>

                  <div class="d-flex justify-content-between small pt-2 border-top mt-2">
                    <span class="fw-bold text-dark">Balance Pending:</span>
                    <span class="fw-bold <%= (sem.balance_pending || 0) > 0 ? 'text-danger' : 'text-success' %>">
                      ₹<%= (sem.balance_pending || 0).toLocaleString('en-IN') %>
                    </span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-folder-open fs-1 opacity-25 d-block mb-2"></i>
            No semester fee structure assigned yet.
          </div>
        <% } %>
      </div>
    </div>

    <!-- 🧾 RECEIPTS PASSBOOK -->
    <div class="col-lg-5">
      <div class="glass-card p-4 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <h5 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-receipt text-success me-2"></i>Receipts Passbook
          </h5>
          <span class="badge bg-dark text-white"><%= (transactions || []).length %> Transactions</span>
        </div>

        <% if (transactions && transactions.length > 0) { %>
          <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Receipt / Date</th>
                  <th>Details</th>
                  <th>Paid</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% transactions.forEach(tx => { %>
                  <% const isCancelled = tx.status === 'CANCELLED'; %>
                  <tr class="<%= isCancelled ? 'table-danger opacity-75' : '' %>">
                    <td>
                      <div class="fw-bold text-dark"><%= tx.receiptNumber %></div>
                      <div class="text-muted small" style="font-size: 0.75rem;">
                        <%= new Date(tx.paymentDate || tx.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </div>
                    </td>
                    <td>
                      <div>
                        <span class="badge bg-secondary me-1">Sem <%= tx.semNumber %></span>
                        <span class="badge bg-light text-dark border"><%= tx.paymentMode %></span>
                      </div>
                      <% if (isCancelled) { %>
                        <span class="badge badge-status-cancelled mt-1">CANCELLED</span>
                      <% } else { %>
                        <span class="badge badge-status-active mt-1">ACTIVE</span>
                      <% } %>
                    </td>
                    <td class="fw-bold <%= isCancelled ? 'text-decoration-line-through text-danger' : 'text-success' %>">
                      ₹<%= (tx.amountPaid || 0).toLocaleString('en-IN') %>
                    </td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-outline-primary fw-bold" 
                              onclick="viewReceiptModal('<%= encodeURIComponent(JSON.stringify(tx)) %>')">
                        <i class="fa-solid fa-eye me-1"></i>View
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-receipt fs-1 opacity-25 d-block mb-2"></i>
            No fee payment receipts available.
          </div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- 🖨️ ULTRA-MODERN PREMIUM DIGITAL RECEIPT MODAL -->
<div class="modal fade" id="printableReceiptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
      
      <!-- Modal Top Bar (Screen Only) -->
      <div class="modal-header bg-dark text-white px-4 py-3 no-print">
        <h5 class="modal-title fw-bold fs-6">
          <i class="fa-solid fa-receipt text-warning me-2"></i>Official Student Fee Receipt
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <!-- Printable Area -->
      <div class="modal-body p-4 p-md-5 bg-white" id="receiptPrintArea">
        
        <!-- College Header -->
        <div class="text-center pb-3 mb-4 border-bottom border-2">
          <h3 class="fw-black text-uppercase m-0 text-dark" style="letter-spacing: 0.5px; font-weight: 800;">
            Aligarh College of Engineering & Technology
          </h3>
          <p class="text-secondary small mb-1">Approved by AICTE & Affiliated to AKTU / Board of Technical Education</p>
          <span class="badge bg-light text-dark border px-3 py-1 text-uppercase fw-bold" style="letter-spacing: 1px;">
            Fee Payment Acknowledgment Receipt
          </span>
        </div>

        <!-- Receipt Metas -->
        <div class="row g-3 mb-4 p-3 rounded-3 bg-light border align-items-center">
          <div class="col-6 col-sm-3">
            <span class="text-muted small d-block text-uppercase fw-bold" style="font-size: 0.72rem;">Receipt No</span>
            <span id="recNo" class="fw-bold text-primary fs-6">--</span>
          </div>
          <div class="col-6 col-sm-3">
            <span class="text-muted small d-block text-uppercase fw-bold" style="font-size: 0.72rem;">Payment Date</span>
            <span id="recDate" class="fw-bold text-dark">--</span>
          </div>
          <div class="col-6 col-sm-3">
            <span class="text-muted small d-block text-uppercase fw-bold" style="font-size: 0.72rem;">Academic Year</span>
            <span id="recAcadYear" class="fw-bold text-dark">--</span>
          </div>
          <div class="col-6 col-sm-3 text-sm-end">
            <span class="text-muted small d-block text-uppercase fw-bold" style="font-size: 0.72rem;">Payment Mode</span>
            <span id="recMode" class="badge bg-dark text-white px-2 py-1">--</span>
          </div>
        </div>

        <!-- Student Information Grid -->
        <div class="p-3 rounded-3 border mb-4">
          <h6 class="fw-bold text-uppercase small text-secondary mb-3 border-bottom pb-1" style="letter-spacing: 0.5px;">
            <i class="fa-solid fa-user-graduate me-1 text-primary"></i> Student Profile
          </h6>
          <div class="row g-2 small">
            <div class="col-6 col-md-4">
              <span class="text-muted">Student Name:</span> 
              <div class="fw-bold text-dark fs-6" id="recStudent">--</div>
            </div>
            <div class="col-6 col-md-4">
              <span class="text-muted">Admin No:</span> 
              <div class="fw-bold text-dark fs-6" id="recRoll">--</div>
            </div>
            <div class="col-6 col-md-4">
              <span class="text-muted">Father's Name:</span> 
              <div class="fw-bold text-dark" id="recFather">--</div>
            </div>
            <div class="col-6 col-md-4 mt-2">
              <span class="text-muted">Course / Branch:</span> 
              <div class="fw-bold text-dark"><%= feeLedger.currentCourse %></div>
            </div>
            <div class="col-6 col-md-4 mt-2">
              <span class="text-muted">Academic Session:</span> 
              <div class="fw-bold text-dark"><%= feeLedger.session %></div>
            </div>
            <div class="col-6 col-md-4 mt-2">
              <span class="text-muted">Semester:</span> 
              <div class="fw-bold text-primary" id="recSemBadge">--</div>
            </div>
          </div>
        </div>

        <!-- Payment Breakdown Table -->
        <div class="table-responsive mb-4">
          <table class="table table-bordered align-middle mb-0">
            <thead class="table-dark small text-uppercase">
              <tr>
                <th style="width: 50%;">Fee Particulars</th>
                <th class="text-center">Semester</th>
                <th class="text-center">Session Year</th>
                <th class="text-end" style="width: 25%;">Amount Paid</th>
              </tr>
            </thead>
            <tbody class="small">
              <tr>
                <td>
                  <span class="fw-bold d-block text-dark">Academic Tuition / College Fee</span>
                  <span class="text-muted" style="font-size: 0.75rem;">Direct Account Credit Ledger Log</span>
                </td>
                <td class="text-center fw-bold" id="recSemTable">--</td>
                <td class="text-center fw-bold" id="recYearTable">--</td>
                <td class="text-end fw-bold fs-6 text-success" id="recAmount">₹0.00</td>
              </tr>
            </tbody>
            <tfoot>
              <tr class="table-light">
                <td colspan="3" class="text-end fw-bold text-uppercase small">Total Settled Amount:</td>
                <td class="text-end fw-black fs-5 text-dark" id="recTotalAmount" style="font-weight: 800;">₹0.00</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Cancellation Alert -->
        <div id="cancellationReasonBlock" class="alert alert-danger py-2 px-3 small rounded-3 d-none mb-4">
          <i class="fa-solid fa-triangle-exclamation me-1"></i>
          <b>Receipt Cancelled Reason:</b> <span id="recCancelReason">--</span>
        </div>

        <!-- Terms & Verification Footer -->
        <div class="row align-items-end pt-3 mt-4 border-top text-muted small">
          <div class="col-7">
            <p class="m-0" style="font-size: 0.72rem;">
              • Computer-generated fee acknowledgment receipt. No physical signature required.<br>
              • Subject to realization of online payment / cheque clearing.<br>
              • Keep this receipt safe for future official reference.
            </p>
          </div>
          <div class="col-5 text-end">
            <div class="d-inline-block text-center">
              <div style="height: 35px;" class="d-flex align-items-end justify-content-center">
                <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.65rem;">System Verified</span>
              </div>
              <div class="border-top border-dark mt-1 pt-1 fw-bold text-dark" style="width: 140px; font-size: 0.8rem;">
                Accounts Department
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Modal Actions (Screen Only) -->
      <div class="modal-footer bg-light px-4 py-3 no-print">
        <button type="button" class="btn btn-outline-secondary fw-bold px-3" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary fw-bold px-4" onclick="window.print()">
          <i class="fa-solid fa-print me-2"></i>Print Official Receipt
        </button>
      </div>

    </div>
  </div>
</div>

<!-- ⚙️ JAVASCRIPT HANDLER -->
<script>
  function viewReceiptModal(txRaw) {
    try {
      const tx = JSON.parse(decodeURIComponent(txRaw));

      // 1. Basic Tx Metas
      document.getElementById('recNo').innerText = tx.receiptNumber || 'N/A';
      document.getElementById('recDate').innerText = new Date(tx.paymentDate || tx.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
      document.getElementById('recMode').innerText = (tx.paymentMode || 'Cash').toUpperCase();

      // 2. Academic Year & Semester
      const semNum = tx.semNumber ? `Semester ${tx.semNumber}` : 'N/A';
      const acadYear = tx.academicYear || new Date(tx.paymentDate || tx.createdAt).getFullYear();

      document.getElementById('recAcadYear').innerText = acadYear;
      document.getElementById('recSemBadge').innerText = semNum;
      document.getElementById('recSemTable').innerText = semNum;
      document.getElementById('recYearTable').innerText = acadYear;

      // 3. Student Metas
      document.getElementById('recStudent').innerText = tx.studentName || '<%= feeLedger.studentName %>';
      document.getElementById('recRoll').innerText = tx.rollNumber || '<%= feeLedger.rollNumber %>';
      document.getElementById('recFather').innerText = tx.fatherName || '<%= feeLedger.fatherName || "N/A" %>';

      // 4. Amount Formatting
      const formattedAmount = `₹${(tx.amountPaid || 0).toLocaleString('en-IN')}`;
      document.getElementById('recAmount').innerText = formattedAmount;
      document.getElementById('recTotalAmount').innerText = formattedAmount;

      // 5. Cancellation Logic
      const cancelBlock = document.getElementById('cancellationReasonBlock');
      if (tx.status === 'CANCELLED') {
        cancelBlock.classList.remove('d-none');
        document.getElementById('recCancelReason').innerText = tx.actionReason || (tx.metadata && tx.metadata.cancellationReason) || 'Cancelled by Admin';
      } else {
        cancelBlock.classList.add('d-none');
      }

      // Show Modal
      new bootstrap.Modal(document.getElementById('printableReceiptModal')).show();
    } catch (e) {
      console.error("Receipt Modal Error:", e);
    }
  }
</script>