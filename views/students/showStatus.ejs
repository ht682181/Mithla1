  <%- layout("/layouts/boilerplateStudent") -%>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  body { background: #f4f6f9; color: #334155; font-family: 'Poppins', sans-serif; }
  .premium-card { background: #ffffff; border: none !important; border-radius: 20px !important; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important; }
  .gradient-header-card { background: linear-gradient(135deg, #0f172a 0%, #2563eb 100%); color: white; border-radius: 20px !important; padding: 24px; box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25); }
  .premium-control { border: 2px solid #cbd5e1 !important; border-radius: 12px !important; padding: 8px 12px !important; font-size: 14px; font-weight: 500; }
  
  /* Read-only status badges */
  .badge-present { background-color: #d1fae5 !important; color: #065f46 !important; font-weight: 700 !important; border: 1px solid #10b981 !important; padding: 6px 16px; border-radius: 50px; }
  .badge-absent { background-color: #fee2e2 !important; color: #991b1b !important; font-weight: 700 !important; border: 1px solid #ef4444 !important; padding: 6px 16px; border-radius: 50px; }

  .table-header-dark { background: #1e293b !important; color: #ffffff !important; font-weight: 600; border-top-left-radius: 20px; border-top-right-radius: 20px; }
  .premium-table th { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; padding: 16px !important; background: #f8fafc !important; }
  .widget-blue { border-left: 6px solid #2563eb; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); }
  .widget-green { border-left: 6px solid #10b981; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); }
  .widget-red { border-left: 6px solid #ef4444; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); }
  .stat-card { border-radius: 16px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.01); }

  .avg-radial-box { position: relative; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; }
  .avg-svg-ring circle { fill: none; stroke-width: 8; stroke-linecap: round; transform: rotate(-90deg); transform-origin: 50% 50%; }
</style>

<div class="container my-5">

  <div class="gradient-header-card d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-4">
    <div>
      <h2 class="fw-bold m-0"><i class="fa-solid fa-graduation-cap me-2"></i> My Attendance Portal</h2>
      <p class="mb-0 opacity-90 mt-2 fs-5">
        Welcome, <span class="fw-bold text-warning"><%= student.name %></span> | Admin No: <span class="fw-semibold"><%= student.rollNo %></span>
      </p>
    </div>
    <a href="/student/attendance/status/check" class="btn btn-light shadow fw-bold text-dark px-4 py-2 rounded-pill">
      <i class="fa-solid fa-rotate me-1"></i> Refresh Dashboard
    </a>
  </div>

  <div class="card p-3 premium-card mb-4">
    <div class="d-flex justify-content-center gap-4 flex-wrap text-center fw-bold">
      <div><i class="fa-solid fa-book text-primary me-1"></i> Class: <span class="badge bg-primary px-3 py-1.5 fs-7"><%= student.class %></span></div>
      <div><i class="fa-solid fa-graduation-cap text-success me-1"></i> Semester: <span class="badge bg-success px-3 py-1.5 fs-7"><%= student.semester %></span></div>
      <div><i class="fa-solid fa-layer-group text-warning me-1"></i> Section: <span class="badge bg-warning text-dark px-3 py-1.5 fs-7"><%= student.section %></span></div>
    </div>
  </div>

  <div class="card p-4 premium-card mb-4 border-start border-4 border-info shadow-sm">
    <div class="row align-items-center g-4">
      <div class="col-md-7 border-end-md">
        <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4">
          <div class="avg-radial-box flex-shrink-0 mx-auto mx-sm-0">
            <svg class="avg-svg-ring" width="90" height="90">
              <circle stroke="#e2e8f0" cx="45" cy="45" r="38"></circle>
              <circle id="radialProgressStroke" stroke="#3b82f6" cx="45" cy="45" r="38" stroke-dasharray="238.76" stroke-dashoffset="238.76"></circle>
            </svg>
            <div class="position-absolute fs-4 fw-bold text-dark" id="avgPercentText">0%</div>
          </div>
          <div class="text-center text-sm-start w-100" style="min-width: 0;">
            <h5 class="fw-bold text-dark m-0">Your Performance Score</h5>
            <p class="text-muted small m-0 mt-1" style="word-wrap: break-word;">Evaluated based on complete micro-periods distribution layout logs.</p>
            <div id="eligibilityStatusBadge" class="mt-2 d-inline-block text-wrap max-w-100"></div>
          </div>
        </div>
      </div>
      <div class="col-md-5">
        <div class="bg-light p-3 rounded-3 d-flex flex-column gap-2">
          <div class="d-flex justify-content-between small fw-bold">
            <span class="text-muted">Total Slots Conducted:</span>
            <span id="dashboardTotalSlots" class="text-dark">0</span>
          </div>
          <div class="d-flex justify-content-between small fw-bold">
            <span class="text-success">Attended Counter:</span>
            <span id="dashboardPresentSlots" class="text-success">0 Slots</span>
          </div>
          <div class="progress rounded-pill" style="height: 6px;">
            <div id="dashboardProgressBar" class="progress-bar bg-primary" role="progressbar" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>
  </div> 

  <div class="card p-4 premium-card mb-4 border-top border-primary border-4">
    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-filter text-primary me-2"></i>Filter Archives</h5>
    
    <div id="searchAlertContainer"></div>

    <form id="archiveFilterForm" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label class="form-label small fw-bold text-muted">Start Date</label>
        <input type="date" id="logStartDate" class="form-control premium-control" onchange="clearWarningState()">
      </div>
      
      <div class="col-md-3">
        <label class="form-label small fw-bold text-muted">End Date</label>
        <input type="date" id="logEndDate" class="form-control premium-control" onchange="clearWarningState()">
      </div>

      <div class="col-md-3">
        <label class="form-label small fw-bold text-muted">Academic Year Filter</label>
        <select id="academicYearSelect" class="form-select premium-control" onchange="clearWarningState()">
          <option value="">-- View All Years --</option>
          <option value="1">1st Year Logs</option>
          <option value="2">2nd Year Logs</option>
          <option value="3">3rd Year Logs</option>
          <option value="4">4th Year Logs</option>
        </select>
      </div>

      <div class="col-md-3 d-flex gap-2">
        <button type="button" onclick="triggerArchiveSearch(true)" class="btn btn-dark rounded-pill py-2.5 fw-bold flex-grow-1">
          <i class="fa-solid fa-filter me-2"></i>Apply Filters
        </button>
        <button type="button" id="resetDefaultBtn" onclick="resetToDefaultLogs()" class="btn btn-outline-danger rounded-pill py-2.5 fw-bold d-none">
          <i class="fa-solid fa-rotate-left"></i> Reset
        </button>
      </div>
    </form>
  </div>

  <div class="mb-4 d-flex justify-content-center gap-2 flex-wrap">
    <button class="btn btn-outline-primary px-4 rounded-pill filter-btn active" data-filter="all">All Logs</button>
    <button class="btn btn-outline-primary px-4 rounded-pill filter-btn" data-filter="monthly">Monthly Window</button>
    <button class="btn btn-outline-primary px-4 rounded-pill filter-btn" data-filter="weekly">Weekly Loop</button>
    <button class="btn btn-outline-primary px-4 rounded-pill filter-btn" data-filter="today">Today Matrix</button>
  </div>

  <div class="row g-4 mb-4 text-center">
    <div class="col-md-4">
      <div class="stat-card widget-blue">
        <h6 class="text-muted fw-bold small uppercase mb-1">Total Academic Days</h6>
        <h2 class="fw-bold text-primary m-0" id="totalDays">0</h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card widget-green">
        <h6 class="text-success fw-bold small uppercase mb-1">Days Present</h6>
        <h2 class="fw-bold text-success m-0" id="presentDays">0</h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card widget-red">
        <h6 class="text-danger fw-bold small uppercase mb-1">Days Absent</h6>
        <h2 class="fw-bold text-danger m-0" id="absentDays">0</h2>
      </div>
    </div>
  </div>

  <div class="card premium-card overflow-hidden shadow-sm mb-4">
    <div class="table-header-dark d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 gap-2">
      <h5 class="mb-0 fw-bold"><i class="fa-solid fa-clipboard-list me-2"></i>Attendance Ledger Logs</h5>
      <span class="badge bg-light text-dark px-3 py-2 fw-semibold rounded fs-7 shadow-sm">
        <i class="fa-solid fa-clock text-primary me-1"></i> 
        Micro Slots Track: <span id="slotsPresent" class="text-success fw-bold">0</span> Present / <span id="slotsTotal" class="text-secondary fw-bold">0</span> Total Periods
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover premium-table align-middle text-center mb-0">
        <thead>
          <tr>
            <th>Date</th>
            <th>Period Slot</th>
            <th>Subject Track</th>
            <th>Teacher</th>
            <th>Unit Index</th>
            <th>Topic Description</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="attendanceTableBody">
          <tr>
            <td colspan="7" class="py-5 text-muted">
              <div class="spinner-border text-primary spinner-border-sm me-2"></div>Syncing my attendance data...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-2">
    <div class="small fw-semibold text-muted text-uppercase">
      Showing Entries: <span id="paginationInfo" class="text-dark fw-bold">0-0 of 0</span>
    </div>
    <nav>
      <ul class="pagination pagination-sm m-0 gap-1" id="paginationControlsContainer"></ul>
    </nav>
  </div>

</div>

<script>
  let activeFilterMode = "all";
  let activeCurrentPage = 1;

  function clearWarningState() {
    document.getElementById("searchAlertContainer").innerHTML = "";
  }

  async function syncMasterAttendancePipeline(pageNumber = 1) {
    activeCurrentPage = pageNumber;
    const fromDate = document.getElementById("logStartDate").value;
    const toDate = document.getElementById("logEndDate").value;
    const academicYear = document.getElementById("academicYearSelect").value;
    const tbody = document.getElementById("attendanceTableBody");

    // Route updated to new Student Mirror V2 API
    let queryURI = `/student/attendance/api/v2?page=${activeCurrentPage}&filter=${activeFilterMode}`;
    
    if (activeFilterMode === "custom" && fromDate && toDate) {
      queryURI += `&from=${fromDate}&to=${toDate}`;
    }
    if (academicYear) {
      queryURI += `&academicYear=${academicYear}`;
    }

    try {
      const response = await fetch(queryURI);
      const res = await response.json();
      if (res.success) {
        processSummaryAndTableRender(res.data, res.pagination, res.summary);
      } else {
        // Safe Session handling fallback redirect
        window.location.href = "/student/attendance/status/check";
      }
    } catch (err) {
      console.error(err);
      tbody.innerHTML = `<tr><td colspan="7" class="py-4 text-danger text-center">Failed to fetch logs data structure.</td></tr>`;
    }
  }

  function triggerArchiveSearch(isUserClick = true) {
    const fromDate = document.getElementById("logStartDate").value;
    const toDate = document.getElementById("logEndDate").value;
    const academicYear = document.getElementById("academicYearSelect").value;
    const alertBox = document.getElementById("searchAlertContainer");
    const resetBtn = document.getElementById("resetDefaultBtn");

    if (isUserClick && !fromDate && !toDate && !academicYear) {
      alertBox.innerHTML = `
        <div class="alert alert-danger alert-dismissible fade show fw-bold mb-3 border-0 rounded-3 shadow-sm" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-2"></i> 
          Please choose at least one option! Select a Date Range or an Academic Year before filtering.
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      `;
      return; 
    }

    clearWarningState();

    if (fromDate && toDate) {
      activeFilterMode = "custom";
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
    } else if (academicYear) {
      activeFilterMode = "all"; 
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
    }

    resetBtn.classList.remove("d-none");
    syncMasterAttendancePipeline(1);
  }

  function resetToDefaultLogs() {
    document.getElementById("logStartDate").value = "";
    document.getElementById("logEndDate").value = "";
    document.getElementById("academicYearSelect").value = "";
    clearWarningState();

    document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
    const allLogsBtn = document.querySelector('[data-filter="all"]');
    if(allLogsBtn) allLogsBtn.classList.add("active");

    document.getElementById("resetDefaultBtn").classList.add("d-none");

    activeFilterMode = "all";
    syncMasterAttendancePipeline(1);
  }

  function processSummaryAndTableRender(data, pagination, summary) {
    document.getElementById("totalDays").innerText = summary.totalDays;
    document.getElementById("presentDays").innerText = summary.presentDays;
    document.getElementById("absentDays").innerText = summary.absentDays;
    document.getElementById("slotsTotal").innerText = summary.slotsTotal;
    document.getElementById("slotsPresent").innerText = summary.slotsPresent;

    let avgPercentage = summary.slotsTotal > 0 ? Math.round((summary.slotsPresent / summary.slotsTotal) * 100) : 0;
    document.getElementById("avgPercentText").innerText = `${avgPercentage}%`;
    document.getElementById("dashboardTotalSlots").innerText = summary.slotsTotal;
    document.getElementById("dashboardPresentSlots").innerText = `${summary.slotsPresent} Slots`;
    document.getElementById("dashboardProgressBar").style.width = `${avgPercentage}%`;

    const circleRadius = 38;
    const circumference = 2 * Math.PI * circleRadius;
    const offset = circumference - (avgPercentage / 100) * circumference;
    const progressStroke = document.getElementById("radialProgressStroke");
    progressStroke.style.strokeDashoffset = offset;

    const elgBox = document.getElementById("eligibilityStatusBadge");
    if (avgPercentage >= 75) {
      progressStroke.setAttribute("stroke", "#10b981");
      elgBox.innerHTML = `<span class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1 rounded small"><i class="fa-solid fa-circle-check me-1"></i> Eligible for Term Examinations</span>`;
    } else {
      progressStroke.setAttribute("stroke", "#ef4444");
      elgBox.innerHTML = `<span class="badge bg-danger-subtle text-danger border border-danger fw-bold px-2 py-1 rounded small"><i class="fa-solid fa-triangle-exclamation me-1"></i> Critical: Short Attendance Warning</span>`;
    }

    const tbody = document.getElementById("attendanceTableBody");
    tbody.innerHTML = "";

    if (!data.length) {
      tbody.innerHTML = `<tr><td colspan="7" class="py-5 text-muted text-center fw-bold"><i class="fa-solid fa-folder-open text-warning fs-3 d-block mb-2"></i>No records found matching your timeline scale.</td></tr>`;
      document.getElementById("paginationInfo").innerText = "0 entries";
      document.getElementById("paginationControlsContainer").innerHTML = "";
      return;
    }

    data.forEach(a => {
      const date = new Date(a.date).toLocaleDateString('en-IN', { day: '2-digit', month: '2-digit', year: 'numeric' });
      const isPresent = a.status === "Present";
      
      // Removed edit dropdown system, rendered clean static badges instead
      const statusBadge = isPresent 
        ? `<span class="badge-present"><i class="fa-solid fa-circle-check me-1"></i> Present</span>` 
        : `<span class="badge-absent"><i class="fa-solid fa-circle-xmark me-1"></i> Absent</span>`;

      tbody.insertAdjacentHTML("beforeend", `
        <tr>
          <td class="fw-bold text-dark">${date}</td>
          <td><span class="badge bg-success text-white font-monospace px-2.5">${a.period || "-"}</span></td>
          <td><span class="fw-semibold text-muted">${a.subject || "-"}</span></td>
          <td class="fw-semibold text-secondary small">${a.teacherName || "Unassigned"}</td>
          <td class="small fw-semibold text-muted">${a.unit || "-"}</td>
          <td class="text-uppercase small fw-semibold text-secondary">${a.description || "-"}</td>
          <td>${statusBadge}</td>
        </tr>
      `);
    });

    const { totalRecords, totalPages, currentPage, perPage, isFilterActive } = pagination;
    const startRange = ((currentPage - 1) * perPage) + 1;
    const endRange = Math.min(currentPage * perPage, totalRecords);
    
    if (isFilterActive) {
      document.getElementById("paginationInfo").innerText = `Filtered: ${startRange}-${endRange} of ${totalRecords}`;
    } else {
      document.getElementById("paginationInfo").innerText = `${startRange}-${endRange} of ${totalRecords}`;
    }

    let controlsHtml = "";

    if (totalPages > 1) {
      if (currentPage > 1) {
        controlsHtml += `
          <li class="page-item">
            <button class="page-link px-3 py-1.5 fw-bold rounded-start-3" onclick="syncMasterAttendancePipeline(${currentPage - 1})">
              <i class="fa-solid fa-chevron-left me-1 small"></i> Previous
            </button>
          </li>
        `;
      }

      const maxVisiblePages = 4; 
      let startPage = Math.max(1, currentPage - 1);
      let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

      if (endPage - startPage + 1 < maxVisiblePages) {
        startPage = Math.max(1, endPage - maxVisiblePages + 1);
      }

      if (startPage > 1) {
        controlsHtml += `
          <li class="page-item">
            <button class="page-link px-3 fw-bold" onclick="syncMasterAttendancePipeline(1)">1</button>
          </li>
        `;
        if (startPage > 2) {
          controlsHtml += `<li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted px-2">...</span></li>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        controlsHtml += `
          <li class="page-item ${currentPage === i ? 'active' : ''}">
            <button class="page-link px-3 fw-bold" onclick="syncMasterAttendancePipeline(${i})">${i}</button>
          </li>
        `;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          controlsHtml += `<li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted px-2">...</span></li>`;
        }
        controlsHtml += `
          <li class="page-item">
            <button class="page-link px-3 fw-bold" onclick="syncMasterAttendancePipeline(${totalPages})">${totalPages}</button>
          </li>
        `;
      }

      if (currentPage < totalPages) {
        controlsHtml += `
          <li class="page-item">
            <button class="page-link px-3 py-1.5 fw-bold rounded-end-3" onclick="syncMasterAttendancePipeline(${currentPage + 1})">
              Next <i class="fa-solid fa-chevron-right ms-1 small"></i>
            </button>
          </li>
        `;
      }
    }

    document.getElementById("paginationControlsContainer").innerHTML = controlsHtml;
  }

  document.addEventListener("DOMContentLoaded", () => {
    syncMasterAttendancePipeline(1);

    document.querySelectorAll(".filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        
        document.getElementById("logStartDate").value = "";
        document.getElementById("logEndDate").value = "";
        document.getElementById("academicYearSelect").value = "";
        document.getElementById("resetDefaultBtn").classList.add("d-none"); 
        clearWarningState();

        activeFilterMode = btn.dataset.filter;
        syncMasterAttendancePipeline(1);
      });
    });
  });
</script>