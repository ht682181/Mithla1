<body>

    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="alert-holder mb-3">
        <% if (error && error.length) { %>
        <div class="alert alert-danger alert-dismissible fade show text-danger bg-danger bg-opacity-10" role="alert">
            <strong>Error!</strong> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <% } %>
    </div>

    <div class="otp-card p-4 p-md-5">
        <div class="text-center">
            <div class="otp-icon-box">🔐</div>
            <h2 class="form-heading mb-2">OTP Verification</h2>
            <p class="text-muted small mb-1">We’ve sent a one-time password to</p>

            <% 
                const [otpEmailUser, otpEmailDomain] = email.split("@");
                const visible = otpEmailUser.slice(-4);
                const masked = "*".repeat(Math.max(0, otpEmailUser.length - 4));
                const maskedEmail = masked + visible + "@" + otpEmailDomain;
            %>
            <div class="email-badge"><%= maskedEmail %></div>
        </div>

        <form action="/verify-otp" method="post" class="needs-validation mt-4" novalidate>
            <div class="mb-4">
                <label class="form-label">Enter 6-Digit OTP</label>
                <input 
                    type="text"
                    name="otp"
                    class="form-control otp-input shadow-sm"
                    placeholder="••••••"
                    maxlength="6"
                    pattern="\d{6}"
                    required
                    autocomplete="off"
                >
                <div class="invalid-feedback text-start">
                    Please enter a valid 6-digit OTP.
                </div>
            </div>

            <button type="submit" class="w-100 btn btn-gradient fw-semibold">
                Verify OTP
            </button>
        </form>

        <!-- TIMER SECTION -->
        <div class="text-center mt-4">
            <small class="text-muted">
                OTP valid only for 
                <span class="fw-semibold text-danger">
                    <span id="otpTimer">30</span> seconds
                </span>
            </small>
        </div>

        <!-- RESEND LINK SECTION (Bina page refresh ka jugaad) -->
        <div class="text-center mt-2">
            <a
                href="javascript:void(0);"
                id="resendLink"
                onclick="handleResendOTP()"
                class="text-decoration-none text-muted small"
                style="pointer-events: none; cursor: not-allowed;"
            >
                Resend OTP
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Form Validation -->
    <script>
        (() => {
          'use strict'
          const forms = document.querySelectorAll('.needs-validation')
          Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
              if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
              }
              form.classList.add('was-validated')
            }, false)
          })
        })()
    </script>

    <!-- Dynamic Timer + AJAX Fetch Call for Brevo API -->
    <script>
        let timeLeft = 30;
        let timer;
        const timerEl = document.getElementById("otpTimer");
        const resendLink = document.getElementById("resendLink");

        function startTimer() {
            timeLeft = 30;
            timerEl.textContent = timeLeft;
            resendLink.style.pointerEvents = "none";
            resendLink.style.cursor = "not-allowed";
            resendLink.classList.remove("resend-active");
            resendLink.classList.add("text-muted");
            resendLink.innerText = "Resend OTP";

            timer = setInterval(() => {
                timeLeft--;
                timerEl.textContent = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    resendLink.style.pointerEvents = "auto";
                    resendLink.style.cursor = "pointer";
                    resendLink.classList.remove("text-muted");
                    resendLink.classList.add("resend-active");
                }
            }, 1000);
        }

        // Pehli baar load par timer chalayein
        startTimer();

        // AJAX (Fetch) Call handler
        async function handleResendOTP() {
            if (timeLeft > 0) return; 

            resendLink.innerText = "Sending..."; 
            resendLink.style.pointerEvents = "none";

            try {
                // Background POST call to server
                const response = await fetch('/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.success) {
                    alert("Resend otp successfully");
                    startTimer(); // Timer wapas reset ho jayega
                } else {
                    alert("Error: " + data.message);
                    resendLink.innerText = "Resend OTP";
                    resendLink.style.pointerEvents = "auto";
                }
            } catch (error) {
                console.error("AJAX Error:", error);
                alert("Network issue. Please try again.");
                resendLink.innerText = "Resend OTP";
                resendLink.style.pointerEvents = "auto";
            }
        }
    </script>
</body>
</html>